fyo:magnetic_shear_q1 a owl:DatatypeProperty ;
    rdfs:label "magnetic_shear_q1" ;
    skos:definition "Magnetic shear at surface q = 1, defined as rho_tor/q . dq/drho_tor" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:mask a owl:DatatypeProperty ;
    rdfs:label "mask" ;
    skos:definition "Mask of the region of interest on the frame (0 = point outside the ROI, 1 = point inside the ROI). First dimension : row index (horizontal orientation). Second dimension: column index (vertical orientation)" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:matching_element a owl:ObjectProperty ;
    rdfs:label "matching_element" ;
    skos:definition "Set of matching elements" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" ;
    fyo:dd_units "A" .

fyo:measured_diagnostics a owl:ObjectProperty ;
    rdfs:label "measured_diagnostics" ;
    skos:definition "INPUT — the measured diagnostic signal set of the analyzed discharge (d_obs): magnetic probes / flux loops, interferometry / polarimetry, Thomson scattering, charge exchange, ECE, MSE, bolometry, … — each an IDS occurrence with modality `measured`, produced by the MeasurementProcesses of the Discharge." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:fyo_ids "magnetics, interferometer, polarimeter, thomson_scattering, charge_exchange, ece, mse, bolometer" ;
    fyo:io "input" .

fyo:metastable a owl:DatatypeProperty ;
    rdfs:label "metastable" ;
    skos:definition "An array identifying the metastable; if zero-length, then not a metastable; if of length 1, then the value indicates the electronic level for the metastable (mostly used for atoms/ions); if of length 2, then the 1st would indicate the electronic level and the second the vibrational level for the metastable (mostly used for molecules and molecular ions); if of length 3, then the 1st would indicate the electronic level, the second the vibrational level and the third the rotational level for the metastable (mostly used for molecules and molecular ions)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:midplane_wall_distance a owl:DatatypeProperty ;
    rdfs:label "midplane_wall_distance" ;
    skos:definition "Radial distance from the first wall evaluated at the midplane (0.0 at the first wall)" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:mirror a owl:ObjectProperty ;
    rdfs:label "mirror" ;
    skos:definition "Set of mirrors associated with the launcher" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:movement a owl:ObjectProperty ;
    rdfs:label "movement" ;
    skos:definition "Set of degrees of freedom for this mirror, allowing the mirror to move around its reference position indicated in ../geometry. Can be cascaded for composite movements." ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "3" .

fyo:mse_polarization_angle a owl:ObjectProperty ;
    rdfs:label "mse_polarization_angle" ;
    skos:definition "Set of MSE polarization angles" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "IDS:mse/channel" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "rad" .

fyo:multi_temperature_fits a owl:ObjectProperty ;
    rdfs:label "multi_temperature_fits" ;
    skos:definition "Set of temperatures describing the electron and ion distribution functions in case of multi-temperature fits" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "2" .

fyo:n_e_fast a owl:DatatypeProperty ;
    rdfs:label "n_e_fast" ;
    skos:definition "Density of fast (non-thermal) electrons" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-3" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:n_perpendicular a owl:DatatypeProperty ;
    rdfs:label "n_perpendicular" ;
    skos:definition "Perpendicular refractive index" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../../length" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../length" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:n_pol a owl:DatatypeProperty ;
    rdfs:label "n_pol" ;
    skos:definition "Refraction index in the poloidal direction. The poloidal angle is defined from the reference point; the angle at a point (R,Z) is given by atan((Z-Zref)/(R-Rref)), where Rref=reference_point/r and Zref=reference_point/z" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:neutron_flux_integrated_flags a owl:DatatypeProperty ;
    rdfs:label "neutron_flux_integrated_flags" ;
    skos:definition "Array of flags telling, for each coordinate of the neutron_flux, whether the neutron_flux has been integrated over this coordinate (1) or not (0). If it has been integrated over a coordinate, the size related to this coordinate must be equal to 1" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "1...5" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...5" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:neutron_flux_total a owl:DatatypeProperty ;
    rdfs:label "neutron_flux_total" ;
    skos:definition "Total Neutron Flux reconstructed from the detectors signals" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:nonlinear_controller a owl:ObjectProperty ;
    rdfs:label "nonlinear_controller" ;
    skos:definition "A non-linear controller, this is less conventional and will have to be developed" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:o_mode_fraction a owl:DatatypeProperty ;
    rdfs:label "o_mode_fraction" ;
    skos:definition "Fraction of EC beam power launched in ordinary (O) mode. If all power is launched in ordinary mode (O-mode), o_mode_fraction = 1.0. If all  power is launched in extraordinary mode (X-mode), o_mode_fraction = 0.0" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:operating_point_evaluations a owl:ObjectProperty ;
    rdfs:label "operating_point_evaluations" ;
    skos:definition "OUTPUT — the evaluated operating points of surviving candidates (equilibrium + profiles + global performance summary per candidate); modality simulated; the evidence base of the ranking." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:fyo_ids "equilibrium, core_profiles, summary" ;
    fyo:io "output" .

fyo:optical_temperature a owl:DatatypeProperty ;
    rdfs:label "optical_temperature" ;
    skos:definition "Temperature of the optical components (digital levels)" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:p_e a owl:DatatypeProperty ;
    rdfs:label "p_e" ;
    skos:definition "Electron pressure" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:p_e_fast_parallel a owl:DatatypeProperty ;
    rdfs:label "p_e_fast_parallel" ;
    skos:definition "Fast (non-thermal) electron parallel pressure" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:p_e_fast_perpendicular a owl:DatatypeProperty ;
    rdfs:label "p_e_fast_perpendicular" ;
    skos:definition "Fast (non-thermal) electron perpendicular pressure" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:p_i_total a owl:DatatypeProperty ;
    rdfs:label "p_i_total" ;
    skos:definition "Total ion pressure (sum over the ion species)" ;
    skos:inScheme fyo:sawteeth ;
