fyo:a_field_parallel_perturbed_parity a owl:DatatypeProperty ;
    rdfs:label "a_field_parallel_perturbed_parity" ;
    skos:definition "Parity of the perturbed parallel vector potential with respect to theta = 0 (poloidal angle)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../time_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:a_field_parallel_perturbed_weight a owl:DatatypeProperty ;
    rdfs:label "a_field_parallel_perturbed_weight" ;
    skos:definition "Amplitude of the perturbed parallel vector potential normalized to the sum of amplitudes of all perturbed fields" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../time_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:a_field_phi a owl:ObjectProperty ;
    rdfs:label "a_field_phi" ;
    skos:definition "Toroidal component of the magnetic vector potential, given on various grid subsets" ;
    skos:inScheme fyo:mhd ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "T.m" .

fyo:a_field_tor a owl:ObjectProperty ;
    rdfs:label "a_field_tor" ;
    skos:definition "Toroidal component of the vacuum vector potential, given on various grid subsets" ;
    skos:inScheme fyo:tf ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "T.m" .

fyo:ablated_particles a owl:DatatypeProperty ;
    rdfs:label "ablated_particles" ;
    skos:definition "Number of ablated particles (electrons) along the pellet path" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_coordinate1 "../distance" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../distance" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:ablation_rate a owl:DatatypeProperty ;
    rdfs:label "ablation_rate" ;
    skos:definition "Ablation rate (electrons) along the pellet path" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_coordinate1 "../distance" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s^-1" ;
    fyo:fyo_domain "../distance" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:actuator_commands a owl:ObjectProperty ;
    rdfs:label "actuator_commands" ;
    skos:definition "OUTPUT — the actuator command history issued by the control laws over the simulated pulse (coil circuit voltages / currents, gas / heating commands)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:fyo_ids "pf_active, gas_injection, nbi, ec_launchers" ;
    fyo:io "output" .

fyo:alfven_frequency_spectrum a owl:ObjectProperty ;
    rdfs:label "alfven_frequency_spectrum" ;
    skos:definition "Local shear Alfven spectrum as a function of radius (only in case grid/dim1 is a radial coordinate)" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_coordinate1 "../grid/dim1" ;
    fyo:dd_max_occurs "unbounded" .

fyo:allocated_position a owl:DatatypeProperty ;
    rdfs:label "allocated_position" ;
    skos:definition "Allocation of signal to a position in the SDN (1..N), or several positions in case of signal reshaping; this will be implementation specific" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:angle_pol_equilibrium a owl:DatatypeProperty ;
    rdfs:label "angle_pol_equilibrium" ;
    skos:definition "Poloidal angle grid, from -pi to pi, on which the species dependent effective potential energy (which determines the poloidal variation of the density) is expressed. The angle is defined with respect to (R0,Z0) with R0=(Rmax-Rmin)/2 and Z0=(Zmax-Zmin)/2. It is increasing clockwise. So (r,theta,phi) is right-handed. theta=0 for Z=Z0 and R>R0 (LFS)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "rad" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:antennas_orientation a owl:ObjectProperty ;
    rdfs:label "antennas_orientation" ;
    skos:definition "Description of lines of sight and antenna orientation as a function of time" ;
    skos:inScheme fyo:reflectometer_fluctuation ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:apparent_temperature a owl:DatatypeProperty ;
    rdfs:label "apparent_temperature" ;
    skos:definition "Processed image in apparent temperature. First dimension : row index (horizontal orientation). Second dimension: column index (vertical orientation). The size of this matrix is assumed to be constant over time" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "K" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:attachement_points a owl:ObjectProperty ;
    rdfs:label "attachement_points" ;
    skos:definition "Attachement point(s) of the sensor. Two for displacement sensors, one for the other types of sensors" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "2" .

fyo:attachement_uris a owl:DatatypeProperty ;
    rdfs:label "attachement_uris" ;
    skos:definition "IMAS URI of the system(s) to which this sensor is attached. Two for displacement sensors, one for the other types of sensors" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:axisymmetric a owl:ObjectProperty ;
    rdfs:label "axisymmetric" ;
    skos:definition "Optional equivalent axisymmetric representation of the geometry of each element (e.g. for each iron core segment), typically used to represent iron core in axisymmetric equilibrium solvers" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../centroid/x" ;
    fyo:dd_max_occurs "33" .

fyo:azimuthal_angle a owl:DatatypeProperty ;
    rdfs:label "azimuthal_angle" ;
    skos:definition "Poincare sphere angle psi for mixed mode" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:b_field_average a owl:DatatypeProperty ;
    rdfs:label "b_field_average" ;
    skos:definition "Flux surface averaged modulus of B (always positive, irrespective of the sign convention for the B-field direction)." ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_linear a owl:DatatypeProperty ;
    rdfs:label "b_field_linear" ;
    skos:definition "Array of magnetic field values (corresponding to the assumption of a linear relation between magnetic field and probe coil current), for each of which the probe non-linear response is given in ../b_field_non_linear" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_lines a owl:ObjectProperty ;
    rdfs:label "b_field_lines" ;
    skos:definition "Magnetic field line tracing results, given at various time slices" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" ;
    fyo:fyo_lift "representation_set" ;
    fyo:fyo_note "elements are spo:equivalent_representation peers — one referent quantity on alternative grids/charts" .

fyo:b_field_min a owl:DatatypeProperty ;
    rdfs:label "b_field_min" ;
    skos:definition "Minimum(modulus(B)) on the flux surface (always positive, irrespective of the sign convention for the B-field direction)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_modulus a owl:DatatypeProperty ;
    rdfs:label "b_field_modulus" ;
    skos:definition "Modulus of the magnetic field (always positive, irrespective of the sign convention for the B-field direction), obtained from Zeeman effect fit" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:b_field_non_linear a owl:DatatypeProperty ;
    rdfs:label "b_field_non_linear" ;
    skos:definition "Magnetic field value taking into account the non-linear response of the probe" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "../b_field_linear" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "../b_field_linear" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_normal a owl:DatatypeProperty ;
    rdfs:label "b_field_normal" ;
    skos:definition "Normal component of the vacuum error magnetic field on the various surface points" ;
    skos:inScheme fyo:b_field_non_axisymmetric ;
    fyo:dd_coordinate1 "../outline/r" ;
    fyo:dd_coordinate2 "../phi" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "../outline/r,../phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:b_field_normal_fourier a owl:DatatypeProperty ;
    rdfs:label "b_field_normal_fourier" ;
    skos:definition "Fourier coefficients of the normal component of the vacuum error magnetic field on the various surface points" ;
    skos:inScheme fyo:b_field_non_axisymmetric ;
    fyo:dd_coordinate1 "../outline/r" ;
    fyo:dd_coordinate2 "../n_phi" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T" ;
    fyo:fyo_domain "../outline/r,../n_phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:b_field_parallel_perturbed_parity a owl:DatatypeProperty ;
    rdfs:label "b_field_parallel_perturbed_parity" ;
    skos:definition "Parity of the perturbed parallel magnetic field with respect to theta = 0 (poloidal angle)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../time_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_parallel_perturbed_weight a owl:DatatypeProperty ;
    rdfs:label "b_field_parallel_perturbed_weight" ;
    skos:definition "Amplitude of the perturbed parallel magnetic field normalized to the sum of amplitudes of all perturbed fields" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../time_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:b_field_phi_probe a owl:ObjectProperty ;
    rdfs:label "b_field_phi_probe" ;
    skos:definition "Toroidal field probes" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:b_field_pol_probe_equivalent a owl:DatatypeProperty ;
    rdfs:label "b_field_pol_probe_equivalent" ;
    skos:definition "Indices of equivalent poloidal field probes (from the b_field_pol_probe array) that differ only by their toroidal position and have the same (R,Z) position and the same coil orientation (poloidal and toroidal angles). Sets of equivalent probes (i.e. sets of (R, Z, poloidal_angle and toroidal_angle) values) are grouped by the first coordinate and the coils belonging to a given set are listed along the second coordinate. As an example, if there are N probes in a poloidal cross section that are replicated at the same poloidal positions and with the same orientation at 8 toroidal positions, the matrix will be of size Nx8." ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:bandwidth a owl:ObjectProperty ;
    rdfs:label "bandwidth" ;
    skos:definition "Set of frequency bandwidths" ;
    skos:inScheme fyo:refractometer ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:bandwidth_3db a owl:DatatypeProperty ;
    rdfs:label "bandwidth_3db" ;
    skos:definition "3dB bandwith (first index : lower frequency bound, second index : upper frequency bound)" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:beamlets_group a owl:ObjectProperty ;
    rdfs:label "beamlets_group" ;
    skos:definition "Group of beamlets with common vertical and horizontal focal point. If there are no common focal points, then select small groups of beamlets such that a focal point description of the beamlets group provides a fair description. Beamlet groups are assumed to be Gaussian." ;
    skos:inScheme fyo:nbi ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "16" .

fyo:bin a owl:ObjectProperty ;
    rdfs:label "bin" ;
    skos:definition "Set of bins (binning in the vertical dimension) defined to increase the signal to noise ratio of the spectra" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:binormal a owl:DatatypeProperty ;
    rdfs:label "binormal" ;
    skos:definition "Coordinates along the binormal axis" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../normal" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../normal" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:bins a owl:DatatypeProperty ;
    rdfs:label "bins" ;
    skos:definition "Bins of quantitiy values, defined for each element (first dimension) corresponding to the first dimension of the original 2D quantity" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:bounce_harmonics a owl:DatatypeProperty ;
    rdfs:label "bounce_harmonics" ;
    skos:definition "Array of bounce harmonics k" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:boundary_condition a owl:ObjectProperty ;
    rdfs:label "boundary_condition" ;
    skos:definition "Set of boundary conditions of the transport equation" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:boundary_conditions_ggd a owl:ObjectProperty ;
    rdfs:label "boundary_conditions_ggd" ;
    skos:definition "Boundary conditions of the transport equations, provided on the GGD, for various time slices" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:boundary_outline a owl:ObjectProperty ;
    rdfs:label "boundary_outline" ;
    skos:definition "Set of (R,Z) points defining the outline of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "301" .

fyo:brdf a owl:ObjectProperty ;
    rdfs:label "brdf" ;
    skos:definition "Bidirectional Reflectance Distribution Function, given for each slice of the grid_ggd time base (the component description is not supposed to change, but grid_ggd may evolve with time)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:calibration_absolute a owl:DatatypeProperty ;
    rdfs:label "calibration_absolute" ;
    skos:definition "Factor to be multiplied by the spectral calibration to obtain the instrument function (fraction of signal received on each energy channel when a photon of relevant energy enters the optical system)" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "../wavelength_band" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelength_band" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:calibration_spectral a owl:DatatypeProperty ;
    rdfs:label "calibration_spectral" ;
    skos:definition "Polychromator response function: fraction of signal received on each energy channel when a photon of relevant energy enters the polychromator." ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "../wavelength_band" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelength_band" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:camera_dimensions a owl:DatatypeProperty ;
    rdfs:label "camera_dimensions" ;
    skos:definition "Total camera dimension in each direction (x1, x2)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:change a owl:ObjectProperty ;
    rdfs:label "change" ;
    skos:definition "Set of instant change terms (each being due to a different phenomenon)" ;
    skos:inScheme fyo:core_instant_changes ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:charge_state a owl:ObjectProperty ;
    rdfs:label "charge_state" ;
    skos:definition "Process tables for a set of charge states. Only one table is used for that process, defined by process(:)/table_dimension. If the data in the table_Nd array are used as parameters for a function, then no coordinates are needed, and coordinate_index should be set to -1, and result_transformation should contain the integer identifier to the internally provided functions. If the results will come from an interpolation in the table_Nd data, then coordinates must be provided in coordinate_system(process(i1)/coordinate_index), and the shape of the table should match the cartesian product of the coordinates" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "75" .

fyo:circuit a owl:ObjectProperty ;
    rdfs:label "circuit" ;
    skos:definition "Circuits, connecting multiple PF coils to multiple supplies, defining the current and voltage relationships in the system" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "32" .

fyo:closed_loop_trajectory a owl:ObjectProperty ;
    rdfs:label "closed_loop_trajectory" ;
    skos:definition "OUTPUT — the closed-loop simulated state trajectory (equilibrium + profiles over time); modality simulated." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:fyo_ids "equilibrium, core_profiles, summary" ;
    fyo:io "output" .

fyo:coherent_wave a owl:ObjectProperty ;
    rdfs:label "coherent_wave" ;
    skos:definition "Wave description for each frequency" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:cold_neutrals_fraction a owl:DatatypeProperty ;
    rdfs:label "cold_neutrals_fraction" ;
    skos:definition "Fraction of cold neutrals for this isotope (n_cold_neutrals/(n_cold_neutrals+n_hot_neutrals))" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:cold_neutrals_temperature a owl:DatatypeProperty ;
    rdfs:label "cold_neutrals_temperature" ;
    skos:definition "Temperature of cold neutrals for this isotope" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:collector a owl:ObjectProperty ;
    rdfs:label "collector" ;
    skos:definition "Set of probe collectors including measurements specific to each collector. The number of collectors (size of this array of structure) is assumed to remain constant for all plunges" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:columns_uri a owl:DatatypeProperty ;
    rdfs:label "columns_uri" ;
    skos:definition "List of URIs corresponding to the columns (2nd dimension) of the coupling matrix. See examples above (rows_uri)" ;
    skos:inScheme fyo:em_coupling ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:combination_matrix a owl:DatatypeProperty ;
    rdfs:label "combination_matrix" ;
    skos:definition "Force limits are expressed as a linear combination of the forces on each individual coil. The weights of the linear combination are given by this matrix, while the limits are given by the sibling nodes limit_min and limit_max. Each row of this matrix corresponds to a force limit. The columns represent, for each coil, the 4 types of forces on the coil namely [coil1_radial, coil1_vertical, coil1_radial_crush, coil1_vertical_crush, coil2_radial, coil2_vertical, coil2_radial_crush, coil2_vertical_crush, ...]. There are therefore 4*coils_n columns." ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "../limit_max" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../limit_max,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:conductivity a owl:ObjectProperty ;
    rdfs:label "conductivity" ;
    skos:definition "Conductivity, on various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "ohm^-1.m^-1" .

fyo:conductor a owl:ObjectProperty ;
    rdfs:label "conductor" ;
    skos:definition "Set of conductors inside the coil. The structure can be used with size 1 for a simplified description as a single conductor. A conductor is composed of several elements, serially connected, i.e. transporting the same current." ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" ;
    fyo:dd_type "static" .

fyo:connections a owl:DatatypeProperty ;
    rdfs:label "connections" ;
    skos:definition "Description of the supplies and coils connections (nodes) across the circuit. Nodes of the circuit are listed as the first dimension of the matrix. Supplies (listed first) and coils (listed second) are listed as the second dimension. Thus the second dimension has a size equal to (N_supplies+N_coils). N_supplies (resp. N_coils) is the total number of supplies (resp. coils) listed in the supply (resp.coil) array of structure, i.e. including also supplies/coils that are not part of the actual circuit. The (i,j) matrix elements are 1 if the j-th supply or coil side is connected to the i-th node by its positive side, -1 if connected by its negative side, or 0 if not connected." ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:constant_float0d a owl:ObjectProperty ;
    rdfs:label "constant_float0d" ;
    skos:definition "Constant 0D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" ;
    fyo:dd_units "mixed" .

fyo:constant_float1d a owl:ObjectProperty ;
    rdfs:label "constant_float1d" ;
    skos:definition "Constant 1D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" ;
    fyo:dd_units "mixed" .

fyo:constant_float2d a owl:ObjectProperty ;
    rdfs:label "constant_float2d" ;
    skos:definition "Constant 2D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_float3d a owl:ObjectProperty ;
    rdfs:label "constant_float3d" ;
    skos:definition "Constant 3D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_float4d a owl:ObjectProperty ;
    rdfs:label "constant_float4d" ;
    skos:definition "Constant 4D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_float5d a owl:ObjectProperty ;
    rdfs:label "constant_float5d" ;
    skos:definition "Constant 5D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_float6d a owl:ObjectProperty ;
    rdfs:label "constant_float6d" ;
    skos:definition "Constant 6D float" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_integer0d a owl:ObjectProperty ;
    rdfs:label "constant_integer0d" ;
    skos:definition "Constant 0D integer" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_integer1d a owl:ObjectProperty ;
    rdfs:label "constant_integer1d" ;
    skos:definition "Constant 1D integer" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_integer2d a owl:ObjectProperty ;
    rdfs:label "constant_integer2d" ;
    skos:definition "Constant 2D integer" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_integer3d a owl:ObjectProperty ;
    rdfs:label "constant_integer3d" ;
    skos:definition "Constant 3D integer" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_string0d a owl:ObjectProperty ;
    rdfs:label "constant_string0d" ;
    skos:definition "Constant 0D string" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constant_string1d a owl:ObjectProperty ;
    rdfs:label "constant_string1d" ;
    skos:definition "Constant 1D string" ;
    skos:inScheme fyo:temporary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:constraints_and_priors a owl:ObjectProperty ;
    rdfs:label "constraints_and_priors" ;
    skos:definition "INPUT (optional) — parameterization, regularization and prior information (the middle layer of the forward / parameterization+prior / inference-engine decoupling)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:io "input" .

fyo:content a owl:ObjectProperty ;
    rdfs:label "content" ;
    skos:definition "Particle content = total number of particles for this ion species in the volume of the grid subset, for various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "1" .

fyo:control_float a owl:DatatypeProperty ;
    rdfs:label "control_float" ;
    skos:definition "Array of real workflow control parameters used by this component (component specific)" ;
    skos:inScheme fyo:workflow ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:control_integer a owl:DatatypeProperty ;
    rdfs:label "control_integer" ;
    skos:definition "Array of integer workflow control parameters used by this component (component specific)" ;
    skos:inScheme fyo:workflow ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:control_surface a owl:ObjectProperty ;
    rdfs:label "control_surface" ;
    skos:definition "Magnetic field components and Fourier decomposition of the normal components of the magnetic field for a set of given control surfaces" ;
    skos:inScheme fyo:b_field_non_axisymmetric ;
    fyo:dd_coordinate1 "../../control_surface_names" ;
    fyo:dd_max_occurs "unbounded" .

fyo:control_surface_names a owl:DatatypeProperty ;
    rdfs:label "control_surface_names" ;
    skos:definition "List of control surface names, refers to the ../time_slice/control_surface index" ;
    skos:inScheme fyo:b_field_non_axisymmetric ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:cooling_loop a owl:ObjectProperty ;
    rdfs:label "cooling_loop" ;
    skos:definition "Set of cooling loops" ;
    skos:inScheme fyo:calorimetry ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "8" .

fyo:coordinate a owl:ObjectProperty ;
    rdfs:label "coordinate" ;
    skos:definition "Set of coordinates for that coordinate system. A coordinate an be either a range of real values or a set of discrete values (if interpolation_type=0)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "6" .

fyo:coordinate_identifier a owl:ObjectProperty ;
    rdfs:label "coordinate_identifier" ;
    skos:definition "Set of coordinate identifiers, coordinates on which the markers are represented" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "W.m^-3" .

fyo:counts_bin_n a owl:DatatypeProperty ;
    rdfs:label "counts_bin_n" ;
    skos:definition "Number of counts detected on each pixel/bin of the binned frame during one exposure time" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "../../bin" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N,../../bin" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:counts_to_radiance a owl:DatatypeProperty ;
    rdfs:label "counts_to_radiance" ;
    skos:definition "Counts to radiance factor, for each pixel of the detector. Includes both the transmission losses in the relay optics and the quantum efficiency of the camera itself, integrated over the wavelength range" ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^-2.s^-1.sr^-1" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:coupling_matrix a owl:ObjectProperty ;
    rdfs:label "coupling_matrix" ;
    skos:definition "Set of user-defined coupling matrices, complementary to the other system-based coupling matrices of this IDS" ;
    skos:inScheme fyo:em_coupling ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:crash_trigger a owl:DatatypeProperty ;
    rdfs:label "crash_trigger" ;
    skos:definition "Flag indicating whether a crash condition has been satisfied : 0 = no crash. N(>0) = crash triggered due to condition N as follows. 1: crash triggered by the ideal kink criterion; 2: crash triggered by the ideal kink criterion including kinetic effects from fast particles; 31: crash triggered by the resistive kink criterion (meeting necessary conditions for reconnection); 32: crash triggered by the resistive kink criterion (resistive kink mode is unstable). The distinction between 31 and 32 only indicates whether (31) or (32) was the last criterion to be satisfied" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:cross_section a owl:ObjectProperty ;
    rdfs:label "cross_section" ;
    skos:definition "The cross-section perpendicular to the conductor contour is described by a series of contour points, given by their relative position with respect to the start point of each element. If the size of this array of structure is equal to 1, then the cross-section is given only for the first element and translated along the conductor elements. Otherwise, it's given explictly for each element, allowing to describe changes of the cross section shape" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../elements/types OR 1...1" ;
    fyo:dd_max_occurs "50" .

fyo:current_halo_phi a owl:DatatypeProperty ;
    rdfs:label "current_halo_phi" ;
    skos:definition "Toroidal halo current" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:current_parallel_density a owl:DatatypeProperty ;
    rdfs:label "current_parallel_density" ;
    skos:definition "Flux surface averaged wave driven parallel current density = average(j.B) / B0, where B0 = vacuum_toroidal_field/b0." ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:current_parallel_density_n_phi a owl:DatatypeProperty ;
    rdfs:label "current_parallel_density_n_phi" ;
    skos:definition "Flux surface averaged wave driven parallel current density, per toroidal mode number" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_coordinate2 "../n_phi" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../grid/rho_tor_norm,../n_phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:current_phi_inside a owl:DatatypeProperty ;
    rdfs:label "current_phi_inside" ;
    skos:definition "Wave driven toroidal current, inside a flux surface" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:current_phi_inside_n_phi a owl:DatatypeProperty ;
    rdfs:label "current_phi_inside_n_phi" ;
    skos:definition "Wave driven toroidal current, inside a flux surface, per toroidal mode number" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_coordinate2 "../n_phi" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A" ;
    fyo:fyo_domain "../grid/rho_tor_norm,../n_phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:current_phi_n_phi a owl:DatatypeProperty ;
    rdfs:label "current_phi_n_phi" ;
    skos:definition "Wave driven toroidal current from a stand alone calculation (not consistent with other sources) per toroidal mode number" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../n_phi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A" ;
    fyo:fyo_domain "../n_phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:curvature_radii a owl:DatatypeProperty ;
    rdfs:label "curvature_radii" ;
    skos:definition "Curvature radius of each arc of circle" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../r" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../r" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:cut a owl:DatatypeProperty ;
    rdfs:label "cut" ;
    skos:definition "Miller indices characterizing the cut of the crystal (can be of length 3 or 4)" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:cut_off_frequency a owl:DatatypeProperty ;
    rdfs:label "cut_off_frequency" ;
    skos:definition "Cut-off frequency as a function of measurement position and time" ;
    skos:inScheme fyo:reflectometer_profile ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "../n_e/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_domain "1...N,../n_e/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:d2_dr2 a owl:DatatypeProperty ;
    rdfs:label "d2_dr2" ;
    skos:definition "Second order radial derivative with respect to the primary coordinate" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../../../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:d_dr a owl:DatatypeProperty ;
    rdfs:label "d_dr" ;
    skos:definition "Radial derivative with respect to the primary coordinate" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../../../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:d_dt a owl:DatatypeProperty ;
    rdfs:label "d_dt" ;
    skos:definition "Time derivative" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../../../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:d_dt_cphi a owl:DatatypeProperty ;
    rdfs:label "d_dt_cphi" ;
    skos:definition "Derivative with respect to time, at constant toroidal flux (for current diffusion equation)" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../../../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:d_dt_cr a owl:DatatypeProperty ;
    rdfs:label "d_dt_cr" ;
    skos:definition "Derivative with respect to time, at constant primary coordinate coordinate (for current diffusion equation)" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../../../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:d_dvolume_drho_tor_dt a owl:DatatypeProperty ;
    rdfs:label "d_dvolume_drho_tor_dt" ;
    skos:definition "Partial derivative with respect to time of the derivative of the volume with respect to the toroidal flux coordinate" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^2.s^-1" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:darea_dpsi a owl:DatatypeProperty ;
    rdfs:label "darea_dpsi" ;
    skos:definition "Radial derivative of the cross-sectional area of the flux surface with respect to psi" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^2.Wb^-1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:darea_drho_tor a owl:DatatypeProperty ;
    rdfs:label "darea_drho_tor" ;
    skos:definition "Radial derivative of the cross-sectional area of the flux surface with respect to rho_tor" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:data_entry a owl:ObjectProperty ;
    rdfs:label "data_entry" ;
    skos:definition "For this release, list of each data item (i.e. shot/run pair containing the actual data) included in this release" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "30" .

fyo:data_str a owl:DatatypeProperty ;
    rdfs:label "data_str" ;
    skos:definition "Signal data (e.g. diagnostic signal or PCS command), serialized as a string" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "../../time_stamp" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "../../time_stamp" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:dc_dr_minor_norm a owl:DatatypeProperty ;
    rdfs:label "dc_dr_minor_norm" ;
    skos:definition "Derivative of the 'c' shape coefficients with respect to r_minor_norm" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../shape_coefficients_c" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../shape_coefficients_c" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:density_ratio a owl:DatatypeProperty ;
    rdfs:label "density_ratio" ;
    skos:definition "Ratio of the density of neutrals of this isotope over the summed neutral densities of all other isotopes described in the ../isotope array" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:description_ggd a owl:ObjectProperty ;
    rdfs:label "description_ggd" ;
    skos:definition "Set of 3D wall descriptions, described using the GGD, for each type of possible physics or engineering configurations necessary (gas tight vs wall with ports and holes, coarse vs fine representation, ...)." ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "3" .

fyo:detector_dimensions a owl:DatatypeProperty ;
    rdfs:label "detector_dimensions" ;
    skos:definition "Total detector dimension in each direction (horizontal, vertical)" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:detectors_used a owl:DatatypeProperty ;
    rdfs:label "detectors_used" ;
    skos:definition "1 if the detector is used for the emissivity reconstruction; 0 if the detector is not used" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../../detector" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "../../detector,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:diamagnetic_coefficients a owl:DatatypeProperty ;
    rdfs:label "diamagnetic_coefficients" ;
    skos:definition "Interpolation coefficients for the diamagnetic component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "as_parent" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:dim3 a owl:DatatypeProperty ;
    rdfs:label "dim3" ;
    skos:definition "Third dimension values" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:discrete a owl:DatatypeProperty ;
    rdfs:label "discrete" ;
    skos:definition "List of indices of grid spaces (refers to ../grid/space) for which the source is discretely distributed. For example consider a source of 3.5 MeV alpha particles provided on a grid with two coordinates (spaces); rho_tor and energy. To specify that the source is given at energies exactly equal to 3.5 MeV, let discret have length 1 and set discrete(1)=2 since energy is dimension number 2. The source is then proportional to delta( 1 - energy / 3.5MeV ), where delta is the direct delta distribution. Discrete dimensions can only be used when the grid is rectangular." ;
    skos:inScheme fyo:distribution_sources ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:distance_to_antenna a owl:DatatypeProperty ;
    rdfs:label "distance_to_antenna" ;
    skos:definition "Radial distance to the antenna mouth (grid for the electron density profile). 0 at antenna mouth, increasing towards the plasma" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:divergence_component a owl:ObjectProperty ;
    rdfs:label "divergence_component" ;
    skos:definition "Detailed information on beamlet divergence. Divergence is described as a superposition of Gaussian components with amplitide \"particles_fraction\" and vertical/horizontal divergence. Note that for positive ion NBI the divergence is well described by a single Gaussian" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "3" .

fyo:divertor a owl:ObjectProperty ;
    rdfs:label "divertor" ;
    skos:definition "Set of divertors" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "8" .

fyo:divertor_target a owl:ObjectProperty ;
    rdfs:label "divertor_target" ;
    skos:definition "Parameters at a divertor target" ;
    skos:inScheme fyo:summary ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "4" .

fyo:dn_e_over_n_e a owl:DatatypeProperty ;
    rdfs:label "dn_e_over_n_e" ;
    skos:definition "Relative amplitude of the density fluctuations post-processed for swept and fixed frequency (profile/one point)" ;
    skos:inScheme fyo:reflectometer_fluctuation ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "../time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N,../time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:dpressure_dpsi a owl:DatatypeProperty ;
    rdfs:label "dpressure_dpsi" ;
    skos:definition "Derivative of pressure w.r.t. psi" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa.Wb^-1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:dpsi_drho_tor a owl:DatatypeProperty ;
    rdfs:label "dpsi_drho_tor" ;
    skos:definition "Derivative of Psi with respect to Rho_Tor" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb.m^-1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:drho_tor_dt a owl:DatatypeProperty ;
    rdfs:label "drho_tor_dt" ;
    skos:definition "Partial derivative of the toroidal flux coordinate profile with respect to time" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
