fyo:PortExecutionMode a owl:Class ;
    rdfs:label "PortExecutionMode" ;
    owl:unionOf ( <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/PortExecutionMode#live> <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/PortExecutionMode#stub> <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/PortExecutionMode#archive> ) ;
    skos:definition "Execution mode of an engineering port run (FYTOK-ADR-126): live external-code run, stub, or archive read-back — archive is a FIRST-CLASS mode (an archived result can serve as the numerical arm; one real engineering run costs far more than one archive read)." ;
