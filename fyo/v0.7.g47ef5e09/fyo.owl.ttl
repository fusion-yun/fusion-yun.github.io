fyo:energy_radiated_electrons_impurities a owl:DatatypeProperty ;
    rdfs:label "energy_radiated_electrons_impurities" ;
    skos:definition "Total cumulated energy (integral of the power over the disruption duration) radiated by electrons on impurities" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:energy_radiated_electrons_impurities_halo a owl:DatatypeProperty ;
    rdfs:label "energy_radiated_electrons_impurities_halo" ;
    skos:definition "Cumulated energy (integral of the power over the disruption duration) radiated by electrons on impurities in the halo region" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:energy_threshold_lower a owl:DatatypeProperty ;
    rdfs:label "energy_threshold_lower" ;
    skos:definition "Lower energy detection threshold on each pixel of the detector (photons are counted only if their energy is above this value)" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:dd_units "eV" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:engineering_evaluations a owl:ObjectProperty ;
    rdfs:label "engineering_evaluations" ;
    skos:definition "OUTPUT — port-evaluated whole-machine engineering quantities of candidates (first port: neutronics — source from fusion source terms, geometry from wall / coil carriers), landed in existing DD carriers per the ADR-126 contract." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:fyo_ids "wall, breeding_blanket, balance_of_plant" ;
    fyo:io "output" .

fyo:equation a owl:ObjectProperty ;
    rdfs:label "equation" ;
    skos:definition "Set of transport equations" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:event a owl:ObjectProperty ;
    rdfs:label "event" ;
    skos:definition "List of events, either predefined triggers  or events recorded during the pulse" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "130" .

fyo:extinction_coefficient a owl:DatatypeProperty ;
    rdfs:label "extinction_coefficient" ;
    skos:definition "Extinction coefficient (for metal)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelengths" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:extrapolation_type a owl:DatatypeProperty ;
    rdfs:label "extrapolation_type" ;
    skos:definition "Extrapolation strategy when leaving the domain. The first value of the vector describes the behaviour at lower bound, the second describes the at upper bound. Possible values: 0=none, report error; 1=boundary value; 2=linear extrapolation" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:f a owl:DatatypeProperty ;
    rdfs:label "f" ;
    skos:definition "Diamagnetic function (F=R B_Phi)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T.m" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:f_df_dpsi a owl:DatatypeProperty ;
    rdfs:label "f_df_dpsi" ;
    skos:definition "Derivative of F w.r.t. Psi, multiplied with F" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T^2.m^2.Wb^-1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:filter_denominator a owl:DatatypeProperty ;
    rdfs:label "filter_denominator" ;
    skos:definition "Coefficients of the denominator, in increasing order : b0 + b1*s + ... + bm*s^m; used for a linear supply description" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:filter_numerator a owl:DatatypeProperty ;
    rdfs:label "filter_numerator" ;
    skos:definition "Coefficients of the numerator, in increasing order : a0 + a1*s + ... + an*s^n; used for a linear supply description" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:fragment a owl:ObjectProperty ;
    rdfs:label "fragment" ;
    skos:definition "Set of shattered pellet fragments" ;
    skos:inScheme fyo:spi ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:frame_analysis a owl:ObjectProperty ;
    rdfs:label "frame_analysis" ;
    skos:definition "Quantities deduced from frame analysis for a set of time slices" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:free_variables a owl:DatatypeProperty ;
    rdfs:label "free_variables" ;
    skos:definition "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
    skos:inScheme fyo:scenario .

fyo:frequencies_fourier a owl:DatatypeProperty ;
    rdfs:label "frequencies_fourier" ;
    skos:definition "Array of frequencies used for the Fourier transform" ;
    skos:inScheme fyo:reflectometer_fluctuation ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:fringe_jump_correction a owl:DatatypeProperty ;
    rdfs:label "fringe_jump_correction" ;
    skos:definition "Signed number of 2pi phase corrections applied to remove a fringe jump, for each time slice on which a correction has been made" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_coordinate1 "../fringe_jump_correction_times" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "../fringe_jump_correction_times" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:fringe_jump_correction_times a owl:DatatypeProperty ;
    rdfs:label "fringe_jump_correction_times" ;
    skos:definition "List of time slices of the pulse on which a fringe jump correction has been made" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:fuel_ratio a owl:DatatypeProperty ;
    rdfs:label "fuel_ratio" ;
    skos:definition "Radio of densities nT/nD" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:full_wave a owl:ObjectProperty ;
    rdfs:label "full_wave" ;
    skos:definition "Solution by a full wave code, given on a generic grid description, for various time slices" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:fusion_power a owl:DatatypeProperty ;
    rdfs:label "fusion_power" ;
    skos:definition "Fusion power reconstructed from the detectors signals" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:fusion_power_dd a owl:DatatypeProperty ;
    rdfs:label "fusion_power_dd" ;
    skos:definition "Fusion power profile due to DD reactions" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W.m^-3" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:fusion_power_dd_accuracy a owl:DatatypeProperty ;
    rdfs:label "fusion_power_dd_accuracy" ;
    skos:definition "Accuracy profile of reconstructed DD fusion power with respect to true DD fusion power. The accuracy is obtained by comparing the reconstructed profile and the profile input to the synthetic diagnostic calculation: relative error = (reconstruted-input)/input" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:fusion_power_dt a owl:DatatypeProperty ;
    rdfs:label "fusion_power_dt" ;
    skos:definition "Fusion power profile due to DT reactions" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W.m^-3" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:fusion_power_dt_accuracy a owl:DatatypeProperty ;
    rdfs:label "fusion_power_dt_accuracy" ;
    skos:definition "Accuracy profile of reconstructed DT fusion power with respect to true DT fusion power. The accuracy is obtained by comparing the reconstructed profile and the profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:gain_plant a owl:DatatypeProperty ;
    rdfs:label "gain_plant" ;
    skos:definition "Electricity gain of the plant (ratio of net electric / plant electricity during operation)" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:gauge a owl:ObjectProperty ;
    rdfs:label "gauge" ;
    skos:definition "Set of gauges" ;
    skos:inScheme fyo:barometry ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:gaussian_fit a owl:DatatypeProperty ;
    rdfs:label "gaussian_fit" ;
    skos:definition "Amplitude of the gaussian fit of the measured signal in each energy band, used to estimate the electron temperature" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "../../polychromator(channel(i1)/polychromator_index)/wavelength_band" ;
    fyo:dd_coordinate2 "../t_e/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "../../polychromator(channel(i1)/polychromator_index)/wavelength_band,../t_e/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:generator_conversion_efficiency a owl:DatatypeProperty ;
    rdfs:label "generator_conversion_efficiency" ;
    skos:definition "Conversion efficiency of thermal to electric power of the steam cycle" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:geometric_coefficients a owl:DatatypeProperty ;
    rdfs:label "geometric_coefficients" ;
    skos:definition "Set of 9 geometric coefficients providing the MSE polarization angle as a function of the local electric and magnetic field components (these are related to the angle between beam and line of sight). The list is ordered as follows : coefficients of BZ, BR, Bphi, ER (numerator of the MSE angle expression); coefficients of BZ, BR, Bphi, ER, EZ (denominator)" ;
    skos:inScheme fyo:mse ;
    fyo:dd_coordinate1 "1...9" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_domain "1...9" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:get_operation a owl:ObjectProperty ;
    rdfs:label "get_operation" ;
    skos:definition "Plugins actually used to read back a node (potentially, multiple plugins can be applied, listed in reverse order of application). This information is filled by the plugin infrastructure during the GET operation." ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:ggd_fluid a owl:ObjectProperty ;
    rdfs:label "ggd_fluid" ;
    skos:definition "Fluid quantities represented using the general grid description for 2D or 3D description" ;
    skos:inScheme fyo:runaway_electrons ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:ggd_object_index a owl:DatatypeProperty ;
    rdfs:label "ggd_object_index" ;
    skos:definition "Index of GGD volumic object corresponding to each element. Refers to the array /grid_ggd/space(1)/objects_per_dimension(4)/object" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../centroid/x" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "../centroid/x" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm1 a owl:DatatypeProperty ;
    rdfs:label "gm1" ;
    skos:definition "Flux surface averaged 1/R^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-2" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm2 a owl:DatatypeProperty ;
    rdfs:label "gm2" ;
    skos:definition "Flux surface averaged |grad_rho_tor|^2/R^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-2" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm3 a owl:DatatypeProperty ;
    rdfs:label "gm3" ;
    skos:definition "Flux surface averaged |grad_rho_tor|^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm4 a owl:DatatypeProperty ;
    rdfs:label "gm4" ;
    skos:definition "Flux surface averaged 1/B^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T^-2" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm5 a owl:DatatypeProperty ;
    rdfs:label "gm5" ;
    skos:definition "Flux surface averaged B^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T^2" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm6 a owl:DatatypeProperty ;
    rdfs:label "gm6" ;
    skos:definition "Flux surface averaged |grad_rho_tor|^2/B^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "T^-2" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm7 a owl:DatatypeProperty ;
    rdfs:label "gm7" ;
    skos:definition "Flux surface averaged |grad_rho_tor|" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:gm8 a owl:DatatypeProperty ;
    rdfs:label "gm8" ;
    skos:definition "Flux surface averaged R" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:grid_2d a owl:ObjectProperty ;
    rdfs:label "grid_2d" ;
    skos:definition "Values for the 2D grid, for various time slices. The timebase of this array of structure must be a subset of the profiles_2d timebase" ;
    skos:inScheme fyo:turbulence ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:grids_ggd a owl:ObjectProperty ;
    rdfs:label "grids_ggd" ;
    skos:definition "Grids (using the Generic Grid Description), for various time slices. The timebase of this array of structure must be a subset of the time_slice timebase" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:group a owl:ObjectProperty ;
    rdfs:label "group" ;
    skos:definition "Set of groups of components on which calorimetry measurements are carried out (grouped by tokamak subsystems or localization on the machine)" ;
    skos:inScheme fyo:calorimetry ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "25" .

fyo:half_width_external a owl:DatatypeProperty ;
    rdfs:label "half_width_external" ;
    skos:definition "External (towards separatrix) half width of the emissivity peak (in normalized toroidal flux)" ;
    skos:inScheme fyo:hard_x_rays ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:half_width_internal a owl:DatatypeProperty ;
    rdfs:label "half_width_internal" ;
    skos:definition "Internal (towards magnetic axis) half width of the emissivity peak (in normalized toroidal flux)" ;
    skos:inScheme fyo:hard_x_rays ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:halo_currents a owl:ObjectProperty ;
    rdfs:label "halo_currents" ;
    skos:definition "Halo currents geometry and values for a set of time slices" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:has_coil a owl:ObjectProperty ;
    rdfs:label "has_coil" ;
    rdfs:range fyo:Coil ;
    skos:definition "A CoilSystem is composed of atomic Coil instances (BFO has_part)." ;
    skos:inScheme fyo:core .

fyo:has_subsystem a owl:ObjectProperty ;
    rdfs:label "has_subsystem" ;
    rdfs:range fyo:MachineSubsystem ;
    skos:definition "A Machine bears first-class material sub-systems (BFO has_part)." ;
    skos:inScheme fyo:core .

fyo:heat_load_breeder a owl:DatatypeProperty ;
    rdfs:label "heat_load_breeder" ;
    skos:definition "Heat flow towards the breeder" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:heat_load_divertor a owl:DatatypeProperty ;
    rdfs:label "heat_load_divertor" ;
    skos:definition "Heat flow towards the divertor" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:heat_load_wall a owl:DatatypeProperty ;
    rdfs:label "heat_load_wall" ;
    skos:definition "Heat flow towards the wall" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:heating_and_current_drive a owl:ObjectProperty ;
    rdfs:label "heating_and_current_drive" ;
    skos:definition "INPUT — heating / current-drive actuator settings feeding the source terms (NBI, EC launchers, IC / LH antennas). GAP (informative): H&CD deposition physics is the identified precondition gap G-A1 — predictive scenarios are currently ohmic-only." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "nbi, ec_launchers, ic_antennas, lh_antennas, core_sources" ;
    fyo:io "input" .

fyo:hosts a owl:ObjectProperty ;
    rdfs:label "hosts" ;
    rdfs:range fyo:Plasma ;
    skos:definition "A Machine holds a Plasma within its vacuum-vessel fiat boundary during a Shot." ;
    skos:inScheme fyo:core .

fyo:hot_neutrals_fraction a owl:DatatypeProperty ;
    rdfs:label "hot_neutrals_fraction" ;
    skos:definition "Fraction of hot neutrals for this isotope (n_hot_neutrals/(n_cold_neutrals+n_hot_neutrals))" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:hot_neutrals_temperature a owl:DatatypeProperty ;
    rdfs:label "hot_neutrals_temperature" ;
    skos:definition "Temperature of hot neutrals for this isotope" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:image_raw a owl:DatatypeProperty ;
    rdfs:label "image_raw" ;
    skos:definition "Raw image (unprocessed) (digital levels). First dimension : line index (horizontal axis). Second dimension: column index (vertical axis)." ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:incident_species a owl:ObjectProperty ;
    rdfs:label "incident_species" ;
    skos:definition "Sputtering coefficients due to a set of incident species" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:indices a owl:DatatypeProperty ;
    rdfs:label "indices" ;
    skos:definition "Integer identifiers (enumeration index within a list). Private identifier values must be indicated by a negative index." ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "../names" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "../names" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:indices_compound a owl:DatatypeProperty ;
    rdfs:label "indices_compound" ;
    skos:definition "Indices (from the rogowski_coil array of structure) of the partial Rogowskis used to build the coumpound signal (sum of the partial Rogowski signals). Can be set to any unique integer value for each section of a compound Rogowski coil. Use only if ../measure_quantity/index = 5, leave empty otherwise" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:initial_state a owl:ObjectProperty ;
    rdfs:label "initial_state" ;
    skos:definition "INPUT — the initial plasma state (equilibrium + profiles) the closed loop starts from." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:fyo_ids "equilibrium, core_profiles" ;
    fyo:io "input" .

fyo:injector a owl:ObjectProperty ;
    rdfs:label "injector" ;
    skos:definition "Set of shattered pellet injectors" ;
    skos:inScheme fyo:spi ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "5" .

fyo:integer0d a owl:ObjectProperty ;
    rdfs:label "integer0d" ;
    skos:definition "Set of integer type scalar control parameters" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:integration_time a owl:DatatypeProperty ;
    rdfs:label "integration_time" ;
    skos:definition "Integration time per pixel. First dimension : row index (horizontal orientation). Second dimension: column index (vertical orientation). The size of this matrix is assumed to be constant over time. Allocate dimensions to 1 in case of uniform exposure time." ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "K" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:ion_fast a owl:ObjectProperty ;
    rdfs:label "ion_fast" ;
    skos:definition "Derived Fast Ion Charge eXchange (FICX) parameters" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "5" .

fyo:iron_core_segment a owl:ObjectProperty ;
    rdfs:label "iron_core_segment" ;
    skos:definition "Magnetization M of a set of iron core segments" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "IDS:iron_core/segment" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "T" .

fyo:is_referenced_by a owl:DatatypeProperty ;
    rdfs:label "is_referenced_by" ;
    skos:definition "List of documents (e.g. publications) or datasets making use of this data entry (e.g. PIDs of other datasets using this data entry as input)" ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:isotope a owl:ObjectProperty ;
    rdfs:label "isotope" ;
    skos:definition "Set of isotopes" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "3" .

fyo:j_anomalous a owl:ObjectProperty ;
    rdfs:label "j_anomalous" ;
    skos:definition "Anomalous current density, given on various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-2" .

fyo:j_diamagnetic a owl:ObjectProperty ;
    rdfs:label "j_diamagnetic" ;
