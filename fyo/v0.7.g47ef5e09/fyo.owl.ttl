fyo:WavesProfiles1dEFieldNPhi a owl:Class ;
    rdfs:label "WavesProfiles1dEFieldNPhi" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:WavesCPXAmpPhase1D ;
