        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
