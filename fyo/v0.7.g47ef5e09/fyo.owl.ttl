fyo:CoilConductor a owl:Class ;
    rdfs:label "CoilConductor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilConductorElements ;
            owl:onProperty fyo:elements ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilCrossSection ;
            owl:onProperty fyo:cross_section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:voltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:resistance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:resistance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:resistance ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:SignalFlt1d ;
            owl:onProperty fyo:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:cross_section ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:elements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:elements ],
        spo:InformationContentEntity ;
    skos:definition "Set of conductors inside the coil. The structure can be used with size 1 for a simplified description as a single conductor. A conductor is composed of several elements, serially connected, i.e. transporting the same current." ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "2" ;
    fyo:dd_type_name "coil_conductor" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:CoilConductorElements a owl:Class ;
    rdfs:label "CoilConductorElements" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilNaRphiz1dStatic ;
            owl:onProperty fyo:start_points ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:start_points ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:intermediate_points ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilNaRphiz1dStatic ;
            owl:onProperty fyo:centres ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:end_points ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:end_points ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:centres ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilNaRphiz1dStatic ;
            owl:onProperty fyo:end_points ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:intermediate_points ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:start_points ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:types ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CoilNaRphiz1dStatic ;
            owl:onProperty fyo:intermediate_points ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:centres ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:types ],
        spo:InformationContentEntity ;
    skos:definition "Set of geometrical elements (line segments and/or arcs of a circle) describing the contour of the conductor centre. We define a coordinate system associated to each element as follows: for the arc and circle elements: binormal = (start point - center) x (intermediate point - center). This vector points in the direction of the circle / arc axis. normal = (center - point on curve). The normal vector will rotate as the point moves around the curve. Tangent = normal x binormal. For the line element " ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "2" ;
    fyo:dd_type_name "coil_conductor_elements" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:CoilCrossSection a owl:Class ;
    rdfs:label "CoilCrossSection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:geometry_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:area ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:height ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:radius_inner ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:height ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:outline ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:width ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:width ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:outline ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:area ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:geometry_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:radius_inner ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:height ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:NormalBinormalStatic ;
            owl:onProperty fyo:outline ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:radius_inner ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Identifier ;
            owl:onProperty fyo:geometry_type ],
        spo:InformationContentEntity ;
    skos:definition "The cross-section perpendicular to the conductor contour is described by a series of contour points, given by their relative position with respect to the start point of each element. If the size of this array of structure is equal to 1, then the cross-section is given only for the first element and translated along the conductor elements. Otherwise, it's given explictly for each element, allowing to describe changes of the cross section shape" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "2" ;
    fyo:dd_type_name "coil_cross_section" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

