            owl:onProperty fyo:minus ],
        spo:InformationContentEntity ;
    skos:definition "Components of the electric field per toroidal mode number" ;
    skos:inScheme fyo:waves ;
    fyo:dd_path "waves/coherent_wave/profiles_2d/e_field_n_phi" ;
    fyo:dd_type_name "waves_profiles_2d_e_field_n_phi" .

fyo:Workflow a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:IdsCode ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IdsProperties ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time_loop ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WorkflowTimeLoop ;
            owl:onProperty fyo:time_loop ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:time_loop ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:code ],
        fyo:IDS ;
    skos:definition "Description of the workflow that has produced this data entry. The workflow IDS can also be used to communicate information about workflow state between workflow components." ;
    skos:inScheme fyo:workflow ;
    fyo:dd_path "workflow" ;
    fyo:fyo_category "simulation-workflow" .

fyo:WorkflowComponent a owl:Class ;
    rdfs:label "WorkflowComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:execution_mode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:time_interval_elapsed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:control_float ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time_interval_request ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:execution_mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:control_float ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time_interval_request ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:execution_mode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:control_integer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time_interval_elapsed ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time_interval_elapsed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:control_integer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:time_interval_request ],
        spo:InformationContentEntity ;
    skos:definition "Control parameters for the set of participting components defined in ../../component" ;
    skos:inScheme fyo:workflow ;
    fyo:dd_path "workflow/time_loop/workflow_cycle/component" ;
    fyo:dd_type_name "workflow_component" .

fyo:WorkflowCycle a owl:Class ;
    rdfs:label "WorkflowCycle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WorkflowComponent ;
            owl:onProperty fyo:component ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:component ],
        spo:TimeSlice ;
    skos:definition "Set of time slices corresponding to the beginning of workflow cycles (main time loop of the workflow). During each workflow cycle, active components compute their result during their given time_interval. Components having completed their computation are frozen until the end of the workflow cycle. The next workflow cycle begins when the maximum time_interval (over the components) has been reached." ;
    skos:inScheme fyo:workflow ;
    fyo:dd_path "workflow/time_loop/workflow_cycle" ;
    fyo:dd_type_name "workflow_cycle" ;
    fyo:fyo_lift "time_slice" .

fyo:WorkflowTimeLoop a owl:Class ;
    rdfs:label "WorkflowTimeLoop" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time_end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:component ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CodeConstant ;
            owl:onProperty fyo:component ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:time_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WorkflowCycle ;
            owl:onProperty fyo:workflow_cycle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:workflow_cycle ],
        spo:InformationContentEntity ;
    skos:definition "Description of a workflow based on a time loop which calls components defined in component_list sequentially  during each cycle of the loop (workflow_cycle)." ;
    skos:inScheme fyo:workflow ;
    fyo:dd_path "workflow/time_loop" ;
    fyo:dd_type_name "workflow_time_loop" .

fyo:Xyz1dPositionsStatic a owl:Class ;
    rdfs:label "Xyz1dPositionsStatic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x ],
        spo:InformationContentEntity ;
    skos:definition "List of positions of the centroids, in Cartesian coordinates" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_path "ferritic/object/centroid" ;
    fyo:dd_type_name "xyz1d_positions_static" .

fyo:Xyz3dStatic a owl:Class ;
    rdfs:label "Xyz3dStatic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:y ],
        spo:InformationContentEntity ;
    skos:definition "Vector that points from the centre of the voxel to the centre of the detector, described in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis." ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_path "neutron_diagnostic/detector/field_of_view/direction_to_detector" ;
    fyo:dd_type_name "xyz3d_static" .

spo:ContinuantFiatBoundary a owl:Class ;
    rdfs:label "ContinuantFiatBoundary" ;
    rdfs:subClassOf spo:ImmaterialEntity ;
    skos:definition "A zero-, one- or two-dimensional immaterial entity whose location is fixed relative to some material entity, and which never has a spatial region as continuant part (BFO 2020 elucidation). Carrier of a demarcation drawn on a thing rather than found in it — a region's fiat boundary, a nominal surface. Added when the conformance gate found `sp.mathx.region.FiatBoundary` anchored to a BFO term the T-Box did not carry: the ontology is authoritative, so the gap was the ontology's (SPM-REPORT-104)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000140> ;
    skos:inScheme spo:core .

spo:DesignSpecification a owl:Class ;
    rdfs:label "DesignSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spo:MaterialEntity ;
            owl:onProperty spo:prescribes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:prescribes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:prescribes ],
        spo:InformationContentEntity ;
    skos:definition "A DIRECTIVE information content entity that prescribes a material artifact to be realized — an engineering drawing of the EAST vacuum vessel, a coil winding spec. Distinguish three stances toward one MaterialEntity: (1) the thing itself (MaterialEntity); (2) the prescription of it (this class — exists before/independent of the thing; the as-designed view); (3) the description of it as built (a plain descriptive ICE with is_about — an as-measured machine-description dataset). Design and as-built descriptions may disagree; only (3) is truth-evaluable against reality. IAO alignment IRI [TBD]." ;
    skos:inScheme spo:vocab .

spo:PlanSpecification a owl:Class ;
    rdfs:label "PlanSpecification" ;
    rdfs:subClassOf spo:InformationContentEntity ;
    skos:definition "A directive information content entity that prescribes a planned process (IAO plan specification). A pulse_schedule (reference waveforms / setpoints) is a PlanSpecification prescribing a discharge (C-10). class_uri version-sensitive — verify." ;
    skos:exactMatch IAO:0000104 ;
    skos:inScheme spo:vocab .

spo:PlannedProcess a owl:Class ;
    rdfs:label "PlannedProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:realizes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:realizes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:realizes ],
        spo:Process ;
    skos:definition "A process that realizes a plan specification (OBI planned process). An experiment / planned discharge." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/OBI_0000011> ;
    skos:inScheme spo:core .

spo:ProcessBoundary a owl:Class ;
    rdfs:label "ProcessBoundary" ;
    rdfs:subClassOf spo:Occurrent ;
    skos:definition "The instantaneous temporal boundary of a process (BFO 2020). Parented on Occurrent, following BFO's own hierarchy — a process boundary is not itself a process. Added with ContinuantFiatBoundary, for the same reason (SPM-REPORT-104)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:inScheme spo:core .

spo:ProcessRecord a owl:Class ;
    rdfs:label "ProcessRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:is_record_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Process ;
            owl:onProperty spo:is_record_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:is_record_of ],
        spo:InformationContentEntity ;
    skos:definition "The RECORD of a process — an ICE generated by and about an Occurrent (prov:Entity wasGeneratedBy the Activity). The experiment / record split: a Shot (PlannedProcess) is unrepeatable and unstorable; what a data system holds is its ProcessRecord (the shot file, the populated IDS set, the logbook entry). The record is mutable/versionable and may be partial or wrong about the process; the process itself is neither." ;
    skos:inScheme spo:provenance .

spo:ProvenanceMixin a owl:Class ;
    rdfs:label "ProvenanceMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Process ;
            owl:onProperty spo:generated_by_process ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty spo:reproducible ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:provider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:generated_by_process ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:version_put ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:creation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:creation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Code ;
            owl:onProperty spo:produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:creation_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:version_put ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:reproducible ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:provider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:reproducible ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:DataModality ;
            owl:onProperty spo:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:modality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:version_put ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:generated_by_process ] ;
    skos:definition "Orthogonal provenance carried by any domain ICE (L7). Provenance time (creation_date / version order) is distinct from physical time (manifold coordinate). Also carries the data **modality** (static-device / measured / reconstructed / simulated) — derived from the generating process, orthogonal to the domain category (FYTOK-REPORT-05 §rpt05-modality)." ;
    skos:inScheme spo:provenance .

spo:Solid a owl:Class ;
    rdfs:label "Solid" ;
    rdfs:subClassOf spo:GeoObject ;
    skos:definition "A 3-D geometric object / manifold_dim 3 (Box / Ball / Cylinder / Toroidal / swept solids)." ;
    skos:inScheme spo:geometry .

spo:SpacetimeWorm a owl:Class ;
    rdfs:label "SpacetimeWorm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:occupies_spacetime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:occupies_spacetime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:foliates_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:foliates_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:foliates_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:SpacetimeRegion ;
            owl:onProperty spo:occupies_spacetime ],
        spo:Occurrent ;
    skos:definition "A four-dimensionally extended individual (its temporal parts are time slices). A DD `time_slice[]` array is the discretized worm; the 3D continuant view is its foliated slice. Identity rests in the 4D intension artifact (SPM-CONOPS-01). Conservative extension — does not alter the 3D core axioms." ;
    skos:inScheme spo:core ;
    fyo:spo_stratum "4d_extension" .

spo:TimeSeries a owl:Class ;
    rdfs:label "TimeSeries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_channel ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Signal ;
            owl:onProperty spo:has_channel ],
        spo:TemporalAggregate ;
    skos:definition "The SoA layout — per-quantity channels over a shared or embedded TimeAxis (DD signal pattern; a control-room trend plot). Each channel is a spo-signal Signal (a quantity over the time domain). Convenient for single-quantity-over-time access; dual to the AoS TimeSliceSeries via dual_view_of (slice the stack)." ;
    skos:inScheme spo:time ;
    fyo:layout "soa" .

fyo:AmnsDataProcessReactant a owl:Class ;
    rdfs:label "AmnsDataProcessReactant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:metastable_label ],
        [ a owl:Restriction ;
