spo:CoordinateSystem a owl:Class ;
    rdfs:label "CoordinateSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:chart_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:coordinate_axis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:chart_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:coordinate_axis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_metric ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:chart_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Metric ;
            owl:onProperty spo:has_metric ],
        spo:InformationContentEntity ;
    skos:definition "A coordinate chart — an ordered tuple of coordinate axes plus the metric that measures lengths / areas / volumes on it (IMAS ``coordinate_system`` / ``grid_type``). Cartesian (x,y,z), polar (r,θ), cylindrical (r,z,φ), spherical (r,φ,θ) and toroidal charts are the built-in kinds; the metric is Euclidean-identity unless the chart is curvilinear. COCOS orientation of flux charts is a fusion-domain concern owned by fyo (SPM-ADR-104 D2)." ;
    skos:inScheme spo:geometry .

spo:Domain a owl:Class ;
    rdfs:label "Domain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:coordinate ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:ContinuousCoordinate ;
            owl:onProperty spo:coordinate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:coordinate ],
        spo:ImmaterialEntity ;
    skos:definition "A mathematical domain a quantity is defined over (an axis / grid / mesh). Coordinates are Domains, not path strings (C-3). Mesh / discretization detail is owned by sp_mathx (OI-2)." ;
    skos:inScheme spo:domain .

spo:Field a owl:Class ;
    rdfs:label "Field" ;
    rdfs:subClassOf spo:ContinuousQuantity ;
    skos:definition "A continuous quantity over a (spatial / general) Domain — scalar or tensor (SoA leaf, L3; rank-1 → Function). Sibling of Signal under ContinuousQuantity." ;
    skos:inScheme spo:domain .

spo:Quality a owl:Class ;
    rdfs:label "Quality" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:inheres_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:inheres_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:MaterialEntity ;
            owl:onProperty spo:inheres_in ],
        spo:SpecificallyDependentContinuant ;
    skos:definition "A specifically dependent continuant that inheres in its bearer (BFO quality). A measurable physical attribute." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:inScheme spo:core .

fyo:DataModality a owl:Class ;
    rdfs:label "DataModality" ;
    owl:unionOf ( <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#static_device> <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#measured> <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#reconstructed> <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#simulated> ) ;
    skos:definition "The provenance modality of a datum (FYTOK-REPORT-05 §rpt05-modality). Orthogonal to the domain category; derived from the generating process, not from DD `type` (which only gives static/dynamic)." ;
    skos:inScheme spo:provenance ;
    linkml:permissible_values <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#measured>,
        <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#reconstructed>,
        <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/DataModality#simulated>,
