            owl:onProperty fyo:wavelengths ],
        spo:InformationContentEntity ;
    skos:definition "Characteristics of the filter window" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "4" ;
    fyo:dd_type_name "filter_window" ;
