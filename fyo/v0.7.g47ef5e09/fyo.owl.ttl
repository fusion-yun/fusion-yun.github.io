fyo:InferenceEngine a owl:Class ;
    rdfs:label "InferenceEngine" ;
    rdfs:subClassOf spo:Code ;
    skos:definition "An exchangeable inference engine stacked on the fixed forward spine — least-squares reconstruction, MAP, Bayesian posterior sampling, or UQ propagation (forward / parameterization+prior / inference-engine three-layer decoupling, FYTOK-REPORT-107). Swapping engines never changes F." ;
    skos:inScheme fyo:scenario .

