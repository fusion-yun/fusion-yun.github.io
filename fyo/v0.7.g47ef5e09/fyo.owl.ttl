fyo:GasMixtureConstant a owl:Class ;
    rdfs:label "GasMixtureConstant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
