    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_coordinate3 "1...N" ;
    fyo:dd_coordinate4 "1...N" ;
    fyo:dd_coordinate5 "1...N" ;
    fyo:dd_coordinate6 "1...N" ;
    fyo:dd_ndim 6 ;
    fyo:dd_type "static" ;
    fyo:dd_units "units given by process(i1)/results_units" ;
    fyo:fyo_domain "1...N,1...N,1...N,1...N,1...N,1...N" ;
    fyo:fyo_lift "field" ;
