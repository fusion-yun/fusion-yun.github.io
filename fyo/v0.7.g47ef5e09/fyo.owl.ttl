fyo:EquilibriumSolve a owl:Class ;
    rdfs:label "EquilibriumSolve" ;
    rdfs:subClassOf fyo:SolverInvocation ;
    skos:definition "A Grad–Shafranov equilibrium solve (fixed or free boundary; built-in fyeq or external plugins) — writes back the equilibrium IDS (enabling-core scenario S-2). Axisymmetric by construction (configuration applicability boundary)." ;
    skos:inScheme fyo:scenario ;
    fyo:conops_ref "FYTOK-CONOPS-00 S-2" ;
    fyo:fyo_ids "equilibrium" .

