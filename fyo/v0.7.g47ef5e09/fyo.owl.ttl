fyo:PhysicsModelingTask a owl:Class ;
    rdfs:label "PhysicsModelingTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:predicted_equilibrium ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:predicted_equilibrium ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:predicted_profiles ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:predicted_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:MachineDescription ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:predicted_transport ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:heating_and_current_drive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:predicted_equilibrium ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:heating_and_current_drive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:initial_profiles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:predicted_transport ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:predicted_profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:initial_profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:predicted_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:prescribed_waveforms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:initial_profiles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:prescribed_waveforms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:predicted_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:prescribed_waveforms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:predicted_transport ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:predicted_profiles ],
        fyo:ApplicationTask ;
    skos:definition "A forward physics-modeling / prediction run (S-7, primary). FUNCTION: instantiate the device aggregate entity (S-1), bind the fyo-modeled physical state, then let the ScenarioLoop alternate equilibrium and transport solves — with source terms — until physical convergence or through a prescribed time evolution; the result PREDICTS the plasma equilibrium / profile / transport state. Direction: forward (θ → state); the plasma configuration evolves, the machine is fixed. Every output IDS carries data-modality `simulated` in its provenance (the schema itself is modality-blind)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:conops_scenario "S-7" ;
    fyo:free_variables_note "free = plasma configuration / profiles evolution; fixed = machine, actuator settings" .

