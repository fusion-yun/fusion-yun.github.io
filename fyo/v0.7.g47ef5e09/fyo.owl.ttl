    skos:definition "Townsend electric field along each field line" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_coordinate1 "../starting_positions/r" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "V.m^-1" ;
