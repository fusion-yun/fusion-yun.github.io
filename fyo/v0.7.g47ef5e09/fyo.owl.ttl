            owl:onProperty fyo:reference_waveforms ],
        fyo:ApplicationTask ;
    skos:definition "A closed-loop control-simulation run (S-9). FUNCTION: at each control cycle, a StateEstimation process infers the plasma state from (synthetic) diagnostic signals, the feedback control law compares it against the reference waveforms and issues actuator commands, and the forward kernel advances the device state under those commands — closing the loop in quasi-real time (a flight simulator for the real plant's control system). Direction: closed-loop / reactive; free variables are the real-time actuator commands. Outputs are the simulated closed-loop state trajectory and the command history; modality simulated." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:conops_scenario "S-9" ;
    fyo:free_variables_note "free = actuator commands (real-time / quasi-real-time); fixed = machine, control-law structure, references" .

fyo:Controllers a owl:Class ;
