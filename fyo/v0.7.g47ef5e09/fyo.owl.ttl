            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:values ],
        spo:InformationContentEntity ;
    skos:definition "Orbit type identifier" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_path "distributions/distribution/ggd/orbit_type" ;
    fyo:dd_type_name "generic_grid_integer" .

fyo:GenericGridMatrix a owl:Class ;
    rdfs:label "GenericGridMatrix" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:grid_subset_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:coefficients ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:grid_subset_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coefficients ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:grid_subset_index ],
        spo:InformationContentEntity ;
    skos:definition "Orbit description of the particle at this position in phase space. First dimension is the element index. Second dimension is the time along the orbit. Third dimension contains the particle phase space coordinates." ;
    skos:inScheme fyo:distributions ;
    fyo:dd_path "distributions/distribution/ggd/orbit" ;
    fyo:dd_type_name "generic_grid_matrix" .

