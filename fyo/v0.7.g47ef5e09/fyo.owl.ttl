        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:parallel ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WavesCPXAmpPhase1D ;
            owl:onProperty fyo:parallel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:plus ],
        [ a owl:Restriction ;
