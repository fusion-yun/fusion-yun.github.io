fyo:temperature_cold_neutrals a owl:DatatypeProperty ;
    rdfs:label "temperature_cold_neutrals" ;
    skos:definition "Fit of cold neutrals temperature" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "signal" ;
