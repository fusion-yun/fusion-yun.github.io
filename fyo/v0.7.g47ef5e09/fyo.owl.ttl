    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:surface_current a owl:ObjectProperty ;
    rdfs:label "surface_current" ;
    skos:definition "Description of the IC surface current on the antenna straps and on passive components, for every time slice" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:table_1d a owl:DatatypeProperty ;
