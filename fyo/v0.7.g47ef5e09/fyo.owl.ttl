            owl:minCardinality 0 ;
            owl:onProperty fyo:amplitude ],
        spo:InformationContentEntity ;
    skos:definition "Left hand polarized electric field component for every flux surface" ;
    skos:inScheme fyo:waves ;
    fyo:dd_path "waves/coherent_wave/profiles_1d/e_field_n_phi/plus" ;
    fyo:dd_type_name "waves_CPX_amp_phase_1D" .

fyo:WavesCPXAmpPhase2D a owl:Class ;
    rdfs:label "WavesCPXAmpPhase2D" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:amplitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:amplitude ],
        spo:InformationContentEntity ;
    skos:definition "Left hand polarized electric field component" ;
    skos:inScheme fyo:waves ;
    fyo:dd_path "waves/coherent_wave/profiles_2d/e_field_n_phi/plus" ;
    fyo:dd_type_name "waves_CPX_amp_phase_2D" .

fyo:Xyz0dDynamicAos3 a owl:Class ;
    rdfs:label "Xyz0dDynamicAos3" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:z ],
        spo:InformationContentEntity ;
    skos:definition "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
    skos:inScheme fyo:reflectometer_fluctuation ;
    fyo:dd_path "reflectometer_fluctuation/channel/antennas_orientation/antenna_emission/x1_unit_vector" ;
    fyo:dd_type_name "xyz0d_dynamic_aos3" .

fyo:acceleration a owl:ObjectProperty ;
    rdfs:label "acceleration" ;
    skos:definition "Acceleration measured by an accelerometer sensor" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_units "m.s^-2" .

fyo:access_layer a owl:DatatypeProperty ;
    rdfs:label "access_layer" ;
    skos:definition "Version of Access Layer used to PUT this IDS" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:access_layer_language a owl:DatatypeProperty ;
    rdfs:label "access_layer_language" ;
    skos:definition "Programming language of the Access Layer high level API used to PUT this IDS" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:acquisition_state a owl:ObjectProperty ;
    rdfs:label "acquisition_state" ;
    skos:definition "Acquisition state of the related system : index = 1 : armed; index = 2 : on; index = 3 : off; index = 4 : closed" ;
    skos:inScheme fyo:pulse_schedule .

fyo:acquisition_strategy a owl:ObjectProperty ;
    rdfs:label "acquisition_strategy" ;
    skos:definition "Acquisition strategy related to this event: index = 1 : on-trigger; index = 2 : pre-trigger; index = 3 : post-trigger" ;
    skos:inScheme fyo:pulse_schedule .

fyo:active_limiter_point a owl:ObjectProperty ;
    rdfs:label "active_limiter_point" ;
    skos:definition "RZ position of the active limiter point (point of the plasma boundary in contact with the limiter)" ;
    skos:inScheme fyo:pulse_schedule .

fyo:active_wall_point a owl:ObjectProperty ;
    rdfs:label "active_wall_point" ;
    skos:definition "R,Z position of the point of the plasma boundary in contact with the wall" ;
    skos:inScheme fyo:disruption .

fyo:adc a owl:ObjectProperty ;
    rdfs:label "adc" ;
    skos:definition "Description of analogic-digital converter" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:adiabatic_electrons a owl:DatatypeProperty ;
    rdfs:label "adiabatic_electrons" ;
    skos:definition "Flag = 1 if electrons are adiabatic, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:algorithm_type a owl:ObjectProperty ;
    rdfs:label "algorithm_type" ;
    skos:definition "Algorithm used to reconstruct the emissivity profile" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:alpha a owl:DatatypeProperty ;
    rdfs:label "alpha" ;
    skos:definition "Inclination of first angle measured counter-clockwise from horizontal outwardly directed radial vector (grad R)." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:alpha_critical a owl:ObjectProperty ;
    rdfs:label "alpha_critical" ;
    skos:definition "Critical normalized pressure gradient determined with self-consistent runs with an MHD stability code. Details of the method for scanning parameters in the series of runs must be described in the 'source' node" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:alpha_electron_pedestal_max a owl:ObjectProperty ;
    rdfs:label "alpha_electron_pedestal_max" ;
    skos:definition "Maximum value in the pedestal of the alpha parameter for electron pressure (see [Miller PoP 5 (1998),973,Eq. 42])" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:alpha_electron_pedestal_max_position a owl:ObjectProperty ;
    rdfs:label "alpha_electron_pedestal_max_position" ;
    skos:definition "Position in normalized poloidal flux of the maximum value in the pedestal of the alpha parameter for electron pressure (see [Miller PoP 5 (1998),973,Eq. 42])" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:alpha_experimental a owl:ObjectProperty ;
    rdfs:label "alpha_experimental" ;
    skos:definition "Experimental normalized pressure gradient reconstructed by an MHD stability code (with assumptions on the ion pressure). See definition in [Miller PoP 5 (1998),973,Eq. 42]" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:alpha_ratio a owl:ObjectProperty ;
    rdfs:label "alpha_ratio" ;
    skos:definition "Ratio of alpha_critical over alpha_experimental" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:amplitude_multiplier a owl:DatatypeProperty ;
    rdfs:label "amplitude_multiplier" ;
    skos:definition "Multiplier that is needed to convert the linear mode structures to the amplitude of a non-linearly saturated mode in physical units. If empty, it means that the structures contains no information about non-linearly saturated mode" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:amplitude_parameter a owl:DatatypeProperty ;
    rdfs:label "amplitude_parameter" ;
    skos:definition "Amplitude of the line of sight position parameter oscillation (in case moving_mode/index = 1)" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_type "static" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:angle_bragg a owl:DatatypeProperty ;
    rdfs:label "angle_bragg" ;
    skos:definition "Bragg angle of the crystal" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:angle_major a owl:DatatypeProperty ;
    rdfs:label "angle_major" ;
    skos:definition "Angle between the cone direction and unit_vector_major" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:angle_minor a owl:DatatypeProperty ;
    rdfs:label "angle_minor" ;
    skos:definition "Angle between the cone direction and unit_vector_minor" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:annular a owl:ObjectProperty ;
    rdfs:label "annular" ;
    skos:definition "Annular representation of a layer by two contours, inner and outer. Alternatively, the layer can be described by a centreline and thickness." ;
    skos:inScheme fyo:common .

fyo:annulus a owl:ObjectProperty ;
    rdfs:label "annulus" ;
    skos:definition "The element is an annulus of centre R, Z, with inner radius radius_inner and outer radius radius_outer" ;
    skos:inScheme fyo:common .

fyo:antenna_detection_static a owl:ObjectProperty ;
    rdfs:label "antenna_detection_static" ;
    skos:definition "Static part of the geometry of the detection antenna, to be filled only if it is distinct from the emission antenna." ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:antenna_emission_static a owl:ObjectProperty ;
    rdfs:label "antenna_emission_static" ;
    skos:definition "Static part of the geometry of the emission antenna" ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:antenna_name a owl:DatatypeProperty ;
    rdfs:label "antenna_name" ;
    skos:definition "Name of the antenna that launches this wave. Corresponds to the name specified in antennas/ec(i)/name, or antennas/ic(i)/name or antennas/lh(i)/name (depends of antenna/wave type) in the ANTENNAS IDS." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:arcs_of_circle a owl:ObjectProperty ;
    rdfs:label "arcs_of_circle" ;
    skos:definition "Description of the element contour by a set of arcs of circle. For each of these, the position of the start point is given together with the curvature radius. The end point is given by the start point of the next arc of circle." ;
    skos:inScheme fyo:common .

fyo:b a owl:ObjectProperty ;
    rdfs:label "b" ;
    skos:definition "B matrix" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "../state_names" ;
    fyo:dd_coordinate2 "../../input_names" ;
    fyo:dd_coordinate3 "time" ;
    fyo:dd_units "mixed" .

fyo:b_field_max_timed a owl:ObjectProperty ;
    rdfs:label "b_field_max_timed" ;
    skos:definition "Maximum absolute value of the magnetic field on the conductor surface" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "T" .

fyo:b_field_perpendicular a owl:ObjectProperty ;
    rdfs:label "b_field_perpendicular" ;
    skos:definition "Perpendicular magnetic field at plasma position. b_field_perpendicular = sqrt(b_field_stray^2+b_field_eddy^2)" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "T" .

fyo:b_field_phi_sign a owl:DatatypeProperty ;
    rdfs:label "b_field_phi_sign" ;
    skos:definition "Sign of the toroidal magnetic field" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:b_field_phi_vacuum_r a owl:ObjectProperty ;
    rdfs:label "b_field_phi_vacuum_r" ;
    skos:definition "Vacuum field times major radius in the toroidal field magnet. Positive sign means anti-clockwise when viewed from above" ;
    skos:inScheme fyo:tf ;
    fyo:dd_units "T.m" .

fyo:b_field_sensor a owl:ObjectProperty ;
    rdfs:label "b_field_sensor" ;
    skos:definition "Magnetic field sensor" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:b_field_stray a owl:ObjectProperty ;
    rdfs:label "b_field_stray" ;
    skos:definition "Stray magnetic field at plasma position" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "T" .

fyo:back_surface a owl:ObjectProperty ;
    rdfs:label "back_surface" ;
    skos:definition "Curvature of the front surface" ;
    skos:inScheme fyo:common .

fyo:ballooning_type a owl:ObjectProperty ;
    rdfs:label "ballooning_type" ;
    skos:definition "Ballooning type of the mode : ballooning 0; anti-ballooning:1; flute-like:2" ;
    skos:inScheme fyo:mhd_linear .

fyo:beam_beam a owl:ObjectProperty ;
    rdfs:label "beam_beam" ;
    skos:definition "Neutron rate coming from NBI beam self reactions" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "Hz" .

fyo:beam_thermal a owl:ObjectProperty ;
    rdfs:label "beam_thermal" ;
    skos:definition "Neutron rate coming from NBI beam - plasma reactions" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "Hz" .

fyo:beamlets a owl:ObjectProperty ;
    rdfs:label "beamlets" ;
    skos:definition "Detailed information on beamlets" ;
    skos:inScheme fyo:nbi .

fyo:beat_length a owl:DatatypeProperty ;
    rdfs:label "beat_length" ;
    skos:definition "Linear beat length" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:bes a owl:ObjectProperty ;
    rdfs:label "bes" ;
    skos:definition "Derived Beam Emission Spectroscopy (BES) parameters" ;
    skos:inScheme fyo:charge_exchange .

fyo:beta a owl:DatatypeProperty ;
    rdfs:label "beta" ;
    skos:definition "Inclination of second angle measured counter-clockwise from vertically upwards directed vector (grad Z). If both alpha and beta are zero (rectangle) then the simpler rectangular elements description should be used." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:beta_pol_mhd a owl:ObjectProperty ;
    rdfs:label "beta_pol_mhd" ;
    skos:definition "Poloidal beta estimated from the pressure determined by an equilibrium reconstruction code. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:beta_reference a owl:DatatypeProperty ;
    rdfs:label "beta_reference" ;
    skos:definition "Reference plasma beta (see detailed documentation at the root of the IDS)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:beta_tor_mhd a owl:ObjectProperty ;
    rdfs:label "beta_tor_mhd" ;
    skos:definition "Toroidal beta, using the pressure determined by an equilibrium reconstruction code" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:beta_tor_norm_mhd a owl:ObjectProperty ;
    rdfs:label "beta_tor_norm_mhd" ;
    skos:definition "Normalized toroidal beta, using the pressure determined by an equilibrium reconstruction code" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:beta_tor_thermal_norm a owl:ObjectProperty ;
    rdfs:label "beta_tor_thermal_norm" ;
    skos:definition "Normalized toroidal beta from thermal pressure only, defined as 100 * beta_tor_thermal * a[m] * B0 [T] / ip [MA]" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:bias a owl:DatatypeProperty ;
    rdfs:label "bias" ;
    skos:definition "ADC signal bias" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:bootstrap_current_hager a owl:ObjectProperty ;
    rdfs:label "bootstrap_current_hager" ;
    skos:definition "MHD calculations of the critical alpha parameter using the Hager formula for the calculation of the bootstrap current, from Phys. Plasmas 23 (2016) 042503" ;
    skos:inScheme fyo:summary .

fyo:bootstrap_current_sauter a owl:ObjectProperty ;
    rdfs:label "bootstrap_current_sauter" ;
    skos:definition "MHD calculations of the critical alpha parameter using the Sauter formula for the calculation of the bootstrap current, from Phys. Plasmas 6 (1999) 2834" ;
    skos:inScheme fyo:summary .

fyo:bottom_cap_thickness a owl:DatatypeProperty ;
    rdfs:label "bottom_cap_thickness" ;
    skos:definition "Bottom cap poloidal thickness" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:c a owl:ObjectProperty ;
    rdfs:label "c" ;
    skos:definition "C matrix" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "../state_names" ;
    fyo:dd_coordinate2 "../../output_names" ;
    fyo:dd_coordinate3 "time" ;
    fyo:dd_units "mixed" .

fyo:calibration a owl:ObjectProperty ;
    rdfs:label "calibration" ;
    skos:definition "Calibration data" ;
    skos:inScheme fyo:camera_ir .

fyo:calibration_absolute_date a owl:DatatypeProperty ;
    rdfs:label "calibration_absolute_date" ;
    skos:definition "Date at which the absolute calibration was carried out" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_type "static" .

fyo:calibration_coefficient a owl:DatatypeProperty ;
    rdfs:label "calibration_coefficient" ;
    skos:definition "Coefficient used for converting raw signal into absolute pressure" ;
    skos:inScheme fyo:barometry ;
    fyo:dd_type "static" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:calibration_factor a owl:DatatypeProperty ;
    rdfs:label "calibration_factor" ;
    skos:definition "Calibration factor, used as t_radiation = calibration_factor * (voltage_t_radiation - calibration_offset)" ;
    skos:inScheme fyo:ece ;
    fyo:dd_type "static" ;
    fyo:dd_units "eV.V^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:calibration_offset a owl:ObjectProperty ;
    rdfs:label "calibration_offset" ;
    skos:definition "Calibration offset, may be re-evaluated dynamically during long pulses on some experiments" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "V" .

fyo:calibration_spectral_date a owl:DatatypeProperty ;
    rdfs:label "calibration_spectral_date" ;
    skos:definition "Date at which the spectral calibration was carried out" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_type "static" .

fyo:candidate_design a owl:ObjectProperty ;
    rdfs:label "candidate_design" ;
    skos:definition "OUTPUT (principal) — the selected / optimized device parameter set as a DIRECTIVE design specification (as-designed stance: it prescribes a Machine — which may not yet exist — and is truth-evaluated by nothing; the later as-built description may disagree with it)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:directive "true" ;
    fyo:io "output" .

fyo:capacitance a owl:ObjectProperty ;
    rdfs:label "capacitance" ;
    skos:definition "Capacitance of the macthing element" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_units "F" .

fyo:cause a owl:DatatypeProperty ;
    rdfs:label "cause" ;
    skos:definition "Cause of the mode onset" ;
    skos:inScheme fyo:ntms ;
    fyo:dd_type "dynamic" .

fyo:centreline a owl:ObjectProperty ;
    rdfs:label "centreline" ;
    skos:definition "Centreline, i.e. middle of the vessel layer as a series of point. Repeat the first point in case of a closed contour" ;
    skos:inScheme fyo:common .

fyo:centres a owl:ObjectProperty ;
    rdfs:label "centres" ;
    skos:definition "Position of the centre of the arc of a circle of every element (meaningful only if type/index = 2 or 3, fill with default/empty value otherwise)" ;
    skos:inScheme fyo:common .

fyo:centroid a owl:ObjectProperty ;
    rdfs:label "centroid" ;
    skos:definition "List of positions of the centroids, in Cartesian coordinates" ;
    skos:inScheme fyo:ferritic .

fyo:charge a owl:DatatypeProperty ;
    rdfs:label "charge" ;
    skos:definition "Charge number of the participant" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:charge_norm a owl:DatatypeProperty ;
    rdfs:label "charge_norm" ;
    skos:definition "normalized charge" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:checked_against a owl:ObjectProperty ;
    rdfs:label "checked_against" ;
    rdfs:range fyo:EngineeringLimitSet ;
    skos:definition "The engineering-limit set this design run verifies its candidate trajectories against — limit verification is part of the task's FUNCTION, not an afterthought (a design that the coil set and power supplies cannot realize without exceeding limits is not a design)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> .

fyo:chi_squared_r a owl:DatatypeProperty ;
    rdfs:label "chi_squared_r" ;
    skos:definition "Squared error on the major radius normalized by the variance considered in the minimization process : chi_squared = weight^2 *(position_reconstructed/r - position_measured/r)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:chi_squared_reduced a owl:DatatypeProperty ;
    rdfs:label "chi_squared_reduced" ;
    skos:definition "Sum of the chi_squared of all constraints used for the equilibrium reconstruction, divided by the number of degrees of freedom of the identification model" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:chi_squared_z a owl:DatatypeProperty ;
    rdfs:label "chi_squared_z" ;
    skos:definition "Squared error on the altitude normalized by the variance considered in the minimization process : chi_squared = weight^2 *(position_reconstructed/z - position_measured/z)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:circular a owl:ObjectProperty ;
    rdfs:label "circular" ;
    skos:definition "Description of circular or elliptic image" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:citation a owl:DatatypeProperty ;
    rdfs:label "citation" ;
    skos:definition "Reference to publication(s)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:closest_wall_point a owl:ObjectProperty ;
    rdfs:label "closest_wall_point" ;
    skos:definition "Position and distance to the plasma boundary of the point of the first wall which is the closest to plasma boundary" ;
    skos:inScheme fyo:equilibrium .

fyo:cocos a owl:DatatypeProperty ;
    rdfs:label "cocos" ;
    rdfs:range xsd:integer ;
    skos:definition "COCOS index (Sauter tokamak coordinate-convention identifier) fixing the signs and orientation of the flux chart." ;
    skos:inScheme fyo:core .

fyo:coils_n a owl:DatatypeProperty ;
    rdfs:label "coils_n" ;
    skos:definition "Number of coils around the torus, in case is_periodic = 1" ;
    skos:inScheme fyo:tf ;
    fyo:dd_type "static" .

fyo:collisions_energy_conservation a owl:DatatypeProperty ;
    rdfs:label "collisions_energy_conservation" ;
    skos:definition "Flag = 1 if the collision operator conserves energy, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:collisions_finite_larmor_radius a owl:DatatypeProperty ;
    rdfs:label "collisions_finite_larmor_radius" ;
    skos:definition "Flag = 1 if finite larmor radius effects are retained in the collision operator, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:collisions_momentum_conservation a owl:DatatypeProperty ;
    rdfs:label "collisions_momentum_conservation" ;
    skos:definition "Flag = 1 if the collision operator conserves momentum, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:collisions_pitch_only a owl:DatatypeProperty ;
    rdfs:label "collisions_pitch_only" ;
    skos:definition "Flag = 1 if only pitch-angle scattering is retained, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:column_index_temperature_max a owl:DatatypeProperty ;
    rdfs:label "column_index_temperature_max" ;
    skos:definition "Column index with maximum apparent temperature" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "dynamic" .

fyo:columns_n a owl:DatatypeProperty ;
    rdfs:label "columns_n" ;
    skos:definition "Number of pixel columns in the horizontal direction" ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_type "static" .

fyo:component_type a owl:ObjectProperty ;
    rdfs:label "component_type" ;
    skos:definition "Type of component of this unit" ;
    skos:inScheme fyo:wall .

fyo:composition a owl:ObjectProperty ;
    rdfs:label "composition" ;
    skos:definition "Ratios of the volume-averaged density (inside LCFS) of each ion species to the volume-averaged electron density, taken at the time of maximum electron density during the pulse" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:computation_mode a owl:ObjectProperty ;
    rdfs:label "computation_mode" ;
    skos:definition "Computation mode for this equation" ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:cone_diameter a owl:DatatypeProperty ;
    rdfs:label "cone_diameter" ;
    skos:definition "Diameter of the base of the optical cone at the entrance pupil" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:connection_length a owl:ObjectProperty ;
    rdfs:label "connection_length" ;
    skos:definition "Average length of open magnetic field lines. In the case of fully closed field lines, connection_length = 1" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "m" .

fyo:constraints a owl:ObjectProperty ;
    rdfs:label "constraints" ;
    skos:definition "In case of equilibrium reconstruction under constraints, measurements used to constrain the equilibrium, reconstructed values and accuracy of the fit. The names of the child nodes correspond to the following definition: the solver aims at minimizing a cost function defined as : J=1/2*sum_i [ weight_i^2 (reconstructed_i - measured_i)^2 / sigma_i^2 ]. in which sigma_i is the standard deviation of the measurement error (to be found in the IDS of the measurement)" ;
    skos:inScheme fyo:equilibrium .

fyo:constraints_n a owl:DatatypeProperty ;
    rdfs:label "constraints_n" ;
    skos:definition "Number of constraints used (i.e. having a non-zero weight)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" .

fyo:contour_tree a owl:ObjectProperty ;
    rdfs:label "contour_tree" ;
    skos:definition "Description of the topological connectivity of the poloidal flux map critical points as an undirected graph. Critical points are ether local extremum (o-points) or saddle points (x-points) of the poloidal flux map. X-points have zero gradients in orthogonal directions but are not local extremum of the poloidal flux map whilst O-points are." ;
    skos:inScheme fyo:equilibrium .

fyo:control_laws a owl:ObjectProperty ;
    rdfs:label "control_laws" ;
    skos:definition "INPUT — the feedback controller set (structure, gains, wiring) to be exercised against the simulated plant." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:fyo_ids "controllers" ;
    fyo:io "input" .

fyo:control_parameters a owl:ObjectProperty ;
    rdfs:label "control_parameters" ;
    skos:definition "Solver-specific input or output quantities" ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:coolant a owl:ObjectProperty ;
    rdfs:label "coolant" ;
    skos:definition "Cooling material" ;
    skos:inScheme fyo:breeding_blanket .

fyo:cooling a owl:ObjectProperty ;
    rdfs:label "cooling" ;
    skos:definition "Cooling system of this module" ;
    skos:inScheme fyo:breeding_blanket .

fyo:coordinate1 a owl:ObjectProperty ;
    rdfs:label "coordinate1" ;
    skos:definition "First coordinate (radial)" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "as_parent" .

fyo:coordinate2 a owl:ObjectProperty ;
    rdfs:label "coordinate2" ;
    skos:definition "Second coordinate (poloidal)" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "as_parent" .

fyo:coordinate3 a owl:ObjectProperty ;
    rdfs:label "coordinate3" ;
    skos:definition "Third coordinate (toroidal)" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "as_parent" .

fyo:coordinate_index a owl:DatatypeProperty ;
    rdfs:label "coordinate_index" ;
    skos:definition "Index in tables_coord, specifying what coordinate systems to use for this process (valid for all tables)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:coulomb_logarithm a owl:ObjectProperty ;
    rdfs:label "coulomb_logarithm" ;
    skos:definition "Coulomb logarithm" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "1" .

fyo:count_limit_max a owl:DatatypeProperty ;
    rdfs:label "count_limit_max" ;
    skos:definition "Maximum count limit under which the detector response is linear" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" ;
    fyo:dd_units "s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:count_limit_min a owl:DatatypeProperty ;
    rdfs:label "count_limit_min" ;
    skos:definition "Minimum count limit above which the detector response is linear" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" ;
    fyo:dd_units "s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:counting a owl:ObjectProperty ;
    rdfs:label "counting" ;
    skos:definition "Detected counts per second as a function of time" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_units "s^-1" .

fyo:coupling_resistance a owl:ObjectProperty ;
    rdfs:label "coupling_resistance" ;
    skos:definition "Coupling resistance" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_units "ohm" .

fyo:creation_date a owl:DatatypeProperty ;
    rdfs:label "creation_date" ;
    skos:definition "Date at which this data has been produced" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:critical_type a owl:DatatypeProperty ;
    rdfs:label "critical_type" ;
    skos:definition "0-minimum, 1-saddle, 2-maximum" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" .

fyo:crystal a owl:ObjectProperty ;
    rdfs:label "crystal" ;
    skos:definition "Characteristics of the crystal used" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal .

fyo:current_alignment a owl:ObjectProperty ;
    rdfs:label "current_alignment" ;
    skos:definition "Figure of merit of the alignment of the current profile sources, defined in the following reference: http://iopscience.iop.org/article/10.1088/0029-5515/43/7/318" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "A" .

fyo:current_centre a owl:ObjectProperty ;
    rdfs:label "current_centre" ;
    skos:definition "Position and vertical velocity of the current centre" ;
    skos:inScheme fyo:equilibrium .

fyo:current_centroid a owl:ObjectProperty ;
    rdfs:label "current_centroid" ;
    skos:definition "RZ position of the current centroid" ;
    skos:inScheme fyo:pulse_schedule .

fyo:current_limit_min a owl:DatatypeProperty ;
    rdfs:label "current_limit_min" ;
    skos:definition "Minimum current in the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" ;
    fyo:dd_units "A" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:current_limiter_gain a owl:DatatypeProperty ;
    rdfs:label "current_limiter_gain" ;
    skos:definition "Gain to prevent overcurrent in a linear model of the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:current_ohm a owl:ObjectProperty ;
    rdfs:label "current_ohm" ;
    skos:definition "Ohmic current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "A" .

fyo:current_phi_max a owl:ObjectProperty ;
    rdfs:label "current_phi_max" ;
    skos:definition "Maximum toroidal current carried by runaway electrons during the pulse" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "A" .

fyo:current_runaways a owl:ObjectProperty ;
    rdfs:label "current_runaways" ;
    skos:definition "Total toroidal current carried by runaway electrons" ;
    skos:inScheme fyo:summary .

fyo:data_dictionary a owl:DatatypeProperty ;
    rdfs:label "data_dictionary" ;
    skos:definition "Version of Data Dictionary used to PUT this IDS" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:data_type a owl:DatatypeProperty ;
    rdfs:label "data_type" ;
    skos:definition "Signal data type" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_type "constant" .

fyo:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    skos:definition "Date of this release" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:dd a owl:ObjectProperty ;
    rdfs:label "dd" ;
    skos:definition "Neutron rates from DD reactions" ;
    skos:inScheme fyo:summary .

fyo:debye_length_norm a owl:DatatypeProperty ;
    rdfs:label "debye_length_norm" ;
    skos:definition "Debye length computed from the reference quantities (see detailed documentation at the root of the IDS)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:decay_time a owl:ObjectProperty ;
    rdfs:label "decay_time" ;
    skos:definition "Decay time" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:decay_times a owl:ObjectProperty ;
    rdfs:label "decay_times" ;
    skos:definition "Characteristic decay times describing the loss of different quantities during the disruption" ;
    skos:inScheme fyo:summary .

fyo:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    skos:definition "Definition of the reference point" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_type "static" .

fyo:delay a owl:DatatypeProperty ;
    rdfs:label "delay" ;
    skos:definition "Pure delay in the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:delongation_dr_minor_norm a owl:DatatypeProperty ;
    rdfs:label "delongation_dr_minor_norm" ;
    skos:definition "Derivative of the elongation with respect to r_minor_norm" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:delta_angle a owl:DatatypeProperty ;
    rdfs:label "delta_angle" ;
    skos:definition "Variation of the angle of inclination between a beamlet at the centre of the injection unit surface and the horiontal plane" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:delta_b_field_phi_vacuum_r a owl:ObjectProperty ;
    rdfs:label "delta_b_field_phi_vacuum_r" ;
    skos:definition "Variation of (vacuum field times major radius in the toroidal field magnet) from the start of the plasma." ;
    skos:inScheme fyo:tf ;
    fyo:dd_units "T.m" .

fyo:delta_position_suprathermal a owl:ObjectProperty ;
    rdfs:label "delta_position_suprathermal" ;
    skos:definition "Simple estimate of the difference in position induced by the presence of suprathermal electrons. Position without corrections = position - delta_position_suprathermal" ;
    skos:inScheme fyo:ece .

fyo:delta_relative a owl:ObjectProperty ;
    rdfs:label "delta_relative" ;
    skos:definition "Relative deviation on the primary quantity of the transport equation between the present and the  previous iteration of the solver" ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:delta_tangency_radius a owl:DatatypeProperty ;
    rdfs:label "delta_tangency_radius" ;
    skos:definition "Variation of the tangency radius (major radius where the central line of a NBI unit is tangent to a circle around the torus)" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:deltat a owl:ObjectProperty ;
    rdfs:label "deltat" ;
    skos:definition "Discrete time sampling interval ; if less than 1e-10, the controller is considered to be expressed in continuous time" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_units "s" .

fyo:denergy_diamagnetic_dt a owl:ObjectProperty ;
    rdfs:label "denergy_diamagnetic_dt" ;
    skos:definition "Time derivative of the diamagnetic plasma energy content" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:denergy_thermal_dt a owl:ObjectProperty ;
    rdfs:label "denergy_thermal_dt" ;
    skos:definition "Time derivative of the thermal plasma energy content" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:density_control a owl:ObjectProperty ;
    rdfs:label "density_control" ;
    skos:definition "Gas injection system and density control references" ;
    skos:inScheme fyo:pulse_schedule .

fyo:density_log_gradient_norm a owl:DatatypeProperty ;
    rdfs:label "density_log_gradient_norm" ;
    skos:definition "normalized logarithmic gradient (with respect to r_minor_norm) of the density" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:density_norm a owl:DatatypeProperty ;
    rdfs:label "density_norm" ;
    skos:definition "normalized density" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:density_volume_average a owl:ObjectProperty ;
    rdfs:label "density_volume_average" ;
    skos:definition "Volume averaged density of this neutral species (averaged over the plasma volume up to the LCFS)" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "m^-3" .

fyo:deposition_rho_tor_norm a owl:ObjectProperty ;
    rdfs:label "deposition_rho_tor_norm" ;
    skos:definition "Normalized toroidal flux coordinate at which the main deposition should occur" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:describes_machine a owl:ObjectProperty ;
    rdfs:label "describes_machine" ;
    rdfs:range fyo:Machine ;
    skos:definition "The Machine this description is about (iao:is_about specialization)." ;
    skos:inScheme fyo:core .

fyo:design_space a owl:ObjectProperty ;
    rdfs:label "design_space" ;
    skos:definition "INPUT — the declared design space (which parameters are free, their bounds and couplings)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:io "input" .

fyo:design_targets a owl:ObjectProperty ;
    rdfs:label "design_targets" ;
    skos:definition "INPUT — the discharge design goals (target plasma current / shape / density / stored-energy waypoints, flat-top duration, …) the trajectory must reach." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:io "input" .

fyo:designed_pulse_schedule a owl:ObjectProperty ;
    rdfs:label "designed_pulse_schedule" ;
    skos:definition "OUTPUT (principal) — the designed feedforward pulse schedule: reference waveforms / setpoints for all actuators over the full discharge. A directive ICE (spo PlanSpecification nature): the future Discharge realizes it." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:directive "true" ;
    fyo:fyo_ids "pulse_schedule" ;
    fyo:io "output" .

fyo:detailed_evolution a owl:ObjectProperty ;
    rdfs:label "detailed_evolution" ;
    skos:definition "Detailed NTM evolution on a finer timebase than the time_slice array of structure" ;
    skos:inScheme fyo:ntms .

fyo:detector_humidity a owl:ObjectProperty ;
    rdfs:label "detector_humidity" ;
    skos:definition "Fraction of humidity (0-1) measured at the detector level" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_units "1" .

fyo:detector_image a owl:ObjectProperty ;
    rdfs:label "detector_image" ;
    skos:definition "Image of the detector or pixel on the focal plane of the optical system" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:detector_position_parameter a owl:ObjectProperty ;
    rdfs:label "detector_position_parameter" ;
    skos:definition "In case of detector moving during a pulse, position parameter allowing to record and compute the detector position as a function of time" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_units "mixed" .

fyo:detector_temperature a owl:ObjectProperty ;
    rdfs:label "detector_temperature" ;
    skos:definition "Temperature measured at the detector level" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_units "K" .

fyo:detector_voltage a owl:DatatypeProperty ;
    rdfs:label "detector_voltage" ;
    skos:definition "Voltage applied on the microchannel plate detector" ;
    skos:inScheme fyo:spectrometer_mass ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:dgeometric_axis_r_dr_minor a owl:DatatypeProperty ;
    rdfs:label "dgeometric_axis_r_dr_minor" ;
    skos:definition "Derivative of the major radius of the surface geometric axis with respect to r_minor" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:dgeometric_axis_z_dr_minor a owl:DatatypeProperty ;
    rdfs:label "dgeometric_axis_z_dr_minor" ;
    skos:definition "Derivative of the height of the surface geometric axis with respect to r_minor" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:diagnostics a owl:ObjectProperty ;
    rdfs:label "diagnostics" ;
    skos:definition "Detailed information about the sawtooth characteristics" ;
    skos:inScheme fyo:sawteeth .

fyo:diameter a owl:DatatypeProperty ;
    rdfs:label "diameter" ;
    skos:definition "Pellet diameter" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:direction_second a owl:ObjectProperty ;
    rdfs:label "direction_second" ;
    skos:definition "Second direction of measurement, in case of a rosette straing gauge" ;
    skos:inScheme fyo:operational_instrumentation .

fyo:direction_to_detector a owl:ObjectProperty ;
    rdfs:label "direction_to_detector" ;
    skos:definition "Vector that points from the centre of the voxel to the centre of the detector, described in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis." ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:discriminator_level_lower a owl:DatatypeProperty ;
    rdfs:label "discriminator_level_lower" ;
    skos:definition "Lower level discriminator of ADC" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" .

fyo:discriminator_level_upper a owl:DatatypeProperty ;
    rdfs:label "discriminator_level_upper" ;
    skos:definition "Upper level discriminator of ADC" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" .

fyo:displacement_parallel a owl:ObjectProperty ;
    rdfs:label "displacement_parallel" ;
    skos:definition "Parallel displacement of the modes" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "m" .

fyo:displacement_perpendicular a owl:ObjectProperty ;
    rdfs:label "displacement_perpendicular" ;
    skos:definition "Perpendicular displacement of the modes" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "m" .

fyo:distance_inner_outer_separatrices a owl:ObjectProperty ;
    rdfs:label "distance_inner_outer_separatrices" ;
    skos:definition "Distance between the inner and outer separatrices, in the major radius direction, at the plasma outboard and at the height corresponding to the maximum R for the inner separatrix." ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:distance_to_conductor a owl:DatatypeProperty ;
    rdfs:label "distance_to_conductor" ;
    skos:definition "Distance to conducting wall or other conductor behind the antenna strap" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:distance_x_point_z a owl:ObjectProperty ;
    rdfs:label "distance_x_point_z" ;
    skos:definition "Distance in the z direction of the measurement position to the closest X-point (Zmeasurement-Zx_point)" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "m" .

fyo:divertor_index a owl:DatatypeProperty ;
    rdfs:label "divertor_index" ;
    skos:definition "If the shunt is located on a given divertor, index of that divertor in the divertors IDS" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" .

fyo:dn_e_dt a owl:ObjectProperty ;
    rdfs:label "dn_e_dt" ;
    skos:definition "Time derivative of the electron density" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m^-3.s^-1" .

fyo:doppler a owl:ObjectProperty ;
    rdfs:label "doppler" ;
    skos:definition "Processed data for Doppler reflectometers" ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:doppler_shift a owl:ObjectProperty ;
    rdfs:label "doppler_shift" ;
    skos:definition "Doppler shift due to the diagnostic neutral beam particle velocity" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_units "m" .

fyo:dr_dz_zero_point a owl:ObjectProperty ;
    rdfs:label "dr_dz_zero_point" ;
    skos:definition "Outboard point on the separatrix on which dr/dz = 0 (local maximum of the major radius of the separatrix). In case of multiple local maxima, the closest one from z=z_magnetic_axis is chosen." ;
    skos:inScheme fyo:equilibrium .

fyo:dt a owl:ObjectProperty ;
    rdfs:label "dt" ;
    skos:definition "Neutron rates from DT reactions" ;
    skos:inScheme fyo:summary .

fyo:duration a owl:DatatypeProperty ;
    rdfs:label "duration" ;
    skos:definition "Duration of this event" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:e_field_critical_definition a owl:ObjectProperty ;
    rdfs:label "e_field_critical_definition" ;
    skos:definition "Definition chosen for the critical electric field (in global_quantities, profiles_1d and ggd)" ;
    skos:inScheme fyo:runaway_electrons .

fyo:e_field_plus_minus_ratio a owl:ObjectProperty ;
    rdfs:label "e_field_plus_minus_ratio" ;
    skos:definition "Average E+/E- power ratio of IC waves" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:effective_helical_ripple a owl:ObjectProperty ;
    rdfs:label "effective_helical_ripple" ;
    skos:definition "Effective helical ripple for 1/nu neoclassical regime (see [Beidler, C. D., and W. N. G. Hitchon, 1994, Plasma Phys. Control. Fusion 35, 317])" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:electron_rate a owl:ObjectProperty ;
    rdfs:label "electron_rate" ;
    skos:definition "Number of electrons injected per second" ;
    skos:inScheme fyo:gas_injection ;
    fyo:dd_units "s^-1" .

fyo:electrons_n a owl:ObjectProperty ;
    rdfs:label "electrons_n" ;
    skos:definition "Total number of electrons in the plasma, estimated from the line densities measured by the various channels" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_units "1" .

fyo:elements a owl:ObjectProperty ;
    rdfs:label "elements" ;
    skos:definition "Set of geometrical elements (line segments and/or arcs of a circle) describing the contour of the conductor centre. We define a coordinate system associated to each element as follows: for the arc and circle elements: binormal = (start point - center) x (intermediate point - center). This vector points in the direction of the circle / arc axis. normal = (center - point on curve). The normal vector will rotate as the point moves around the curve. Tangent = normal x binormal. For the line element we require an extra point, using the currently redundant intermediate point to define the line element's normal axis. The local coordinates for the line element then become: tangent = end point - start point; normal = intermediate point - start point; binormal = tangent x normal. It is assumed that all the axes above are normalized such that they have a unit length." ;
    skos:inScheme fyo:common .

fyo:ellipticity_initial a owl:DatatypeProperty ;
    rdfs:label "ellipticity_initial" ;
    skos:definition "Initial ellipticity before entering the plasma" ;
    skos:inScheme fyo:polarimeter ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:elms a owl:ObjectProperty ;
    rdfs:label "elms" ;
    skos:definition "Edge Localized Modes related quantities" ;
    skos:inScheme fyo:summary .

fyo:elongation_lower a owl:ObjectProperty ;
    rdfs:label "elongation_lower" ;
    skos:definition "Elongation (lower half w.r.t. geometric axis) of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:elongation_upper a owl:ObjectProperty ;
    rdfs:label "elongation_upper" ;
    skos:definition "Elongation (upper half w.r.t. geometric axis) of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:emission_current a owl:DatatypeProperty ;
    rdfs:label "emission_current" ;
    skos:definition "Emission current in the spectrometer filament" ;
    skos:inScheme fyo:spectrometer_mass ;
    fyo:dd_type "static" ;
    fyo:dd_units "A" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:end_points a owl:ObjectProperty ;
    rdfs:label "end_points" ;
    skos:definition "Position of the end point of every element. Meaningful only if type/index = 1 or 2, fill with default/empty value otherwise" ;
    skos:inScheme fyo:common .

fyo:energy_b_field_pol a owl:ObjectProperty ;
    rdfs:label "energy_b_field_pol" ;
    skos:definition "Poloidal magnetic plasma energy content = 1/(2.mu0) * integral over the plasma volume of b_field_pol^2" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "J" .

fyo:energy_configuration_name a owl:DatatypeProperty ;
    rdfs:label "energy_configuration_name" ;
    skos:definition "Name of the chosen energy configuration (energy detection threshold)" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_type "static" .

fyo:energy_cumulated a owl:ObjectProperty ;
    rdfs:label "energy_cumulated" ;
    skos:definition "Energy extracted from the component since the start of the pulse" ;
    skos:inScheme fyo:calorimetry ;
    fyo:dd_units "J" .

fyo:energy_electrons_thermal a owl:ObjectProperty ;
    rdfs:label "energy_electrons_thermal" ;
    skos:definition "Thermal electron plasma energy content = 3/2 * integral over the plasma volume of the thermal electron pressure" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "J" .

fyo:energy_fast_perpendicular a owl:ObjectProperty ;
    rdfs:label "energy_fast_perpendicular" ;
    skos:definition "Fast particles perpendicular energy content = 3/2 * integral over the plasma volume of the fast perpendicular pressure" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "J" .

fyo:energy_fluxes a owl:ObjectProperty ;
    rdfs:label "energy_fluxes" ;
    skos:definition "Energy fluxes. The incident and emitted components are distinguished. The net flux received by the wall is equal to incident - emitted" ;
    skos:inScheme fyo:wall .

fyo:energy_in a owl:ObjectProperty ;
    rdfs:label "energy_in" ;
    skos:definition "Energy of the laser pulse measured just before entering the vacuum vessel" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_units "J" .

fyo:energy_ion_total_thermal a owl:ObjectProperty ;
    rdfs:label "energy_ion_total_thermal" ;
    skos:definition "Thermal ion plasma energy content (sum over the ion species) = 3/2 * integral over the plasma volume of the thermal ion pressure" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "J" .

fyo:energy_multiplication_factor a owl:DatatypeProperty ;
    rdfs:label "energy_multiplication_factor" ;
    skos:definition "Energy multiplication factor" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:energy_out a owl:ObjectProperty ;
    rdfs:label "energy_out" ;
    skos:definition "Energy of the laser pulse measured after crossing the plasma" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_units "J" .

fyo:energy_perturbed a owl:DatatypeProperty ;
    rdfs:label "energy_perturbed" ;
    skos:definition "Perturbed energy associated to the mode" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:engineering_limits a owl:ObjectProperty ;
    rdfs:label "engineering_limits" ;
    skos:definition "INPUT — the engineering-limit set used for feasibility screening (shared with S-10; see EngineeringLimitSet in the discharge_design module)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:io "input" .

fyo:equations a owl:ObjectProperty ;
    rdfs:label "equations" ;
    skos:definition "Type of MHD equations used to populate this IDS" ;
    skos:inScheme fyo:mhd_linear .

fyo:escape_flux_max a owl:DatatypeProperty ;
    rdfs:label "escape_flux_max" ;
    skos:definition "Maximum neutron flux escaping from the back of the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W.m^-2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:evaporation a owl:ObjectProperty ;
    rdfs:label "evaporation" ;
    skos:definition "Chemical formula of the evaporated material or gas used to cover the vaccum vessel wall. NONE for no evaporation." ;
    skos:inScheme fyo:summary .

fyo:event_in_detector_neutron_flux a owl:ObjectProperty ;
    rdfs:label "event_in_detector_neutron_flux" ;
    skos:definition "5th dimension for the neutron_flux Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:event_in_detector_response_function a owl:ObjectProperty ;
    rdfs:label "event_in_detector_response_function" ;
    skos:definition "5th dimension for the response_function Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:exit_position a owl:ObjectProperty ;
    rdfs:label "exit_position" ;
    skos:definition "Exit position of the pipe in the vaccum vessel" ;
    skos:inScheme fyo:gas_injection .

fyo:exponential a owl:ObjectProperty ;
    rdfs:label "exponential" ;
    skos:definition "Exponential decay time (tau) used when the process is described by an exponential function (exp(-(t-t0)/tau))). Here \"t\" is time and \"t0\" is the time where the decay process starts" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:expression a owl:DatatypeProperty ;
    rdfs:label "expression" ;
    skos:definition "Expression used by the solver to calculate the relative deviation" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_type "dynamic" .

fyo:extension_r a owl:DatatypeProperty ;
    rdfs:label "extension_r" ;
    skos:definition "Target length projected on the major radius axis" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:extension_z a owl:DatatypeProperty ;
    rdfs:label "extension_z" ;
    skos:definition "Target length projected on the height axis" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:fall_time a owl:DatatypeProperty ;
    rdfs:label "fall_time" ;
    skos:definition "Peak fall time" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:fast_filter a owl:ObjectProperty ;
    rdfs:label "fast_filter" ;
    skos:definition "Description of how the fast and the thermal particle populations are separated" ;
    skos:inScheme fyo:distributions .

fyo:fibre_image a owl:ObjectProperty ;
    rdfs:label "fibre_image" ;
    skos:definition "Image of the optical fibre on the focal plane of the optical system" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:fibre_length a owl:DatatypeProperty ;
    rdfs:label "fibre_length" ;
    skos:definition "Spun fibre length on the vacuum vessel" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:fibre_positions a owl:ObjectProperty ;
    rdfs:label "fibre_positions" ;
    skos:definition "Individual fibres centres positions in the (X1, X2) coordinate system" ;
    skos:inScheme fyo:common .

fyo:fibre_properties a owl:ObjectProperty ;
    rdfs:label "fibre_properties" ;
    skos:definition "Intrinsic properties of the fibre installed on the vacuum vessel" ;
    skos:inScheme fyo:focs .

fyo:fibre_radius a owl:DatatypeProperty ;
    rdfs:label "fibre_radius" ;
    skos:definition "Radius of a single fibre" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:field a owl:ObjectProperty ;
    rdfs:label "field" ;
    skos:definition "Magnetic field component in direction of sensor normal axis (n) averaged over sensor volume defined by area and length, where n = cos(poloidal_angle)*cos(toroidal_angle)*grad(R) - sin(poloidal_angle)*grad(Z) + cos(poloidal_angle)*sin(toroidal_angle)*grad(Phi)/norm(grad(Phi))" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_units "T" .

fyo:field_of_view a owl:ObjectProperty ;
    rdfs:label "field_of_view" ;
    skos:definition "Field of view associated to this detector. The field of view is described by a voxelized plasma volume. Each voxel, with indexes i_R, i_Z, and i_phi, has an associated solid angle scalar and a detector direction vector." ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:field_of_view_horizontal a owl:DatatypeProperty ;
    rdfs:label "field_of_view_horizontal" ;
    skos:definition "Field of view in the horizontal detector plane" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:field_of_view_vertical a owl:DatatypeProperty ;
    rdfs:label "field_of_view_vertical" ;
    skos:definition "Field of view in the vertical detector plane" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:fields a owl:ObjectProperty ;
    rdfs:label "fields" ;
    skos:definition "Electrostatic potential, magnetic field and magnetic vector potential" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fields_4d a owl:ObjectProperty ;
    rdfs:label "fields_4d" ;
    skos:definition "4D fields" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fields_intensity_1d a owl:ObjectProperty ;
    rdfs:label "fields_intensity_1d" ;
    skos:definition "1D fields (summed over kx, time averaged and flux surface averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fields_intensity_2d_surface_average a owl:ObjectProperty ;
    rdfs:label "fields_intensity_2d_surface_average" ;
    skos:definition "2D fields (time averaged and flux surface averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fields_intensity_3d a owl:ObjectProperty ;
    rdfs:label "fields_intensity_3d" ;
    skos:definition "3D fields (time averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fields_zonal_2d a owl:ObjectProperty ;
    rdfs:label "fields_zonal_2d" ;
    skos:definition "2D zonal fields (taken at ky=0, flux surface averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:filter_spectrometer a owl:ObjectProperty ;
    rdfs:label "filter_spectrometer" ;
    skos:definition "Quantities measured by the channel if connected to a filter spectrometer" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:first_wall_enclosed_volume a owl:DatatypeProperty ;
    rdfs:label "first_wall_enclosed_volume" ;
    skos:definition "Volume available to gas or plasma enclosed by the first wall contour" ;
    skos:inScheme fyo:wall ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^3" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:first_wall_power_flux_peak a owl:ObjectProperty ;
    rdfs:label "first_wall_power_flux_peak" ;
    skos:definition "Peak power flux on the first wall (including divertors)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_units "W.m^-2" .

fyo:first_wall_power_flux_peak_outside_divertors a owl:ObjectProperty ;
    rdfs:label "first_wall_power_flux_peak_outside_divertors" ;
    skos:definition "Peak power flux on the first wall (excluding the divertors surface)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_units "W.m^-2" .

fyo:first_wall_surface_area a owl:DatatypeProperty ;
    rdfs:label "first_wall_surface_area" ;
    skos:definition "First wall surface area" ;
    skos:inScheme fyo:wall ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:flow_rate_max a owl:DatatypeProperty ;
    rdfs:label "flow_rate_max" ;
    skos:definition "Maximum flow rate of the valve" ;
    skos:inScheme fyo:gas_injection ;
    fyo:dd_type "static" ;
    fyo:dd_units "Pa.m^3.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:flow_rate_min a owl:DatatypeProperty ;
    rdfs:label "flow_rate_min" ;
    skos:definition "Minimum flow rate of the valve" ;
    skos:inScheme fyo:gas_injection ;
    fyo:dd_type "static" ;
    fyo:dd_units "Pa.m^3.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:fluctuations_level a owl:ObjectProperty ;
    rdfs:label "fluctuations_level" ;
    skos:definition "Reconstruction of the amplitude of the fluctuations" ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:fluctuations_spectrum a owl:ObjectProperty ;
    rdfs:label "fluctuations_spectrum" ;
    skos:definition "Spectrum of the fluctuations, obtained by Fourier transform" ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:fluence a owl:ObjectProperty ;
    rdfs:label "fluence" ;
    skos:definition "Positive charge fluence normal to an ideal axisymmetric surface of the divertor (assuming no shaping), estimated at the probe location." ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "m^-2" .

fyo:fluids_n a owl:DatatypeProperty ;
    rdfs:label "fluids_n" ;
    skos:definition "Number of fluids considered in the model" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "constant" .

fyo:flux_control a owl:ObjectProperty ;
    rdfs:label "flux_control" ;
    skos:definition "Magnetic flux control references" ;
    skos:inScheme fyo:pulse_schedule .

fyo:flux_surface a owl:ObjectProperty ;
    rdfs:label "flux_surface" ;
    skos:definition "Flux surface characteristics" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_1d a owl:ObjectProperty ;
    rdfs:label "fluxes_1d" ;
    skos:definition "1D fluxes (flux-surface and time averaged), summed over kx and ky" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_1d_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_1d_rotating_frame" ;
    skos:definition "1D fluxes (flux-surface and time averaged), summed over kx and ky in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_2d_k_x_k_y_sum a owl:ObjectProperty ;
    rdfs:label "fluxes_2d_k_x_k_y_sum" ;
    skos:definition "2D fluxes (flux-surface averaged), summed over kx and ky" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_2d_k_x_k_y_sum_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_2d_k_x_k_y_sum_rotating_frame" ;
    skos:definition "2D fluxes (flux-surface averaged), summed over kx and ky in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_2d_k_x_sum a owl:ObjectProperty ;
    rdfs:label "fluxes_2d_k_x_sum" ;
    skos:definition "2D fluxes (time and flux-surface averaged), summed over kx" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_2d_k_x_sum_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_2d_k_x_sum_rotating_frame" ;
    skos:definition "2D fluxes (time and flux-surface averaged), summed over kx in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_3d a owl:ObjectProperty ;
    rdfs:label "fluxes_3d" ;
    skos:definition "3D fluxes (time and flux surface averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_3d_k_x_sum a owl:ObjectProperty ;
    rdfs:label "fluxes_3d_k_x_sum" ;
    skos:definition "3D fluxes (flux surface averaged, summed over kx)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_3d_k_x_sum_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_3d_k_x_sum_rotating_frame" ;
    skos:definition "3D fluxes (flux surface averaged, summed over kx)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_3d_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_3d_rotating_frame" ;
    skos:definition "3D fluxes (time and flux surface averaged) in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_4d a owl:ObjectProperty ;
    rdfs:label "fluxes_4d" ;
    skos:definition "4D fluxes (time averaged)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_4d_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_4d_rotating_frame" ;
    skos:definition "4D fluxes (time averaged) in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_5d a owl:ObjectProperty ;
    rdfs:label "fluxes_5d" ;
    skos:definition "5D fluxes" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:fluxes_5d_rotating_frame a owl:ObjectProperty ;
    rdfs:label "fluxes_5d_rotating_frame" ;
    skos:definition "5D fluxes in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:focal_length a owl:DatatypeProperty ;
    rdfs:label "focal_length" ;
    skos:definition "Focal length of the collector lens" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:focal_length_horizontal a owl:DatatypeProperty ;
    rdfs:label "focal_length_horizontal" ;
    skos:definition "Horizontal focal length along the beam line, i.e. the point along the centre of the beamlet-group where the beamlet-group has its minimum horizontal width" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:focal_length_vertical a owl:DatatypeProperty ;
    rdfs:label "focal_length_vertical" ;
    skos:definition "Vertical focal length along the beam line, i.e. the point along the centre of the beamlet-group where the beamlet-group has its minimum vertical width" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:focus a owl:ObjectProperty ;
    rdfs:label "focus" ;
    skos:definition "Describes how the beamlet group is focused. Calculations of width_min_horizontal and width_min_vertical are on a plane defined by the average normal vector of the two constituent accelerator nbi target planes." ;
    skos:inScheme fyo:nbi .

fyo:force a owl:ObjectProperty ;
    rdfs:label "force" ;
    skos:definition "Force (positive when upwards for a vertical force, positive when outwards for a radial force)" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "N" .

fyo:force_limits a owl:ObjectProperty ;
    rdfs:label "force_limits" ;
    skos:definition "Description of force limits on the axisymmetric PF coil system" ;
    skos:inScheme fyo:pf_active .

fyo:force_radial a owl:ObjectProperty ;
    rdfs:label "force_radial" ;
    skos:definition "Radial force applied on this coil (positive when outwards)" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "N" .

fyo:force_radial_crushing a owl:ObjectProperty ;
    rdfs:label "force_radial_crushing" ;
    skos:definition "Radial crushing force applied on this coil (positive when compressive)" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "N" .

fyo:force_vertical a owl:ObjectProperty ;
    rdfs:label "force_vertical" ;
    skos:definition "Vertical force applied on this coil (positive when upwards)" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "N" .

fyo:force_vertical_crushing a owl:ObjectProperty ;
    rdfs:label "force_vertical_crushing" ;
    skos:definition "Vertical crushing force applied on this coil (positive when compressive)" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_units "N" .

fyo:formula a owl:ObjectProperty ;
    rdfs:label "formula" ;
    skos:definition "Analytical formula representing the electron density profile as a function of a radial coordinate and adjustable parameters f(rho_tor_norm, alpha1, ... alphaN)" ;
    skos:inScheme fyo:refractometer .

fyo:fraction_pol_max a owl:ObjectProperty ;
    rdfs:label "fraction_pol_max" ;
    skos:definition "Maximum poloidal halo current normalized by the pre-disruption toroidal plasma current" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:fragmentation_gas a owl:ObjectProperty ;
    rdfs:label "fragmentation_gas" ;
    skos:definition "Description of the gas produced during fragmentation" ;
    skos:inScheme fyo:spi .

fyo:freedom_degrees_n a owl:DatatypeProperty ;
    rdfs:label "freedom_degrees_n" ;
    skos:definition "Number of degrees of freedom of the identification model" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" .

fyo:frequency_main a owl:DatatypeProperty ;
    rdfs:label "frequency_main" ;
    skos:definition "Main frequency used to probe the plasma (before upshifting and modulating)" ;
    skos:inScheme fyo:refractometer ;
    fyo:dd_type "static" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:frequency_norm a owl:DatatypeProperty ;
    rdfs:label "frequency_norm" ;
    skos:definition "Frequency" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:front_surface a owl:ObjectProperty ;
    rdfs:label "front_surface" ;
    skos:definition "Curvature of the front surface" ;
    skos:inScheme fyo:common .

fyo:fusion a owl:ObjectProperty ;
    rdfs:label "fusion" ;
    skos:definition "Fusion reactions" ;
    skos:inScheme fyo:summary .

fyo:fusion_fluence a owl:ObjectProperty ;
    rdfs:label "fusion_fluence" ;
    skos:definition "Fusion fluence : power provided by fusion reactions, integrated over time since the beginning of the pulse" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "J" .

fyo:fusion_gain a owl:ObjectProperty ;
    rdfs:label "fusion_gain" ;
    skos:definition "Fusion gain : ratio of the power provided by fusion reactions to the auxiliary power needed to heat the plasma. Often noted as Q in the litterature." ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:gap_limiter_wall a owl:ObjectProperty ;
    rdfs:label "gap_limiter_wall" ;
    skos:definition "Distance between the separatrix and the nearest limiter or wall element" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:gas_injection_accumulated a owl:ObjectProperty ;
    rdfs:label "gas_injection_accumulated" ;
    skos:definition "Accumulated injected gas since the plasma breakdown in equivalent electrons" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:gas_injection_prefill a owl:ObjectProperty ;
    rdfs:label "gas_injection_prefill" ;
    skos:definition "Accumulated injected gas during the prefill in equivalent electrons" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:gas_injection_rates a owl:ObjectProperty ;
    rdfs:label "gas_injection_rates" ;
    skos:definition "Gas injection rates in equivalent electrons.s^-1" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s^-1" .

fyo:gauge_length a owl:DatatypeProperty ;
    rdfs:label "gauge_length" ;
    skos:definition "Length of the strain gauge" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:geometric_axis_r a owl:ObjectProperty ;
    rdfs:label "geometric_axis_r" ;
    skos:definition "R position of the geometric axis (defined as (Rmax+Rmin) / 2 of the boundary)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:geometric_axis_z a owl:ObjectProperty ;
    rdfs:label "geometric_axis_z" ;
    skos:definition "Z position of the geometric axis (defined as (Zmax+Zmin) / 2 of the boundary)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:grad_shafranov_deviation_expression a owl:ObjectProperty ;
    rdfs:label "grad_shafranov_deviation_expression" ;
    skos:definition "Expression for calculating the residual deviation between the left and right hand side of the Grad Shafranov equation" ;
    skos:inScheme fyo:equilibrium .

fyo:grad_shafranov_deviation_value a owl:DatatypeProperty ;
    rdfs:label "grad_shafranov_deviation_value" ;
    skos:definition "Value of the residual deviation between the left and right hand side of the Grad Shafranov equation, evaluated as per grad_shafranov_deviation_expression" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "mixed" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:grating_spectrometer a owl:ObjectProperty ;
    rdfs:label "grating_spectrometer" ;
    skos:definition "Quantities measured by the channel if connected to a grating spectrometer" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:green_functions a owl:ObjectProperty ;
    rdfs:label "green_functions" ;
    skos:definition "Green function coefficients used to represent the detector response based on its field of view" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:greenwald_fraction a owl:ObjectProperty ;
    rdfs:label "greenwald_fraction" ;
    skos:definition "Greenwald fraction =line_average/n_e/value divided by (global_quantities/ip/value *1e6 * pi * minor_radius^2)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:grid_2d_type a owl:ObjectProperty ;
    rdfs:label "grid_2d_type" ;
    skos:definition "Selection of one of a set of grid types for grid_2d" ;
    skos:inScheme fyo:turbulence .

fyo:groove_density a owl:DatatypeProperty ;
    rdfs:label "groove_density" ;
    skos:definition "Number of grooves per unit length" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:growth_rate_norm a owl:DatatypeProperty ;
    rdfs:label "growth_rate_norm" ;
    skos:definition "Growth rate" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:growth_rate_tolerance a owl:DatatypeProperty ;
    rdfs:label "growth_rate_tolerance" ;
    skos:definition "Relative tolerance on the growth rate (convergence of the simulation)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:growthrate a owl:DatatypeProperty ;
    rdfs:label "growthrate" ;
    skos:definition "Linear growthrate of the mode" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:h_98 a owl:ObjectProperty ;
    rdfs:label "h_98" ;
    skos:definition "Energy confinement time enhancement factor over the IPB98(y,2) scaling" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:h_mode a owl:ObjectProperty ;
    rdfs:label "h_mode" ;
    skos:definition "H-mode flag: 0 when the plasma is in L-mode and 1 when in H-mode" ;
    skos:inScheme fyo:summary .

fyo:halo_current a owl:ObjectProperty ;
    rdfs:label "halo_current" ;
    skos:definition "Characteristics of halo current" ;
    skos:inScheme fyo:summary .

fyo:heat_flux_e_decay_length a owl:ObjectProperty ;
    rdfs:label "heat_flux_e_decay_length" ;
    skos:definition "Electron heat flux radial decay length inv(grad qe/qe)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:heat_flux_i_decay_length a owl:ObjectProperty ;
    rdfs:label "heat_flux_i_decay_length" ;
    skos:definition "Ion heat flux radial decay length inv(grad qi/qi)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:heat_flux_steady_limit_max a owl:DatatypeProperty ;
    rdfs:label "heat_flux_steady_limit_max" ;
    skos:definition "Maximum steady state heat flux allowed on divertor target surface (engineering design limit)" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "static" ;
    fyo:dd_units "W.m^-2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:heating_current_drive a owl:ObjectProperty ;
    rdfs:label "heating_current_drive" ;
    skos:definition "Heating and current drive parameters" ;
    skos:inScheme fyo:summary .

fyo:homogeneous_time a owl:DatatypeProperty ;
    rdfs:label "homogeneous_time" ;
    skos:definition "This node must be filled (with 0, 1, or 2) for the IDS to be valid. If 1, the time of this IDS is homogeneous, i.e. the time values for this IDS are stored in the time node just below the root of this IDS. If 0, the time values are stored in the various time fields at lower levels in the tree. In the case only constant or static nodes are filled within the IDS, homogeneous_time must be set to 2" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:horizontal a owl:DatatypeProperty ;
    rdfs:label "horizontal" ;
    skos:definition "The horiztonal beamlet divergence of the component. Here the divergence is defined for Gaussian beams as the angle where the beam density is reduced by a factor 1/e compared to the maximum density (equivalent to the intensity for the divergence of each individual beamlet as the energy is assumed constant). For non-Gaussian beams the divergence is mean((x-mean(x))**2)/sqrt(2), where x is the angle and the mean should be performed over the beam density, P(x): mean(y)=int(y*P(x)*dx)." ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:i a owl:ObjectProperty ;
    rdfs:label "i" ;
    skos:definition "Integral term" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "../../output_names" ;
    fyo:dd_coordinate2 "../../input_names" ;
    fyo:dd_coordinate3 "time" ;
    fyo:dd_units "mixed" .

fyo:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "ID of the fibre, e.g. commercial reference" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" .

fyo:ideal_flag a owl:DatatypeProperty ;
    rdfs:label "ideal_flag" ;
    skos:definition "1 if ideal MHD is used to populate this IDS, 0 for non-ideal MHD" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "constant" .

fyo:if_bandwidth a owl:DatatypeProperty ;
    rdfs:label "if_bandwidth" ;
    skos:definition "Full-width of the Intermediate Frequency (IF) bandpass filter" ;
    skos:inScheme fyo:ece ;
    fyo:dd_type "static" ;
    fyo:dd_units "Hz" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:image_diameter a owl:DatatypeProperty ;
    rdfs:label "image_diameter" ;
    skos:definition "Diameter at the image plane (typically the diameter of the optical fibre)" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:image_field a owl:ObjectProperty ;
    rdfs:label "image_field" ;
    skos:definition "Surface on which the grating image is focused" ;
    skos:inScheme fyo:spectrometer_uv .

fyo:impedance a owl:DatatypeProperty ;
    rdfs:label "impedance" ;
    skos:definition "ADC impedance" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" ;
    fyo:dd_units "ohm" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:include_a_field_parallel a owl:DatatypeProperty ;
    rdfs:label "include_a_field_parallel" ;
    skos:definition "Flag = 1 if fluctuations of the parallel vector potential are retained, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:include_b_field_parallel a owl:DatatypeProperty ;
    rdfs:label "include_b_field_parallel" ;
    skos:definition "Flag = 1 if fluctuations of the parallel magnetic field are retained, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:include_centrifugal_effects a owl:DatatypeProperty ;
    rdfs:label "include_centrifugal_effects" ;
    skos:definition "Flag = 1 if centrifugal effects are retained, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:include_coriolis_drift a owl:DatatypeProperty ;
    rdfs:label "include_coriolis_drift" ;
    skos:definition "Flag = 1 if Coriolis drift is included, 0 otherwise" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:index_in_antenna a owl:DatatypeProperty ;
    rdfs:label "index_in_antenna" ;
    skos:definition "Index of the wave (starts at 1), separating different waves generated from a single antenna." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:infrastructure_get a owl:ObjectProperty ;
    rdfs:label "infrastructure_get" ;
    skos:definition "Plugin infrastructure used to GET the data" ;
    skos:inScheme fyo:common .

fyo:infrastructure_put a owl:ObjectProperty ;
    rdfs:label "infrastructure_put" ;
    skos:definition "Plugin infrastructure used to PUT the data" ;
    skos:inScheme fyo:common .

fyo:initial_guess a owl:ObjectProperty ;
    rdfs:label "initial_guess" ;
    skos:definition "INPUT (optional) — an initial pulse-schedule guess (e.g. a scaled reference shot) seeding the optimization." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:fyo_ids "pulse_schedule" ;
    fyo:io "input" .

fyo:initial_profiles a owl:ObjectProperty ;
    rdfs:label "initial_profiles" ;
    skos:definition "INPUT — initial core plasma profiles (densities, temperatures, current) from which the forward advance starts." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "core_profiles" ;
    fyo:io "input" .

fyo:initial_value_run a owl:DatatypeProperty ;
    rdfs:label "initial_value_run" ;
    skos:definition "Flag = 1 if this is an initial value run, 0 for an eigenvalue run" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:injection_direction a owl:ObjectProperty ;
    rdfs:label "injection_direction" ;
    skos:definition "Unit vector of the unshattered pellet velocity direction right before shattering" ;
    skos:inScheme fyo:spi .

fyo:input_range a owl:DatatypeProperty ;
    rdfs:label "input_range" ;
    skos:definition "ADC input range" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:inside_lcfs a owl:ObjectProperty ;
    rdfs:label "inside_lcfs" ;
    skos:definition "Emissions from the core plasma, inside the last closed flux surface" ;
    skos:inScheme fyo:radiation .

fyo:inside_vessel a owl:ObjectProperty ;
    rdfs:label "inside_vessel" ;
    skos:definition "Total emissions inside the vacuum vessel" ;
    skos:inScheme fyo:radiation .

fyo:intermediate_points a owl:ObjectProperty ;
    rdfs:label "intermediate_points" ;
    skos:definition "Position of an intermediate point along the circle or arc of circle, for every element, providing the orientation of the element (must define with the corresponding start point an aperture angle strictly inferior to PI). In the case of a line segment (../types/index=1), fill this node with a point such that the vector intermediate_point - start_point defines the direction of the element's normal axis (see documentation of ../elements)" ;
    skos:inScheme fyo:common .

fyo:interpolation_type a owl:DatatypeProperty ;
    rdfs:label "interpolation_type" ;
    skos:definition "Interpolation strategy in this coordinate direction. Integer flag: 0=discrete (no interpolation); 1=linear; ..." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:iota a owl:ObjectProperty ;
    rdfs:label "iota" ;
    skos:definition "Rotational transform (1/q)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:ip_sign a owl:DatatypeProperty ;
    rdfs:label "ip_sign" ;
    skos:definition "Sign of the plasma current" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:is_delta_f a owl:DatatypeProperty ;
    rdfs:label "is_delta_f" ;
    skos:definition "If is_delta_f=1, then the distribution represents the deviation from a Maxwellian; is_delta_f=0, then the distribution represents all particles, i.e. the full-f solution" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "constant" .

fyo:is_hosted_by a owl:ObjectProperty ;
    rdfs:label "is_hosted_by" ;
    rdfs:range fyo:Machine ;
    skos:definition "Inverse of hosts — the Machine a Plasma is confined in." ;
    skos:inScheme fyo:core .

fyo:is_neutral a owl:DatatypeProperty ;
    rdfs:label "is_neutral" ;
    skos:definition "Flag specifying if this state corresponds to a neutral (1) or not (0)" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_type "dynamic" .

fyo:is_periodic a owl:DatatypeProperty ;
    rdfs:label "is_periodic" ;
    skos:definition "Flag indicating whether coils are described one by one in the coil() structure (flag=0) or whether the coil structure represents only coils having different characteristics (flag = 1, n_coils must be filled in that case). In the latter case, the coil() sequence is repeated periodically around the torus." ;
    skos:inScheme fyo:tf ;
    fyo:dd_type "static" .

fyo:is_replaced_by a owl:DatatypeProperty ;
    rdfs:label "is_replaced_by" ;
    skos:definition "Persistent identifier referencing the new version of this data (replacing the present version)" ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_type "constant" .

fyo:isotope_fraction_hydrogen a owl:ObjectProperty ;
    rdfs:label "isotope_fraction_hydrogen" ;
    skos:definition "Fraction of hydrogen density among the hydrogenic species (nH/(nH+nD+nT))" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:isotope_ratios a owl:ObjectProperty ;
    rdfs:label "isotope_ratios" ;
    skos:definition "Isotope ratios and related information" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:itb a owl:ObjectProperty ;
    rdfs:label "itb" ;
    skos:definition "Parameters at internal transport barrier" ;
    skos:inScheme fyo:summary .

fyo:iteration_cap a owl:DatatypeProperty ;
    rdfs:label "iteration_cap" ;
    skos:definition "Upper bound on scenario-loop iterations (explicit modeling decision)." ;
    skos:inScheme fyo:scenario .

fyo:j_i_kurtosis a owl:ObjectProperty ;
    rdfs:label "j_i_kurtosis" ;
    skos:definition "Pearson kurtosis of the ion saturation current density" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "1" .

fyo:j_i_parallel_sigma a owl:ObjectProperty ;
    rdfs:label "j_i_parallel_sigma" ;
    skos:definition "Standard deviation of ion parallel current density at the probe position" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "A.m^-2" .

fyo:j_i_saturation_kurtosis a owl:ObjectProperty ;
    rdfs:label "j_i_saturation_kurtosis" ;
    skos:definition "Pearson kurtosis of the ion saturation current density" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "1" .

fyo:j_i_saturation_sigma a owl:ObjectProperty ;
    rdfs:label "j_i_saturation_sigma" ;
    skos:definition "Standard deviation of the ion saturation current density, corresponding to the fluctuations of the quantity over time" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "A.m^-2" .

fyo:j_i_saturation_skew a owl:ObjectProperty ;
    rdfs:label "j_i_saturation_skew" ;
    skos:definition "Skew of the ion saturation current density" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "1" .

fyo:j_i_sigma a owl:ObjectProperty ;
    rdfs:label "j_i_sigma" ;
    skos:definition "Standard deviation of the ion saturation current density, corresponding to the fluctuations of the quantity over time" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "A.m^-2" .

fyo:j_i_skew a owl:ObjectProperty ;
    rdfs:label "j_i_skew" ;
    skos:definition "Skew of the ion saturation current density" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "1" .

fyo:kicks a owl:ObjectProperty ;
    rdfs:label "kicks" ;
    skos:definition "Vertical kicks of the plasma position" ;
    skos:inScheme fyo:summary .

fyo:kinetic a owl:ObjectProperty ;
    rdfs:label "kinetic" ;
    skos:definition "Energy fluxes due to the kinetic energy of particles" ;
    skos:inScheme fyo:wall .

fyo:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "String identifying the neutral molecule (e.g. H2, D2, T2, N2, ...)" ;
    skos:inScheme fyo:gas_pumping ;
    fyo:dd_type "constant" .

fyo:launching_position a owl:ObjectProperty ;
    rdfs:label "launching_position" ;
    skos:definition "Launching position of the beam" ;
    skos:inScheme fyo:ec_launchers .

fyo:length_alpha a owl:DatatypeProperty ;
    rdfs:label "length_alpha" ;
    skos:definition "Length of the parallelogram side inclined with angle alpha with respect to the major radius axis" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:length_beta a owl:DatatypeProperty ;
    rdfs:label "length_beta" ;
    skos:definition "Length of the parallelogram side inclined with angle beta with respect to the height axis" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:length_pol a owl:DatatypeProperty ;
    rdfs:label "length_pol" ;
    skos:definition "Poloidal length of the magnetic surface" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:levelset a owl:ObjectProperty ;
    rdfs:label "levelset" ;
    skos:definition "Single poloidal flux contour including critical point (x-point only)" ;
    skos:inScheme fyo:equilibrium .

fyo:li6_fraction a owl:DatatypeProperty ;
    rdfs:label "li6_fraction" ;
    skos:definition "Fraction of Li6 isotope over the total amount of Li in the blanket" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:li_3_mhd a owl:ObjectProperty ;
    rdfs:label "li_3_mhd" ;
    skos:definition "Internal inductance as determined by an equilibrium reconstruction code. Use this only when the li node above is used for another estimation method and there is a need to store a second value of li (determined by an equilibrium reconstruction code). The li_3 definition is used, i.e. li_3 = 2/R0/mu0^2/Ip^2 * int(Bp^2 dV)." ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:definition "License(s) under which the data is made available (license description or, more convenient, publicly accessible URL pointing to the full license text)" ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_type "constant" .

fyo:light_collection_efficiencies a owl:ObjectProperty ;
    rdfs:label "light_collection_efficiencies" ;
    skos:definition "Light collection efficiencies (fraction of the local emission detected by the optical system) for a list of points defining regions of interest. To be used for non-pinhole optics." ;
    skos:inScheme fyo:spectrometer_visible .

fyo:limit_verification_report a owl:ObjectProperty ;
    rdfs:label "limit_verification_report" ;
    skos:definition "OUTPUT — the engineering-limit verification report: per-channel margins of the designed trajectory against the EngineeringLimitSet (which limit, where in the pulse, how close)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:io "output" .

fyo:line_average a owl:ObjectProperty ;
    rdfs:label "line_average" ;
    skos:definition "Line average plasma parameters" ;
    skos:inScheme fyo:summary .

fyo:line_of_sight_index a owl:DatatypeProperty ;
    rdfs:label "line_of_sight_index" ;
    skos:definition "Number of the line of sight where the detector is mounted" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" .

fyo:linear_20_80 a owl:ObjectProperty ;
    rdfs:label "linear_20_80" ;
    skos:definition "Decay time defined as (t(0.2)-t(0.8))/0.6, where t(X) corresponds to the time where this quantity reaches X*100% of its pre-disruptive value" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:linear_custom a owl:ObjectProperty ;
    rdfs:label "linear_custom" ;
    skos:definition "Decay time defined as (t(X2)-t(X1))/(X1-X2), where t(Xj) corresponds to the time where this quantity reaches Xj*100% of its pre-disruptive value" ;
    skos:inScheme fyo:summary .

fyo:linear_weights a owl:ObjectProperty ;
    rdfs:label "linear_weights" ;
    skos:definition "normalized fluxes in the laboratory frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:linear_weights_rotating_frame a owl:ObjectProperty ;
    rdfs:label "linear_weights_rotating_frame" ;
    skos:definition "normalized fluxes in the rotating frame" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:lines_n a owl:DatatypeProperty ;
    rdfs:label "lines_n" ;
    skos:definition "Number of pixel lines in the vertical direction" ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_type "static" .

fyo:lines_of_sight_rho_tor_norm a owl:ObjectProperty ;
    rdfs:label "lines_of_sight_rho_tor_norm" ;
    skos:definition "Shortest distance in rho_tor_norm between lines of sight and magnetic axis, signed with following convention : positive (resp. negative) means the point of shortest distance is above (resp. below) the magnetic axis" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "../lines_of_sight_second_point/r" ;
    fyo:dd_units "1" .

fyo:lines_of_sight_second_point a owl:ObjectProperty ;
    rdfs:label "lines_of_sight_second_point" ;
    skos:definition "For each profile point, a line of sight is defined by a first point given by the centre of the crystal and a second point described here." ;
    skos:inScheme fyo:spectrometer_x_ray_crystal .

fyo:lorentz_shift a owl:ObjectProperty ;
    rdfs:label "lorentz_shift" ;
    skos:definition "Lorentz shift due to the Lorentz electric field (vxB) in the frame of the diagnostic neutral beam particles moving with a velocity v across the magnetic field B" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_units "m" .

fyo:m_pol_dominant a owl:DatatypeProperty ;
    rdfs:label "m_pol_dominant" ;
    skos:definition "Dominant poloidal mode number defining the mode rational surface; for TAEs the lower of the two main m's has to be specified" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:mach_number_parallel a owl:ObjectProperty ;
    rdfs:label "mach_number_parallel" ;
    skos:definition "Parallel Mach number" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "1" .

fyo:machine a owl:DatatypeProperty ;
    rdfs:label "machine" ;
    skos:definition "Name of the experimental device to which this data is related (if relevant)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:magnetic_axis_r a owl:ObjectProperty ;
    rdfs:label "magnetic_axis_r" ;
    skos:definition "R position of the magnetic axis" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:magnetic_axis_z a owl:ObjectProperty ;
    rdfs:label "magnetic_axis_z" ;
    skos:definition "Z position of the magnetic axis" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:magnetic_shear_flag a owl:ObjectProperty ;
    rdfs:label "magnetic_shear_flag" ;
    skos:definition "Magnetic field shear indicator for stellarators: 0 for shearless stellarators (W7-A, W7-AS, W7-X); 1, otherwise. See [Stroth U. et al 1996 Nucl. Fusion 36 1063]" ;
    skos:inScheme fyo:summary .

fyo:magnetic_shear_r_minor a owl:DatatypeProperty ;
    rdfs:label "magnetic_shear_r_minor" ;
    skos:definition "Magnetic shear, defined as r_minor_norm/q . dq/dr_minor_norm (different definition from the equilibrium IDS)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:mass a owl:DatatypeProperty ;
    rdfs:label "mass" ;
    skos:definition "Mass of the participant" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" ;
    fyo:dd_units "u" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:mass_density_perturbed a owl:ObjectProperty ;
    rdfs:label "mass_density_perturbed" ;
    skos:definition "Perturbed mass density for given toroidal mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "kg.m^-3" .

fyo:mass_norm a owl:DatatypeProperty ;
    rdfs:label "mass_norm" ;
    skos:definition "normalized mass" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:material_properties a owl:ObjectProperty ;
    rdfs:label "material_properties" ;
    skos:definition "Material properties of the optical element" ;
    skos:inScheme fyo:common .

fyo:measured_quantity a owl:ObjectProperty ;
    rdfs:label "measured_quantity" ;
    skos:definition "Quantity measured by the sensor" ;
    skos:inScheme fyo:magnetics .

fyo:meff_hydrogenic a owl:ObjectProperty ;
    rdfs:label "meff_hydrogenic" ;
    skos:definition "Effective mass of the hydrogenic species (MH. nH+MD.nD+MT.nT)/(nH+nD+nT)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "u" .

fyo:mesh_type a owl:ObjectProperty ;
    rdfs:label "mesh_type" ;
    skos:definition "Crystal mesh type" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal .

fyo:metastable_label a owl:DatatypeProperty ;
    rdfs:label "metastable_label" ;
    skos:definition "Label identifying in text form the metastable" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:method_name a owl:DatatypeProperty ;
    rdfs:label "method_name" ;
    skos:definition "Name of the calculation method" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" .

fyo:mirror_index a owl:DatatypeProperty ;
    rdfs:label "mirror_index" ;
    skos:definition "Index of the mirror (in the mirror array of structure) on which this beam has been reflected" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "constant" .

fyo:misfit_report a owl:ObjectProperty ;
    rdfs:label "misfit_report" ;
    skos:definition "OUTPUT — the residual / uncertainty report of the inference (per-channel misfit, posterior spreads when a Bayesian engine is used)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:io "output" .

fyo:mitigation_valve a owl:ObjectProperty ;
    rdfs:label "mitigation_valve" ;
    skos:definition "Flag indicating whether any disruption mitigation valve has been used (1) or none (0)" ;
    skos:inScheme fyo:summary .

fyo:mobile a owl:ObjectProperty ;
    rdfs:label "mobile" ;
    skos:definition "In case of mobile plasma facing components, use the time-dependent description below this node to provide the full outline of the closest PFC surfaces to the plasma. Even in such a case, the 'limiter' structure is still used to provide the outermost limiting surface (can be used e.g. to define the boundary of the mesh of equilibrium reconstruction codes)" ;
    skos:inScheme fyo:wall .

fyo:model_name a owl:DatatypeProperty ;
    rdfs:label "model_name" ;
    skos:definition "Name of the antenna model used for antenna spectrum computation" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_type "constant" .

fyo:model_type a owl:ObjectProperty ;
    rdfs:label "model_type" ;
    skos:definition "Type of model used to populate this IDS" ;
    skos:inScheme fyo:mhd_linear .

fyo:modules_n a owl:DatatypeProperty ;
    rdfs:label "modules_n" ;
    skos:definition "Total number of blanket modules" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" .

fyo:modules_pol_n a owl:DatatypeProperty ;
    rdfs:label "modules_pol_n" ;
    skos:definition "Number of blanket modules in a poloidal cross section" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" .

fyo:molecules_n a owl:DatatypeProperty ;
    rdfs:label "molecules_n" ;
    skos:definition "Number of molecules of the propellant gas injected in the vacuum vessel when launching the pellet" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:moments_norm_gyrocenter a owl:ObjectProperty ;
    rdfs:label "moments_norm_gyrocenter" ;
    skos:definition "Moments (normalized) of the perturbed distribution function of gyrocenters" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:moments_norm_gyrocenter_bessel_0 a owl:ObjectProperty ;
    rdfs:label "moments_norm_gyrocenter_bessel_0" ;
    skos:definition "Moments (normalized) of the perturbed distribution function of gyrocenters times 0th order Bessel function of the first kind" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:moments_norm_gyrocenter_bessel_1 a owl:ObjectProperty ;
    rdfs:label "moments_norm_gyrocenter_bessel_1" ;
    skos:definition "Moments (normalized) of the perturbed distribution function of gyrocenters times 1st order Bessel function of the first kind" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:moments_norm_particle a owl:ObjectProperty ;
    rdfs:label "moments_norm_particle" ;
    skos:definition "Moments (normalized) of the perturbed distribution function of particles" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:momentum_critical_avalanche_definition a owl:ObjectProperty ;
    rdfs:label "momentum_critical_avalanche_definition" ;
    skos:definition "Definition chosen for the critical momentum for avalanche, Compton and tritium (in global_quantities, profiles_1d and ggd)" ;
    skos:inScheme fyo:runaway_electrons .

fyo:momentum_critical_hot_tail_definition a owl:ObjectProperty ;
    rdfs:label "momentum_critical_hot_tail_definition" ;
    skos:definition "Definition chosen for the critical momentum for hot tail (in global_quantities, profiles_1d and ggd)" ;
    skos:inScheme fyo:runaway_electrons .

fyo:momentum_phi_method a owl:ObjectProperty ;
    rdfs:label "momentum_phi_method" ;
    skos:definition "Description of the method used to reconstruct the total plasma toroidal momentum" ;
    skos:inScheme fyo:charge_exchange .

fyo:moving_mode a owl:ObjectProperty ;
    rdfs:label "moving_mode" ;
    skos:definition "Moving mode of the line of sight. Index = 0 : no movement, fixed position. Index = 1 : oscillating" ;
    skos:inScheme fyo:spectrometer_uv .

fyo:mtanh a owl:ObjectProperty ;
    rdfs:label "mtanh" ;
    skos:definition "Quantities related to \"mtanh\" fit" ;
    skos:inScheme fyo:summary .

fyo:multiplicity a owl:DatatypeProperty ;
    rdfs:label "multiplicity" ;
    skos:definition "Multiplicity in the reaction" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:n_e_decay_length a owl:ObjectProperty ;
    rdfs:label "n_e_decay_length" ;
    skos:definition "Electron density radial decay length inv(grad ne/ne)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:n_e_line_average a owl:ObjectProperty ;
    rdfs:label "n_e_line_average" ;
    skos:definition "Line average density inferred from interferometer measurements. Corresponds to the density integrated along the full line-of-sight and then divided by the length of the line-of-sight" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_units "m^-3" .

fyo:n_e_line_lcfs a owl:ObjectProperty ;
    rdfs:label "n_e_line_lcfs" ;
    skos:definition "Line integrated electron density over a line of sight within the LCFS" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "m^-2" .

fyo:n_e_line_of_sight a owl:ObjectProperty ;
    rdfs:label "n_e_line_of_sight" ;
    skos:definition "Description of the line of sight for calculating n_e, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
    skos:inScheme fyo:pulse_schedule .

fyo:n_e_profile_approximation a owl:ObjectProperty ;
    rdfs:label "n_e_profile_approximation" ;
    skos:definition "Approximation of the radial electron density profile with an array of parameters and an approximation formula, used by post-processing programs for the identification of the electron density profile." ;
    skos:inScheme fyo:refractometer .

fyo:n_e_profile_average a owl:ObjectProperty ;
    rdfs:label "n_e_profile_average" ;
    skos:definition "Integral of a 1D core profile over rho_tor_norm up to the LCFS" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "m^-3" .

fyo:n_e_target a owl:DatatypeProperty ;
    rdfs:label "n_e_target" ;
    skos:definition "Electron density at divertor target" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-3" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:n_h_over_n_d a owl:ObjectProperty ;
    rdfs:label "n_h_over_n_d" ;
    skos:definition "Average ratio of hydrogen over deuterium density" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:n_i_over_n_e a owl:ObjectProperty ;
    rdfs:label "n_i_over_n_e" ;
    skos:definition "Ion concentration (ratio of the ion density over the electron density) at the channel measurement point" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_units "1" .

fyo:n_i_over_n_e_method a owl:ObjectProperty ;
    rdfs:label "n_i_over_n_e_method" ;
    skos:definition "Description of the method used to derive the ion concentration" ;
    skos:inScheme fyo:charge_exchange .

fyo:n_i_total_decay_length a owl:ObjectProperty ;
    rdfs:label "n_i_total_decay_length" ;
    skos:definition "Ion density radial decay length inv(grad ni/ni)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:n_parallel_peak a owl:ObjectProperty ;
    rdfs:label "n_parallel_peak" ;
    skos:definition "Peak parallel refractive index of the launched wave spectrum (simple estimate based on the measured phase difference)" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_units "1" .

fyo:n_t_over_n_d a owl:ObjectProperty ;
    rdfs:label "n_t_over_n_d" ;
    skos:definition "Average ratio of tritium over deuterium density" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:nanoseconds a owl:DatatypeProperty ;
    rdfs:label "nanoseconds" ;
    skos:definition "Elapsed nanoseconds since Unix Epoch time in seconds" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:nbi_beamlets_group a owl:DatatypeProperty ;
    rdfs:label "nbi_beamlets_group" ;
    skos:definition "Index of the NBI beamlets group considered. Refers to the \"unit/beamlets_group\" array of the NBI IDS. 0 means sum over all beamlets groups." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:nbi_energy a owl:ObjectProperty ;
    rdfs:label "nbi_energy" ;
    skos:definition "For NBI source, energy of the accelerated species considered. index = 0 for a sum over all energies; index = 1 for full energiy; index = 2 for half energy; index = 3 for third energy" ;
    skos:inScheme fyo:common .

fyo:nbi_unit a owl:DatatypeProperty ;
    rdfs:label "nbi_unit" ;
    skos:definition "Index of the NBI unit considered. Refers to the \"unit\" array of the NBI IDS. 0 means sum over all NBI units." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:neutron_fast_flux_inboard a owl:ObjectProperty ;
    rdfs:label "neutron_fast_flux_inboard" ;
    skos:definition "Fast neutron flux arriving on the inboard side of this coil" ;
    skos:inScheme fyo:common ;
    fyo:dd_units "m^-2.s^-1" .

fyo:neutron_power_total a owl:ObjectProperty ;
    rdfs:label "neutron_power_total" ;
    skos:definition "Total neutron power (from all reactions). Sum over each type of reaction (DD, DT, TT for thermal, beam-plasma, beam-beam, etc.) of the neutron production rate times the average neutron birth energy" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:neutron_rates a owl:ObjectProperty ;
    rdfs:label "neutron_rates" ;
    skos:definition "Neutron rates from various reactions" ;
    skos:inScheme fyo:summary .

fyo:noise a owl:DatatypeProperty ;
    rdfs:label "noise" ;
    skos:definition "Detector noise (e.g. read-out noise) (rms counts per second exposure time)" ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:non_linear a owl:ObjectProperty ;
    rdfs:label "non_linear" ;
    skos:definition "Non-linear simulation" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:non_linear_response a owl:ObjectProperty ;
    rdfs:label "non_linear_response" ;
    skos:definition "Non-linear response of the probe (typically in case of a Hall probe)" ;
    skos:inScheme fyo:magnetics .

fyo:nonlinear_model a owl:DatatypeProperty ;
    rdfs:label "nonlinear_model" ;
    skos:definition "Description of the nonlinear transfer function of the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" .

fyo:normal_vector a owl:ObjectProperty ;
    rdfs:label "normal_vector" ;
    skos:definition "Components of the normal vector to the surface, given on each point of the surface" ;
    skos:inScheme fyo:b_field_non_axisymmetric .

fyo:normalizing_quantities a owl:ObjectProperty ;
    rdfs:label "normalizing_quantities" ;
    skos:definition "Physical quantities used for normalization (useful to link to the original simulation/experience)" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:ntv a owl:ObjectProperty ;
    rdfs:label "ntv" ;
    skos:definition "Neoclassical toroidal viscosity tensor" ;
    skos:inScheme fyo:mhd_linear .

fyo:nuclei_n a owl:DatatypeProperty ;
    rdfs:label "nuclei_n" ;
    skos:definition "Number of target nuclei in the dectector" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" .

fyo:object_observed a owl:DatatypeProperty ;
    rdfs:label "object_observed" ;
    skos:definition "Main object observed by the channel" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_type "static" .

fyo:objectives a owl:ObjectProperty ;
    rdfs:label "objectives" ;
    skos:definition "INPUT — the optimization objectives / figures of merit (target operating point, performance measures, margins) candidates are ranked by." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:io "input" .

fyo:oblique a owl:ObjectProperty ;
    rdfs:label "oblique" ;
    skos:definition "Parallelogram description of the element" ;
    skos:inScheme fyo:common .

fyo:occurrence_type a owl:ObjectProperty ;
    rdfs:label "occurrence_type" ;
    skos:definition "Type of data contained in this occurrence" ;
    skos:inScheme fyo:common .

fyo:onset a owl:ObjectProperty ;
    rdfs:label "onset" ;
    skos:definition "NTM onset characteristics" ;
    skos:inScheme fyo:ntms .

fyo:open_fraction a owl:DatatypeProperty ;
    rdfs:label "open_fraction" ;
    skos:definition "Fraction of open field lines : ratio open fields lines / (open+closed field lines)" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:optical_depth a owl:ObjectProperty ;
    rdfs:label "optical_depth" ;
    skos:definition "Optical depth of the plasma at the position of the measurement. This parameter is a proxy for the local / non-local character of the ECE emission. It must be greater than 1 to guarantee that the measurement is dominated by local ECE emission (non-local otherwise)" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "1" .

fyo:optical_pellet_diagnostic a owl:ObjectProperty ;
    rdfs:label "optical_pellet_diagnostic" ;
    skos:definition "Information related to the embedded optical pellet diagnostic" ;
    skos:inScheme fyo:spi .

fyo:orbit a owl:ObjectProperty ;
    rdfs:label "orbit" ;
    skos:definition "Orbit description of the particle at this position in phase space. First dimension is the element index. Second dimension is the time along the orbit. Third dimension contains the particle phase space coordinates." ;
    skos:inScheme fyo:distributions ;
    fyo:dd_units "mixed" .

fyo:orbit_frequency_pol a owl:ObjectProperty ;
    rdfs:label "orbit_frequency_pol" ;
    skos:definition "Poloidal orbit frequency (transit or bounce) at the grid location (in phase space)" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_units "rad.s^-1" .

fyo:orbit_frequency_tor a owl:ObjectProperty ;
    rdfs:label "orbit_frequency_tor" ;
    skos:definition "Toroidal orbit frequency (transit or precession) at the grid location (in phase space)" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_units "rad.s^-1" .

fyo:orbit_integrals a owl:ObjectProperty ;
    rdfs:label "orbit_integrals" ;
    skos:definition "Integrals along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral (f(n_tor,m_pol,k,eq,...) dt) from time - tau to time, where tau is the transit/trapping time of the marker and f() a dimensionless function (phase factor,drift,etc) of the equilibrium (e.g. q) and perturbation (Fourier harmonics n_tor,m_pol and bounce harmonic k) along the particles orbits. In fact the integrals are taken during the last orbit of each marker at the time value of the time node below" ;
    skos:inScheme fyo:common .

fyo:orbit_integrals_instant a owl:ObjectProperty ;
    rdfs:label "orbit_integrals_instant" ;
    skos:definition "Integrals/quantities along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral ( f(eq) dt) from time - tau to time_orbit for different values of time_orbit in the interval from time - tau to time, where tau is the transit/trapping time of the marker and f(eq) a dimensionless function (phase, drift,q,etc) of the equilibrium along the markers orbits. The integrals are taken during the last orbit of each marker at the time value of the time node below" ;
    skos:inScheme fyo:common .

fyo:orbit_type a owl:ObjectProperty ;
    rdfs:label "orbit_type" ;
    skos:definition "Orbit type identifier" ;
    skos:inScheme fyo:distributions .

fyo:origin a owl:ObjectProperty ;
    rdfs:label "origin" ;
    skos:definition "Coordinates of the origin of the shatter cone" ;
    skos:inScheme fyo:spi .

fyo:outline_inner a owl:ObjectProperty ;
    rdfs:label "outline_inner" ;
    skos:definition "Inner vessel outline. Repeat the first point in case of a closed contour" ;
    skos:inScheme fyo:common .

fyo:outline_outer a owl:ObjectProperty ;
    rdfs:label "outline_outer" ;
    skos:definition "Outer vessel outline. Repeat the first point in case of a closed contour" ;
    skos:inScheme fyo:common .

fyo:output_voltage a owl:ObjectProperty ;
    rdfs:label "output_voltage" ;
    skos:definition "Raw voltage output of the whole acquisition chain" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_units "V" .

fyo:p a owl:ObjectProperty ;
    rdfs:label "p" ;
    skos:definition "Proportional term" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "../../output_names" ;
    fyo:dd_coordinate2 "../../input_names" ;
    fyo:dd_coordinate3 "time" ;
    fyo:dd_units "mixed" .

fyo:particle_flux_recycled_total a owl:ObjectProperty ;
    rdfs:label "particle_flux_recycled_total" ;
    skos:definition "Total recycled particle flux from  the divertor (in equivalent electrons)" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_units "s^-1" .

fyo:particle_fluxes a owl:ObjectProperty ;
    rdfs:label "particle_fluxes" ;
    skos:definition "Particle fluxes. The incident and emitted components are distinguished. The net flux received by the wall is equal to incident - emitted" ;
    skos:inScheme fyo:wall .

fyo:particles_fast_n a owl:DatatypeProperty ;
    rdfs:label "particles_fast_n" ;
    skos:definition "Number of fast particles in the distribution, i.e. the volume integral of the density (note: this is the number of real particles and not markers)" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:particles_fraction a owl:DatatypeProperty ;
    rdfs:label "particles_fraction" ;
    skos:definition "Fraction of injected particles in the component" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:particles_n a owl:DatatypeProperty ;
    rdfs:label "particles_n" ;
    skos:definition "Number of particles in the distribution, i.e. the volume integral of the density (note: this is the number of real particles and not markers)" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:path_geometry a owl:ObjectProperty ;
    rdfs:label "path_geometry" ;
    skos:definition "Geometry of the pellet path in the vaccuum chamber" ;
    skos:inScheme fyo:pellets .

fyo:path_length_variation a owl:ObjectProperty ;
    rdfs:label "path_length_variation" ;
    skos:definition "Optical path length variation due to the plasma" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_units "m" .

fyo:path_profiles a owl:ObjectProperty ;
    rdfs:label "path_profiles" ;
    skos:definition "1-D profiles of plasma and pellet along the pellet path" ;
    skos:inScheme fyo:pellets .

fyo:pb_li_volume a owl:DatatypeProperty ;
    rdfs:label "pb_li_volume" ;
    skos:definition "Volume of PbLi contained in the blanket" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^3" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:pedestal a owl:ObjectProperty ;
    rdfs:label "pedestal" ;
    skos:definition "Parameters at pedestal top" ;
    skos:inScheme fyo:summary .

fyo:pedestal_fits a owl:ObjectProperty ;
    rdfs:label "pedestal_fits" ;
    skos:definition "Quantities derived from specific fits of pedestal profiles, typically used in the Pedestal Database." ;
    skos:inScheme fyo:summary .

fyo:period a owl:DatatypeProperty ;
    rdfs:label "period" ;
    skos:definition "Period of the line of sight oscillation (in case moving_mode/index = 1)" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_type "static" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:perturbation_type a owl:ObjectProperty ;
    rdfs:label "perturbation_type" ;
    skos:definition "Type of the perturbation" ;
    skos:inScheme fyo:mhd_linear .

fyo:phase_average a owl:ObjectProperty ;
    rdfs:label "phase_average" ;
    skos:definition "Phase difference between two neighbouring modules (average over modules), at the mouth (front) of the antenna" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_units "rad" .

fyo:phase_corrected a owl:ObjectProperty ;
    rdfs:label "phase_corrected" ;
    skos:definition "Phase measured for this wavelength, corrected from fringe jumps" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_units "rad" .

fyo:phase_forward a owl:ObjectProperty ;
    rdfs:label "phase_forward" ;
    skos:definition "Phase of the forward power with respect to the first module" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_units "rad" .

fyo:phase_quadrature a owl:ObjectProperty ;
    rdfs:label "phase_quadrature" ;
    skos:definition "In-phase and Quadrature components of the analysed signal. They are returned by an IQ-detector, that takes carrying and reference signals as the input and yields I and Q components. These are respectively stored as the first and the second index of the first dimension of the data child." ;
    skos:inScheme fyo:refractometer ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_coordinate2 "time" ;
    fyo:dd_units "V" .

fyo:phase_reflected a owl:ObjectProperty ;
    rdfs:label "phase_reflected" ;
    skos:definition "Phase of the reflected power with respect to the forward power of this module" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_units "rad" .

fyo:phase_to_n_e_line a owl:DatatypeProperty ;
    rdfs:label "phase_to_n_e_line" ;
    skos:definition "Conversion factor to be used to convert phase into line density for this wavelength" ;
    skos:inScheme fyo:interferometer ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^-2.rad^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:phi_poloidal_current a owl:DatatypeProperty ;
    rdfs:label "phi_poloidal_current" ;
    skos:definition "Toroidal flux at the selected plasma boundary generated by the plasma poloidal current" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:phi_potential_perturbed a owl:ObjectProperty ;
    rdfs:label "phi_potential_perturbed" ;
    skos:definition "Perturbed electrostatic potential for given toroidal mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "V" .

fyo:photoelectric_voltage a owl:ObjectProperty ;
    rdfs:label "photoelectric_voltage" ;
    skos:definition "Gain corrected and background subtracted voltage" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_units "V" .

fyo:photon_count a owl:ObjectProperty ;
    rdfs:label "photon_count" ;
    skos:definition "Detected photon count" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_units "s^-1" .

fyo:pid a owl:ObjectProperty ;
    rdfs:label "pid" ;
    skos:definition "Filtered PID controller" ;
    skos:inScheme fyo:controllers .

fyo:pinhole a owl:ObjectProperty ;
    rdfs:label "pinhole" ;
    skos:definition "Pinhole position in the (X,Y,Z) coordinate system" ;
    skos:inScheme fyo:camera_ir .

fyo:pixel_position a owl:ObjectProperty ;
    rdfs:label "pixel_position" ;
    skos:definition "Position of the centre of each pixel. First dimension : line index (x1 axis). Second dimension: column index (x2 axis)." ;
    skos:inScheme fyo:common .

fyo:pixel_size a owl:DatatypeProperty ;
    rdfs:label "pixel_size" ;
    skos:definition "Sensor pixel size (square pixel assumed)" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:pixels_n_horizontal a owl:DatatypeProperty ;
    rdfs:label "pixels_n_horizontal" ;
    skos:definition "Number of pixels in the horizontal direction (of the detector)" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "static" .

fyo:pixels_n_vertical a owl:DatatypeProperty ;
    rdfs:label "pixels_n_vertical" ;
    skos:definition "Number of pixels in the vertical direction (of the detector)" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "static" .

fyo:plasma a owl:ObjectProperty ;
    rdfs:label "plasma" ;
    skos:definition "MHD modes in the confined plasma" ;
    skos:inScheme fyo:mhd_linear .

fyo:plasma_duration a owl:ObjectProperty ;
    rdfs:label "plasma_duration" ;
    skos:definition "Duration of existence of a confined plasma during the pulse" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:plasma_inductance a owl:DatatypeProperty ;
    rdfs:label "plasma_inductance" ;
    skos:definition "Plasma inductance 2 E_magnetic/Ip^2, where E_magnetic = 1/2 * int(psi.j_tor.dS) (integral over the plasma poloidal cross-section)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "H" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:plasma_resistance a owl:DatatypeProperty ;
    rdfs:label "plasma_resistance" ;
    skos:definition "Plasma resistance = int(e_field.j.dV) / Ip^2" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "ohm" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:plateau_factor a owl:ObjectProperty ;
    rdfs:label "plateau_factor" ;
    skos:definition "Plateau factor, as defined in equation (25) of reference [Stroth U. et al 1998 Plasma Phys. Control. Fusion 40 1551]" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:plugins a owl:ObjectProperty ;
    rdfs:label "plugins" ;
    skos:definition "Information about the plugins used to write/read this IDS. This structure is filled automatically by the Access Layer at GET/PUT time, no need to fill it via a user program." ;
    skos:inScheme fyo:common .

fyo:polarization_initial a owl:DatatypeProperty ;
    rdfs:label "polarization_initial" ;
    skos:definition "Initial polarization vector before entering the plasma" ;
    skos:inScheme fyo:polarimeter ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:polarization_spectroscopy a owl:ObjectProperty ;
    rdfs:label "polarization_spectroscopy" ;
    skos:definition "Physics quantities measured from polarized light spectroscopy" ;
    skos:inScheme fyo:spectrometer_visible .

fyo:polarizer_active a owl:DatatypeProperty ;
    rdfs:label "polarizer_active" ;
    skos:definition "Indicator of whether a polarizer is present and active in the optical system (set to 1 in this case, set to 0 or leave empty ottherwise)" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_type "static" .

fyo:poloidal_angle a owl:DatatypeProperty ;
    rdfs:label "poloidal_angle" ;
    skos:definition "Angle of the sensor normal vector (vector parallel to the the axis of the coil, n on the diagram) with respect to horizontal plane (clockwise theta-like angle). Zero if sensor normal vector fully in the horizontal plane and oriented towards increasing major radius. Values in [0 , 2Pi]" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:poloidal_turns a owl:DatatypeProperty ;
    rdfs:label "poloidal_turns" ;
    skos:definition "Number of poloidal turns considered in the flux-tube simulation" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:polychromator_index a owl:DatatypeProperty ;
    rdfs:label "polychromator_index" ;
    skos:definition "Index of the polychromator used by this channel (refers to the ../../polychromator array)" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_type "static" .

fyo:port_name a owl:DatatypeProperty ;
    rdfs:label "port_name" ;
    skos:definition "The engineering port bound (e.g. neutronics; later tritium / heat-and-net-electric / system-code)." ;
    skos:inScheme fyo:scenario .

fyo:position_average a owl:ObjectProperty ;
    rdfs:label "position_average" ;
    skos:definition "Average position of the measurements derived from multiple collectors" ;
    skos:inScheme fyo:langmuir_probes .

fyo:position_control a owl:ObjectProperty ;
    rdfs:label "position_control" ;
    skos:definition "Plasma position and shape control references" ;
    skos:inScheme fyo:pulse_schedule .

fyo:position_measured a owl:ObjectProperty ;
    rdfs:label "position_measured" ;
    skos:definition "Measured or estimated position" ;
    skos:inScheme fyo:equilibrium .

fyo:position_parameter a owl:ObjectProperty ;
    rdfs:label "position_parameter" ;
    skos:definition "In case of line of sight moving during a pulse, position parameter allowing to record and compute the line of sight position as a function of time" ;
    skos:inScheme fyo:spectrometer_uv ;
    fyo:dd_units "mixed" .

fyo:position_per_laser a owl:ObjectProperty ;
    rdfs:label "position_per_laser" ;
    skos:definition "Position of the intersection between each laser beam and this line of sight" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "../../laser" .

fyo:position_reconstructed a owl:ObjectProperty ;
    rdfs:label "position_reconstructed" ;
    skos:definition "Position estimated from the reconstructed equilibrium" ;
    skos:inScheme fyo:equilibrium .

fyo:power_additional a owl:ObjectProperty ;
    rdfs:label "power_additional" ;
    skos:definition "Total additional external power (NBI+EC+IC+LH, without ohmic) coupled to the plasma" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_bremsstrahlung a owl:ObjectProperty ;
    rdfs:label "power_bremsstrahlung" ;
    skos:definition "Radiated power from Bremsstrahlung" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_charge_exchange a owl:DatatypeProperty ;
    rdfs:label "power_charge_exchange" ;
    skos:definition "Power loss due to Charge Exchange loss of fast ions" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_cycle_type a owl:ObjectProperty ;
    rdfs:label "power_cycle_type" ;
    skos:definition "Type of the primary power cycle" ;
    skos:inScheme fyo:balance_of_plant .

fyo:power_ec a owl:ObjectProperty ;
    rdfs:label "power_ec" ;
    skos:definition "Total EC power coupled to the plasma" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_electric_plant_operation a owl:ObjectProperty ;
    rdfs:label "power_electric_plant_operation" ;
    skos:definition "Electric plant operation" ;
    skos:inScheme fyo:balance_of_plant .

fyo:power_electrons a owl:DatatypeProperty ;
    rdfs:label "power_electrons" ;
    skos:definition "Power emitted by electrons" ;
    skos:inScheme fyo:radiation ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_first_orbit a owl:DatatypeProperty ;
    rdfs:label "power_first_orbit" ;
    skos:definition "Power loss due to first orbit losses" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_ic a owl:ObjectProperty ;
    rdfs:label "power_ic" ;
    skos:definition "Total IC power coupled to the plasma" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_incident_fraction a owl:ObjectProperty ;
    rdfs:label "power_incident_fraction" ;
    skos:definition "Power fraction incident on the target (normalized to the total power incident on the divertor)" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_units "1" .

fyo:power_incident_neutron a owl:DatatypeProperty ;
    rdfs:label "power_incident_neutron" ;
    skos:definition "Total incident neutron power on the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_incident_radiated a owl:DatatypeProperty ;
    rdfs:label "power_incident_radiated" ;
    skos:definition "Total incident radiative power on the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_launched_ec a owl:ObjectProperty ;
    rdfs:label "power_launched_ec" ;
    skos:definition "Total EC power launched from EC launchers into the vacuum vessel" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_launched_ic a owl:ObjectProperty ;
    rdfs:label "power_launched_ic" ;
    skos:definition "Total IC power launched from IC antennas into the vacuum vessel" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_launched_lh a owl:ObjectProperty ;
    rdfs:label "power_launched_lh" ;
    skos:definition "Total LH power launched from LH antennas into the vacuum vessel" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_launched_nbi a owl:ObjectProperty ;
    rdfs:label "power_launched_nbi" ;
    skos:definition "Total NBI power launched from neutral beam injectors into the vacuum vessel" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_launched_nbi_co_injected_ratio a owl:ObjectProperty ;
    rdfs:label "power_launched_nbi_co_injected_ratio" ;
    skos:definition "Ratio of co-injected beam launched power to total NBI launched power. Is set to 1 for purely perpendicular injection" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:power_lh a owl:ObjectProperty ;
    rdfs:label "power_lh" ;
    skos:definition "Total LH power coupled to the plasma" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_line a owl:ObjectProperty ;
    rdfs:label "power_line" ;
    skos:definition "Radiated power from line radiation" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_loss a owl:ObjectProperty ;
    rdfs:label "power_loss" ;
    skos:definition "Power through separatrix" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_nbi a owl:ObjectProperty ;
    rdfs:label "power_nbi" ;
    skos:definition "Total NBI power coupled to the plasma" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_neutral_total a owl:DatatypeProperty ;
    rdfs:label "power_neutral_total" ;
    skos:definition "Total power emitted by all neutral species" ;
    skos:inScheme fyo:radiation ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_nuclear_blanket a owl:DatatypeProperty ;
    rdfs:label "power_nuclear_blanket" ;
    skos:definition "Nuclear heating power on the blanket" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_nuclear_shields a owl:DatatypeProperty ;
    rdfs:label "power_nuclear_shields" ;
    skos:definition "Nuclear heating power on the shields" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_plant a owl:ObjectProperty ;
    rdfs:label "power_plant" ;
    skos:definition "Energy conversion" ;
    skos:inScheme fyo:balance_of_plant .

fyo:power_radiated_outside_lcfs a owl:ObjectProperty ;
    rdfs:label "power_radiated_outside_lcfs" ;
    skos:definition "Radiated power from the plasma outside the Last Closed Flux Surface" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_rotation a owl:DatatypeProperty ;
    rdfs:label "power_rotation" ;
    skos:definition "Power going to plasma rotation. This power goes into sustaining the plasma rotation rather than heating the plasma. This is given because the injection energy in the rotating plasma frame is (assuming rotation in the same direction of the NB injection) lower than in the lab-frame." ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_steady a owl:ObjectProperty ;
    rdfs:label "power_steady" ;
    skos:definition "Total power coupled to the plasma minus dW/dt (correcting from transient energy content)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_synchrotron a owl:ObjectProperty ;
    rdfs:label "power_synchrotron" ;
    skos:definition "Radiated power from synchrotron radiation" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "W" .

fyo:power_thermal_extracted a owl:DatatypeProperty ;
    rdfs:label "power_thermal_extracted" ;
    skos:definition "Total thermal power that is extracted from the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_thermal_neutrons a owl:DatatypeProperty ;
    rdfs:label "power_thermal_neutrons" ;
    skos:definition "Total neutron power (deposited + generated) in the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:power_thermal_radiated a owl:DatatypeProperty ;
    rdfs:label "power_thermal_radiated" ;
    skos:definition "Total radiated power (incident - reflected) in the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:predicted_equilibrium a owl:ObjectProperty ;
    rdfs:label "predicted_equilibrium" ;
    skos:definition "OUTPUT — the predicted Grad–Shafranov equilibrium (flux map, boundary, global quantities), written back by the equilibrium solves; modality simulated." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "equilibrium" ;
    fyo:io "output" .

fyo:predicted_profiles a owl:ObjectProperty ;
    rdfs:label "predicted_profiles" ;
    skos:definition "OUTPUT — the predicted core plasma profiles at convergence / over time; modality simulated." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "core_profiles" ;
    fyo:io "output" .

fyo:predicted_sources a owl:ObjectProperty ;
    rdfs:label "predicted_sources" ;
    skos:definition "OUTPUT — the realized source / sink profiles consistent with the converged state." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "core_sources" ;
    fyo:io "output" .

fyo:predicted_transport a owl:ObjectProperty ;
    rdfs:label "predicted_transport" ;
    skos:definition "OUTPUT — the transport coefficients used / predicted. GAP (informative): turbulence closure is analytic-only today (G-A2, QLKNN surrogate unwired)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "core_transport" ;
    fyo:io "output" .

fyo:prescribed_waveforms a owl:ObjectProperty ;
    rdfs:label "prescribed_waveforms" ;
    skos:definition "INPUT (optional) — prescribed boundary / actuator waveforms over the simulated interval (time-dependent runs)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/physics_modeling> ;
    fyo:fyo_ids "pulse_schedule" ;
    fyo:io "input" .

fyo:pressure_gradient_norm a owl:DatatypeProperty ;
    rdfs:label "pressure_gradient_norm" ;
    skos:definition "normalized pressure gradient (derivative with respect to r_minor_norm)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:pressure_inlet a owl:DatatypeProperty ;
    rdfs:label "pressure_inlet" ;
    skos:definition "Inlet coolant pressure" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:pressure_neutral a owl:ObjectProperty ;
    rdfs:label "pressure_neutral" ;
    skos:definition "Neutral pressure in the SOL" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "Pa" .

fyo:pressure_perturbed a owl:ObjectProperty ;
    rdfs:label "pressure_perturbed" ;
    skos:definition "Perturbed pressure for given toroidal mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "Pa" .

fyo:pressure_tank a owl:ObjectProperty ;
    rdfs:label "pressure_tank" ;
    skos:definition "Pressure in the vacuum tank of the antenna" ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_units "Pa" .

fyo:primary_coordinate a owl:ObjectProperty ;
    rdfs:label "primary_coordinate" ;
    skos:definition "Primary coordinate system with which the transport equations are solved. For a 1D transport solver: index = 1 means rho_tor_norm; 2 = rho_tor." ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:primary_quantity a owl:ObjectProperty ;
    rdfs:label "primary_quantity" ;
    skos:definition "Profile and derivatives of the primary quantity of the transport equation" ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:process_index a owl:DatatypeProperty ;
    rdfs:label "process_index" ;
    skos:definition "Index into distribution/process" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" .

fyo:profiles_line_integrated a owl:ObjectProperty ;
    rdfs:label "profiles_line_integrated" ;
    skos:definition "Profiles proxies are given in the vertical direction of the detector. They are estimated directly from the camera, without tomographic inversion. Binning is allowed so the number of profile points may be lower than the length of z_frames. Physical quantities deduced from the measured spectra are given for each profile point. They correspond to the spectra integrated along lines of sight, defined by a first point given by the centre of the crystal and a second point (depending on the profile point) described below." ;
    skos:inScheme fyo:spectrometer_x_ray_crystal .

fyo:provenance a owl:ObjectProperty ;
    rdfs:label "provenance" ;
    skos:definition "Provenance information about this IDS" ;
    skos:inScheme fyo:common .

fyo:psi_axis a owl:DatatypeProperty ;
    rdfs:label "psi_axis" ;
    skos:definition "Poloidal flux at the magnetic axis" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:psi_potential_perturbed a owl:ObjectProperty ;
    rdfs:label "psi_potential_perturbed" ;
    skos:definition "Perturbed electromagnetic super-potential for given toroidal mode number, see ref [Antonsen/Lane Phys Fluids 23(6) 1980, formula 34], so that A_field_parallel=1/(i*2pi*frequency) (grad psi_potential)_parallel" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "V" .

fyo:pulse a owl:DatatypeProperty ;
    rdfs:label "pulse" ;
    skos:definition "Pulse number to which this data is related (if relevant)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:pulse_processing_time_begin a owl:DatatypeProperty ;
    rdfs:label "pulse_processing_time_begin" ;
    skos:definition "For experimental processed data, date and time (UTC) at which the pulse data processing started on the experiment (if relevant), expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:pulse_time_begin a owl:DatatypeProperty ;
    rdfs:label "pulse_time_begin" ;
    skos:definition "Date and time (UTC) at which the pulse started on the experiment (if relevant), expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:pulse_time_begin_epoch a owl:ObjectProperty ;
    rdfs:label "pulse_time_begin_epoch" ;
    skos:definition "Time at which the pulse started on the experiment (if relevant), expressed in Unix Epoch time represented as two integers: seconds, plus additionally elapsed nanoseconds" ;
    skos:inScheme fyo:summary .

fyo:pulse_time_end_epoch a owl:ObjectProperty ;
    rdfs:label "pulse_time_end_epoch" ;
    skos:definition "Time at which the pulse ended on the experiment (if relevant), expressed in Unix Epoch time represented as two integers: seconds, plus additionally elapsed nanoseconds" ;
    skos:inScheme fyo:summary .

fyo:q_axis a owl:DatatypeProperty ;
    rdfs:label "q_axis" ;
    skos:definition "q at the magnetic axis" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:q_min a owl:ObjectProperty ;
    rdfs:label "q_min" ;
    skos:definition "Minimum q value and position" ;
    skos:inScheme fyo:equilibrium .

fyo:quantity a owl:ObjectProperty ;
    rdfs:label "quantity" ;
    skos:definition "Physical quantity obtained following the matrix multiplication of the data node with the vector constructed from references contained in the columns_uri node" ;
    skos:inScheme fyo:em_coupling .

fyo:quasi_linear a owl:DatatypeProperty ;
    rdfs:label "quasi_linear" ;
    skos:definition "Flag = 1 if the non-linear fluxes are in fact calculated by a quasi-linear model, 0 if non-linear" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:r_eff_norm_2_3 a owl:ObjectProperty ;
    rdfs:label "r_eff_norm_2_3" ;
    skos:definition "Parameters at r_eff_norm = 2/3, where r_eff_norm is the stellarator effective minor radius normalized to its value at the last closed flux surface" ;
    skos:inScheme fyo:summary .

fyo:r_limit_max a owl:DatatypeProperty ;
    rdfs:label "r_limit_max" ;
    skos:definition "Major radius upper limit for the system" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:r_limit_min a owl:DatatypeProperty ;
    rdfs:label "r_limit_min" ;
    skos:definition "Major radius lower limit for the system" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:r_minor_norm a owl:DatatypeProperty ;
    rdfs:label "r_minor_norm" ;
    skos:definition "normalized minor radius of the flux surface of interest = 1/2 * (max(R) - min(R))/L_ref" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:radial_mode_number a owl:DatatypeProperty ;
    rdfs:label "radial_mode_number" ;
    skos:definition "Radial mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:radiance_continuum a owl:ObjectProperty ;
    rdfs:label "radiance_continuum" ;
    skos:definition "Calibrated continuum intensity  in the middle of the spectrum per unit wavelength" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_coordinate2 "time" ;
    fyo:dd_units "m^-2.s^-1.sr^-1.m^-1" .

fyo:radiance_spectral_method a owl:ObjectProperty ;
    rdfs:label "radiance_spectral_method" ;
    skos:definition "Description of the method used to reconstruct the fast ion charge exchange spectrum (e.g. what pre-defined slowing-down and source functions used)" ;
    skos:inScheme fyo:charge_exchange .

fyo:radiances a owl:ObjectProperty ;
    rdfs:label "radiances" ;
    skos:definition "Calibrated intensities of the 9 splitted lines (Stark effect due to Lorentz electric field). Note: radiances are integrated over the sightline crossing the neutral beam" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_coordinate1 "1...9" ;
    fyo:dd_coordinate2 "time" ;
    fyo:dd_units "m^-2.s^-1.sr^-1" .

fyo:radius_outer a owl:DatatypeProperty ;
    rdfs:label "radius_outer" ;
    skos:definition "Outer radius" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:ratio_tau_helium_fuel a owl:ObjectProperty ;
    rdfs:label "ratio_tau_helium_fuel" ;
    skos:definition "Ratio of Helium confinement time to fuel confinement time" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "1" .

fyo:raw_signal a owl:ObjectProperty ;
    rdfs:label "raw_signal" ;
    skos:definition "Raw data from IQ detector" ;
    skos:inScheme fyo:reflectometer_fluctuation .

fyo:reactant_energy a owl:ObjectProperty ;
    rdfs:label "reactant_energy" ;
    skos:definition "For nuclear reaction source, energy of the reactants. index = 0 for a sum over all energies; index = 1 for thermal-thermal; index = 2 for beam-beam; index = 3 for beam-thermal" ;
    skos:inScheme fyo:common .

fyo:readout_time a owl:DatatypeProperty ;
    rdfs:label "readout_time" ;
    skos:definition "Time used to read out each frame on the detector" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:realizes_scenario a owl:ObjectProperty ;
    rdfs:label "realizes_scenario" ;
    rdfs:range fyo:ScenarioSpecification ;
    skos:definition "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
    skos:inScheme fyo:scenario .

fyo:recombination a owl:ObjectProperty ;
    rdfs:label "recombination" ;
    skos:definition "Wall recombination" ;
    skos:inScheme fyo:wall .

fyo:reconstructed_emissivity a owl:ObjectProperty ;
    rdfs:label "reconstructed_emissivity" ;
    skos:definition "Reconstructed emissivity parameters and data" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:reconstructed_equilibrium a owl:ObjectProperty ;
    rdfs:label "reconstructed_equilibrium" ;
    skos:definition "OUTPUT — the reconstructed equilibrium (flux map, boundary, global quantities) best matching the measurements; modality reconstructed." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:fyo_ids "equilibrium" ;
    fyo:io "output" .

fyo:reconstructed_profiles a owl:ObjectProperty ;
    rdfs:label "reconstructed_profiles" ;
    skos:definition "OUTPUT — the reconstructed kinetic core profiles; modality reconstructed." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:fyo_ids "core_profiles" ;
    fyo:io "output" .

fyo:rectangle a owl:ObjectProperty ;
    rdfs:label "rectangle" ;
    skos:definition "Rectangular description of the element" ;
    skos:inScheme fyo:common .

fyo:recycling a owl:ObjectProperty ;
    rdfs:label "recycling" ;
    skos:definition "Fraction of incoming particles that is reflected back to the vacuum chamber" ;
    skos:inScheme fyo:wall .

fyo:reference_design a owl:ObjectProperty ;
    rdfs:label "reference_design" ;
    skos:definition "INPUT (optional) — a reference machine description the search starts from or is constrained around (retrofit / variation studies on an existing device)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:io "input" .

fyo:reference_waveforms a owl:ObjectProperty ;
    rdfs:label "reference_waveforms" ;
    skos:definition "INPUT — the reference / setpoint waveforms the controllers track (a directive PlanSpecification-natured IDS; typically the product of an S-10 design run)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:fyo_ids "pulse_schedule" ;
    fyo:io "input" .

fyo:relative_charge a owl:DatatypeProperty ;
    rdfs:label "relative_charge" ;
    skos:definition "This is a flag indicating that charges are absolute (if set to 0), relative (if 1) or irrelevant (-1); relative would be used to categorize the ionization reactions from i to i+1 for all charge states; in the case of bundles, the +1 relative indicates the next bundle" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:replaces a owl:DatatypeProperty ;
    rdfs:label "replaces" ;
    skos:definition "Persistent identifier referencing the previous version of this data" ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_type "constant" .

fyo:response_curve a owl:ObjectProperty ;
    rdfs:label "response_curve" ;
    skos:definition "Response curve of the valve, i.e. gas flow rate obtained as a function of the applied voltage." ;
    skos:inScheme fyo:gas_injection .

fyo:result a owl:ObjectProperty ;
    rdfs:label "result" ;
    skos:definition "Convergence result" ;
    skos:inScheme fyo:equilibrium .

fyo:result_label a owl:DatatypeProperty ;
    rdfs:label "result_label" ;
    skos:definition "Description of the process result (rate, cross section, sputtering yield, ...)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:result_transformation a owl:DatatypeProperty ;
    rdfs:label "result_transformation" ;
    skos:definition "Transformation of the process result. Integer flag: 0=no transformation; 1=10^; 2=exp()" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:result_units a owl:DatatypeProperty ;
    rdfs:label "result_units" ;
    skos:definition "Units of the process result" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:rho_tor_boundary a owl:DatatypeProperty ;
    rdfs:label "rho_tor_boundary" ;
    skos:definition "Toroidal flux coordinate at the selected plasma boundary" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:rights_holder a owl:DatatypeProperty ;
    rdfs:label "rights_holder" ;
    skos:definition "The organization owning or managing rights over this data" ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_type "constant" .

fyo:rise_time a owl:DatatypeProperty ;
    rdfs:label "rise_time" ;
    skos:definition "Peak rise time" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:rmps a owl:ObjectProperty ;
    rdfs:label "rmps" ;
    skos:definition "Resonant magnetic perturbations related quantities" ;
    skos:inScheme fyo:summary .

fyo:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    skos:definition "Identifier for the role of this paricipant in the reaction. For surface reactions distinguish between projectile and wall." ;
    skos:inScheme fyo:amns_data .

fyo:rotation_angle_max a owl:DatatypeProperty ;
    rdfs:label "rotation_angle_max" ;
    skos:definition "Maximum angular displacement with respect to the reference position, counter-clockwise around the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:rotation_angle_min a owl:DatatypeProperty ;
    rdfs:label "rotation_angle_min" ;
    skos:definition "Minimum angular displacement with respect to the reference position, counter-clockwise around the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:row_index_temperature_max a owl:DatatypeProperty ;
    rdfs:label "row_index_temperature_max" ;
    skos:definition "Row index with maximum apparent temperature" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "dynamic" .

fyo:run a owl:DatatypeProperty ;
    rdfs:label "run" ;
    skos:definition "Which run number is the active run number for this version" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:runaways a owl:ObjectProperty ;
    rdfs:label "runaways" ;
    skos:definition "Runaway electrons" ;
    skos:inScheme fyo:summary .

fyo:sampling_rate a owl:DatatypeProperty ;
    rdfs:label "sampling_rate" ;
    skos:definition "Number of samples recorded per second" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_type "static" .

fyo:scattering_length a owl:DatatypeProperty ;
    rdfs:label "scattering_length" ;
    skos:definition "Length of the light scattering volume (full width) along the laser beam path, for this line of sight (i.e. length of the intersection between the laser beam and the viewing cone). This is a time average value in case of different lasers fired at different times" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:scrape_off_layer a owl:ObjectProperty ;
    rdfs:label "scrape_off_layer" ;
    skos:definition "Scrape-Off-Layer (SOL) characteristics" ;
    skos:inScheme fyo:summary .

fyo:seconds a owl:DatatypeProperty ;
    rdfs:label "seconds" ;
    skos:definition "Elapsed seconds since the Unix Epoch time (01/01/1970 00:00:00 UTC)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" .

fyo:separatrix_average a owl:ObjectProperty ;
    rdfs:label "separatrix_average" ;
    skos:definition "Flux surface averaged parameters at separatrix (flux-surface average over the entire core-SOL boundary separatrix)" ;
    skos:inScheme fyo:summary .

fyo:shatter_cone a owl:ObjectProperty ;
    rdfs:label "shatter_cone" ;
    skos:definition "Description of the elliptic shatter cone" ;
    skos:inScheme fyo:spi .

fyo:shatter_cone_definition a owl:ObjectProperty ;
    rdfs:label "shatter_cone_definition" ;
    skos:definition "Definition of the shatter cone" ;
    skos:inScheme fyo:spi .

fyo:shattering_angle a owl:DatatypeProperty ;
    rdfs:label "shattering_angle" ;
    skos:definition "Impact (or grazing) angle of the pellet with the shattering element. It is the complementary of the incidence angle with the element surface at the shattering location" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:shattering_position a owl:ObjectProperty ;
    rdfs:label "shattering_position" ;
    skos:definition "Position where the pellet is shattered. It is defined as the intersection of the trayectory of the pellet center of mass with the shattering element" ;
    skos:inScheme fyo:spi .

fyo:shearing_rate_norm a owl:DatatypeProperty ;
    rdfs:label "shearing_rate_norm" ;
    skos:definition "normalized ExB shearing rate (for non-linear runs only)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:shell a owl:ObjectProperty ;
    rdfs:label "shell" ;
    skos:definition "Shell-layer around of the unshattered pellet" ;
    skos:inScheme fyo:spi .

fyo:shinethrough a owl:ObjectProperty ;
    rdfs:label "shinethrough" ;
    skos:definition "Shinethrough losses" ;
    skos:inScheme fyo:distribution_sources .

fyo:shot a owl:DatatypeProperty ;
    rdfs:label "shot" ;
    skos:definition "Shot number = Mass*1000+Nuclear_charge" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:shunt_index a owl:DatatypeProperty ;
    rdfs:label "shunt_index" ;
    skos:definition "If the tile carries a measurement shunt, index of that shunt (in the magnetics IDS shunt array)" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "static" .

fyo:side_wall_thickness a owl:DatatypeProperty ;
    rdfs:label "side_wall_thickness" ;
    skos:definition "Side wall thickness" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:simulation a owl:ObjectProperty ;
    rdfs:label "simulation" ;
    skos:definition "Description of the general characteristics of the simulation, if this dataset has been produced by a simulation" ;
    skos:inScheme fyo:summary .

fyo:sol_heat_spreading_length a owl:DatatypeProperty ;
    rdfs:label "sol_heat_spreading_length" ;
    skos:definition "Heat flux spreading length in SOL at equatorial mid-plane, this is the S power spreading parameter defined in reference T. Eich et al, Nucl. Fusion 53 (2013) 093031. Relevant only for attached plasmas." ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:solver a owl:ObjectProperty ;
    rdfs:label "solver" ;
    skos:definition "Solver identifier" ;
    skos:inScheme fyo:transport_solver_numerics .

fyo:spacing a owl:DatatypeProperty ;
    rdfs:label "spacing" ;
    skos:definition "Flag for specific coordinate spacing (for optimization purposes). Integer flag: 0=undefined; 1=uniform; ..." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:species_all a owl:ObjectProperty ;
    rdfs:label "species_all" ;
    skos:definition "Physical quantities common to all species" ;
    skos:inScheme fyo:gyrokinetics_local .

fyo:sphere_centre a owl:ObjectProperty ;
    rdfs:label "sphere_centre" ;
    skos:definition "Position of the center of the sphere which defines the mirror, in the case of a spherical mirror (geometry_type = 2), derived from the above geometric data" ;
    skos:inScheme fyo:common .

fyo:spun a owl:DatatypeProperty ;
    rdfs:label "spun" ;
    skos:definition "Spun period" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:spun_initial_azimuth a owl:DatatypeProperty ;
    rdfs:label "spun_initial_azimuth" ;
    skos:definition "Spun fibre initial azimuth" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    skos:definition "MHD stability analysis of the pedestal (for this fit of the profiles)" ;
    skos:inScheme fyo:summary .

fyo:start_points a owl:ObjectProperty ;
    rdfs:label "start_points" ;
    skos:definition "Position of the start point of every element" ;
    skos:inScheme fyo:common .

fyo:starting_positions a owl:ObjectProperty ;
    rdfs:label "starting_positions" ;
    skos:definition "Starting position to initiate field line tracing, for each field line" ;
    skos:inScheme fyo:plasma_initiation .

fyo:state_index a owl:DatatypeProperty ;
    rdfs:label "state_index" ;
    skos:definition "If the primary quantity is related to a particular state (of an ion or a neutral species), index of the corresponding state in the core_profiles/profiles_1d/ion (or neutral)/state array" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_type "dynamic" .

fyo:statespace a owl:ObjectProperty ;
    rdfs:label "statespace" ;
    skos:definition "Statespace controller in discrete or continuous time" ;
    skos:inScheme fyo:controllers .

fyo:stationary_phase_flag a owl:ObjectProperty ;
    rdfs:label "stationary_phase_flag" ;
    skos:definition "This flag is set to one if the pulse is in a stationary phase from the point of the of the energy content (if the time derivative of the energy dW/dt can be neglected when calculating tau_E as W/(P_abs-dW/dt).)" ;
    skos:inScheme fyo:summary .

fyo:steel_temperature_limit_max a owl:DatatypeProperty ;
    rdfs:label "steel_temperature_limit_max" ;
    skos:definition "Maximum allowed temperature for steel" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "K" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:stokes_initial a owl:ObjectProperty ;
    rdfs:label "stokes_initial" ;
    skos:definition "Initial Stokes vector at the entrance of the FOCS" ;
    skos:inScheme fyo:focs .

fyo:strain a owl:ObjectProperty ;
    rdfs:label "strain" ;
    skos:definition "Strain measured by a strain gauge" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_units "1" .

fyo:strain_rosette a owl:ObjectProperty ;
    rdfs:label "strain_rosette" ;
    skos:definition "Strain measured by a rosette strain gauge. The first dimension lists the components of the strain tensor : Sx1x1, Sx1x2, Sx2x2, where x1 is the main direction and x2 is the second direction of measurement." ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_coordinate1 "1...3" ;
    fyo:dd_units "1" .

fyo:stress_maxwell a owl:ObjectProperty ;
    rdfs:label "stress_maxwell" ;
    skos:definition "Maxwell stress tensor" ;
    skos:inScheme fyo:mhd_linear .

fyo:stress_reynolds a owl:ObjectProperty ;
    rdfs:label "stress_reynolds" ;
    skos:definition "Reynolds stress tensor" ;
    skos:inScheme fyo:mhd_linear .

fyo:strike_point_configuration a owl:ObjectProperty ;
    rdfs:label "strike_point_configuration" ;
    skos:definition "String describing the configuration of the strike points (constant, may need to become dynamic when available)" ;
    skos:inScheme fyo:summary .

fyo:strike_point_inner_r a owl:ObjectProperty ;
    rdfs:label "strike_point_inner_r" ;
    skos:definition "R position of the inner strike point" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:strike_point_inner_z a owl:ObjectProperty ;
    rdfs:label "strike_point_inner_z" ;
    skos:definition "Z position of the inner strike point" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:strike_point_outer_r a owl:ObjectProperty ;
    rdfs:label "strike_point_outer_r" ;
    skos:definition "R position of the outer strike point" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:strike_point_outer_z a owl:ObjectProperty ;
    rdfs:label "strike_point_outer_z" ;
    skos:definition "Z position of the outer strike point" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:subcollimators_n a owl:DatatypeProperty ;
    rdfs:label "subcollimators_n" ;
    skos:definition "Number of sub-collimators" ;
    skos:inScheme fyo:bolometer ;
    fyo:dd_type "static" .

fyo:subcollimators_separation a owl:DatatypeProperty ;
    rdfs:label "subcollimators_separation" ;
    skos:definition "Thickness of separation between sub-collimators" ;
    skos:inScheme fyo:bolometer ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:sublimation_energy a owl:DatatypeProperty ;
    rdfs:label "sublimation_energy" ;
    skos:definition "Sublimation energy per atom" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:summit a owl:ObjectProperty ;
    rdfs:label "summit" ;
    skos:definition "Position of the grating summit (defined as the point of contact of its concave side if the grating were put on a table). Used as the origin of the x1, x2, x3 vectors defined below" ;
    skos:inScheme fyo:spectrometer_uv .

fyo:supply_low_voltage a owl:ObjectProperty ;
    rdfs:label "supply_low_voltage" ;
    skos:definition "Description of low voltage power supply" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:surface_area_effective a owl:ObjectProperty ;
    rdfs:label "surface_area_effective" ;
    skos:definition "Effective collection area of the probe surface, varying with time due to e.g. changes in the magnetic field line incidence angle" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "m^2" .

fyo:surface_outline a owl:ObjectProperty ;
    rdfs:label "surface_outline" ;
    skos:definition "Outline of the tile surface facing the plasma" ;
    skos:inScheme fyo:divertors .

fyo:t_e_average a owl:ObjectProperty ;
    rdfs:label "t_e_average" ;
    skos:definition "Electron temperature (upstream to downstream average)" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_units "eV" .

fyo:t_e_decay_length a owl:ObjectProperty ;
    rdfs:label "t_e_decay_length" ;
    skos:definition "Electron temperature radial decay length inv(grad Te/Te)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:t_e_pedestal_top_critical a owl:ObjectProperty ;
    rdfs:label "t_e_pedestal_top_critical" ;
    skos:definition "Critical electron temperature at pedestal top determined with self-consistent runs with an MHD stability code. Details of the method for scanning parameters in the series of runs must be described in the 'source' node" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "eV" .

fyo:t_e_target a owl:DatatypeProperty ;
    rdfs:label "t_e_target" ;
    skos:definition "Electron temperature at divertor target" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:t_e_target_sputtering_limit_max a owl:DatatypeProperty ;
    rdfs:label "t_e_target_sputtering_limit_max" ;
    skos:definition "Maximum plasma temperature allowed on the divertor target to avoid excessive sputtering" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_type "static" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:t_i_average_decay_length a owl:ObjectProperty ;
    rdfs:label "t_i_average_decay_length" ;
    skos:definition "Ion temperature (average over ion species) radial decay length inv(grad Ti/Ti)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "m" .

fyo:t_i_average_method a owl:ObjectProperty ;
    rdfs:label "t_i_average_method" ;
    skos:definition "Description of the method used to reconstruct the average ion temperature" ;
    skos:inScheme fyo:charge_exchange .

fyo:t_i_method a owl:ObjectProperty ;
    rdfs:label "t_i_method" ;
    skos:definition "Description of the method used to derive the ion temperature" ;
    skos:inScheme fyo:charge_exchange .

fyo:t_radiation a owl:ObjectProperty ;
    rdfs:label "t_radiation" ;
    skos:definition "Radiation temperature" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:t_radiation_central a owl:ObjectProperty ;
    rdfs:label "t_radiation_central" ;
    skos:definition "Radiation temperature from the closest channel to the magnetic axis, together with its radial location" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:t_radiation_central_o a owl:ObjectProperty ;
    rdfs:label "t_radiation_central_o" ;
    skos:definition "Predicted radiation temperature of the channel closest to the magnetic axis, together with its radial location (Ordinary mode)" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:t_radiation_central_x a owl:ObjectProperty ;
    rdfs:label "t_radiation_central_x" ;
    skos:definition "Predicted radiation temperature of the channel closest to the magnetic axis, together with its radial location (eXtraordinary mode)" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:t_radiation_o a owl:ObjectProperty ;
    rdfs:label "t_radiation_o" ;
    skos:definition "Predicted radiation temperature of the Ordinary mode" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:t_radiation_x a owl:ObjectProperty ;
    rdfs:label "t_radiation_x" ;
    skos:definition "Predicted radiation temperature of the e(X)traordinary mode" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "eV" .

fyo:table_0d a owl:DatatypeProperty ;
    rdfs:label "table_0d" ;
    skos:definition "0D table describing the process data" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" ;
    fyo:dd_units "units given by process(:)/results_units" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:table_dimension a owl:DatatypeProperty ;
    rdfs:label "table_dimension" ;
    skos:definition "Table dimensionality of the process (1 to 6), valid for all charge states. Indicates which of the tables is filled (below the charge_state node)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:tag a owl:ObjectProperty ;
    rdfs:label "tag" ;
    skos:definition "Tag qualifying this data entry (or a list of data entries)" ;
    skos:inScheme fyo:summary .

fyo:target_index a owl:DatatypeProperty ;
    rdfs:label "target_index" ;
    skos:definition "If the shunt is located on a divertor target, index of that target in the divertors IDS" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" .

fyo:target_surface_center a owl:ObjectProperty ;
    rdfs:label "target_surface_center" ;
    skos:definition "Position of the center of the targeted surface" ;
    skos:inScheme fyo:camera_ir .

fyo:tau a owl:ObjectProperty ;
    rdfs:label "tau" ;
    skos:definition "Filter time-constant for the D-term" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_units "s" .

fyo:tau_energy a owl:ObjectProperty ;
    rdfs:label "tau_energy" ;
    skos:definition "Energy confinement time" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:tau_energy_98 a owl:ObjectProperty ;
    rdfs:label "tau_energy_98" ;
    skos:definition "Energy confinement time estimated from the IPB98(y,2) scaling" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:tau_helium a owl:ObjectProperty ;
    rdfs:label "tau_helium" ;
    skos:definition "Helium confinement time" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:temperature_inlet a owl:DatatypeProperty ;
    rdfs:label "temperature_inlet" ;
    skos:definition "Inlet coolant temperature" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "K" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:temperature_log_gradient_norm a owl:DatatypeProperty ;
    rdfs:label "temperature_log_gradient_norm" ;
    skos:definition "normalized logarithmic gradient (with respect to r_minor_norm) of the temperature" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:temperature_max a owl:DatatypeProperty ;
    rdfs:label "temperature_max" ;
    skos:definition "Maximum apparent temperature measured in the region of interest" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "K" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:temperature_norm a owl:DatatypeProperty ;
    rdfs:label "temperature_norm" ;
    skos:definition "normalized temperature" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:temperature_outlet a owl:DatatypeProperty ;
    rdfs:label "temperature_outlet" ;
    skos:definition "Outlet coolant temperature" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "K" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:temperature_perturbed a owl:ObjectProperty ;
    rdfs:label "temperature_perturbed" ;
    skos:definition "Perturbed temperature for given toroidal mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "eV" .

fyo:temperature_reference a owl:ObjectProperty ;
    rdfs:label "temperature_reference" ;
    skos:definition "Reference temperature for which the machine description data is given in this IDS" ;
    skos:inScheme fyo:wall .

fyo:temperature_sensor a owl:ObjectProperty ;
    rdfs:label "temperature_sensor" ;
    skos:definition "Temperature sensor" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:temperature_volume_average a owl:ObjectProperty ;
    rdfs:label "temperature_volume_average" ;
    skos:definition "Volume averaged temperature of this neutral species (averaged over the plasma volume up to the LCFS)" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_units "eV" .

fyo:test_generator a owl:ObjectProperty ;
    rdfs:label "test_generator" ;
    skos:definition "Test generator characteristics" ;
    skos:inScheme fyo:neutron_diagnostic .

fyo:thermal_shield a owl:ObjectProperty ;
    rdfs:label "thermal_shield" ;
    skos:definition "Mechanical structure of the cryostat thermal shield. It is described as a set of nested layers with given physics properties; Two representations are admitted for each vessel unit : annular (two contours) or block elements." ;
    skos:inScheme fyo:cryostat .

fyo:thick_line a owl:ObjectProperty ;
    rdfs:label "thick_line" ;
    skos:definition "The element is approximated by a rectangle defined by a central segment and a thickness in the direction perpendicular to the segment" ;
    skos:inScheme fyo:common .

fyo:third_point a owl:ObjectProperty ;
    rdfs:label "third_point" ;
    skos:definition "Position of the third point" ;
    skos:inScheme fyo:common .

fyo:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold" ;
    skos:definition "Convergence threshold on the metric." ;
    skos:inScheme fyo:scenario .

fyo:tile_index a owl:DatatypeProperty ;
    rdfs:label "tile_index" ;
    skos:definition "If the shunt is located on a divertor tile, index of that tile in the divertors IDS" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" .

fyo:tilt_angle_pol a owl:ObjectProperty ;
    rdfs:label "tilt_angle_pol" ;
    skos:definition "Angle between field lines projected in poloidal plane and target, measured clockwise from the target to the projected field lines" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_units "rad" .

fyo:time_begin a owl:DatatypeProperty ;
    rdfs:label "time_begin" ;
    skos:definition "Start time (relative to the beginning of the pulse)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_breakdown a owl:ObjectProperty ;
    rdfs:label "time_breakdown" ;
    skos:definition "Time of the plasma breakdown" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:time_half_ip a owl:ObjectProperty ;
    rdfs:label "time_half_ip" ;
    skos:definition "Time at which the plasma current has fallen to half of the initial current at the start of the disruption, relative to the time of the disruption" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:time_interval_elapsed a owl:DatatypeProperty ;
    rdfs:label "time_interval_elapsed" ;
    skos:definition "Simulation time interval for which this component has last computed its results" ;
    skos:inScheme fyo:workflow ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_interval_request a owl:DatatypeProperty ;
    rdfs:label "time_interval_request" ;
    skos:definition "Simulation time interval for which this component is requested to compute its results" ;
    skos:inScheme fyo:workflow ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_loop a owl:ObjectProperty ;
    rdfs:label "time_loop" ;
    skos:definition "Description of a workflow based on a time loop which calls components defined in component_list sequentially  during each cycle of the loop (workflow_cycle)." ;
    skos:inScheme fyo:workflow .

fyo:time_offset a owl:DatatypeProperty ;
    rdfs:label "time_offset" ;
    skos:definition "Offset time (when a mode disappears). If the mode reappears later in the simulation, use another index of the mode array of structure" ;
    skos:inScheme fyo:ntms ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_onset a owl:DatatypeProperty ;
    rdfs:label "time_onset" ;
    skos:definition "Onset time" ;
    skos:inScheme fyo:ntms ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_predisruption a owl:ObjectProperty ;
    rdfs:label "time_predisruption" ;
    skos:definition "Pre-disruption time = disruption.time - t_pre, where t_pre[s] is approximately given by 0.0025 * R0[m]^2 and R0 is the major radius where the toroidal field is defined (../../global_quantities/r0)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:time_radiated_power_max a owl:ObjectProperty ;
    rdfs:label "time_radiated_power_max" ;
    skos:definition "Time of maximum radiated power, relative to the time of the disruption" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:time_shatter a owl:DatatypeProperty ;
    rdfs:label "time_shatter" ;
    skos:definition "Arrival time at the shattering unit" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:time_step_average a owl:ObjectProperty ;
    rdfs:label "time_step_average" ;
    skos:definition "Average internal time step used by the transport solver between the previous and the current time stored for this quantity (assuming all transport equations are solved with the same time step)" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_units "s" .

fyo:time_step_min a owl:ObjectProperty ;
    rdfs:label "time_step_min" ;
    skos:definition "Minimum internal time step used by the transport solver between the previous and the current time stored for this quantity (assuming all transport equations are solved with the same time step)" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_units "s" .

fyo:time_trigger a owl:DatatypeProperty ;
    rdfs:label "time_trigger" ;
    skos:definition "Time of trigger request to the power supply according to the DMS sequence" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    skos:definition "Date and time (UTC) at which the reference was created, expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "constant" .

fyo:top_cap_thickness a owl:DatatypeProperty ;
    rdfs:label "top_cap_thickness" ;
    skos:definition "Top cap poloidal thickness" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:toroidal_angle a owl:DatatypeProperty ;
    rdfs:label "toroidal_angle" ;
    skos:definition "Angle of the projection of the sensor normal vector (n) in the horizontal plane with the increasing R direction (i.e. grad(R)) (angle is counter-clockwise from above). Values should be taken modulo pi with values within (-pi/2,pi/2]. Zero if projected sensor normal is parallel to grad(R), pi/2 if it is parallel to grad(phi)." ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:torque_tor_j_radial a owl:DatatypeProperty ;
    rdfs:label "torque_tor_j_radial" ;
    skos:definition "Toroidal torque due to radial currents" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "N.m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:townsend_or_closed_grid_positions a owl:ObjectProperty ;
    rdfs:label "townsend_or_closed_grid_positions" ;
    skos:definition "List of all R, Z grid positions (from ../grid) containing field lines encoutering Townsend condition or being closed field lines" ;
    skos:inScheme fyo:plasma_initiation .

fyo:townsend_or_closed_positions a owl:ObjectProperty ;
    rdfs:label "townsend_or_closed_positions" ;
    skos:definition "List of all R, Z positions along all field lines encoutering Townsend condition or being closed field lines" ;
    skos:inScheme fyo:plasma_initiation .

fyo:transformation a owl:DatatypeProperty ;
    rdfs:label "transformation" ;
    skos:definition "Coordinate transformation applied to coordinate values stored in coord. Integer flag: 0=none; 1=log10; 2=ln" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:transit_time a owl:ObjectProperty ;
    rdfs:label "transit_time" ;
    skos:definition "Transit time for the coolant to go from the input to the output of the component" ;
    skos:inScheme fyo:calorimetry ;
    fyo:dd_units "s" .

fyo:translation_max a owl:DatatypeProperty ;
    rdfs:label "translation_max" ;
    skos:definition "Maximum displacement with respect to reference position, along the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:translation_min a owl:DatatypeProperty ;
    rdfs:label "translation_min" ;
    skos:definition "Minimum displacement with respect to reference position, along the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:transport_perpendicular a owl:ObjectProperty ;
    rdfs:label "transport_perpendicular" ;
    skos:definition "Effective perpendicular transport to the magnetic field for runaways" ;
    skos:inScheme fyo:runaway_electrons .

fyo:triangularity_inner a owl:ObjectProperty ;
    rdfs:label "triangularity_inner" ;
    skos:definition "Inner triangularity of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:triangularity_minor a owl:ObjectProperty ;
    rdfs:label "triangularity_minor" ;
    skos:definition "Minor triangularity of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:triangularity_outer a owl:ObjectProperty ;
    rdfs:label "triangularity_outer" ;
    skos:definition "Outer triangularity of the plasma boundary" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "1" .

fyo:tt a owl:ObjectProperty ;
    rdfs:label "tt" ;
    skos:definition "Neutron rates from TT reactions" ;
    skos:inScheme fyo:summary .

fyo:turns_per_metre a owl:DatatypeProperty ;
    rdfs:label "turns_per_metre" ;
    skos:definition "Number of turns per unit length. In case of multiple layers, turns are counted for a single layer" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_type "static" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:turns_with_sign a owl:DatatypeProperty ;
    rdfs:label "turns_with_sign" ;
    skos:definition "Number of effective turns in the element for calculating the magnetic field from the coil/loop. Should be positive, unless the coil has elements going in opposite directions." ;
    skos:inScheme fyo:common ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:twist a owl:DatatypeProperty ;
    rdfs:label "twist" ;
    skos:definition "Twist period" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:unit_vector_major a owl:ObjectProperty ;
    rdfs:label "unit_vector_major" ;
    skos:definition "Major unit vector describing the geometry of the elliptic shatter cone" ;
    skos:inScheme fyo:spi .

fyo:unit_vector_minor a owl:ObjectProperty ;
    rdfs:label "unit_vector_minor" ;
    skos:definition "Minor unit vector describing the geometry of the elliptic shatter cone" ;
    skos:inScheme fyo:spi .

fyo:units a owl:DatatypeProperty ;
    rdfs:label "units" ;
    skos:definition "Units of coordinate (e.g. eV)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_type "static" .

fyo:up a owl:ObjectProperty ;
    rdfs:label "up" ;
    skos:definition "Detector orientation unit vector" ;
    skos:inScheme fyo:camera_ir .

fyo:uq_input_path a owl:DatatypeProperty ;
    rdfs:label "uq_input_path" ;
    skos:definition "For Sobol index only, path to the related the uq_input quantity, e.g. ../../../uq_input_2d(3)" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "dynamic" .

fyo:use_mhd_approximation a owl:DatatypeProperty ;
    rdfs:label "use_mhd_approximation" ;
    skos:definition "Flag = 1 if the geometric dependence of the grad-B drift is approximated to be that of the curvature drift (including the pressure gradient contribution), 0 otherwise. Using this approximation (Flag=1) is only recommended together with the neglect of parallel magnetic field fluctuations" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" .

fyo:uses_forward_operator a owl:ObjectProperty ;
    rdfs:label "uses_forward_operator" ;
    rdfs:range fyo:ForwardOperator ;
    skos:definition "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
    skos:inScheme fyo:scenario .

fyo:uses_inference_engine a owl:ObjectProperty ;
    rdfs:label "uses_inference_engine" ;
    rdfs:range fyo:InferenceEngine ;
    skos:definition "The exchangeable inference engine stacked on the fixed forward spine (least-squares reconstruction / MAP / Bayesian posterior / UQ propagation are engine choices, not forward-model changes)." ;
    skos:inScheme fyo:scenario .

fyo:v_external a owl:DatatypeProperty ;
    rdfs:label "v_external" ;
    skos:definition "External voltage, i.e. time derivative of psi_external_average (with a minus sign : - d_psi_external_average/d_time)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:vacuum a owl:ObjectProperty ;
    rdfs:label "vacuum" ;
    skos:definition "MHD modes in the vacuum" ;
    skos:inScheme fyo:mhd_linear .

fyo:valid a owl:DatatypeProperty ;
    rdfs:label "valid" ;
    skos:definition "Date range during which the data is or was valid. Expressed as YYYY-MM-DD/YYYY-MM-DD, where the former (resp. latter) date is the data at which the data started (resp. ceased) to be valid. If the data is still valid, the slash should still be present, i.e. indicate the validity start date with YYYY-MM-DD/. If the data ceased being valid but there is no information on the validity start date, indicate /YYYY-MM-DD." ;
    skos:inScheme fyo:dataset_fair ;
    fyo:dd_type "constant" .

fyo:varying_n_phi a owl:DatatypeProperty ;
    rdfs:label "varying_n_phi" ;
    skos:definition "Flag telling whether n_phi is constant along the ray path (0) or varying (1)" ;
    skos:inScheme fyo:common ;
    fyo:dd_type "dynamic" .

fyo:velocity_initial a owl:DatatypeProperty ;
    rdfs:label "velocity_initial" ;
    skos:definition "Initial velocity of the pellet as it enters the vaccum chamber" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_mass_centre_fragments_phi a owl:DatatypeProperty ;
    rdfs:label "velocity_mass_centre_fragments_phi" ;
    skos:definition "Toroidal component of the velocity of the centre of mass of the fragments at the shattering cone origin" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_mass_centre_fragments_r a owl:DatatypeProperty ;
    rdfs:label "velocity_mass_centre_fragments_r" ;
    skos:definition "Major radius component of the velocity of the centre of mass of the fragments at the shattering cone origin" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_mass_centre_fragments_z a owl:DatatypeProperty ;
    rdfs:label "velocity_mass_centre_fragments_z" ;
    skos:definition "Vertical component of the velocity velocity of the centre of mass of the fragments at the shattering cone origin" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_perturbed a owl:ObjectProperty ;
    rdfs:label "velocity_perturbed" ;
    skos:definition "Pertubed velocity for given toroidal mode number" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_units "m.s^-1" .

fyo:velocity_phi_gradient_norm a owl:DatatypeProperty ;
    rdfs:label "velocity_phi_gradient_norm" ;
    skos:definition "Normalized gradient (with respect to r_minor_norm) of the toroidal velocity" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_phi_method a owl:ObjectProperty ;
    rdfs:label "velocity_phi_method" ;
    skos:definition "Description of the method used to reconstruct the ion toroidal velocity" ;
    skos:inScheme fyo:charge_exchange ;
    fyo:dd_units "m.s^-1" .

fyo:velocity_phi_norm a owl:DatatypeProperty ;
    rdfs:label "velocity_phi_norm" ;
    skos:definition "normalized toroidal velocity of species (all species are assumed to have a purely toroidal velocity with a common toroidal angular frequency)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_pol_method a owl:ObjectProperty ;
    rdfs:label "velocity_pol_method" ;
    skos:definition "Description of the method used to reconstruct the ion poloidal velocity" ;
    skos:inScheme fyo:charge_exchange .

fyo:velocity_shatter a owl:DatatypeProperty ;
    rdfs:label "velocity_shatter" ;
    skos:definition "Norm of the velocity of the centre of mass of the pellet right before shattering" ;
    skos:inScheme fyo:spi ;
    fyo:dd_type "constant" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:velocity_tor a owl:ObjectProperty ;
    rdfs:label "velocity_tor" ;
    skos:definition "Toroidal velocity (estimated from a spectral fit directly on the output line-integrated signal, without tomographic inversion)" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "../lines_of_sight_second_point/r" ;
    fyo:dd_units "m.s^-1" .

fyo:verdet_constant a owl:DatatypeProperty ;
    rdfs:label "verdet_constant" ;
    skos:definition "Verdet constant" ;
    skos:inScheme fyo:focs ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad.T^-1.m^-1" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:version_put a owl:ObjectProperty ;
    rdfs:label "version_put" ;
    skos:definition "Version of the access layer package used to PUT this IDS" ;
    skos:inScheme fyo:common .

fyo:vertical a owl:DatatypeProperty ;
    rdfs:label "vertical" ;
    skos:definition "The vertical beamlet divergence of the component. Here the divergence is defined for Gaussian beams as the angle where the beam density is reduced by a factor 1/e compared to the maximum density (equivalent to the intensity for the divergence of each individual beamlet as the energy is assumed constant). For non-Gaussian beams the divergence is mean((x-mean(x))**2)/sqrt(2), where x is the angle and the mean should be performed over the beam density, P(x): mean(y)=int(y*P(x)*dx)." ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:vertical_displacement a owl:ObjectProperty ;
    rdfs:label "vertical_displacement" ;
    skos:definition "Direction of the plasma vertical displacement just before the disruption 1 (upwards) / 0 (no displacement)/ -1 (downwards)" ;
    skos:inScheme fyo:summary ;
    fyo:dd_units "s" .

fyo:vessel a owl:ObjectProperty ;
    rdfs:label "vessel" ;
    skos:definition "Mechanical structure of the vacuum vessel. The vessel is described as a set of nested layers with given physics properties; Two representations are admitted for each vessel unit : annular (two contours) or block elements." ;
    skos:inScheme fyo:wall .

fyo:voltage_limit_max a owl:DatatypeProperty ;
    rdfs:label "voltage_limit_max" ;
    skos:definition "Maximum voltage from the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:voltage_limit_min a owl:DatatypeProperty ;
    rdfs:label "voltage_limit_min" ;
    skos:definition "Minimum voltage from the supply" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_type "static" ;
    fyo:dd_units "V" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:voltage_out a owl:ObjectProperty ;
    rdfs:label "voltage_out" ;
    skos:definition "Voltage at the supply output" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_units "V" .

fyo:voltage_t_radiation a owl:ObjectProperty ;
    rdfs:label "voltage_t_radiation" ;
    skos:definition "Raw voltage measured on each channel, from which the calibrated temperature data is then derived" ;
    skos:inScheme fyo:ece ;
    fyo:dd_units "V" .

fyo:wall_flux_max a owl:DatatypeProperty ;
    rdfs:label "wall_flux_max" ;
    skos:definition "Maximum neutron flux at the first wall" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W.m^-2" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:wave_index a owl:DatatypeProperty ;
    rdfs:label "wave_index" ;
    skos:definition "Index into distribution/wave" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_type "dynamic" .

fyo:wave_solver_type a owl:ObjectProperty ;
    rdfs:label "wave_solver_type" ;
    skos:definition "Type of wave deposition solver used for this wave. Index = 1 for beam/ray tracing; index = 2 for full wave" ;
    skos:inScheme fyo:waves .

fyo:wavelength_bragg a owl:DatatypeProperty ;
    rdfs:label "wavelength_bragg" ;
    skos:definition "Bragg wavelength of the crystal" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:width_horizontal a owl:DatatypeProperty ;
    rdfs:label "width_horizontal" ;
    skos:definition "Horizontal width (dimensions of the smallest rectangle that surrounds the outer dimensions of the beamlets) of the beamlet group at the injection unit surface (or grounded grid)" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:width_min_horizontal a owl:DatatypeProperty ;
    rdfs:label "width_min_horizontal" ;
    skos:definition "The horizontal width (Full Width at Half Maximum) of the beamlets group at the horizontal focal point" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:width_min_vertical a owl:DatatypeProperty ;
    rdfs:label "width_min_vertical" ;
    skos:definition "The vertical width (Full Width at Half Maximum) of the beamlets group at the vertical focal point" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:width_phi a owl:DatatypeProperty ;
    rdfs:label "width_phi" ;
    skos:definition "Width of strap in the toroidal direction" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:width_vertical a owl:DatatypeProperty ;
    rdfs:label "width_vertical" ;
    skos:definition "Vertical width (dimensions of the smallest rectangle that surrounds the outer dimensions of the beamlets) of the beamlet group at the injection unit surface (or grounded grid)" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "quantity" ;
    fyo:spo_class "spo:QuantityValue" .

fyo:x_point_main a owl:ObjectProperty ;
    rdfs:label "x_point_main" ;
    skos:definition "RZ position of the main X-point" ;
    skos:inScheme fyo:summary .

fyo:z_r_max a owl:ObjectProperty ;
    rdfs:label "z_r_max" ;
    skos:definition "Height of the separatrix point of maximum major radius" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "m" .

fyo:z_r_min a owl:ObjectProperty ;
    rdfs:label "z_r_min" ;
    skos:definition "Height of the separatrix point of minimum major radius" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_units "m" .

fyo:zeff_line_average_method a owl:ObjectProperty ;
    rdfs:label "zeff_line_average_method" ;
    skos:definition "Description of the method used to reconstruct the line average effective charge" ;
    skos:inScheme fyo:charge_exchange .

fyo:zeff_line_of_sight a owl:ObjectProperty ;
    rdfs:label "zeff_line_of_sight" ;
    skos:definition "Description of the line of sight for calculating zeff, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
    skos:inScheme fyo:pulse_schedule .

spo:IndependentContinuant a owl:Class ;
    rdfs:label "IndependentContinuant" ;
    rdfs:subClassOf [ owl:unionOf ( spo:ImmaterialEntity spo:MaterialEntity ) ],
        spo:Continuant ;
    skos:definition "A continuant that is the bearer of qualities and does not depend on other entities (BFO independent continuant)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000004> ;
    skos:inScheme spo:core .

spo:QuantityKind a owl:Class ;
    rdfs:label "QuantityKind" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:dimension_vector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:dimension_vector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:dimension_vector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:symbol ],
        spo:InformationContentEntity ;
    skos:definition "A kind of physical quantity — the DETERMINABLE (\"electron temperature\", \"poloidal flux\") as an ICE, independent of any bearer, domain, or unit. A concrete measured or computed quantity (Quality in the world; ContinuousQuantity/QuantityValue as information) determines a QuantityKind. Aligns qudt:QuantityKind; fusion-specific kinds are enumerated downstream (fyo), not here." ;
    skos:exactMatch <http://qudt.org/schema/qudt/QuantityKind> ;
    skos:inScheme spo:quantity .

spo:SpatialRegion a owl:Class ;
    rdfs:label "SpatialRegion" ;
    rdfs:subClassOf spo:Region ;
    skos:definition "A region of space (BFO spatial region). The base manifold a field rides; bound to sp_mathx geometry." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000006> ;
    skos:inScheme spo:domain .

spo:TemporalRegion a owl:Class ;
    rdfs:label "TemporalRegion" ;
    rdfs:subClassOf spo:Region ;
    skos:definition "A region of time (BFO temporal region). A dynamic quantity is a Quality over a TemporalRegion; DD `time_slice[]` dissolves to a TemporalRegion domain (C-1 / L1)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:inScheme spo:domain .

spo:TimeAxis a owl:Class ;
    rdfs:label "TimeAxis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:discretizes_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty spo:samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:samples ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:discretizes_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:TimeInterval ;
            owl:onProperty spo:discretizes_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:samples ],
        spo:InformationContentEntity ;
    skos:definition "The discretized time coordinate — an ordered sequence of sample instants over a TimeInterval (an ICE; the information-level counterpart of the region it discretizes). Unifies the DD timebases: the IDS-homogeneous root `time[]`, a per-signal embedded `.../time`, and an AoS `time_slice[]/time` column are all TimeAxis instances; which one a datum rides is recorded by spo-signal `timebase_source`." ;
    skos:inScheme spo:time .

spo:TimeSliceSeries a owl:Class ;
    rdfs:label "TimeSliceSeries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spo:TimeSlice ;
            owl:onProperty spo:has_slice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_slice ],
        spo:TemporalAggregate ;
    skos:definition "The AoS layout — an ordered array of TimeSlice structs (DD `time_slice[]`): the discretized SpacetimeWorm, foliated per instant. Convenient for whole-state-at-t access (equilibrium at t); dual to the SoA TimeSeries via dual_view_of (stack the slices)." ;
    skos:inScheme spo:time ;
    fyo:layout "aos" .

spo:about_occurrent a owl:ObjectProperty ;
    rdfs:label "about_occurrent" ;
    rdfs:range spo:Occurrent ;
    skos:definition "The temporally extended referent (SpacetimeWorm / Process) this aggregate is the information content of (iao:is_about specialization). Two aggregates about the same referent with different layouts are dual views, not distinct claims about the world." ;
    skos:inScheme spo:time .

spo:at_instant a owl:ObjectProperty ;
    rdfs:label "at_instant" ;
    rdfs:range spo:TimeInstant ;
    skos:definition "The TimeInstant this slice is the state description of." ;
    skos:inScheme spo:time .

spo:at_time a owl:DatatypeProperty ;
    rdfs:label "at_time" ;
    rdfs:range xsd:float ;
    skos:definition "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
    skos:inScheme spo:time ;
    fyo:unit "s" .

spo:chart_kind a owl:DatatypeProperty ;
    rdfs:label "chart_kind" ;
    rdfs:range xsd:string ;
    skos:definition "Named chart family — cartesian / polar / cylindrical / spherical / toroidal (selects the built-in metric)." ;
    skos:inScheme spo:geometry .

spo:coordinate a owl:ObjectProperty ;
    rdfs:label "coordinate" ;
    rdfs:range fyo:ContinuousCoordinate ;
    skos:definition "The controlled coordinate name this Domain realizes (continuous physical axis)." ;
    skos:inScheme spo:domain .

spo:creation_date a owl:DatatypeProperty ;
    rdfs:label "creation_date" ;
    skos:definition "Provenance time of generation (≠ physical time)." ;
    skos:inScheme spo:provenance .

spo:data a owl:DatatypeProperty ;
    rdfs:label "data" ;
    skos:definition "Signal samples over the time base — the DD/A-Box serialization column (runtime carrier is a Function)." ;
    skos:inScheme spo:signal ;
    fyo:array true ;
    fyo:represented_as "spdata:data_handle" .

spo:describes_region a owl:ObjectProperty ;
    rdfs:label "describes_region" ;
    rdfs:range spo:SpatialRegion ;
    skos:definition "The SpatialRegion this geometry describes." ;
    skos:inScheme spo:geometry .

spo:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "Human-readable description." ;
    skos:inScheme spo:vocab .

spo:dimension_vector a owl:DatatypeProperty ;
    rdfs:label "dimension_vector" ;
    skos:definition "QUDT dimension-vector expression (e.g. L2 M T-2); authority external (QUDT)." ;
    skos:inScheme spo:quantity .

spo:discretizes_spacetime a owl:ObjectProperty ;
    rdfs:label "discretizes_spacetime" ;
    rdfs:range spo:SpacetimeRegion ;
    skos:definition "The SpacetimeRegion this 4D mesh discretizes." ;
    skos:inScheme spo:time ;
    fyo:spo_stratum "4d_extension" .

spo:discretizes_time a owl:ObjectProperty ;
    rdfs:label "discretizes_time" ;
    rdfs:range spo:TimeInterval ;
    skos:definition "The TimeInterval this axis discretizes." ;
    skos:inScheme spo:time .

spo:draws_from a owl:ObjectProperty ;
    rdfs:label "draws_from" ;
    rdfs:range spo:ControlledVocabulary ;
    skos:definition "The controlled vocabulary this identifier value draws from (value → vocabulary, A-Box → T-Box)." ;
    skos:inScheme spo:vocab .

spo:dual_view_of a owl:ObjectProperty ;
    rdfs:label "dual_view_of" ;
    rdfs:range spo:TemporalAggregate ;
    skos:definition "The other-layout aggregate carrying the same content about the same referent (AoS ↔ SoA; the slice ⊣ stack adjunction). Symmetric; a read-time transform (sampling one way, regrouping the other), not a persisted distinct datum." ;
    skos:inScheme spo:time ;
    fyo:symmetric "true" .

spo:executed_code a owl:ObjectProperty ;
    rdfs:label "executed_code" ;
    rdfs:range spo:Code ;
    skos:definition "The Code (program) whose execution this record documents (prov:used the plan)." ;
    skos:inScheme spo:provenance .

spo:foliates_to a owl:DatatypeProperty ;
    rdfs:label "foliates_to" ;
    skos:definition "The 3D+Time foliated view of this worm (slice ⊣ stack; SPM-CONOPS-01). Read-time derivation, not a persisted distinct datum." ;
    skos:inScheme spo:core ;
    fyo:spo_stratum "4d_extension" .

spo:generated_by_process a owl:ObjectProperty ;
    rdfs:label "generated_by_process" ;
    rdfs:range spo:Process ;
    skos:definition "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
    skos:inScheme spo:provenance .

spo:geometry_role a owl:DatatypeProperty ;
    rdfs:label "geometry_role" ;
    rdfs:range xsd:string ;
    skos:definition "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
    skos:inScheme spo:geometry .

spo:has_coordinate_system a owl:ObjectProperty ;
    rdfs:label "has_coordinate_system" ;
    rdfs:range spo:CoordinateSystem ;
    skos:definition "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
    skos:inScheme spo:geometry .

spo:has_domain a owl:ObjectProperty ;
    rdfs:label "has_domain" ;
    rdfs:range spo:Domain ;
    skos:definition "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
    skos:inScheme spo:domain .

spo:has_input a owl:DatatypeProperty ;
    rdfs:label "has_input" ;
    skos:definition "An information / material input consumed by this process." ;
    skos:inScheme spo:core .

spo:has_metric a owl:ObjectProperty ;
    rdfs:label "has_metric" ;
    rdfs:range spo:Metric ;
    skos:definition "The metric tensor of this coordinate system." ;
    skos:inScheme spo:geometry .

spo:has_output a owl:DatatypeProperty ;
    rdfs:label "has_output" ;
    skos:definition "An information content entity produced by this process (e.g. an IDS)." ;
    skos:inScheme spo:core .

spo:has_provenance a owl:DatatypeProperty ;
    rdfs:label "has_provenance" ;
    rdfs:range xsd:string ;
    skos:definition "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
    skos:inScheme spo:core .

spo:has_quantity_kind a owl:ObjectProperty ;
    rdfs:label "has_quantity_kind" ;
    rdfs:range spo:QuantityKind ;
    skos:definition "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
    skos:inScheme spo:quantity .

spo:has_spacetime_extent a owl:ObjectProperty ;
    rdfs:label "has_spacetime_extent" ;
    rdfs:range spo:SpacetimeRegion ;
    skos:definition "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
    skos:inScheme spo:core ;
    fyo:spo_stratum "4d_extension" .

spo:has_spatial_base a owl:ObjectProperty ;
    rdfs:label "has_spatial_base" ;
    rdfs:range spo:Mesh ;
    skos:definition "The spatial base Mesh of a product-form SpacetimeMesh (absent for unstructured 4D grids)." ;
    skos:inScheme spo:time .

spo:has_unit a owl:ObjectProperty ;
    rdfs:label "has_unit" ;
    rdfs:range spo:Unit ;
    skos:definition "The Unit the numeric value is expressed in." ;
    skos:inScheme spo:quantity .

spo:index a owl:DatatypeProperty ;
    rdfs:label "index" ;
    skos:definition "Integer index into the vocabulary." ;
    skos:inScheme spo:vocab .

spo:is_about a owl:ObjectProperty ;
    rdfs:label "is_about" ;
    rdfs:range spo:Entity ;
    skos:definition "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
    skos:inScheme spo:core .

spo:is_function_of a owl:ObjectProperty ;
    rdfs:label "is_function_of" ;
    rdfs:range spo:Domain ;
    skos:definition "The Domain this quality is a function of (C-4)." ;
    skos:inScheme spo:domain .

spo:is_record_of a owl:ObjectProperty ;
    rdfs:label "is_record_of" ;
    rdfs:range spo:Process ;
    skos:definition "The process this record is about and generated by (iao:is_about + prov:wasGeneratedBy)." ;
    skos:inScheme spo:provenance .

spo:manifold_dim a owl:DatatypeProperty ;
    rdfs:label "manifold_dim" ;
    rdfs:range xsd:integer ;
    skos:definition "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
    skos:inScheme spo:geometry .

spo:metric_kind a owl:DatatypeProperty ;
    rdfs:label "metric_kind" ;
    rdfs:range xsd:string ;
    skos:definition "Structural form of the metric — euclidean (identity) / diagonal / general." ;
    skos:inScheme spo:geometry .

spo:modality a owl:ObjectProperty ;
    rdfs:label "modality" ;
    rdfs:range fyo:DataModality ;
    skos:definition "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
    skos:inScheme spo:provenance .

spo:numeric_value a owl:DatatypeProperty ;
    rdfs:label "numeric_value" ;
    skos:definition "The numeric value in has_unit." ;
    skos:inScheme spo:quantity .

spo:occupies a owl:DatatypeProperty ;
    rdfs:label "occupies" ;
    rdfs:range xsd:string ;
    skos:definition "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
    skos:inScheme spo:core .

spo:occupies_spacetime a owl:ObjectProperty ;
    rdfs:label "occupies_spacetime" ;
    rdfs:range spo:SpacetimeRegion ;
    skos:definition "The spacetime region this worm occupies." ;
    skos:inScheme spo:core ;
    fyo:spo_stratum "4d_extension" .

spo:of_coordinate_system a owl:ObjectProperty ;
    rdfs:label "of_coordinate_system" ;
    rdfs:range spo:CoordinateSystem ;
    skos:definition "The CoordinateSystem this metric measures." ;
    skos:inScheme spo:geometry .

spo:of_quality a owl:ObjectProperty ;
    rdfs:label "of_quality" ;
    rdfs:range spo:Quality ;
    skos:definition "The world-side Quality (SDC inhering in a MaterialEntity) this information is about — the reality/description bridge for scalar values (iao:is_about specialization)." ;
    skos:inScheme spo:quantity .

spo:prescribes a owl:ObjectProperty ;
    rdfs:label "prescribes" ;
    rdfs:range spo:MaterialEntity ;
    skos:definition "The material entity (kind) this design specification prescribes." ;
    skos:inScheme spo:vocab .

spo:produced_by a owl:ObjectProperty ;
    rdfs:label "produced_by" ;
    rdfs:range spo:Code ;
    skos:definition "The Code (activity / agent) that produced this artifact." ;
    skos:inScheme spo:provenance .

spo:provider a owl:DatatypeProperty ;
    rdfs:label "provider" ;
    skos:definition "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
    skos:inScheme spo:provenance .

spo:quantity_kind a owl:ObjectProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "The QuantityKind this unit conventionally measures." ;
    skos:inScheme spo:quantity .

spo:realizes a owl:DatatypeProperty ;
    rdfs:label "realizes" ;
    rdfs:range xsd:string ;
    skos:definition "This planned process realizes a plan / specification — a pulse_schedule for a discharge, or a Code (the program text) for a ComputationalProcess (program = GDC, run = Process, result = ICE output)." ;
    skos:inScheme spo:core .

spo:representation_of a owl:ObjectProperty ;
    rdfs:label "representation_of" ;
    rdfs:range spo:Quality ;
    skos:definition "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
    skos:inScheme spo:domain .

spo:reproducible a owl:DatatypeProperty ;
    rdfs:label "reproducible" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
    skos:inScheme spo:provenance .

spo:samples a owl:DatatypeProperty ;
    rdfs:label "samples" ;
    skos:definition "The sample instants (seconds); externalized array (A-Box column)." ;
    skos:inScheme spo:time ;
    fyo:array true ;
    fyo:represented_as "spdata:data_handle" ;
    fyo:unit "s" .

spo:slice_of a owl:ObjectProperty ;
    rdfs:label "slice_of" ;
    rdfs:range spo:TimeSliceSeries ;
    skos:definition "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
    skos:inScheme spo:time .

spo:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    skos:definition "Conventional symbol (e.g. T_e, psi)." ;
    skos:inScheme spo:quantity .

spo:timebase_source a owl:ObjectProperty ;
    rdfs:label "timebase_source" ;
    rdfs:range fyo:TimebaseSource ;
    skos:definition "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
    skos:inScheme spo:signal .

spo:ucum_code a owl:DatatypeProperty ;
    rdfs:label "ucum_code" ;
    skos:definition "UCUM unit expression (e.g. Wb, m2.s-1, eV)." ;
    skos:inScheme spo:quantity .

spo:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:range xsd:string ;
    skos:definition "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
    skos:inScheme spo:domain .

spo:version_put a owl:DatatypeProperty ;
    rdfs:label "version_put" ;
    skos:definition "DD / Access-Layer version the data was written with (prov:Entity)." ;
    skos:inScheme spo:provenance .

fyo:CoilNaRphiz1dStatic a owl:Class ;
    rdfs:label "CoilNaRphiz1dStatic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:r ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:phi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:phi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:r ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:z ],
        spo:InformationContentEntity ;
    skos:definition "Position of the start point of every element" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "2" ;
    fyo:dd_type_name "coil_na_rphiz1d_static" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:DistributionsDGgdExpansion a owl:Class ;
    rdfs:label "DistributionsDGgdExpansion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:grid_subset ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:GenericGridScalar ;
            owl:onProperty fyo:grid_subset ],
        spo:InformationContentEntity ;
    skos:definition "Distribution function expanded into a vector of successive approximations. The first element in the vector (expansion(1)) is the zeroth order distribution function, while the K:th element in the vector (expansion(K)) is the K:th correction, such that the total distribution function is a sum over all elements in the expansion vector." ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "2" ;
    fyo:dd_type_name "distributions_d_ggd_expansion" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:FilterWindow a owl:Class ;
    rdfs:label "FilterWindow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:wavelength_upper ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x2_width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:thickness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:radius ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:wavelength_lower ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:geometry_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:material ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:radius ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x2_curvature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:wavelength_lower ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x1_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x2_unit_vector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x1_width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x1_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x3_unit_vector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:photon_absorption ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:wavelength_upper ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:radius ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:curvature_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:surface ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:wavelength_lower ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x1_curvature ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Identifier ;
            owl:onProperty fyo:material ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:centre ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:x2_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:material ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:wavelength_upper ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:surface ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x2_width ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:x1_curvature ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Identifier ;
            owl:onProperty fyo:geometry_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:x1_unit_vector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:geometry_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
