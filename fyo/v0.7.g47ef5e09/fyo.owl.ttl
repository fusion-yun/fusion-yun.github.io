    skos:definition "5th dimension for the neutron_flux Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_path "neutron_diagnostic/detector/green_functions/event_in_detector_neutron_flux" ;
    fyo:dd_type_name "neutron_diagnostic_event" .

