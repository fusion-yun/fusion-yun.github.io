fyo:Plasma a owl:Class ;
    rdfs:label "Plasma" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:Machine ;
            owl:onProperty fyo:is_hosted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:is_hosted_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:is_hosted_by ],
        spo:MaterialEntity ;
    skos:definition "The ionized matter held inside the vacuum-vessel fiat boundary of a Machine during a Shot, bearer of physical qualities (temperature, density, current, flux topology). NOT a bfo:object (no bona-fide boundary; discontinuous across shots). One Plasma instance per Shot. SP-ONT-APP-PLASMA. `sp:Plasma ⊑ bfo:fiat_object_part ⊓ ∃isHostedBy.Machine`." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:inScheme fyo:core .

