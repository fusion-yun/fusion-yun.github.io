    skos:inScheme fyo:divertors ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "6" .

fyo:tau_alfven a owl:DatatypeProperty ;
    rdfs:label "tau_alfven" ;
    skos:definition "Alven time=R/vA=R0 sqrt(mi ni(rho))/B0" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_coordinate1 "../grid/dim1" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_domain "../grid/dim1" ;
    fyo:fyo_lift "field" ;
