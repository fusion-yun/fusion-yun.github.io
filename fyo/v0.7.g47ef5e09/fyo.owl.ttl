fyo:WavesProfiles2dEFieldNPhi a owl:Class ;
    rdfs:label "WavesProfiles2dEFieldNPhi" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:WavesCPXAmpPhase2D ;
            owl:onProperty fyo:parallel ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WavesCPXAmpPhase2D ;
            owl:onProperty fyo:plus ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:WavesCPXAmpPhase2D ;
