    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:stokes_output a owl:ObjectProperty ;
    rdfs:label "stokes_output" ;
    skos:definition "Stokes vector at the output of the FOCS as a function of time" ;
    skos:inScheme fyo:focs ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:strap a owl:ObjectProperty ;
    rdfs:label "strap" ;
    skos:definition "Set of IC antenna straps" ;
    skos:inScheme fyo:ic_antennas ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:subsystem a owl:ObjectProperty ;
    rdfs:label "subsystem" ;
