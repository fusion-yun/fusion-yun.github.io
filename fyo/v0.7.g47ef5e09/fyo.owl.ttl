fyo:DeviceParameterOptimizationTask a owl:Class ;
    rdfs:label "DeviceParameterOptimizationTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:EngineeringPortRun ;
            owl:onProperty fyo:port_runs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:reference_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:operating_point_evaluations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:design_space ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:objectives ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:DesignSpecification ;
            owl:onProperty fyo:candidate_design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:engineering_limits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:candidate_design ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:engineering_evaluations ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:MachineDescription ;
            owl:onProperty fyo:reference_design ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:reference_design ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:objectives ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:objectives ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:candidate_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:operating_point_evaluations ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:engineering_evaluations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:port_runs ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:DesignSpaceSpecification ;
            owl:onProperty fyo:design_space ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:engineering_limits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:design_space ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:engineering_limits ],
        fyo:ApplicationTask ;
    skos:definition "A device-parameter optimization run (S-11). FUNCTION: search a declared design space of static device / configuration parameters θ_dev — coil currents and positions, geometry, heating mix — under steady-state or parameter-scan evaluation of the shared forward kernel, screening candidates for physics performance (target operating point reached) and engineering feasibility (limits, port-evaluated whole-machine quantities), and ranking them against declared objectives. Direction: outer search over designs; each candidate evaluation is a forward run (S-7-shaped) at fixed θ_dev. What is free here is the MACHINE ITSELF (design-phase lifecycle: the physical counterpart may not yet exist — design work counts as twin work from the start). Whole-machine engineering quantities enter ONLY via EngineeringPortRun (in/port/out boundary); the candidate-design OUTPUT is directive — a DesignSpecification prescribing a Machine, the as-designed stance, not a description of any existing device." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/device_optimization> ;
    fyo:conops_scenario "S-11" ;
    fyo:free_variables_note "free = static device / configuration parameters θ_dev (+ per-candidate operating point); the machine itself is the unknown" .

fyo:Diagnostic a owl:Class ;
    rdfs:label "Diagnostic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:produces ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:produces ],
        spo:MaterialEntity ;
    skos:definition "A measurement apparatus designed to measure physical quantities of the Machine or the Plasma it hosts, bearing a disposition to produce information artifacts (W3C SOSA Sensor aligned). SP-ONT-APP-DIAG. `sp:Diagnostic ⊑ bfo:object ⊓ ∃produces.InformationContentEntity`." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000030> ;
    skos:inScheme fyo:core .

fyo:DischargeOperationDesignTask a owl:Class ;
    rdfs:label "DischargeOperationDesignTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:limit_verification_report ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:limit_verification_report ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:designed_pulse_schedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:initial_guess ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:MachineDescription ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:limit_verification_report ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:predicted_trajectory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:designed_pulse_schedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:EngineeringPortRun ;
            owl:onProperty fyo:port_runs ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:design_targets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:design_targets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:design_targets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:port_runs ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:EngineeringLimitSet ;
            owl:onProperty fyo:checked_against ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:checked_against ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:designed_pulse_schedule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:initial_guess ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:initial_guess ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:checked_against ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:predicted_trajectory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:machine_description ],
        fyo:ApplicationTask ;
    skos:definition "A discharge-operation design run (S-10). FUNCTION: before the experiment, optimize the feedforward actuator trajectory over the WHOLE discharge time sequence — breakdown, ramp-up, flat-top, ramp-down, termination — as a control-vector-parameterization (CVP) problem over the shared forward kernel, while verifying that every candidate stays within the per-channel engineering limits (per-coil current / voltage / stored energy / temperature rise / forces / wall heat load). Direction: feedforward / pre-shot; free variables are the actuator waveforms u(t) over the full pulse. Distinct from S-9 by the absence of feedback: nothing reacts, everything is planned. The pulse-schedule OUTPUT is directive — it PRESCRIBES a future Discharge (the discharge realizes it), unlike the descriptive outputs of S-7/S-8." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:conops_scenario "S-10" ;
    fyo:free_variables_note "free = actuator waveforms u(t) over the full pulse (feedforward); fixed = machine, targets, limits" .

fyo:Disruption a owl:Class ;
    rdfs:label "Disruption" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
