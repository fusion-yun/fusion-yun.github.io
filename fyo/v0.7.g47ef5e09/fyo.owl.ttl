fyo:emissivity_neutral_total a owl:DatatypeProperty ;
    rdfs:label "emissivity_neutral_total" ;
    skos:definition "Emissivity (summed over neutral  species)" ;
    skos:inScheme fyo:radiation ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W.m^-3" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:emissivity_profile_1d a owl:ObjectProperty ;
