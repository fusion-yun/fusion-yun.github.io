    skos:definition "Components of the electric field per toroidal mode number, averaged over the flux surface, where the averaged is weighted with the power deposition density, such that e_field = ave(e_field.power_density) / ave(power_density)" ;
    skos:inScheme fyo:waves ;
    fyo:dd_path "waves/coherent_wave/profiles_1d/e_field_n_phi" ;
