    fyo:dd_coordinate1 "../../length" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_domain "../../length" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:k_phi_norm a owl:DatatypeProperty ;
