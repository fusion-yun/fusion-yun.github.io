fyo:power_mechanical a owl:DatatypeProperty ;
    rdfs:label "power_mechanical" ;
    skos:definition "Shaft power associated with the component, (+) = into the system, (-) = out of the system" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_n_phi a owl:DatatypeProperty ;
    rdfs:label "power_n_phi" ;
    skos:definition "Absorbed wave power per toroidal mode number" ;
    skos:inScheme fyo:waves ;
    fyo:dd_coordinate1 "../n_phi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_domain "../n_phi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:power_ohm_halo a owl:DatatypeProperty ;
    rdfs:label "power_ohm_halo" ;
    skos:definition "Ohmic power in the halo region" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_outer_target a owl:DatatypeProperty ;
    rdfs:label "power_outer_target" ;
    skos:definition "Electron power on the inner target" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "../../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_parallel_halo a owl:DatatypeProperty ;
    rdfs:label "power_parallel_halo" ;
    skos:definition "Power of the parallel heat flux in the halo region" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_radiated_electrons_impurities a owl:DatatypeProperty ;
    rdfs:label "power_radiated_electrons_impurities" ;
    skos:definition "Total power radiated by electrons on impurities" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_radiated_electrons_impurities_halo a owl:DatatypeProperty ;
    rdfs:label "power_radiated_electrons_impurities_halo" ;
    skos:definition "Power radiated by electrons on impurities in the halo region" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_radiated_total a owl:DatatypeProperty ;
    rdfs:label "power_radiated_total" ;
    skos:definition "Total radiated power reconstructed from bolometry data" ;
    skos:inScheme fyo:bolometer ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_radiated_validity a owl:DatatypeProperty ;
    rdfs:label "power_radiated_validity" ;
    skos:definition "Validity flag related to the radiated power reconstructions" ;
    skos:inScheme fyo:bolometer ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_to_cooling a owl:DatatypeProperty ;
    rdfs:label "power_to_cooling" ;
    skos:definition "Power to cooling systems" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:power_total a owl:DatatypeProperty ;
    rdfs:label "power_total" ;
    skos:definition "Total electrical power used to operate the plant" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:predicted_trajectory a owl:ObjectProperty ;
    rdfs:label "predicted_trajectory" ;
    skos:definition "OUTPUT — the predicted plasma trajectory under the designed schedule (equilibrium + profiles over the pulse); modality simulated; the evidence the design decision rests on." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:fyo_ids "equilibrium, core_profiles, summary" ;
    fyo:io "output" .

fyo:pressure_partial a owl:DatatypeProperty ;
    rdfs:label "pressure_partial" ;
    skos:definition "Partial pressure (calibrated data)" ;
    skos:inScheme fyo:spectrometer_mass ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Pa" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:pressure_rotational a owl:ObjectProperty ;
    rdfs:label "pressure_rotational" ;
    skos:definition "Set of rotational pressure estimates. The rotational pressure is defined as R0^2*rho*omega^2 / 2, where omega is the toroidal rotation frequency, rho=ne(R0,psi)*m, and m is the plasma equivalent mass." ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "Pa" .

fyo:previous_crash_time a owl:DatatypeProperty ;
    rdfs:label "previous_crash_time" ;
    skos:definition "Time at which the previous sawtooth crash occured" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:previous_crash_trigger a owl:DatatypeProperty ;
    rdfs:label "previous_crash_trigger" ;
    skos:definition "Previous crash trigger. Flag indicating whether a crash condition has been satisfied : 0 = no crash. N(>0) = crash triggered due to condition N" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:previous_period a owl:DatatypeProperty ;
    rdfs:label "previous_period" ;
    skos:definition "Previous sawtooth period" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "s" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:probability a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    skos:definition "Probability to have a value of the quantity between bins(n) and bins(n+1) (thus the size of its second dimension is the size of the second dimension of the bins array - 1). The first dimension correspond to the first dimension of the original 2D quantity" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:range spo:InformationContentEntity ;
    skos:definition "A Diagnostic produces information artifacts (⊑ inverse prov:wasGeneratedBy)." ;
    skos:inScheme fyo:core .

fyo:products a owl:ObjectProperty ;
    rdfs:label "products" ;
    skos:definition "Set of products resulting of this process" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "5" .

fyo:psi_halo_boundary a owl:DatatypeProperty ;
    rdfs:label "psi_halo_boundary" ;
    skos:definition "Poloidal flux at halo region boundary" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:psi_star_post_crash a owl:DatatypeProperty ;
    rdfs:label "psi_star_post_crash" ;
    skos:definition "Psi* = psi - phi, after the sawtooth crash" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:psi_star_pre_crash a owl:DatatypeProperty ;
    rdfs:label "psi_star_pre_crash" ;
    skos:definition "Psi* = psi - phi, just before the sawtooth crash" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "Wb" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:put_operation a owl:ObjectProperty ;
    rdfs:label "put_operation" ;
    skos:definition "Plugins used to PUT a node (potentially, multiple plugins can be applied, if so they are listed by order of application)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:quality a owl:DatatypeProperty ;
    rdfs:label "quality" ;
    skos:definition "Indicator of the quality of the signal. Following ITER PCS documentation (https://user.iter.org/?uid=354SJ3&action=get_document), possible values are: 1 - GOOD (the nominal state); 2 - INVALID (data no usable); 3 - DATA INTEGRITY ERROR (e.g. out of bounds with respect to expectations, calibration error,...)" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "../../time_stamp" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "../../time_stamp" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:quantity_2d a owl:ObjectProperty ;
    rdfs:label "quantity_2d" ;
    skos:definition "Set of 2D quantities on which statistics are provided. 2D means 1D+time dimension, so either a 1D quantity within a dynamic array of structure, or a 2D dynamic quantity outside of an array of structure. Therefore the resulting statistical value is 1D for a given statistics time slice." ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:quantum_efficiency a owl:DatatypeProperty ;
    rdfs:label "quantum_efficiency" ;
    skos:definition "Quantum efficiency of the detector, i.e. conversion factor multiplying the number of counts to obtain the number of photons impacting the detector, tabulated as a function of the photon energy, for each pixel of the detector. If all pixels have the same quantum efficiency, just set the size of the first and second dimensions to 1" ;
    skos:inScheme fyo:camera_x_rays ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_coordinate3 "../photon_energy" ;
    fyo:dd_ndim 3 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N,1...N,../photon_energy" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:r_inboard a owl:DatatypeProperty ;
    rdfs:label "r_inboard" ;
    skos:definition "Radial coordinate (major radius) on the inboard side of the magnetic axis" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:r_j_phi a owl:ObjectProperty ;
    rdfs:label "r_j_phi" ;
    skos:definition "Toroidal component of the current density multiplied by the local major radius, given on various grid subsets" ;
    skos:inScheme fyo:mhd ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-1" .

fyo:r_j_total_phi a owl:ObjectProperty ;
    rdfs:label "r_j_total_phi" ;
    skos:definition "Toroidal component of the current density multiplied by the local major radius, given on various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-1" .

fyo:r_outboard a owl:DatatypeProperty ;
    rdfs:label "r_outboard" ;
    skos:definition "Radial coordinate (major radius) on the outboard side of the magnetic axis" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:radial_coefficients a owl:DatatypeProperty ;
    rdfs:label "radial_coefficients" ;
    skos:definition "Interpolation coefficients for the radial component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "as_parent" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:reactants a owl:ObjectProperty ;
    rdfs:label "reactants" ;
    skos:definition "Set of reactants involved in this process" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "5" .

fyo:readback a owl:ObjectProperty ;
    rdfs:label "readback" ;
    skos:definition "Plugins to be used to read back a node (potentially, multiple plugins can be applied, listed in reverse order of application)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:real0d a owl:ObjectProperty ;
    rdfs:label "real0d" ;
    skos:definition "Set of real type scalar control parameters" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:reciprocating a owl:ObjectProperty ;
    rdfs:label "reciprocating" ;
    skos:definition "Set of reciprocating probes" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:recycling_energy_coefficient a owl:DatatypeProperty ;
    rdfs:label "recycling_energy_coefficient" ;
    skos:definition "Energy recycling coefficient corresponding to the conversion into various neutral types (first dimension: 1: cold; 2: thermal; 3: fast)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...3" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...3,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:recycling_particles_coefficient a owl:DatatypeProperty ;
    rdfs:label "recycling_particles_coefficient" ;
    skos:definition "Particle recycling coefficient corresponding to the conversion into various neutral types (first dimension: 1: cold; 2: thermal; 3: fast)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...3" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...3,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:reflector a owl:ObjectProperty ;
    rdfs:label "reflector" ;
    skos:definition "Set of reflectors (optional) reflecting the light coming from the plasma towards the crystal. If empty, means that the plasma light directly arrives on the crystal." ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:refractive_index a owl:DatatypeProperty ;
    rdfs:label "refractive_index" ;
    skos:definition "Refractive index (for metal and dielectric)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelengths" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:region_of_interest a owl:ObjectProperty ;
    rdfs:label "region_of_interest" ;
    skos:definition "Set of regions of interest for the real-time monitoring of machine protection. Regions of interest are defined by a combination of polygons for each image" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:relative_permeability a owl:DatatypeProperty ;
    rdfs:label "relative_permeability" ;
    skos:definition "Relative permeability as a function of the magnetic field" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../b_field" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../b_field" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:release a owl:ObjectProperty ;
    rdfs:label "release" ;
    skos:definition "List of available releases of the AMNS data; each element contains information about the AMNS data that is included in the release. This part of the IDS is filled and stored only into shot/run=0/1, playing the role of a catalogue." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:residual_spectrum a owl:ObjectProperty ;
    rdfs:label "residual_spectrum" ;
    skos:definition "Set of entire mass spectra recorded at various time slices" ;
    skos:inScheme fyo:spectrometer_mass ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:response_function a owl:DatatypeProperty ;
    rdfs:label "response_function" ;
    skos:definition "Number of events occurring in the detector from one neutron energy bin emitted by the current plasma voxel towards the detector" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../../field_of_view/emission_grid/r" ;
    fyo:dd_coordinate2 "../../field_of_view/emission_grid/z" ;
    fyo:dd_coordinate3 "../../field_of_view/emission_grid/phi" ;
    fyo:dd_coordinate4 "../source_neutron_energies" ;
    fyo:dd_coordinate5 "../event_in_detector_response_function/values" ;
    fyo:dd_ndim 5 ;
    fyo:dd_type "static" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../field_of_view/emission_grid/r,../../field_of_view/emission_grid/z,../../field_of_view/emission_grid/phi,../source_neutron_energies,../event_in_detector_response_function/values" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:response_function_integrated_flags a owl:DatatypeProperty ;
    rdfs:label "response_function_integrated_flags" ;
    skos:definition "Array of flags telling, for each coordinate of the response_function, whether the response_function has been integrated over this coordinate (1) or not (0). If it has been integrated over a coordinate, the size related to this coordinate must be equal to 1" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "1...5" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...5" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:restart_files a owl:ObjectProperty ;
    rdfs:label "restart_files" ;
    skos:definition "Set of code-specific restart files for a given time slice. These files are managed by a physical application to ensure its restart during long simulations" ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:rho_tor_norm_drift a owl:DatatypeProperty ;
    rdfs:label "rho_tor_norm_drift" ;
    skos:definition "Difference to due ExB drifts between the ablation and the final deposition locations, in terms of the normalized toroidal flux coordinate" ;
    skos:inScheme fyo:pellets ;
    fyo:dd_coordinate1 "../distance" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../distance" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:rho_tor_norm_inversion a owl:DatatypeProperty ;
    rdfs:label "rho_tor_norm_inversion" ;
    skos:definition "Normalized toroidal flux coordinate at inversion radius" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:rho_tor_norm_mixing a owl:DatatypeProperty ;
    rdfs:label "rho_tor_norm_mixing" ;
    skos:definition "Normalized toroidal flux coordinate at mixing radius" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:rho_tor_norm_q1 a owl:DatatypeProperty ;
    rdfs:label "rho_tor_norm_q1" ;
    skos:definition "Normalized toroidal flux coordinate at surface q = 1" ;
    skos:inScheme fyo:sawteeth ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:rho_volume_norm a owl:DatatypeProperty ;
    rdfs:label "rho_volume_norm" ;
    skos:definition "Normalized square root of enclosed volume (radial coordinate). The normalizing value is the enclosed volume at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:ripple_amplitude a owl:DatatypeProperty ;
    rdfs:label "ripple_amplitude" ;
    skos:definition "Value of (b_field_max-b_field_min)/(b_field_max+b_field_min), where b_field_max resp. b_field_min) is the maximum (resp. minimum) of the magnetic field amplitude over a 2pi rotation in toroidal angle phi at a given R, Z position." ;
    skos:inScheme fyo:b_field_non_axisymmetric ;
    fyo:dd_coordinate1 "../grid/r" ;
    fyo:dd_coordinate2 "../grid/z" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../grid/r,../grid/z" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:rogowski_coil a owl:ObjectProperty ;
    rdfs:label "rogowski_coil" ;
    skos:definition "Set of Rogowski coils. If some of the coils form a compound Rogowski sensor, they must be entered in contiguous order" ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:rotation_angle a owl:DatatypeProperty ;
    rdfs:label "rotation_angle" ;
    skos:definition "Angular displacement with respect to the reference position, counter-clockwise around the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:roughness a owl:DatatypeProperty ;
    rdfs:label "roughness" ;
    skos:definition "Roughness parameter of the material. Varies in range [0, 1]. 0 is perfectly specular, 1 is perfectly rough" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelengths" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:row a owl:ObjectProperty ;
    rdfs:label "row" ;
    skos:definition "Set of horizontal rows of waveguides (corresponding to different poloidal positions). A power spectrum is provided for each row." ;
    skos:inScheme fyo:lh_antennas ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "6" .

fyo:sample a owl:DatatypeProperty ;
    rdfs:label "sample" ;
    skos:definition "Index of sample (time stamp counter)" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "../time_stamp" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "../time_stamp" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:saturated_relative_permeability a owl:DatatypeProperty ;
    rdfs:label "saturated_relative_permeability" ;
    skos:definition "Saturated relative magnetic permeability of each element" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../centroid/x" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "H.m^-1" ;
    fyo:fyo_domain "../centroid/x" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:scattering_angle a owl:DatatypeProperty ;
    rdfs:label "scattering_angle" ;
    skos:definition "Angle formed by the laser beam wave vector and the line of sight, counted clockwise when projected in the poloidal plane" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "../../laser" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_domain "../../laser" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:segment a owl:ObjectProperty ;
    rdfs:label "segment" ;
    skos:definition "The iron core is describred as a set of segments" ;
    skos:inScheme fyo:iron_core ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "33" .

fyo:sensitivity a owl:DatatypeProperty ;
    rdfs:label "sensitivity" ;
    skos:definition "Photoelectric sensitivity of the detector. This is the conversion factor from the received power on the detector into electric voltage depending on the wavelength" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "V.W^-1" ;
    fyo:fyo_domain "../wavelengths" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:sensor a owl:ObjectProperty ;
    rdfs:label "sensor" ;
    skos:definition "Set of sensors" ;
    skos:inScheme fyo:operational_instrumentation ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "150" .

fyo:shape_coefficients_c a owl:DatatypeProperty ;
    rdfs:label "shape_coefficients_c" ;
    skos:definition "'c' coefficients in the formula defining the shape of the flux surface" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:shape_coefficients_s a owl:DatatypeProperty ;
    rdfs:label "shape_coefficients_s" ;
    skos:definition "'s' coefficients in the formula defining the shape of the flux surface" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:shunt a owl:ObjectProperty ;
    rdfs:label "shunt" ;
    skos:definition "Set of shunt resistances through which currents in the divertor structure are measured. Shunts are modelled as piecewise straight line segments in the poloidal plane." ;
    skos:inScheme fyo:magnetics ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "50" .

fyo:signal a owl:ObjectProperty ;
    rdfs:label "signal" ;
    skos:definition "List of signals that are allocated to the PCS interface" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:signal_to_noise a owl:DatatypeProperty ;
    rdfs:label "signal_to_noise" ;
    skos:definition "Log10 of the ratio of the powers in two bands, one with the spectral lines of interest (signal) the other without spectral lines (noise)." ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "dB" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:solver_1d a owl:ObjectProperty ;
    rdfs:label "solver_1d" ;
    skos:definition "Numerics related to 1D radial solver, for various time slices." ;
    skos:inScheme fyo:transport_solver_numerics ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:solver_selection a owl:DatatypeProperty ;
    rdfs:label "solver_selection" ;
    skos:definition "Solver plugin names this scenario binds (FyModule prefix keys), e.g. fyeq / fytrans / freegs." ;
    skos:inScheme fyo:scenario .

fyo:source_neutron_energies a owl:DatatypeProperty ;
    rdfs:label "source_neutron_energies" ;
    skos:definition "Array of source neutron energy bins" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "eV" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:sputtering_chemical a owl:DatatypeProperty ;
    rdfs:label "sputtering_chemical" ;
    skos:definition "Effective coefficient of chemical sputtering due to this incident species. It is assumed that all sputtered neutrals from the wall have the wall temperature (cold neutrals)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:sputtering_chemical_coefficient a owl:DatatypeProperty ;
    rdfs:label "sputtering_chemical_coefficient" ;
    skos:definition "Effective coefficient of chemical sputtering for various neutral types (first dimension: 1: cold; 2: thermal; 3: fast), due to this incident species" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...3" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...3,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:sputtering_physical a owl:DatatypeProperty ;
    rdfs:label "sputtering_physical" ;
    skos:definition "Effective coefficient of physical sputtering due to this incident species. It is assumed that all sputtered neutrals from the wall have the wall temperature (cold neutrals)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "../angles" ;
    fyo:dd_coordinate2 "../energies" ;
    fyo:dd_coordinate3 "/time" ;
    fyo:dd_ndim 3 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../angles,../energies,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:sputtering_physical_coefficient a owl:DatatypeProperty ;
    rdfs:label "sputtering_physical_coefficient" ;
    skos:definition "Effective coefficient of physical sputtering for various neutral types (first dimension: 1: cold; 2: thermal; 3: fast), due to this incident species and for various energies (second dimension)" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...3" ;
    fyo:dd_coordinate2 "../energies" ;
    fyo:dd_coordinate3 "/time" ;
    fyo:dd_ndim 3 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...3,../energies,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:state_names a owl:DatatypeProperty ;
    rdfs:label "state_names" ;
    skos:definition "Names of the states" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:statistics_type a owl:ObjectProperty ;
    rdfs:label "statistics_type" ;
