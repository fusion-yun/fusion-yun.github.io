    skos:definition "Total ohmic cumulated energy (integral of the power over the disruption duration)" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:energy_ohm_halo a owl:DatatypeProperty ;
    rdfs:label "energy_ohm_halo" ;
