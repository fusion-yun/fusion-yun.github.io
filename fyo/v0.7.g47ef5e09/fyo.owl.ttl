fyo:edges a owl:DatatypeProperty ;
    rdfs:label "edges" ;
    skos:definition "Edges connect nodes to one another. A single node may connect to multiple edges such as the case where a single maximum (a hill) may topologically link to multiple minima (the floors of different valleys). For each edge (1st dimension), the index of the two connected nodes are listed (index referring to the ../node array)" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...2" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_domain "1...N,1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:eigenmode a owl:ObjectProperty ;
    rdfs:label "eigenmode" ;
    skos:definition "Set of eigenmode for this wavector" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "5" .

fyo:ellipticity_angle a owl:DatatypeProperty ;
    rdfs:label "ellipticity_angle" ;
    skos:definition "Poincare sphere angle chi for mixed mode" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "rad" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:em_force_density a owl:ObjectProperty ;
    rdfs:label "em_force_density" ;
    skos:definition "Electromagnetic force density computed by the cross-product of j_total x b_field and given on various grid subsets" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "N.m^-3" .

fyo:embedded a owl:ObjectProperty ;
    rdfs:label "embedded" ;
    skos:definition "Set of embedded (in a plasma facing component) probes" ;
    skos:inScheme fyo:langmuir_probes ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "100" .

fyo:emissivity_dd a owl:DatatypeProperty ;
    rdfs:label "emissivity_dd" ;
    skos:definition "Emissivity profile due to DD reactions" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-3.s^-1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:emissivity_dd_accuracy a owl:DatatypeProperty ;
    rdfs:label "emissivity_dd_accuracy" ;
    skos:definition "Accuracy profile of reconstructed DD emissivity with respect to true DD emissivity. The accuracy is obtained by comparing the reconstructed emissivity profile and the emissivity profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:emissivity_dt a owl:DatatypeProperty ;
    rdfs:label "emissivity_dt" ;
    skos:definition "Emissivity profile due to DT reactions" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-3.s^-1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:emissivity_dt_accuracy a owl:DatatypeProperty ;
    rdfs:label "emissivity_dt_accuracy" ;
    skos:definition "Accuracy profile of reconstructed DT emissivity with respect to true DT emissivity. The accuracy is obtained by comparing the reconstructed emissivity profile and the emissivity profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
    skos:inScheme fyo:neutron_diagnostic ;
    fyo:dd_coordinate1 "../rho_tor_norm" ;
    fyo:dd_coordinate2 "/time" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../rho_tor_norm,/time" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:emissivity_ion_total a owl:DatatypeProperty ;
    rdfs:label "emissivity_ion_total" ;
    skos:definition "Emissivity (summed over ion  species)" ;
