fyo:kr a owl:DatatypeProperty ;
    rdfs:label "kr" ;
    skos:definition "Component along the major radius" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:kz a owl:DatatypeProperty ;
    rdfs:label "kz" ;
    skos:definition "Component along the vertical direction" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:laser a owl:ObjectProperty ;
    rdfs:label "laser" ;
    skos:definition "Set of probing lasers" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "3" .

fyo:layer a owl:ObjectProperty ;
    rdfs:label "layer" ;
    skos:definition "Set of layers in the blanket module" ;
    skos:inScheme fyo:breeding_blanket ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "6" .

fyo:lengths a owl:DatatypeProperty ;
    rdfs:label "lengths" ;
    skos:definition "Length of each field line" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_coordinate1 "../starting_positions/r" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../starting_positions/r" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:limit_max a owl:DatatypeProperty ;
    rdfs:label "limit_max" ;
    skos:definition "Maximum force limit, for each limit (line of the combination matrix). EMPTY_FLT value means unbounded" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "N" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:limit_min a owl:DatatypeProperty ;
    rdfs:label "limit_min" ;
    skos:definition "Minimum force limit, for each limit (line of the combination matrix). EMPTY_FLT value means unbounded" ;
    skos:inScheme fyo:pf_active ;
    fyo:dd_coordinate1 "../limit_max" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "N" ;
    fyo:fyo_domain "../limit_max" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:linear_controller a owl:ObjectProperty ;
    rdfs:label "linear_controller" ;
    skos:definition "A linear controller, this is rather conventional" ;
    skos:inScheme fyo:controllers ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:listeners a owl:DatatypeProperty ;
    rdfs:label "listeners" ;
    skos:definition "Systems listening to this event" ;
    skos:inScheme fyo:pulse_schedule ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:loop a owl:ObjectProperty ;
    rdfs:label "loop" ;
    skos:definition "Passive axisymmetric conductor description in the form of non-connected loops; any connected loops are expressed as active coil circuits with no power supply attached." ;
    skos:inScheme fyo:pf_passive ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "500" .

fyo:luminance_to_temperature a owl:DatatypeProperty ;
    rdfs:label "luminance_to_temperature" ;
