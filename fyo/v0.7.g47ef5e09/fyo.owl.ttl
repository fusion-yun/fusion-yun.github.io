    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...2" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:magnetic_moment_phi a owl:DatatypeProperty ;
    rdfs:label "magnetic_moment_phi" ;
    skos:definition "Toroidal component of the magnetic moment of each element" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../../centroid/x" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../../centroid/x" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:magnetic_moment_r a owl:DatatypeProperty ;
    rdfs:label "magnetic_moment_r" ;
    skos:definition "R component of the magnetic moment of each element" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../../centroid/x" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../../centroid/x" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:magnetic_moment_z a owl:DatatypeProperty ;
    rdfs:label "magnetic_moment_z" ;
    skos:definition "Z component of the magnetic moment of each element" ;
    skos:inScheme fyo:ferritic ;
    fyo:dd_coordinate1 "../../centroid/x" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../../centroid/x" ;
