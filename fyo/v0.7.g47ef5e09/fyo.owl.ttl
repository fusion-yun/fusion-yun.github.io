fyo:tangency_radii a owl:DatatypeProperty ;
    rdfs:label "tangency_radii" ;
    skos:definition "Tangency radius (major radius where the central line of a beamlet is tangent to a circle around the torus), for each beamlet" ;
    skos:inScheme fyo:nbi ;
    fyo:dd_coordinate1 "../positions/r" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "../positions/r" ;
    fyo:fyo_lift "field" ;
