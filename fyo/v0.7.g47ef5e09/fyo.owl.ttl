fyo:GenericGridDynamicGridSubsetElementObject a owl:Class ;
    rdfs:label "GenericGridDynamicGridSubsetElementObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:space ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:dimension ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:space ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:space ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:index ],
        spo:InformationContentEntity ;
    skos:definition "Set of objects defining the element" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "16" ;
    fyo:dd_type_name "generic_grid_dynamic_grid_subset_element_object" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:GenericGridDynamicSpaceDimension a owl:Class ;
    rdfs:label "GenericGridDynamicSpaceDimension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:geometry_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Identifier ;
            owl:onProperty fyo:geometry_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:GenericGridDynamicSpaceDimensionObject ;
            owl:onProperty fyo:object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:geometry_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:object ],
        spo:InformationContentEntity ;
    skos:definition "Definition of the space objects for every dimension (from one to the dimension of the highest-dimensional objects). The index correspond to 1=nodes, 2=edges, 3=faces, 4=cells/volumes, .... For every index, a collection of objects of that dimension is described." ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "16" ;
    fyo:dd_type_name "generic_grid_dynamic_space_dimension" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:GenericGridDynamicSpaceDimensionObject a owl:Class ;
    rdfs:label "GenericGridDynamicSpaceDimensionObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:GenericGridDynamicSpaceDimensionObjectBoundary ;
            owl:onProperty fyo:boundary ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:measure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:nodes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:boundary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:nodes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:measure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:geometry_2d ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:measure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:geometry_2d ],
        spo:InformationContentEntity ;
    skos:definition "Set of objects for a given dimension" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "16" ;
    fyo:dd_type_name "generic_grid_dynamic_space_dimension_object" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:GenericGridDynamicSpaceDimensionObjectBoundary a owl:Class ;
    rdfs:label "GenericGridDynamicSpaceDimensionObjectBoundary" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:neighbours ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:index ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:neighbours ],
        spo:InformationContentEntity ;
    skos:definition "Set of  (n-1)-dimensional objects defining the boundary of this n-dimensional object" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "16" ;
    fyo:dd_type_name "generic_grid_dynamic_space_dimension_object_boundary" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:GenericGridIdentifierSingle a owl:Class ;
    rdfs:label "GenericGridIdentifierSingle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom spo:Identifier ;
            owl:onProperty fyo:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:grid_subset_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:grid_subset_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:grid_subset_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:grid_index ],
        spo:InformationContentEntity ;
    skos:definition "The component type is given for various grid_subsets, using the identifier convention below" ;
    skos:inScheme fyo:wall ;
    fyo:dd_path "wall/description_ggd/component/type" ;
    fyo:dd_type_name "generic_grid_identifier_single" .

fyo:GenericGridInteger a owl:Class ;
    rdfs:label "GenericGridInteger" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:grid_index ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:grid_index ],
