    fyo:dd_units "eV" ;
    fyo:fyo_domain "1...N,../z_frames" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:energy_flux_max a owl:ObjectProperty ;
    rdfs:label "energy_flux_max" ;
    skos:definition "Maximum power density over a surface, for various surfaces (grid subsets)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "W.m^-2" .

fyo:energy_kinetic a owl:DatatypeProperty ;
    rdfs:label "energy_kinetic" ;
    skos:definition "Total runaway kinetic energy" ;
    skos:inScheme fyo:runaway_electrons ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
