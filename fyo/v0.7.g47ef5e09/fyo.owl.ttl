    fyo:dd_coordinate1 "../../length" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_domain "../../length" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:k_z_norm a owl:DatatypeProperty ;
    rdfs:label "k_z_norm" ;
    skos:definition "Normalized wave vector component in the vertical direction = k_z / norm(k)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../../length" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../length" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:kphi a owl:DatatypeProperty ;
    rdfs:label "kphi" ;
    skos:definition "Component along the toroidal direction" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "signal" ;
