    fyo:spo_class "spo:Function" .

fyo:topic a owl:ObjectProperty ;
    rdfs:label "topic" ;
    skos:definition "List of topics. Signals are grouped by topic" ;
    skos:inScheme fyo:real_time_data ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "20" .

fyo:torque_fast_tor a owl:DatatypeProperty ;
    rdfs:label "torque_fast_tor" ;
    skos:definition "Collisional toroidal torque density to the fast particle population" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_coordinate1 "../../../../../grid/r OR ../../../../../grid/rho_tor_norm" ;
    fyo:dd_coordinate2 "../../../../../grid/z OR ../../../../../grid/theta_geometric OR ../../../../../grid/theta_straight" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "N.m^-2" ;
    fyo:fyo_domain "../../../../../grid/r OR ../../../../../grid/rho_tor_norm,../../../../../grid/z OR ../../../../../grid/theta_geometric OR ../../../../../grid/theta_straight" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:total_heat_rejected a owl:DatatypeProperty ;
    rdfs:label "total_heat_rejected" ;
    skos:definition "Total heat flow being rejected from the thermal plant" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:total_heat_supplied a owl:DatatypeProperty ;
    rdfs:label "total_heat_supplied" ;
    skos:definition "Total heat flow being supplied to the thermal plant (fusion thermal power)" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "W" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:translation a owl:DatatypeProperty ;
    rdfs:label "translation" ;
    skos:definition "Linear displacement from reference position, along the direction vector" ;
    skos:inScheme fyo:ec_launchers ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:transmission_barrel a owl:DatatypeProperty ;
    rdfs:label "transmission_barrel" ;
    skos:definition "Transmission of the optical barrel" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:transmission_coefficient a owl:DatatypeProperty ;
    rdfs:label "transmission_coefficient" ;
    skos:definition "Transmission coefficient (for dielectric)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "../wavelengths" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../wavelengths" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:transmission_mirror a owl:DatatypeProperty ;
    rdfs:label "transmission_mirror" ;
    skos:definition "Transmission of the mirror" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:transmission_window a owl:DatatypeProperty ;
    rdfs:label "transmission_window" ;
    skos:definition "Transmission of the window" ;
    skos:inScheme fyo:camera_ir ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "1...N" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N,1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:trapped_fraction a owl:DatatypeProperty ;
    rdfs:label "trapped_fraction" ;
    skos:definition "Trapped particle fraction" ;
    skos:inScheme fyo:equilibrium ;
    fyo:dd_coordinate1 "../psi" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../psi" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:two_point_model a owl:ObjectProperty ;
    rdfs:label "two_point_model" ;
    skos:definition "Description of SOL according to the two point model, the downstream point being on this target, for various time slices" ;
    skos:inScheme fyo:divertors ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:types a owl:DatatypeProperty ;
    rdfs:label "types" ;
    skos:definition "Type of every element: 1: line segment, its ends are given by the start and end points; index = 2: arc of a circle; index = 3: full circle" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:uq_input_2d a owl:ObjectProperty ;
    rdfs:label "uq_input_2d" ;
    skos:definition "If the statistics are based on an uncertainty quantification process, set of 2D input quantities that are varied" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" .

fyo:v_biasing a owl:ObjectProperty ;
    rdfs:label "v_biasing" ;
    skos:definition "Electric potential applied to the wall element by outside means, for various wall components (grid subsets). Different from the plasma electric potential or the sheath potential drop." ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "V" .

fyo:v_parallel_energy_perpendicular a owl:DatatypeProperty ;
    rdfs:label "v_parallel_energy_perpendicular" ;
    skos:definition "Normalized moment (integral over 0.5 * m * v_par * v_perp^2)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../../../../species" ;
    fyo:dd_coordinate2 "../../angle_pol" ;
    fyo:dd_coordinate3 "../../time_norm" ;
    fyo:dd_ndim 3 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../../../../species,../../angle_pol,../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:v_perpendicular_square_energy a owl:DatatypeProperty ;
    rdfs:label "v_perpendicular_square_energy" ;
    skos:definition "Normalized moment (integral over 0.5 * m * v_perp^2 * v^2)" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "../../../../../species" ;
    fyo:dd_coordinate2 "../../angle_pol" ;
    fyo:dd_coordinate3 "../../time_norm" ;
    fyo:dd_ndim 3 ;
    fyo:dd_type "constant" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "../../../../../species,../../angle_pol,../../time_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:value_labels a owl:DatatypeProperty ;
    rdfs:label "value_labels" ;
    skos:definition "String description of discrete coordinate values (if interpolation_type=0). E.g., for spectroscopic lines, the spectroscopic description of the transition." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_coordinate1 "../values" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "../values" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:valve_indices a owl:DatatypeProperty ;
    rdfs:label "valve_indices" ;
    skos:definition "Indices (from the ../../valve array of structure) of the valve(s) that are feeding this pipe" ;
    skos:inScheme fyo:gas_injection ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:velocity_cold_neutrals a owl:DatatypeProperty ;
    rdfs:label "velocity_cold_neutrals" ;
    skos:definition "Projection of the cold neutral velocity along the line of sight, positive when going from first point to second point of the line of sight" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:velocity_hot_neutrals a owl:DatatypeProperty ;
    rdfs:label "velocity_hot_neutrals" ;
    skos:definition "Projection of the hot neutral velocity along the line of sight, positive when going from first point to second point of the line of sight" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m.s^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:velocity_mass_centre a owl:ObjectProperty ;
    rdfs:label "velocity_mass_centre" ;
    skos:definition "Velocity of the centre of mass of all the species (see equation 2 in the paper linked below), given on various grid subsets. It is defined as : rho.velocity_mass_centre = sum over all species (rho_species.velocity_species), where rho_species is the mass density of each species and rho = sum over all species (rho_species)" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "m.s^-1" .

fyo:velocity_over_b_field a owl:ObjectProperty ;
    rdfs:label "velocity_over_b_field" ;
    skos:definition "Velocity (average over states when multiple states are considered) divided by the modulus of the local magnetic field, given on various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "m.s^-1" .

fyo:velocity_parallel a owl:ObjectProperty ;
    rdfs:label "velocity_parallel" ;
    skos:definition "Parallel (to magnetic field) component of the plasma velocity, given on various grid subsets" ;
    skos:inScheme fyo:mhd ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "m.s^-1" .

fyo:viewing_angle_alpha_bounds a owl:DatatypeProperty ;
    rdfs:label "viewing_angle_alpha_bounds" ;
    skos:definition "Minimum and maximum values of alpha angle of the field of view, where alpha is the agle between the axis X3 and projection of the chord of view  on the plane X1X3 counted clockwise from the top view of X2 axis. X1, X2, X3 are the ones of the first aperture (i.e. the closest to the plasma)." ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:viewing_angle_beta_bounds a owl:DatatypeProperty ;
    rdfs:label "viewing_angle_beta_bounds" ;
    skos:definition "Minimum and maximum values of beta angle of the field of view, where beta is the angle between the axis X3 and projection of the chord of view on the plane X2X3 counted clockwise from the top view of X1 axis. X1, X2, X3 are the ones of the first aperture (i.e. the closest to the plasma)." ;
    skos:inScheme fyo:camera_visible ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "rad" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:wall_inventory a owl:DatatypeProperty ;
    rdfs:label "wall_inventory" ;
    skos:definition "Wall inventory, i.e. cumulated exchange of neutral species between plasma and wall from t = 0, positive if a species has gone to the wall, for that species" ;
    skos:inScheme fyo:wall ;
    fyo:dd_coordinate1 "/time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:wave a owl:ObjectProperty ;
    rdfs:label "wave" ;
    skos:definition "List all waves affecting the distribution, identified as in waves/coherent_wave(i)/identifier in the waves IDS" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:wavelength_band a owl:ObjectProperty ;
    rdfs:label "wavelength_band" ;
    skos:definition "Set of wavelength bands in which photons are counted by the polychromator" ;
    skos:inScheme fyo:thomson_scattering ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "8" .

fyo:wavelength_frames a owl:DatatypeProperty ;
    rdfs:label "wavelength_frames" ;
    skos:definition "Wavelength of incoming photons on each pixel of the frames, mainly varying accross the horizontal dimension of the frame. However a 2D map of the wavelength is given since it is not constant vertically due to the elliptical curvature of the photon iso-surfaces" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_coordinate2 "../z_frames" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...N,../z_frames" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Field" .

fyo:wavenumber a owl:DatatypeProperty ;
    rdfs:label "wavenumber" ;
    skos:definition "Wavenumber probed by the diagnostic" ;
    skos:inScheme fyo:reflectometer_fluctuation ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "m^-1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:wavevector a owl:ObjectProperty ;
    rdfs:label "wavevector" ;
    skos:definition "Set of wavevectors" ;
    skos:inScheme fyo:gyrokinetics_local ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "10" .

fyo:weights a owl:DatatypeProperty ;
    rdfs:label "weights" ;
    skos:definition "Weight of the markers, i.e. number of real particles represented by each marker. The dimension of the vector correspond to the number of markers" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:workflow_cycle a owl:ObjectProperty ;
    rdfs:label "workflow_cycle" ;
    skos:definition "Set of time slices corresponding to the beginning of workflow cycles (main time loop of the workflow). During each workflow cycle, active components compute their result during their given time_interval. Components having completed their computation are frozen until the end of the workflow cycle. The next workflow cycle begins when the maximum time_interval (over the components) has been reached." ;
    skos:inScheme fyo:workflow ;
    fyo:dd_coordinate1 "time" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_type "dynamic" ;
    fyo:fyo_layout "aos" .

fyo:z_frames a owl:DatatypeProperty ;
    rdfs:label "z_frames" ;
    skos:definition "Height of the observed zone at the focal plane in the plasma, corresponding to the vertical dimension of the frame" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:dd_units "m" ;
    fyo:fyo_domain "1...N" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:z_pixel_range a owl:DatatypeProperty ;
    rdfs:label "z_pixel_range" ;
    skos:definition "Vertical pixel index range indicating the corresponding binned detector area" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_coordinate1 "1...2" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "static" ;
    fyo:fyo_domain "1...2" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

spo:ControlledVocabulary a owl:Class ;
    rdfs:label "ControlledVocabulary" ;
    rdfs:subClassOf spo:InformationContentEntity ;
    skos:definition "A controlled vocabulary (the determinable). Its permissible values are the determinates (DD *_identifier.xml entries)." ;
    skos:inScheme spo:vocab .

spo:GenericallyDependentContinuant a owl:Class ;
    rdfs:label "GenericallyDependentContinuant" ;
    rdfs:subClassOf spo:Continuant,
        spo:InformationContentEntity ;
    skos:definition "A continuant that can be copied across bearers (BFO GDC). Base of information artifacts and scenarios." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:inScheme spo:core .

spo:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:metric_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:metric_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:of_coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:metric_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:CoordinateSystem ;
            owl:onProperty spo:of_coordinate_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:of_coordinate_system ],
        spo:InformationContentEntity ;
    skos:definition "The metric tensor g_ij of a CoordinateSystem — the first fundamental form giving the line element ds² = g_ij dx^i dx^j, the volume element √det g, and (via its inverse g^ij) the Hodge star used by sp_mathx DEC. Identity for Cartesian charts; diagonal for the standard curvilinear charts. Carrier sp_mathx metric.Metric." ;
    skos:inScheme spo:geometry .

spo:SpecificallyDependentContinuant a owl:Class ;
    rdfs:label "SpecificallyDependentContinuant" ;
    rdfs:subClassOf spo:Continuant,
        spo:Quality ;
    skos:definition "A continuant that depends on one specific bearer (BFO SDC)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:inScheme spo:core .

spo:TimeInstant a owl:Class ;
    rdfs:label "TimeInstant" ;
    rdfs:subClassOf spo:TemporalRegion ;
    skos:definition "A zero-dimensional temporal region (BFO temporal instant) — the referent of one time-slice timestamp. A `time_slice[i]/time` value denotes a TimeInstant on the shot/simulation timeline." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000148> ;
    skos:inScheme spo:time .

spo:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval" ;
    rdfs:subClassOf spo:TemporalRegion ;
    skos:definition "A one-dimensional temporal region (BFO temporal interval) — the extent a Signal or a discharge phase covers (e.g. flat-top). A TimeAxis discretizes a TimeInterval." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:inScheme spo:time .

spo:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:ucum_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:ucum_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:ucum_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:QuantityKind ;
            owl:onProperty spo:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:quantity_kind ],
        spo:InformationContentEntity ;
    skos:definition "A measurement unit as an ICE — carrier of the UCUM code / QUDT IRI the `unit` strings across Spo schemas point into. Authority is the external unit system (UCUM/QUDT via the SpData `sp:phys` registry); this class is the T-Box landing, not a unit database." ;
    skos:exactMatch <http://qudt.org/schema/qudt/Unit> ;
    skos:inScheme spo:quantity .

spo:coordinate_axis a owl:DatatypeProperty ;
    rdfs:label "coordinate_axis" ;
    rdfs:range xsd:string ;
    skos:definition "An ordered coordinate axis of the chart. Values draw on the ContinuousCoordinate vocabulary (x / y / z / r / z / phi / theta / psi …). Each axis carries a physical unit." ;
    skos:inScheme spo:geometry .

spo:equivalent_representation a owl:ObjectProperty ;
    rdfs:label "equivalent_representation" ;
    rdfs:range spo:ContinuousQuantity ;
    skos:definition "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
    skos:inScheme spo:domain ;
    fyo:symmetric "true" .

spo:has_channel a owl:ObjectProperty ;
    rdfs:label "has_channel" ;
    rdfs:range spo:Signal ;
    skos:definition "The per-quantity Signal channels of this SoA aggregate." ;
    skos:inScheme spo:time .

spo:has_slice a owl:ObjectProperty ;
    rdfs:label "has_slice" ;
    rdfs:range spo:TimeSlice ;
    skos:definition "The ordered TimeSlice elements (AoS axis; order = TimeAxis order)." ;
    skos:inScheme spo:time .

spo:uses_library a owl:ObjectProperty ;
    rdfs:label "uses_library" ;
    rdfs:range spo:Library ;
    skos:definition "A library this code depends on." ;
    skos:inScheme spo:provenance .

fyo:Complex2dDynamicAosMhdLinearVector a owl:Class ;
    rdfs:label "Complex2dDynamicAosMhdLinearVector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coefficients_real ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:real ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:coefficients_real ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:imaginary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:imaginary ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:real ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coefficients_imaginary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:coefficients_imaginary ],
        spo:InformationContentEntity ;
    skos:definition "First coordinate (radial)" ;
    skos:inScheme fyo:mhd_linear ;
    fyo:dd_path "mhd_linear/time_slice/toroidal_mode/plasma/a_field_perturbed/coordinate1" ;
    fyo:dd_type_name "complex_2d_dynamic_aos_mhd_linear_vector" .

fyo:Complex3dMhdStressTensor a owl:Class ;
    rdfs:label "Complex3dMhdStressTensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
