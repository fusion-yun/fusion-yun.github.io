fyo:EngineeringLimitSet a owl:Class ;
    rdfs:label "EngineeringLimitSet" ;
    rdfs:subClassOf spo:InformationContentEntity ;
    skos:definition "The per-channel engineering operating-limit set of a Machine — per-coil current / voltage / stored energy / temperature rise / force limits, wall heat-load limits — the in-scope engineering face of the in/port/out boundary (limits are IN; whole-machine design is via ports; cost and buildings are OUT — FYTOK-ADR-119 D3/D4). About the machine (is_about); consumed by S-10 verification and S-11 feasibility screening." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/discharge_design> ;
    fyo:adr_ref "FYTOK-ADR-119 D4" .

