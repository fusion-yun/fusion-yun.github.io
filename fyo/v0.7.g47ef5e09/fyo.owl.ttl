        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:consumes_ids ],
        [ owl:unionOf ( fyo:EquilibriumSolve fyo:TransportSolve ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:produces_ids ],
        spo:ComputationalProcess ;
    skos:definition "One invocation of a pluggable solver inside a scenario loop — the solver is bound by plugin name (FyModule), calls the SpModel numerical substrate, and writes its result back to the corresponding IDS occurrence (enabling-core G-2: pluggable, never special-cased in the framework)." ;
    skos:inScheme fyo:scenario .

