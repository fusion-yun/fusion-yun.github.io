fyo:Distributions a owl:Class ;
    rdfs:label "Distributions" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:vacuum_toroidal_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:magnetic_axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IdsProperties ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IdsCode ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:BTorVacuum1 ;
            owl:onProperty fyo:vacuum_toroidal_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:vacuum_toroidal_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:distribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:magnetic_axis ],
        [ a owl:Restriction ;
