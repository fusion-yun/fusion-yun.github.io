            owl:onProperty fyo:type ],
        spo:InformationContentEntity ;
    skos:definition "Instrument function for this bin (replaces the ../../instrument function in case vertical binning is used), i.e. response of the detector to a monochromatic emission passing through the spectrometer. The resulting image on the detector will be a 2-D distribution of pixel values, for each wavelength. It can be given as explicit values for each detector pixel (values node) or as a parametric function of wavelength (described by the other nodes)" ;
    skos:inScheme fyo:spectrometer_x_ray_crystal ;
    fyo:dd_path "spectrometer_x_ray_crystal/channel/bin/instrument_function" ;
    fyo:dd_type_name "spectrometer_x_ray_crystal_instrument_func_bin" .

