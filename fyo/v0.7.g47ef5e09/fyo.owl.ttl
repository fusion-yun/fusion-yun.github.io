            owl:onProperty fyo:metastable_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:mass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:metastable_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:charge ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:mass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:multiplicity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:relative_charge ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:multiplicity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:metastable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:element ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
