spo:Continuant a owl:Class ;
    rdfs:label "Continuant" ;
    rdfs:subClassOf [ owl:unionOf ( spo:GenericallyDependentContinuant spo:IndependentContinuant spo:SpecificallyDependentContinuant ) ],
        spo:Entity ;
    skos:definition "An entity that persists through time keeping its identity, with no temporal parts (BFO continuant)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:inScheme spo:core .

spo:ContinuousQuantity a owl:Class ;
    rdfs:label "ContinuousQuantity" ;
    rdfs:subClassOf [ owl:unionOf ( spo:Field spo:Signal ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:inheres_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Domain ;
            owl:onProperty spo:has_domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:MaterialEntity ;
            owl:onProperty spo:inheres_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:inheres_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:is_function_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Domain ;
            owl:onProperty spo:is_function_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:equivalent_representation ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Quality ;
            owl:onProperty spo:representation_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:representation_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:representation_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:is_function_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:ContinuousQuantity ;
            owl:onProperty spo:equivalent_representation ],
        spo:InformationContentEntity ;
    skos:definition "A continuous physical quantity defined over a Domain — scalar or tensor (the information content of a Quality that is_function_of the Domain and inheres_in a MaterialEntity, C-4). Field (space / general domain) and Signal (time domain) are its sibling specializations. MULTI-REPRESENTATION: one Quality may be re-presented by several ContinuousQuantity instances on different Domains / grids / charts (DD equilibrium profiles_2d[i] per grid_type) — each carries representation_of to the shared Quality and equivalent_representation to its peers; the representations differ in discretization, not in referent." ;
    skos:inScheme spo:domain .

spo:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ owl:unionOf ( spo:Continuant spo:Occurrent ) ] ;
    skos:definition "Anything that exists (BFO entity) — the common root of Continuant and Occurrent. Added as the range of cross-quadrant relations (is_about can target matter, qualities, or processes alike)." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:inScheme spo:core .

spo:GeoObject a owl:Class ;
    rdfs:label "GeoObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:manifold_dim ],
        [ owl:unionOf ( spo:Curve spo:Point spo:Solid spo:Surface ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty spo:manifold_dim ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:manifold_dim ],
        spo:Geometry ;
    skos:definition "Base of geometric primitives; the concrete carrier is sp_mathx (``geom.base.GeoObject`` — control-point ``points`` array, pluggable ``GeometryKernel`` engine). Manifold dimension distinguishes the four concrete children below (SPM-SDD-06 DE-MATHX-05)." ;
    skos:inScheme spo:geometry .

spo:Geometry a owl:Class ;
    rdfs:label "Geometry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:geometry_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:geometry_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:CoordinateSystem ;
            owl:onProperty spo:has_coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:describes_region ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_coordinate_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:SpatialRegion ;
            owl:onProperty spo:describes_region ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:geometry_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_coordinate_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:describes_region ],
        spo:InformationContentEntity ;
    skos:definition "An information content entity describing the geometry of a SpatialRegion (C-5). Bound to a sp_mathx GeoObject." ;
    skos:inScheme spo:geometry .

spo:ImmaterialEntity a owl:Class ;
    rdfs:label "ImmaterialEntity" ;
    rdfs:subClassOf [ owl:unionOf ( spo:ContinuantFiatBoundary spo:Domain spo:Region ) ],
        spo:IndependentContinuant ;
    skos:definition "An independent continuant with no material parts (BFO immaterial entity). Base of regions / sites." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:inScheme spo:core .

spo:Library a owl:Class ;
    rdfs:label "Library" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:repository ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:repository ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:commit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:commit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:commit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:repository ],
        spo:InformationContentEntity ;
    skos:definition "A dependency library used by a Code (DD code/library[]) — a prov:SoftwareAgent." ;
    skos:inScheme spo:provenance .

spo:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:subClassOf [ owl:unionOf ( spo:SpacetimeRegion spo:SpatialRegion spo:TemporalRegion ) ],
        spo:ImmaterialEntity ;
    skos:definition "Base of spatial / temporal / spatiotemporal regions." ;
    skos:inScheme spo:core .

spo:TemporalAggregate a owl:Class ;
    rdfs:label "TemporalAggregate" ;
    rdfs:subClassOf [ owl:unionOf ( spo:TimeSeries spo:TimeSliceSeries ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:TimeAxis ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:about_occurrent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:about_occurrent ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Occurrent ;
            owl:onProperty spo:about_occurrent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:dual_view_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:TemporalAggregate ;
            owl:onProperty spo:dual_view_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:dual_view_of ],
        spo:InformationContentEntity ;
    skos:definition "A temporally indexed information aggregate — the information content of a temporally extended referent (a SpacetimeWorm / Process) sampled on a TimeAxis. Abstract parent of the two LAYOUTS of the same content: TimeSliceSeries (AoS) and TimeSeries (SoA). The layout choice is representational, orthogonal to the referent's identity." ;
    skos:inScheme spo:time .

fyo:ApplicationTask a owl:Class ;
    rdfs:label "ApplicationTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:uses_forward_operator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:converges_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:realizes_scenario ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:free_variables ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:ConvergenceCriterion ;
            owl:onProperty fyo:converges_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:converges_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:performed_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:performed_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:free_variables ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:Machine ;
            owl:onProperty fyo:performed_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:uses_forward_operator ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:ForwardOperator ;
            owl:onProperty fyo:uses_forward_operator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:realizes_scenario ],
        [ owl:unionOf ( fyo:ControlSimulationTask fyo:DeviceParameterOptimizationTask fyo:DischargeOperationDesignTask fyo:ExperimentAnalysisTask fyo:PhysicsModelingTask ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:consumes_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:ScenarioSpecification ;
            owl:onProperty fyo:realizes_scenario ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:consumes_ids ],
        spo:ComputationalProcess ;
    skos:definition "An end-to-end FyTok application task run — the abstract parent of the five CONOPS application-task scenarios (S-7 physics modeling, S-8 experiment analysis, S-9 control simulation, S-10 discharge operation design, S-11 device parameter optimization). A planned computational process performed on (or for) a Machine, realizing a ScenarioSpecification, consuming and producing IDS occurrences, and stacking its task-specific outer operators on the ONE shared ForwardOperator. The five subtypes are distinguished by their method / outer operator and by what is free — never by owning a private forward kernel." ;
    skos:inScheme fyo:scenario ;
    fyo:conops_ref "FYTOK-CONOPS-00 §conops-fytok-scope-tasks (tbl-conops-fytok-app-tasks)" .

