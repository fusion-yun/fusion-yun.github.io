fyo:DistributionMarkersOrbit a owl:Class ;
    rdfs:label "DistributionMarkersOrbit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:m_pol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:n_phi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:n_phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:expressions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:expressions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:m_pol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:bounce_harmonics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:bounce_harmonics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:values ],
        spo:InformationContentEntity ;
    skos:definition "Integrals along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral (f(n_tor,m_pol,k,eq,...) dt) from time - tau to time, where tau is the transit/trapping time of the marker and f() a dimensionless function (phase factor,drift,etc) of the equilibrium (e.g. q) and perturbation (Fourier harmonics n_tor,m_pol and bounce harmonic k) along the particles orbits. In fact the integrals are taken during the last orbit of each marker at the time value of the time node bel" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "3" ;
    fyo:dd_type_name "distribution_markers_orbit" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

fyo:DistributionMarkersOrbitInstant a owl:Class ;
    rdfs:label "DistributionMarkersOrbitInstant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:time_orbit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:expressions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:time_orbit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:expressions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:values ],
        spo:InformationContentEntity ;
    skos:definition "Integrals/quantities along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral ( f(eq) dt) from time - tau to time_orbit for different values of time_orbit in the interval from time - tau to time, where tau is the transit/trapping time of the marker and f(eq) a dimensionless function (phase, drift,q,etc) of the equilibrium along the markers orbits. The integrals are taken during the last orbit of each marker at the time value of the time node below" ;
    skos:inScheme fyo:common ;
    fyo:dd_shared_in "3" ;
    fyo:dd_type_name "distribution_markers_orbit_instant" ;
    fyo:fyo_lift "shared:InformationContentEntity" .

