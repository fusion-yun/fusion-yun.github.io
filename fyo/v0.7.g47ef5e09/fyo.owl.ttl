    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:energy_parallel_halo a owl:DatatypeProperty ;
    rdfs:label "energy_parallel_halo" ;
    skos:definition "Cumulated parallel energy (integral of the heat flux parallel power over the disruption duration) in the halo region" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "J" ;
    fyo:fyo_lift "signal" ;
