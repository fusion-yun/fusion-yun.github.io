fyo:ExperimentAnalysisTask a owl:Class ;
    rdfs:label "ExperimentAnalysisTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:measured_diagnostics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:misfit_report ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:reconstructed_profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:uses_inference_engine ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:measured_diagnostics ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:reconstructed_equilibrium ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:InferenceEngine ;
            owl:onProperty fyo:uses_inference_engine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:constraints_and_priors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:uses_inference_engine ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:machine_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:misfit_report ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:reconstructed_profiles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:reconstructed_equilibrium ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:misfit_report ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:reconstructed_profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:InformationContentEntity ;
            owl:onProperty fyo:constraints_and_priors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:reconstructed_equilibrium ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:MachineDescription ;
            owl:onProperty fyo:machine_description ],
        fyo:ApplicationTask ;
    skos:definition "An experiment-analysis / inversion run (S-8, primary). FUNCTION: assemble measured diagnostic IDS occurrences of one Discharge (via the data-adaptation face, S-5), pose the plasma configuration θ as the unknown, and minimize / infer over ℒ(θ)=‖F(θ)−d_obs‖²_Σ — where F is the SHARED forward operator composed with the diagnostic geometry / response (SyntheticDiagnosticEvaluation) — yielding reconstructed equilibrium and profiles with quantified misfit. Direction: inverse (d_obs → θ). The inference engine is exchangeable (least-squares / MAP / Bayesian / UQ) over the fixed forward spine. Inputs carry modality `measured`; outputs carry modality `reconstructed` (measured-derived) in their provenance." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:conops_scenario "S-8" ;
    fyo:free_variables_note "free = plasma configuration θ (equilibrium + profiles parameterization); fixed = machine, measured data" .

