fyo:temperature_hot_neutrals a owl:DatatypeProperty ;
    rdfs:label "temperature_hot_neutrals" ;
    skos:definition "Fit of hot neutrals temperature" ;
    skos:inScheme fyo:spectrometer_visible ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "eV" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:thermal_efficiency_cycle a owl:DatatypeProperty ;
    rdfs:label "thermal_efficiency_cycle" ;
    skos:definition "The fractional thermal effiency of the power cycle. Calculated as 1 - Q_out/Q_in" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:thermal_efficiency_plant a owl:DatatypeProperty ;
    rdfs:label "thermal_efficiency_plant" ;
    skos:definition "The fractional thermal effiency of the entire BOP thermal plant, inlcudes all of the individual cycles. Calculated as 1 - Q_out/Q_in" ;
    skos:inScheme fyo:balance_of_plant ;
    fyo:dd_coordinate1 "../time" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "1" ;
    fyo:fyo_lift "signal" ;
    fyo:spo_class "spo:Signal" .

fyo:tile a owl:ObjectProperty ;
    rdfs:label "tile" ;
