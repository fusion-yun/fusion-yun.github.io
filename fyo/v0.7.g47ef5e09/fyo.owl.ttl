        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:vacuum_toroidal_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:code ],
        fyo:IDS ;
    skos:definition "Core plasma transport of particles, energy, momentum and poloidal flux. The transport of particles, energy and momentum is described by diffusion coefficients, D, and convection velocities, v. These are defined by the total fluxes of particles, energy and momentum, across a flux surface given by : V' [-D Y' <|grad(rho_tor_norm)|^2> + v Y <|grad(rho_tor_norm)|>], where Y represents the particles, energy and momentum density, respectively, while V is the volume inside a flux surface, the primes de" ;
    skos:inScheme fyo:core_transport ;
    fyo:dd_path "core_transport" ;
    fyo:fyo_category "physics-state" .

