fyo:e_field_phi a owl:DatatypeProperty ;
    rdfs:label "e_field_phi" ;
    skos:definition "Toroidal component of the electric field" ;
    skos:inScheme fyo:plasma_initiation ;
    fyo:dd_coordinate1 "../grid/dim1" ;
    fyo:dd_coordinate2 "../grid/dim2" ;
    fyo:dd_ndim 2 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "V.m^-1" ;
