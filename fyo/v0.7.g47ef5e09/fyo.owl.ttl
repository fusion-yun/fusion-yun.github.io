fyo:j_pfirsch_schlueter a owl:ObjectProperty ;
    rdfs:label "j_pfirsch_schlueter" ;
    skos:definition "Current density due to Pfirsch-Schlüter effects, given on various grid subsets" ;
    skos:inScheme fyo:common ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-2" .

fyo:j_r a owl:ObjectProperty ;
    rdfs:label "j_r" ;
    skos:definition "R component of the current density, given on various grid subsets" ;
    skos:inScheme fyo:mhd ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-2" .

fyo:j_runaways a owl:DatatypeProperty ;
    rdfs:label "j_runaways" ;
    skos:definition "Runaways parallel current density = average(j.B) / B0, where B0 = Disruption/Vacuum_Toroidal_Field/ B0" ;
    skos:inScheme fyo:disruption ;
    fyo:dd_coordinate1 "../grid/rho_tor_norm" ;
    fyo:dd_ndim 1 ;
    fyo:dd_type "dynamic" ;
    fyo:dd_units "A.m^-2" ;
    fyo:fyo_domain "../grid/rho_tor_norm" ;
    fyo:fyo_lift "field" ;
    fyo:spo_class "spo:Function" .

fyo:j_z a owl:ObjectProperty ;
    rdfs:label "j_z" ;
    skos:definition "Z component of the current density, given on various grid subsets" ;
    skos:inScheme fyo:mhd ;
    fyo:dd_coordinate1 "1...N" ;
    fyo:dd_max_occurs "unbounded" ;
    fyo:dd_units "A.m^-2" .

fyo:k_phi a owl:DatatypeProperty ;
