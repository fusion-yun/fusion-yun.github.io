        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:gyro_type ],
        spo:InformationContentEntity ;
    skos:definition "Set of distribution functions. Every distribution function has to be associated with only one particle species, specified in distri_vec/species/, but there could be multiple distribution function for each species. In this case, the fast particle populations should be superposed" ;
    skos:inScheme fyo:distributions ;
    fyo:dd_path "distributions/distribution" ;
    fyo:dd_type_name "distributions_d" .

