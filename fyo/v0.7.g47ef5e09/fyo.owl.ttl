@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fyo: <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spo: <https://fusion-yun.github.io/spo/latest/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fyo:CentralSolenoidSystem a owl:Class ;
    rdfs:label "CentralSolenoidSystem" ;
    rdfs:subClassOf fyo:CoilSystem ;
    skos:definition "Central solenoid — plasma current drive + flux swing (CS)." ;
    skos:inScheme fyo:core .

fyo:CorrectionFieldCoilSystem a owl:Class ;
    rdfs:label "CorrectionFieldCoilSystem" ;
    rdfs:subClassOf fyo:CoilSystem ;
    skos:definition "Error-field correction coils — RMP / ELM mitigation." ;
    skos:inScheme fyo:core .

fyo:Discharge a owl:Class ;
    rdfs:label "Discharge" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:Machine ;
            owl:onProperty fyo:performed_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:performed_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:performed_on ],
        spo:PlannedProcess ;
    skos:definition "A tokamak discharge (shot / pulse) — the planned experimental process realizing a pulse-schedule PlanSpecification on a Machine, during which one Plasma exists and MeasurementProcesses run. An unrepeatable spatiotemporal particular: what a data system keeps of it is its record (spo ProcessRecord; the populated IDS set of a pulse), never the discharge itself." ;
    skos:inScheme fyo:core .

fyo:FluxCoordinateSystem a owl:Class ;
    rdfs:label "FluxCoordinateSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:cocos ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:cocos ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:cocos ],
        spo:CoordinateSystem ;
    skos:definition "A flux-surface coordinate chart (psi / rho_tor / theta / phi families) with its COCOS convention — the fusion-specific chart layer spo-geometry delegates to fyo (SPM-ADR-104 D2). Two Fields on charts with different COCOS are equivalent_representation peers only after the sign / orientation transform." ;
    skos:inScheme fyo:core .

fyo:MagneticDiagnostic a owl:Class ;
    rdfs:label "MagneticDiagnostic" ;
    rdfs:subClassOf fyo:Diagnostic ;
    skos:definition "Diagnostic measuring magnetic field / flux / plasma current." ;
    skos:inScheme fyo:core .

fyo:PoloidalFieldCoilSystem a owl:Class ;
    rdfs:label "PoloidalFieldCoilSystem" ;
    rdfs:subClassOf fyo:CoilSystem ;
    skos:definition "Poloidal-field coil group — plasma shape control (PF)." ;
    skos:inScheme fyo:core .

fyo:ScenarioLoop a owl:Class ;
    rdfs:label "ScenarioLoop" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:ConvergenceCriterion ;
            owl:onProperty fyo:converges_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:converges_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:converges_by ],
        spo:ComputationalProcess ;
    skos:definition "The scenario execution loop — orchestrates alternating solver invocations (BFO has_part: EquilibriumSolve / TransportSolve per cycle) to PHYSICAL convergence under an explicit ConvergenceCriterion (e.g. the 1.5D core equilibrium–transport loop with psi-residual RMS, enabling-core scenario S-4). Orchestrates via solver ports; never inlines solver numerics (design stance #4)." ;
    skos:inScheme fyo:scenario ;
    fyo:conops_ref "FYTOK-CONOPS-00 S-4; goal G-3" .

fyo:StateEstimation a owl:Class ;
    rdfs:label "StateEstimation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:consumes_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:consumes_ids ],
        spo:ComputationalProcess ;
    skos:definition "One state-estimation step of the closed loop — inferring the current plasma state from available (synthetic) diagnostic signals and the device linear model (EKF-family), the quasi-real-time counterpart of S-8's offline inference: same forward spine, hard latency budget. GAP (informative): estimator and device linear model are pending (as-built: direct PD on reconstructed position)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/control_simulation> ;
    fyo:conops_ref "FYTOK-CONOPS-00 S-9" .

fyo:SyntheticDiagnosticEvaluation a owl:Class ;
    rdfs:label "SyntheticDiagnosticEvaluation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:consumes_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:produces_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IDS ;
            owl:onProperty fyo:consumes_ids ],
        spo:ComputationalProcess ;
    skos:definition "A forward evaluation of a diagnostic's response to a candidate plasma configuration — composing the forward operator F with the diagnostic geometry / response model to produce SYNTHETIC signals comparable with d_obs. The reusable half of the unified forward–inference loss; also the verification loop of prediction (predict → synthesize → compare). GAP (informative): synthetic-diagnostic forward models are the identified zero of the as-built state (R-3)." ;
    skos:inScheme <https://fusion-yun.github.io/fyo/v0.7.g47ef5e09/scenario/experiment_analysis> ;
    fyo:conops_ref "FYTOK-REPORT-107; FYTOK-CONOPS-00 S-8" .

fyo:Tokamak a owl:Class ;
    rdfs:label "Tokamak" ;
    rdfs:subClassOf fyo:Machine ;
    skos:definition "A toroidal magnetic-confinement fusion Machine (fusion specialization of Machine)." ;
    skos:inScheme fyo:core .

fyo:ToroidalFieldCoilSystem a owl:Class ;
    rdfs:label "ToroidalFieldCoilSystem" ;
    rdfs:subClassOf fyo:CoilSystem ;
    skos:definition "Toroidal-field coil group — main confinement field (TF)." ;
    skos:inScheme fyo:core .

fyo:fyo.owl.ttl a owl:Ontology ;
    rdfs:label "fyo" ;
    dcterms:license "Apache-2.0" ;
    dcterms:title "fyo — the fusion-domain ontology (aggregator)" ;
    skos:definition "Aggregator over the whole fyo artifact: the hand-curated core and scenario stratum plus the lifted IMAS DD layer, grounded on spo. Build-time only; not a source module." .

spo:ComputationRecord a owl:Class ;
    rdfs:label "ComputationRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:executed_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:executed_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Code ;
            owl:onProperty spo:executed_code ],
        spo:ProcessRecord ;
    skos:definition "The record of a ComputationalProcess — a run manifest: which Code (program, GDC) was executed, with which inputs, producing which outputs (workflow-run document, solver log). Completes the program / computation / result triangle: Code (plan, GDC) — ComputationalProcess (occurrent, realizes the Code) — output ICEs (results) — this record (information about the run, distinct from the results themselves)." ;
    skos:inScheme spo:provenance .

spo:EngineeringDetermination a owl:Class ;
    rdfs:label "EngineeringDetermination" ;
    rdfs:subClassOf spo:Process ;
    skos:definition "An engineering survey / calibration / design determination establishing a static device fact (e.g. a probe position). Invariant on the discharge timescale." ;
    skos:inScheme spo:core ;
    fyo:modality "static_device" ;
    fyo:reproducible "true" .

spo:Function a owl:Class ;
    rdfs:label "Function" ;
    rdfs:subClassOf spo:Field ;
    skos:definition "The one-dimensional Field — a rank-1 continuous quantity over a 1-D Domain (L3). NAMING (convention, see artifact/field.md §1): CamelCase `spo:Function` is this T-Box class (data: values over a domain); lowercase `spo:function` is the SpData document DSL for TYPED MATH FUNCTION specifications (args/returns/body — a mapping rule, GDC). The IRIs are distinct (case-sensitive); never mix the two in prose or CURIEs." ;
    skos:inScheme spo:domain .

spo:MeasurementProcess a owl:Class ;
    rdfs:label "MeasurementProcess" ;
    rdfs:subClassOf spo:Process ;
    skos:definition "A real-world measurement / observation process producing measured data; part of a discharge (a PlannedProcess instance = shot). Unrepeatable — its output is about a unique spatiotemporal particular (this shot at this time), hence read-only / not reproducible / per-shot distinct." ;
    skos:inScheme spo:core ;
    fyo:modality "measured" ;
    fyo:reproducible "false" .

spo:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_quantity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty spo:numeric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_quantity_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:of_quality ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Quality ;
            owl:onProperty spo:of_quality ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:QuantityKind ;
            owl:onProperty spo:has_quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:of_quality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Unit ;
            owl:onProperty spo:has_unit ],
        spo:InformationContentEntity ;
    skos:definition "A scalar physical quantity value — numeric value + Unit + QuantityKind (the lift of a DD FLT_0D leaf with units; e.g. `vacuum_toroidal_field/b0` at one instant). The information counterpart of a fully determinate Quality; for quantities extended over a Domain use ContinuousQuantity (Field/Signal) instead." ;
    skos:exactMatch <http://qudt.org/schema/qudt/QuantityValue> ;
    skos:inScheme spo:quantity .

spo:SpacetimeMesh a owl:Class ;
    rdfs:label "SpacetimeMesh" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:discretizes_spacetime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_spatial_base ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty spo:discretizes_spacetime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty spo:has_spatial_base ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:TimeAxis ;
            owl:onProperty spo:has_time_axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:Mesh ;
            owl:onProperty spo:has_spatial_base ],
        [ a owl:Restriction ;
            owl:allValuesFrom spo:SpacetimeRegion ;
            owl:onProperty spo:discretizes_spacetime ],
        spo:Mesh ;
    skos:definition "A discretized 4D domain — a Mesh whose discretized region is a SpacetimeRegion (4D extension stratum). Two constructions: (a) product form, a spatial base Mesh extruded along a TimeAxis (the common shot-data case: same spatial grid, many instants); (b) a genuinely unstructured 4D GGD (moving/adaptive grids: the spatial grid itself is time-dependent, e.g. per-time-slice equilibrium grids — then the product decomposition is per-interval, not global). Fields over a SpacetimeMesh subsume both AoS and SoA: layout becomes a storage detail of the same 4D Field." ;
    skos:inScheme spo:time ;
    fyo:spo_stratum "4d_extension" .

spo:coordinate_unit a owl:DatatypeProperty ;
    rdfs:label "coordinate_unit" ;
    rdfs:range xsd:string ;
    skos:definition "Physical unit of a coordinate axis (UCUM / QUDT string; authority external — SpData sp:phys). Dimensionless \"-\" for normalized axes." ;
    skos:inScheme spo:geometry .

fyo:AmnsData a owl:Class ;
    rdfs:label "AmnsData" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:a ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataRelease ;
            owl:onProperty fyo:release ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coordinate_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:z_n ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:z_n ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:IdsProperties ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:CodeConstant ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:z_n ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:process ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:release ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataCoordinateSystem ;
            owl:onProperty fyo:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:ids_properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataProcess ;
            owl:onProperty fyo:process ],
        fyo:IDS ;
    skos:definition "Atomic, molecular, nuclear and surface physics data. Each occurrence contains the data for a given element (nuclear charge), describing various physical processes. For each process, data tables are organized by charge states. The coordinate system used by the data tables is described under the coordinate_system node." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_path "amns_data" ;
    fyo:fyo_category "metadata" .

fyo:AmnsDataCoordinateSystem a owl:Class ;
    rdfs:label "AmnsDataCoordinateSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataCoordinateSystemCoordinate ;
            owl:onProperty fyo:coordinate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coordinate ],
        spo:InformationContentEntity ;
    skos:definition "Array of possible coordinate systems for process tables" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_path "amns_data/coordinate_system" ;
    fyo:dd_type_name "amns_data_coordinate_system" .

fyo:AmnsDataCoordinateSystemCoordinate a owl:Class ;
    rdfs:label "AmnsDataCoordinateSystemCoordinate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:spacing ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:units ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:interpolation_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:transformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:extrapolation_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:extrapolation_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:spacing ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:interpolation_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:transformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:interpolation_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:value_labels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:value_labels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:spacing ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fyo:values ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:transformation ],
        spo:InformationContentEntity ;
    skos:definition "Set of coordinates for that coordinate system. A coordinate an be either a range of real values or a set of discrete values (if interpolation_type=0)" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_path "amns_data/coordinate_system/coordinate" ;
    fyo:dd_type_name "amns_data_coordinate_system_coordinate" .

fyo:AmnsDataDataEntry a owl:Class ;
    rdfs:label "AmnsDataDataEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:shot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:run ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:run ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:shot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:shot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:run ],
        spo:InformationContentEntity ;
    skos:definition "For this release, list of each data item (i.e. shot/run pair containing the actual data) included in this release" ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_path "amns_data/release/data_entry" ;
    fyo:dd_type_name "amns_data_data_entry" .

fyo:AmnsDataProcess a owl:Class ;
    rdfs:label "AmnsDataProcess" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:charge_state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:result_transformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:provider ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:coordinate_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:table_dimension ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:result_units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:citation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:table_dimension ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:result_units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:result_units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:result_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:coordinate_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:citation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:products ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:table_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataProcessReactant ;
            owl:onProperty fyo:reactants ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:reactants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:result_transformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:result_transformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:citation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:provider ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fyo:result_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fyo:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataProcessChargeState ;
            owl:onProperty fyo:charge_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fyo:coordinate_index ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fyo:result_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom fyo:AmnsDataProcessReactant ;
            owl:onProperty fyo:products ],
        spo:InformationContentEntity ;
    skos:definition "Description and data for a set of physical processes." ;
    skos:inScheme fyo:amns_data ;
    fyo:dd_path "amns_data/process" ;
    fyo:dd_type_name "amns_data_process" .

fyo:AmnsDataProcessChargeState a owl:Class ;
