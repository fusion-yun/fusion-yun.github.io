fyo:SummaryPedestalFitStabilityMethod a sh:NodeShape ;
    rdfs:comment "MHD calculations of the critical alpha parameter using the Sauter formula for the calculation of the bootstrap current, from Phys. Plasmas 6 (1999) 2834" ;
    sh:closed true ;
