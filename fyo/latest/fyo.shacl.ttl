            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:grid_subset_index ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier of the boundary condition type. List of options TBD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_index ] ;
    sh:targetClass fyo:NumericsBcGgdCurrent .

