        [ sh:datatype xsd:float ;
            sh:description "Poloidal magnetic flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate. rho_tor = sqrt(b_flux_tor/(pi*b0)) ~ sqrt(pi*r^2*b0/(pi*b0)) ~ r [m]. The toroidal field used in its definition is indicated under global_quantities/b0" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation, see time_slice/boundary/b_flux_pol_norm in the equilibrium IDS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:rho_tor_norm ] ;
    sh:targetClass fyo:SummaryLocalPositionRZ .

fyo:SummaryLocalQuantitiesRZ a sh:NodeShape ;
    rdfs:comment "Parameters at magnetic axis" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal magnetic field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:b_field_phi ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal magnetic field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:b_field_tor ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummarySpeciesTorAngle ;
            sh:description "Ion toroidal rotation velocity, per species" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:velocity_phi ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Average on the magnetic surface of (e_field.b_field) / B0, where B0 is global_quantities/b0/value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:e_field_parallel ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total ion density (sum over species)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_i_total ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total plasma toroidal momentum, summed over ion species and electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:momentum_phi ],
        [ sh:class fyo:SummaryLocalPositionRZ ;
            sh:description "Radial position at which physics quantities are evaluated" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:position ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Ion temperature (average over ion species)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:t_i_average ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Safety factor (only positive when toroidal current and magnetic field are in same direction)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:q ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
