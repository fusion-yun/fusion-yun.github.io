            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage set" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:voltage_set ] ;
    sh:targetClass fyo:NeutronDiagnosticSupply .

fyo:PfCoilsElements a sh:NodeShape ;
    rdfs:comment "Each PF coil is comprised of a number of cross-section elements described  individually and connected serially" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Cross-sectional areas of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Number of effective turns in the element for calculating the magnetic field from the coil/loop. Should be positive, unless the coil has elements going in opposite directions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:turns_with_sign ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Cross-sectional shape of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:geometry ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PfCoilsElements .

fyo:PlasmaProfilesGgdFast a sh:NodeShape ;
    rdfs:comment "Quantities provided at a faster sampling rate than the full ggd quantities. These are either integrated quantities or local quantities provided on a reduced set of positions. Positions and integration domains are described by a set of grid_subsets (of size 1 for a position)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaProfilesGgdFastElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:PlasmaProfilesGgdFastIon ;
            sh:description "Quantities related to the different ion species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Plasma energy content = 3/2 * integral over the volume of the grid subset of the thermal pressure (summed over all species), for various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:energy_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:PlasmaProfilesGgdFast .

fyo:PlasmaProfilesProfiles1d a sh:NodeShape ;
    rdfs:comment "SOL radial profiles for various time slices, taken on outboard equatorial mid-plane" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Bootstrap current density = average(J_Bootstrap.B) / B0, where B0 = plasma_profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:j_bootstrap ],
        [ sh:datatype xsd:float ;
            sh:description "Non-inductive (includes bootstrap) parallel current density = average(jni.B) / B0, where B0 = plasma_profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:j_non_inductive ],
        [ sh:datatype xsd:float ;
            sh:description "Total parallel current density = average(jtot.B) / B0, where B0 = plasma_profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:j_total ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Total toroidal current density = average(j_phi/R) / average(1/R)" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:j_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma toroidal momentum, summed over ion species and electrons weighted by their density and major radius, i.e. sum_over_species(n*R*m*Vphi)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:momentum_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Total parallel pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure_parallel ],
        [ sh:class fyo:PlasmaProfilesProfiles1dIon ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionisation states (and other types of states) must be differentiated at the state level below" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaProfilesProfiles1dNeutral ;
            sh:description "Quantities related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:neutral ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel conductivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:conductivity_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Ratio of total ion density (sum over species and charge states) over electron density. (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:n_i_total_over_n_e ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the flux surface averaged electrostatic potential with respect to the poloidal flux, multiplied by (-1/2pi). This quantity is the toroidal angular rotation frequency due to the ExB drift, introduced in formula (43) of Hinton and Wong, Physics of Fluids 3082 (1985), also referred to as sonic flow in regimes in which the toroidal velocity is dominant over the poloidal velocity" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:rotation_frequency_tor_sonic ],
        [ sh:datatype xsd:float ;
            sh:description "Thermal pressure (electrons+ions)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic shear, defined as rho_tor/q . dq/drho_tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path fyo:magnetic_shear ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the t_i_average profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:t_i_average_fit ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the zeff profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:zeff_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Total ion thermal density (sum over species and charge states)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:n_i_thermal_total ],
        [ sh:datatype xsd:float ;
            sh:description "Safety factor" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fyo:q ],
        [ sh:class fyo:PlasmaProfilesProfiles1dElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:PlasmaProfilesVectorComponents1 ;
            sh:description "Electric field, averaged on the magnetic surface. E.g for the parallel component, average(E.B) / B0, using plasma_profiles/vacuum_toroidal_field/b0" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:e_field ],
        [ sh:datatype xsd:float ;
            sh:description "Electrostatic potential, averaged on the magnetic flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fyo:phi_potential ],
        [ sh:datatype xsd:float ;
            sh:description "Effective charge" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:zeff ],
        [ sh:datatype xsd:float ;
            sh:description "Total (sum over ion species) thermal ion pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_ion_total ],
        [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged on charge states and ion species)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:t_i_average ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel current driven inside the flux surface. Cumulative surface integral of j_total" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:current_parallel_inside ],
        [ sh:datatype xsd:float ;
            sh:description "Total perpendicular pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:pressure_perpendicular ],
        [ sh:class fyo:PlasmaRadialGrid ;
            sh:description "Radial grid. Note that some of the radial coordinates listed above are undefined outside the last closed flux surface, thus they must be filled with EMPTY_FLOAT values in such locations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Ohmic parallel current density = average(J_Ohmic.B) / B0, where B0 = plasma_profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:j_ohmic ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1d .

fyo:PlasmaProfilesTimeSlice a sh:NodeShape ;
    rdfs:comment "Edge plasma quantities represented using the general grid description, for various time slices. The timebase of this array of structure must be a subset of the ggd_fast timebase (only if the ggd_fast array of structure is used)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridScalar ;
            sh:description "Effective charge, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:zeff ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Inertial current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:j_inertial ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to the perpendicular viscosity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:j_perpendicular_viscosity ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Ion temperature (averaged on ion species), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:t_i_average ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path fyo:time ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Electric field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:e_field ],
        [ sh:class fyo:PlasmaProfilesTimeSliceNeutral ;
            sh:description "Quantities related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:neutral ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Total current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:j_total ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Total perpendicular pressure (electrons+ions, thermal+non-thermal), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:pressure_perpendicular ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Thermal pressure (electrons+ions), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:pressure_thermal ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Total parallel pressure (electrons+ions, thermal+non-thermal), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:pressure_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Electric potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path fyo:phi_potential ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Vorticity divided by the local major radius, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path fyo:vorticity_over_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Current due to parallel electric and thermo-electric conductivity and potential and electron temperature gradients along the field line, differences away from ambipolar flow in the parallel direction between ions and electrons (this is not the parallel component of j_total)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:j_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Mass density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path fyo:mass_density ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to the heat viscosity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:j_heat_viscosity ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Poloidal flux, given on various grid subsets. Integral of magnetic field passing through a contour defined by the intersection of a flux surface passing through the point of interest and a Z=constant plane. If the integration surface is flat, the surface normal vector is in the increasing vertical coordinate direction, Z, namely upwards." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path fyo:psi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Ratio of total ion density (sum over ion species) over electron density. (thermal+non-thermal), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:n_i_total_over_n_e ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Parallel (to magnetic field) velocity of the centre of mass of all the species (see equation 2 in the paper linked below), divided by the module of the local magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path fyo:velocity_parallel_over_b_field ],
        [ sh:class fyo:PlasmaProfilesTimeSliceIon ;
            sh:description "Quantities related to the different ion species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:ion ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Curl of the velocity_mass_centre vector, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path fyo:vorticity ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Anomalous current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:j_anomalous ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the current density multiplied by the local major radius, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:r_j_total_phi ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Magnetic vector potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:a_field ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Velocity of the centre of mass of all the species (see equation 2 in the paper linked below), given on various grid subsets. It is defined as : rho.velocity_mass_centre = sum over all species (rho_species.velocity_species), where rho_species is the mass density of each species and rho = sum over all species (rho_species)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path fyo:velocity_mass_centre ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:b_field ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to the diamgnetic drift, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:j_diamagnetic ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Total ion density (sum over ion species and thermal+non-thermal), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_i_total ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to Pfirsch-Schlüter effects, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:j_pfirsch_schlueter ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to ion neutral friction, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:j_ion_neutral_friction ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaProfilesTimeSliceElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Current density due to the parallel viscosity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:j_parallel_viscosity ] ;
    sh:targetClass fyo:PlasmaProfilesTimeSlice .

fyo:PlasmaSourcesSourceGgd a sh:NodeShape ;
    rdfs:comment "Source terms represented using the general grid description, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaSourcesSourceGgdIon ;
            sh:description "Source terms related to the different ion species, in the sense of isonuclear or isomolecular sequences. ionization states (and other types of states) must be differentiated at the state level below" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:ion ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Source term for the total (summed over ion  species) energy equation, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:total_ion_energy ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Current density source" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:current ],
        [ sh:class fyo:PlasmaSourcesSourceGgdNeutral ;
            sh:description "Source terms related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:neutral ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Source term for total momentum equations, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:momentum ],
        [ sh:class fyo:PlasmaSourcesSourceGgdElectrons ;
            sh:description "Sources for electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:electrons ] ;
    sh:targetClass fyo:PlasmaSourcesSourceGgd .

fyo:PlasmaSourcesSourceGgdFast a sh:NodeShape ;
    rdfs:comment "Quantities provided at a faster sampling rate than the full ggd quantities. These are either integrated quantities or local quantities provided on a reduced set of positions. Positions and integration domains are described by a set of grid_subsets (of size 1 for a position)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
