fyo:SpectroUvChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (detector or pixel of a camera)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:LineOfSight2pointsDynamicAos1 ;
            sh:description "Description of the line of sight of the channel, given by 2 points. The 2nd point is allowed to evolve in case of dynamic line of sight." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:line_of_sight ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of the front face of the micro channel plate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:detector ],
        [ sh:class fyo:SpectroUvChannelWavelengthCalibration ;
            sh:description "Wavelength calibration data. The wavelength is obtained from the pixel index k by: wavelength =  k * gain + offset. k is starting from 1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:wavelength_calibration ],
        [ sh:datatype xsd:string ;
            sh:description "Date of the wavelength calibration (yyyy_mm_dd)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:wavelength_calibration_date ],
        [ sh:datatype xsd:float ;
            sh:description "Radiance calibration" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:radiance_calibration ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:aperture ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:exposure_time ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "In case of detector moving during a pulse, position parameter allowing to record and compute the detector position as a function of time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:detector_position_parameter ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectroUvChannelGrating ;
            sh:description "Description of the grating" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:grating ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for the whole acquisition period. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:validity ],
        [ sh:class fyo:SpectroUvChannelProcessedLine ;
            sh:description "Set of processed spectral lines" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:processed_line ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Intensity spectrum (not calibrated), i.e. number of photoelectrons detected by unit time by a wavelength pixel of the channel, taking into account electronic gain compensation and channels relative calibration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:intensity_spectrum ],
        [ sh:datatype xsd:string ;
            sh:description "Date of the radiance calibration (yyyy_mm_dd)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:radiance_calibration_date ],
        [ sh:class fyo:SpectroUvSupply ;
            sh:description "Set of high voltage power supplies applied to various parts of the diagnostic" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:supply_high_voltage ],
        [ sh:class fyo:SignalInt2d ;
            sh:description "Indicator of the validity of the data for each wavelength and each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:float ;
            sh:description "Measured wavelengths" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:wavelengths ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Calibrated spectral radiance (radiance per unit wavelength)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:radiance_spectral ],
        [ sh:class fyo:SpectroUvDetector ;
            sh:description "Dimensions of pixels and detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:detector_layout ] ;
    sh:targetClass fyo:SpectroUvChannel .

fyo:SpectroUvChannelGrating a sh:NodeShape ;
    rdfs:comment "Description of the grating" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Curvature radius of the spherical grating" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:curvature_radius ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:class spo:Identifier ;
            sh:description "Grating type. Index = 1 : ruled. Index = 2 : holographic" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the grating summit (defined as the point of contact of its concave side if the grating were put on a table). Used as the origin of the x1, x2, x3 vectors defined below" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:summit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the grating at its summit and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:datatype xsd:float ;
            sh:description "Number of grooves per unit length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:groove_density ],
        [ sh:class spo:Identifier ;
            sh:description "Grating geometry. Index = 1 : spherical. Index = 2 : toric" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:geometry_type ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Centre of the grating sphere (if grating is spherical) or torus (if grating is toric)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:centre ],
        [ sh:class fyo:X1x21dStatic ;
            sh:description "List of the 4 extreme points of the spherical grating in the (X1, X2) coordinate system, using the summit as the origin. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:outline ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is horizontal and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectroUvChannelGratingImage ;
            sh:description "Surface on which the grating image is focused" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:image_field ] ;
    sh:targetClass fyo:SpectroUvChannelGrating .

fyo:SpectroUvChannelGratingImage a sh:NodeShape ;
    rdfs:comment "Surface on which the grating image is focused" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Curvature radius of the image surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:curvature_radius ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Centre of the image surface in case it is spherical, or position of a point on the surface in case it is a plane" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:centre ],
        [ sh:class spo:Identifier ;
            sh:description "Surface geometry. Index = 1 : spherical. Index = 2 : plane" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the surface ( in case it is plane) and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:x3_unit_vector ] ;
    sh:targetClass fyo:SpectroUvChannelGratingImage .

fyo:SpectroUvChannelProcessedLine a sh:NodeShape ;
    rdfs:comment "Set of processed spectral lines" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the processed line. To avoid ambiguities, the following syntax is used : element with ionization state_wavelength in Angstrom (e.g. WI_4000)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Non-calibrated intensity (integrated over the spectrum for this line)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Central wavelength of the processed line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_central ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Calibrated, background subtracted radiance (integrated over the spectrum for this line)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:radiance ] ;
    sh:targetClass fyo:SpectroUvChannelProcessedLine .

fyo:SpectroUvChannelWavelengthCalibration a sh:NodeShape ;
