            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PfPlasmaElement ;
            sh:description "Set of plasma elements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:element ] ;
    sh:targetClass fyo:PfPlasma .

fyo:PhysicsModelingTask a sh:NodeShape ;
    rdfs:comment "A forward physics-modeling / prediction run (S-7, primary). FUNCTION: instantiate the device aggregate entity (S-1), bind the fyo-modeled physical state, then let the ScenarioLoop alternate equilibrium and transport solves — with source terms — until physical convergence or through a prescribed time evolution; the result PREDICTS the plasma equilibrium / profile / transport state. Direction: forward (θ → state); the plasma configuration evolves, the machine is fixed. Every output IDS carries data-modality `simulated` in its provenance (the schema itself is modality-blind)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:IDS ;
            sh:description "INPUT (optional) — prescribed boundary / actuator waveforms over the simulated interval (time-dependent runs)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:prescribed_waveforms ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_input ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:consumes_ids ],
        [ sh:class fyo:MachineDescription ;
            sh:description "INPUT — static as-built geometry / configuration of the target machine (wall, coil and limiter geometry; the device A-Box provided by fydata, loaded by plugin name at device instantiation, S-1)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:machine_description ],
        [ sh:class fyo:ForwardOperator ;
            sh:description "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:uses_forward_operator ],
        [ sh:class fyo:IDS ;
            sh:description "INPUT — heating / current-drive actuator settings feeding the source terms (NBI, EC launchers, IC / LH antennas). GAP (informative): H&CD deposition physics is the identified precondition gap G-A1 — predictive scenarios are currently ohmic-only." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:heating_and_current_drive ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:produces_ids ],
        [ sh:datatype xsd:string ;
            sh:description "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:free_variables ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the transport coefficients used / predicted. GAP (informative): turbulence closure is analytic-only today (G-A2, QLKNN surrogate unwired)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:predicted_transport ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class fyo:ScenarioSpecification ;
            sh:description "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the predicted Grad–Shafranov equilibrium (flux map, boundary, global quantities), written back by the equilibrium solves; modality simulated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:predicted_equilibrium ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the predicted core plasma profiles at convergence / over time; modality simulated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:predicted_profiles ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:performed_on ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class fyo:IDS ;
            sh:description "INPUT — initial core plasma profiles (densities, temperatures, current) from which the forward advance starts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:initial_profiles ],
        [ sh:class fyo:ConvergenceCriterion ;
            sh:description "The explicit convergence criterion of this task's scenario loop — a configurable modeling decision (e.g. psi-residual RMS threshold + iteration cap), never an implicit solver internal (enabling-core goal G-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:converges_by ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_output ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the realized source / sink profiles consistent with the converged state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:predicted_sources ] ;
    sh:targetClass fyo:PhysicsModelingTask .

fyo:PlasmaInitiation a sh:NodeShape ;
    rdfs:comment "Description the early phases of the plasma, before an equilibrium can be calculated" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:PlasmaInitiationGlobalQuantities ;
            sh:description "Global quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaInitiationFieldLines ;
            sh:description "Magnetic field line tracing results, given at various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:b_field_lines ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:version_put ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path spo:modality ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:generated_by_process ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class fyo:PlasmaInitiationProfiles2d ;
            sh:description "2D profiles in the poloidal plane, given at various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:profiles_2d ] ;
    sh:targetClass fyo:PlasmaInitiation .

fyo:PlasmaProfiles a sh:NodeShape ;
    rdfs:comment "Plasma profiles (core and/or edge). This IDS is a prototype based on the merge of core_profiles, edge_profiles and the MHD IDS, for testing purposes only at this stage. It contains magnetic field maps to describe magnetic field fluctuations, while the equilibrium magnetic field is described in the equilibrium IDS" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path spo:has_provenance ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path spo:modality ],
        [ sh:class fyo:PlasmaProfilesProfiles1d ;
            sh:description "Radial profiles for various time slices. Flux averaged profiles in the closed field line region (grid/rho_pol_norm <= 1) and taking local values on outboard equatorial mid-plane when in the SOL (grid/rho_pol_norm > 1)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:profiles_1d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path spo:version_put ],
        [ sh:class fyo:PlasmaProfilesGlobalQuantities ;
            sh:description "Various global quantities derived from the profiles" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class fyo:PlasmaProfilesGgdFast ;
            sh:description "Quantities provided at a faster sampling rate than the full ggd quantities. These are either integrated quantities or local quantities provided on a reduced set of positions. Positions and integration domains are described by a set of grid_subsets (of size 1 for a position)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:ggd_fast ],
        [ sh:class fyo:CovarianceMatrix ;
            sh:description "User defined covariance matrix. The covariance of various quantities can be stored here, these quantities are referred to by giving their IDS path in the rows_uri list" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:covariance ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:class fyo:PlasmaProfilesProfiles2d ;
            sh:description "Plasma quantities in a poloidal cross section, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:profiles_2d ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:code ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class spo:Identifier ;
            sh:description "Choice of midplane definition (use the lowest index number if more than one value is relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:midplane ],
        [ sh:class fyo:GenericGridAos3Root ;
            sh:description "Grid (using the Generic Grid Description), for various time slices. The timebase of this array of structure must be a subset of the ggd timebase" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:grid_ggd ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path spo:generated_by_process ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:time ],
        [ sh:class fyo:PlasmaProfilesTimeSlice ;
            sh:description "Plasma quantities represented using the general grid description, for various time slices. The timebase of this array of structure must be a subset of the ggd_fast timebase (only if the ggd_fast array of structure is used)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:ggd ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition and in the normalization of current densities)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:class fyo:Statistics ;
            sh:description "Statistics for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:statistics ] ;
    sh:targetClass fyo:PlasmaProfiles .

fyo:PlasmaSources a sh:NodeShape ;
    rdfs:comment "Plasma sources. This IDS is a prototype based on the merge of core_sources and edge_sources. Energy terms correspond to the full kinetic energy equation (i.e. the energy flux takes into account the energy transported by the particle flux)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path spo:modality ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:generated_by_process ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
