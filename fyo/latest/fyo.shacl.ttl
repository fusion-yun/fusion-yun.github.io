fyo:IcAntennasMatchingElement a sh:NodeShape ;
    rdfs:comment "Set of matching elements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Capacitance of the macthing element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:capacitance ],
        [ sh:class spo:Identifier ;
            sh:description "Type of the matching element. Index = 1 : capacitor (fill capacitance); Index = 2 : stub (fill phase)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Phase delay induced by the stub" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:phase ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:IcAntennasMatchingElement .

fyo:IcAntennasStrap a sh:NodeShape ;
    rdfs:comment "Set of IC antenna straps" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Strap outline" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:float ;
            sh:description "Width of strap in the toroidal direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:width_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Distance to conducting wall or other conductor behind the antenna strap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:distance_to_conductor ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Phase of the strap current" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Root mean square current flowing along the strap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:current ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Cross-sectional shape of the strap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:geometry ] ;
    sh:targetClass fyo:IcAntennasStrap .

fyo:IcAntennasSurfaceCurrent a sh:NodeShape ;
    rdfs:comment "Description of the IC surface current on the antenna straps and on passive components, for every time slice" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Spectrum of the total surface current on the antenna strap and passive components expressed in poloidal and toroidal modes" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:spectrum ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:integer ;
            sh:description "Poloidal mode numbers, used to describe the spectrum of the antenna current. The poloidal angle is defined from the reference point; the angle at a point (R,Z) is given by atan((Z-Zref)/(R-Rref)), where Rref=reference_point/r and Zref=reference_point/z" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:m_pol ],
        [ sh:datatype xsd:integer ;
            sh:description "Toroidal mode numbers, used to describe the spectrum of the antenna current. The wave vector toroidal component is defined as k_phi = n_phi grad phi where phi is the toroidal angle so that a positive n_phi means a wave propagating in the positive phi direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_phi ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:IcAntennasSurfaceCurrent .

fyo:IdentifierDynamicAos31d a sh:NodeShape ;
    rdfs:comment "Identifier values, one value is provided per element in the grid subset. If the size of the child arrays is 1, their value applies to all elements of the subset." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Verbose description" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:descriptions ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer identifiers (enumeration index within a list). Private identifier values must be indicated by a negative index." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:indices ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifiers" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:names ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:IdentifierDynamicAos31d .

fyo:IdsPlugins a sh:NodeShape ;
    rdfs:comment "Information about the plugins used to write/read this IDS. This structure is filled automatically by the Access Layer at GET/PUT time, no need to fill it via a user program." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:CodeConstantNoparam ;
            sh:description "Plugin infrastructure used to PUT the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:infrastructure_put ],
        [ sh:class fyo:CodeConstantNoparam ;
            sh:description "Plugin infrastructure used to GET the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:infrastructure_get ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:IdsPluginsNode ;
            sh:description "Set of IDS nodes for which a plugin has been applied" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:node ] ;
    sh:targetClass fyo:IdsPlugins .

fyo:IdsPluginsNode a sh:NodeShape ;
    rdfs:comment "Set of IDS nodes for which a plugin has been applied" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:CodeConstant ;
            sh:description "Plugins used to PUT a node (potentially, multiple plugins can be applied, if so they are listed by order of application)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:put_operation ],
        [ sh:class fyo:CodeConstant ;
            sh:description "Plugins to be used to read back a node (potentially, multiple plugins can be applied, listed in reverse order of application)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:readback ],
        [ sh:class fyo:CodeConstant ;
            sh:description "Plugins actually used to read back a node (potentially, multiple plugins can be applied, listed in reverse order of application). This information is filled by the plugin infrastructure during the GET operation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:get_operation ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the node within the IDS, following the syntax given in the link below. If empty, means the plugin applies to the whole IDS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:path ] ;
    sh:targetClass fyo:IdsPluginsNode .

fyo:IdsProvenance a sh:NodeShape ;
    rdfs:comment "Provenance information about this IDS" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:IdsProvenanceNode ;
            sh:description "Set of IDS nodes for which the provenance is given. The provenance information applies to the whole structure below the IDS node. For documenting provenance information for the whole IDS, set the size of this array of structure to 1 and leave the child \"path\" node empty" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:node ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:IdsProvenance .

fyo:IdsProvenanceNode a sh:NodeShape ;
    rdfs:comment "Set of IDS nodes for which the provenance is given. The provenance information applies to the whole structure below the IDS node. For documenting provenance information for the whole IDS, set the size of this array of structure to 1 and leave the child \"path\" node empty" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:IdsProvenanceNodeReference ;
            sh:description "List of references used to populate or calculate this node, identified as explained below. In case the node is the result of of a calculation / data processing, the reference is an input to the process described in the \"code\" structure at the root of the IDS. The reference can be an IDS (identified by a URI or a persitent identifier, see syntax in the link below) or non-IDS data imported directly from an non-IMAS database (identified by the command used to import the reference, or the persistent identifier of the data reference). Often data are obtained by a chain of processes, however only the last process input are recorded here. The full chain of provenance has then to be reconstructed recursively from the provenance information contained in the data references." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:reference ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the node within the IDS, following the syntax given in the link below. If empty, means the provenance information applies to the whole IDS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:path ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:IdsProvenanceNode .

fyo:IdsProvenanceNodeReference a sh:NodeShape ;
    rdfs:comment "List of references used to populate or calculate this node, identified as explained below. In case the node is the result of of a calculation / data processing, the reference is an input to the process described in the \"code\" structure at the root of the IDS. The reference can be an IDS (identified by a URI or a persitent identifier, see syntax in the link below) or non-IDS data imported directly from an non-IMAS database (identified by the command used to import the reference, or the persistent" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Date and time (UTC) at which the reference was created, expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:timestamp ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Reference name" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:IdsProvenanceNodeReference .

fyo:InferenceEngine a sh:NodeShape ;
    rdfs:comment "An exchangeable inference engine stacked on the fixed forward spine — least-squares reconstruction, MAP, Bayesian posterior sampling, or UQ propagation (forward / parameterization+prior / inference-engine three-layer decoupling, FYTOK-REPORT-107). Swapping engines never changes F." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:repository ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:commit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:uses_library ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:version ] ;
    sh:targetClass fyo:InferenceEngine .

fyo:Int1dTime1AndTypeChange a sh:NodeShape ;
    rdfs:comment "Harmonic detected by the channel. 1 corresponds to the \"O1\" mode, while 2 corresponds to the \"X2\" mode." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:validity_timed ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for the whole acquisition period. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:validity ],
        [ sh:datatype xsd:integer ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ] ;
    sh:targetClass fyo:Int1dTime1AndTypeChange .

fyo:InterferometerChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (lines-of-sight)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Line average density inferred from interferometer measurements. Corresponds to the density integrated along the full line-of-sight and then divided by the length of the line-of-sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:n_e_line_average ],
        [ sh:class fyo:InterferometerChannelNE ;
            sh:description "Estimated electron density profile on a set of positions along the line of sight and used by forward models." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:n_e ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Line integrated density, possibly obtained by a combination of multiple interferometry wavelengths. Corresponds to the density integrated along the full line-of-sight (i.e. forward AND return for a reflected channel: NO dividing by 2 correction)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_e_line ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:LineOfSight3points ;
            sh:description "Description of the line of sight of the channel, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:line_of_sight ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Optical path length variation due to the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:path_length_variation ],
        [ sh:class fyo:InterferometerChannelWavelengthInterf ;
            sh:description "Set of wavelengths used for interferometry" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:wavelength ] ;
    sh:targetClass fyo:InterferometerChannel .

fyo:InterferometerChannelNE a sh:NodeShape ;
    rdfs:comment "Estimated electron density profile on a set of positions along the line of sight and used by forward models." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Positions along the line of sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:positions ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:InterferometerChannelNE .

fyo:InterferometerChannelWavelengthInterf a sh:NodeShape ;
    rdfs:comment "Set of wavelengths used for interferometry" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Conversion factor to be used to convert phase into line density for this wavelength" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:phase_to_n_e_line ],
        [ sh:datatype xsd:integer ;
            sh:description "Signed number of 2pi phase corrections applied to remove a fringe jump, for each time slice on which a correction has been made" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:fringe_jump_correction ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Wavelength value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:float ;
            sh:description "List of time slices of the pulse on which a fringe jump correction has been made" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:fringe_jump_correction_times ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Phase measured for this wavelength, corrected from fringe jumps" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:phase_corrected ] ;
    sh:targetClass fyo:InterferometerChannelWavelengthInterf .

fyo:IronCoreSegment a sh:NodeShape ;
    rdfs:comment "The iron core is describred as a set of segments" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Magnetization M of the iron segment along the major radius axis, assumed to be constant inside a given iron segment. Reminder : H = 1/mu0 * B - mur * M;" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:magnetization_r ],
        [ sh:datatype xsd:float ;
            sh:description "Array of magnetic field values, for each of which the relative permeability is given" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:b_field ],
        [ sh:datatype xsd:float ;
            sh:description "Relative permeability of the iron segment" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:permeability_relative ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Magnetization M of the iron segment along the vertical axis, assumed to be constant inside a given iron segment. Reminder : H = 1/mu0 * B - mur * M;" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:magnetization_z ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Cross-sectional shape of the segment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:geometry ] ;
    sh:targetClass fyo:IronCoreSegment .

fyo:LangmuirProbesEmbedded a sh:NodeShape ;
    rdfs:comment "Set of embedded (in a plasma facing component) probes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Pearson kurtosis of the ion saturation current density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:j_i_saturation_kurtosis ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Positive charge fluence normal to an ideal axisymmetric surface of the divertor (assuming no shaping), estimated at the probe location." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:fluence ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Floating potential" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:v_floating ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Standard deviation of the ion saturation current density, corresponding to the fluctuations of the quantity over time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:j_i_saturation_sigma ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Plasma potential" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:v_plasma ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the measurements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:position ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Skew of the ion saturation current density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:j_i_saturation_skew ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Ion saturation current measured by the probe" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:ion_saturation_current ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Incident angle of the magnetic field with respect to PFC surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:b_field_angle ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Electron temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:t_e ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Ion temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:t_i ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes of this probe located at this level of the IDS structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fyo:time ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Parallel heat flux at the probe position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:heat_flux_parallel ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Area of the probe surface exposed to the plasma (use when assuming constant effective collection area)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:surface_area ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Effective collection area of the probe surface, varying with time due to e.g. changes in the magnetic field line incidence angle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:surface_area_effective ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Distance between the measurement position and the separatrix, mapped along flux surfaces to the outboard midplane, in the major radius direction. Positive value means the measurement is outside of the separatrix." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:distance_separatrix_midplane ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Ion saturation current density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:j_i_saturation ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Standard deviation of ion parallel current density at the probe position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:j_i_parallel_sigma ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Ion parallel current density at the probe position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:j_i_parallel ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Electron density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:n_e ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Standard deviation of the floating potential, corresponding to the fluctuations of the quantity over time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:v_floating_sigma ],
        [ sh:class fyo:LangmuirProbesMultiTemperature ;
            sh:description "Set of temperatures describing the electron and ion distribution functions in case of multi-temperature fits" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:multi_temperature_fits ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:LangmuirProbesEmbedded .

fyo:LangmuirProbesMultiTemperature a sh:NodeShape ;
    rdfs:comment "Set of temperatures describing the electron and ion distribution functions in case of multi-temperature fits" ;
