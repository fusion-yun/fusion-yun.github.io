            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ] ;
    sh:targetClass fyo:Xyz0dStatic .

fyo:GenericGridVectorComponents a sh:NodeShape ;
    rdfs:comment "Velocity, given on various grid subsets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the radial component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:radial_coefficients ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Radial component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:radial ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the toroidal component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:phi_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the component along the height axis, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:z_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Component along the major radius axis, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the component along the major radius axis, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:r_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:poloidal ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the parallel component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:parallel_coefficients ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:datatype xsd:float ;
            sh:description "Component along the height axis, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:z ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the poloidal component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:poloidal_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the diamagnetic component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:diamagnetic_coefficients ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path spo:unit ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path spo:equivalent_representation ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path spo:has_domain ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path spo:representation_of ],
        [ sh:datatype xsd:float ;
            sh:description "Diamagnetic component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:diamagnetic ] ;
    sh:targetClass fyo:GenericGridVectorComponents .

<http://purl.obolibrary.org/obo/BFO_0000006> a sh:NodeShape ;
    rdfs:comment "A region of space (BFO spatial region). The base manifold a field rides; bound to sp_mathx geometry." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000006> .

spo:CoordinateSystem a sh:NodeShape ;
    rdfs:comment "A coordinate chart — an ordered tuple of coordinate axes plus the metric that measures lengths / areas / volumes on it (IMAS ``coordinate_system`` / ``grid_type``). Cartesian (x,y,z), polar (r,θ), cylindrical (r,z,φ), spherical (r,φ,θ) and toroidal charts are the built-in kinds; the metric is Euclidean-identity unless the chart is curvilinear. COCOS orientation of flux charts is a fusion-domain concern owned by fyo (SPM-ADR-104 D2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type fyo:cocos ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An ordered coordinate axis of the chart. Values draw on the ContinuousCoordinate vocabulary (x / y / z / r / z / phi / theta / psi …). Each axis carries a physical unit." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:coordinate_axis ],
        [ sh:class spo:Metric ;
            sh:description "The metric tensor of this coordinate system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_metric ],
        [ sh:datatype xsd:string ;
            sh:description "Named chart family — cartesian / polar / cylindrical / spherical / toroidal (selects the built-in metric)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:chart_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass spo:CoordinateSystem .

fyo:SummaryConstantFlt0d2 a sh:NodeShape ;
    rdfs:comment "Hydrogen (H)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Source of the data (any comment describing the origin of the data : code, path to diagnostic signals, processing method, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:SummaryConstantFlt0d2 .

fyo:IDS a sh:NodeShape ;
    rdfs:comment "An IMAS Interface Data Structure occurrence as a whole — the root ICE every lifted per-IDS schema (this schema/ directory, dd2fyo) subclasses. An IDS is ABOUT the Machine / Plasma / Discharge it describes (spo is_about) and carries orthogonal provenance + data modality (measured / reconstructed / simulated / static-device) via ProvenanceMixin — the DD schema itself is modality-blind. Its time mode (homogeneous_time) is a layout choice (AoS TimeSliceSeries vs SoA signals), orthogonal to what the IDS is about." ;
    sh:closed false ;
    sh:ignoredProperties ( fyo:coherent_wave fyo:readout_time fyo:grid_ggd fyo:grid fyo:time_step fyo:composition fyo:polarizer fyo:z_n fyo:description_ggd fyo:dynamic_integer3d fyo:pixel_status fyo:beam fyo:ec fyo:n_e fyo:position fyo:gas_injection_accumulated fyo:time_width fyo:constant_integer1d fyo:valve fyo:elms fyo:etendue_method fyo:runaways fyo:nbi fyo:fibre_bundle fyo:flux_loop fyo:constant_float6d fyo:first_wall_surface_area fyo:dynamic_integer2d fyo:non_linear fyo:delta_b_field_phi_vacuum_r fyo:exposure_time fyo:detector_voltage fyo:reciprocating fyo:time_loop fyo:constant_integer3d fyo:emission_current fyo:primary_coordinate fyo:rogowski_coil spo:description fyo:species fyo:modules_n fyo:is_periodic fyo:first_wall_enclosed_volume fyo:dynamic_float1d fyo:ip fyo:statistics fyo:frame fyo:magnetic_axis fyo:permeability_table fyo:magnetic_shear_flag fyo:gain_plant fyo:covariance fyo:dynamic_float4d fyo:configuration fyo:latency fyo:psi_normalization fyo:constant_string0d fyo:pf_active fyo:nonlinear_controller fyo:kicks fyo:simulation fyo:control_surface_names fyo:stokes_initial fyo:t_radiation_central fyo:channel fyo:linear_controller fyo:distribution fyo:dynamic_float2d fyo:reference_point fyo:dynamic_integer1d fyo:position_control fyo:time_breakdown fyo:ic fyo:embedded fyo:model fyo:electrons_n fyo:power_radiated_total fyo:shatter_cone_definition fyo:steel_temperature_limit_max fyo:global_quantities fyo:coil fyo:gauge fyo:n_e_volume_average spo:unit fyo:energy_threshold_lower fyo:pulse_time_begin fyo:group fyo:ggd_fluid fyo:fusion_power fyo:camera fyo:dynamic_float5d fyo:mirror fyo:disruption fyo:b_field_phi_probe spo:time fyo:fluids_n fyo:thermal_efficiency_cycle fyo:grids_ggd fyo:model_type fyo:local fyo:volume_average fyo:t_e_magnetic_axis fyo:pellets fyo:pulse_processing_time_begin fyo:thermal_efficiency_plant fyo:photon_energy spo:name fyo:code fyo:heating_current_drive fyo:solver_1d fyo:outline fyo:quantum_efficiency fyo:grid_2d fyo:type fyo:dynamic_float6d fyo:filter_window fyo:normalizing_quantities fyo:constant_string1d fyo:reconstructed_emissivity fyo:first_wall_power_flux_peak_outside_divertors fyo:profiles_2d fyo:r0 fyo:t_radiation_central_o fyo:profiles_1d fyo:plasma_duration fyo:momentum_critical_hot_tail_definition fyo:coupling_matrix fyo:constant_float0d fyo:aperture fyo:identifier fyo:a fyo:ideal_flag fyo:residual_spectrum fyo:constant_float4d fyo:duct fyo:current fyo:event fyo:first_wall_power_flux_peak fyo:modules_pol_n fyo:time_step_average fyo:injector fyo:limiter fyo:ggd_fast rdf:type fyo:divertor fyo:line_of_sight fyo:line_average fyo:constant_float5d fyo:time_step_min fyo:circuit fyo:power_radiated_validity fyo:constant_float2d fyo:detector fyo:ggd fyo:object fyo:laser fyo:pulse fyo:equations fyo:flux_control fyo:ids_properties fyo:flux_surface fyo:field_map fyo:license fyo:stationary_phase_flag fyo:e_field_critical_definition fyo:dynamic_float3d fyo:li6_fraction fyo:pipe fyo:release fyo:linear fyo:b_field_z fyo:lh fyo:machine fyo:shunt fyo:b_field_phi_vacuum_r fyo:pulse_time_begin_epoch fyo:fusion fyo:frame_analysis fyo:b_field_pol_probe_equivalent fyo:rights_holder fyo:time_slice fyo:vacuum_toroidal_field fyo:power_plant fyo:optical_element fyo:species_all fyo:diagnostics fyo:halo_currents fyo:stokes_output fyo:power_density fyo:b_field_pol_probe fyo:crash_trigger fyo:is_replaced_by fyo:boundary fyo:collisions fyo:constant_float3d fyo:rmps fyo:gas_injection_rates fyo:tag fyo:pulse_time_end_epoch fyo:wall fyo:constant_float1d fyo:power_electricity_net fyo:cooling_loop fyo:temperature_reference fyo:constant_integer0d fyo:restart_files fyo:constant_integer2d fyo:solver fyo:scrape_off_layer fyo:pedestal_fits fyo:element fyo:b_field_lines fyo:boundary_conditions_ggd fyo:density_control fyo:midplane fyo:is_referenced_by fyo:power_launched fyo:diamagnetic_flux fyo:detector_layout fyo:coils_n fyo:description_2d fyo:emissivity_profile_1d fyo:momentum_critical_avalanche_definition fyo:grid_2d_type fyo:loop fyo:detector_humidity fyo:force_limits fyo:gas_injection_prefill fyo:fibre_properties fyo:power_radiated_inside_lcfs fyo:segment fyo:supply fyo:tf fyo:detector_temperature fyo:process fyo:valid fyo:replaces fyo:pb_li_volume fyo:change fyo:neutron_flux_total fyo:energy_configuration_name fyo:t_radiation_central_x fyo:sensor fyo:coordinate_system fyo:module fyo:fibre_length fyo:grid_type fyo:polychromator fyo:etendue fyo:antenna fyo:power_electric_plant_operation fyo:source fyo:topic ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:reproducible ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:generated_by_process ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:version_put ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path spo:modality ] ;
    sh:targetClass fyo:IDS .

fyo:PlasmaCompositionNeutralElement a sh:NodeShape ;
    rdfs:comment "List of elements forming the atom or molecule" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of atoms of this element in the molecule" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:atoms_n ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ] ;
    sh:targetClass fyo:PlasmaCompositionNeutralElement .

<http://purl.obolibrary.org/obo/BFO_0000148> a sh:NodeShape ;
    rdfs:comment "A zero-dimensional temporal region (BFO temporal instant) — the referent of one time-slice timestamp. A `time_slice[i]/time` value denotes a TimeInstant on the shot/simulation timeline." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000148> .

spo:TimeSliceSeries a sh:NodeShape ;
    rdfs:comment "The AoS layout — an ordered array of TimeSlice structs (DD `time_slice[]`): the discretized SpacetimeWorm, foliated per instant. Convenient for whole-state-at-t access (equilibrium at t); dual to the SoA TimeSeries via dual_view_of (stack the slices)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:TemporalAggregate ;
            sh:description "The other-layout aggregate carrying the same content about the same referent (AoS ↔ SoA; the slice ⊣ stack adjunction). Symmetric; a read-time transform (sampling one way, regrouping the other), not a persisted distinct datum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:dual_view_of ],
        [ sh:class spo:TimeAxis ;
            sh:description "The TimeAxis this aggregate/mesh is sampled on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:has_time_axis ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000003> ;
            sh:description "The temporally extended referent (SpacetimeWorm / Process) this aggregate is the information content of (iao:is_about specialization). Two aggregates about the same referent with different layouts are dual views, not distinct claims about the world." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:about_occurrent ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:TimeSlice ;
            sh:description "The ordered TimeSlice elements (AoS axis; order = TimeAxis order)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_slice ] ;
    sh:targetClass spo:TimeSliceSeries .

fyo:IdsCode a sh:NodeShape ;
    rdfs:comment "DD per-IDS `code` block, deduplicated: the program whose execution produced this IDS (spo:Code = name/commit/version/repository) plus DD extras (parameters, output_flag). The run itself is a spo ComputationalProcess; its run manifest is a spo ComputationRecord." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of the code specific parameters in XML format" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "URL of software repository" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:repository ],
        [ sh:datatype xsd:string ;
            sh:description "Unique version (tag) of software" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:version ],
        [ sh:class spo:Library ;
            sh:description "List of external libraries used by the code that has produced this IDS" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:library ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:uses_library ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique commit reference of software" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:commit ],
        [ sh:datatype xsd:string ;
            sh:description "Short description of the software (type, purpose)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:integer ;
            sh:description "Output flag : 0 means the run is successful, other values mean some difficulty has been encountered, the exact meaning is then code specific. Negative values mean the result shall not be used." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:output_flag ],
        [ sh:datatype xsd:string ;
            sh:description "Name of software generating IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:IdsCode .

fyo:IdsProperties a sh:NodeShape ;
    rdfs:comment "DD ids_properties, deduplicated across all IDS: occurrence metadata + homogeneous_time (the AoS/SoA time-mode switch: 1 = shared root TimeAxis, 0 = per-node embedded timebases, 2 = no dynamic data). Provenance proper lifts to the spo ProvenanceMixin carried by fyo:IDS." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Date at which this data has been produced" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:creation_date ],
        [ sh:datatype xsd:string ;
            sh:description "User-defined name for this IDS occurrence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:class fyo:IdsPlugins ;
            sh:description "Information about the plugins used to write/read this IDS. This structure is filled automatically by the Access Layer at GET/PUT time, no need to fill it via a user program." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:plugins ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the person in charge of producing this data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:provider ],
        [ sh:datatype xsd:integer ;
            sh:description "This node must be filled (with 0, 1, or 2) for the IDS to be valid. If 1, the time of this IDS is homogeneous, i.e. the time values for this IDS are stored in the time node just below the root of this IDS. If 0, the time values are stored in the various time fields at lower levels in the tree. In the case only constant or static nodes are filled within the IDS, homogeneous_time must be set to 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:homogeneous_time ],
        [ sh:datatype xsd:string ;
            sh:description "Any comment describing the content of this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:comment ],
        [ sh:class fyo:VersionDdAl ;
            sh:description "Version of the access layer package used to PUT this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:version_put ],
        [ sh:class fyo:IdsProvenance ;
            sh:description "Provenance information about this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Type of data contained in this occurrence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:occurrence_type ] ;
    sh:targetClass fyo:IdsProperties .

spo:Code a sh:NodeShape ;
    rdfs:comment "The code that produced an IDS (DD code = name / commit / version / repository) — a prov:SoftwareAgent + prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:library fyo:output_flag fyo:parameters spo:description rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:commit ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:uses_library ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:repository ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass spo:Code .

<http://purl.obolibrary.org/obo/BFO_0000015> a sh:NodeShape ;
    rdfs:comment "An occurrent that depends on material participants (BFO process). Unifies physical evolution / computation / measurement (FYTOK-REPORT-05 §rpt05-cat-process)." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:port_name fyo:initial_profiles fyo:uses_forward_operator fyo:design_space fyo:predicted_equilibrium fyo:free_variables fyo:engineering_evaluations fyo:reconstructed_profiles fyo:predicted_profiles fyo:engineering_limits fyo:initial_state fyo:operating_point_evaluations fyo:reconstructed_equilibrium fyo:produces_ids fyo:objectives fyo:initial_guess fyo:limit_verification_report fyo:uses_inference_engine fyo:actuator_commands fyo:predicted_sources fyo:misfit_report fyo:performed_on fyo:predicted_transport fyo:reference_design fyo:consumes_ids rdf:type fyo:candidate_design fyo:designed_pulse_schedule fyo:heating_and_current_drive fyo:control_laws fyo:closed_loop_trajectory fyo:execution_mode fyo:reference_waveforms fyo:prescribed_waveforms fyo:constraints_and_priors fyo:converges_by <http://purl.obolibrary.org/obo/BFO_0000051> fyo:port_runs fyo:predicted_trajectory fyo:machine_description fyo:checked_against fyo:measured_diagnostics fyo:design_targets <http://purl.obolibrary.org/obo/BFO_0000055> ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_output ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000015> .

fyo:SummaryDynamicFlt1dRootParent2 a sh:NodeShape ;
    rdfs:comment "Hydrogen (H)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Value" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Source of the data (any comment describing the origin of the data : code, path to diagnostic signals, processing method, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:SummaryDynamicFlt1dRootParent2 .

fyo:SignalFlt1d a sh:NodeShape ;
    rdfs:comment "Pressure" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:equivalent_representation ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:representation_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path spo:timebase_source ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:unit ] ;
    sh:targetClass fyo:SignalFlt1d .

spo:Identifier a sh:NodeShape ;
    rdfs:comment "The DD identifier triple (name / index / description). The triple is a controlled-vocabulary value; the vocabulary it draws from is a T-Box enum / class (C-8)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Integer index into the vocabulary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:index ],
        [ sh:class spo:ControlledVocabulary ;
            sh:description "The controlled vocabulary this identifier value draws from (value → vocabulary, A-Box → T-Box)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:draws_from ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Short string key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:description ] ;
    sh:targetClass spo:Identifier .

fyo:GenericGridScalar a sh:NodeShape ;
    rdfs:comment "Source density of particles in phase space, for various grid subsets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:equivalent_representation ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:representation_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:unit ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:datatype xsd:float ;
            sh:description "One scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:values ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:coefficients ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_domain ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:is_function_of ] ;
    sh:targetClass fyo:GenericGridScalar .

fyo:SummaryDynamicFlt1dRoot a sh:NodeShape ;
    rdfs:comment "Total plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Value" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Source of the data (any comment describing the origin of the data : code, path to diagnostic signals, processing method, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ] ;
    sh:targetClass fyo:SummaryDynamicFlt1dRoot .

