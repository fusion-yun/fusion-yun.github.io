        [ sh:datatype xsd:float ;
            sh:description "S3 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:s3 ],
        [ sh:datatype xsd:float ;
            sh:description "S2 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:s2 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "S1 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:s1 ] ;
    sh:targetClass fyo:StokesInitial .

fyo:SummaryBoundary a sh:NodeShape ;
    rdfs:comment "Description of the plasma boundary" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Z position of the geometric axis (defined as (Zmax+Zmin) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:geometric_axis_z ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Minor radius of the plasma boundary (defined as (Rmax-Rmin) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:minor_radius ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "R position of the outer strike point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:strike_point_outer_r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummaryRz1dDynamic ;
            sh:description "RZ position of the main X-point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:x_point_main ],
        [ sh:class fyo:SummaryConstantStr0d ;
            sh:description "String describing the configuration of the strike points (constant, may need to become dynamic when available)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:strike_point_configuration ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "R position of the inner strike point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:strike_point_inner_r ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Upper triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:triangularity_upper ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "R position of the geometric axis (defined as (Rmax+Rmin) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:geometric_axis_r ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Elongation of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:elongation ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "R position of the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:magnetic_axis_r ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Z position of the outer strike point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:strike_point_outer_z ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Lower triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:triangularity_lower ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Z position of the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:magnetic_axis_z ],
        [ sh:class fyo:SummaryDynamicInt1dRoot ;
            sh:description "0 (limiter), 1 (diverted), 11 (LSN), 12 (USN), 13 (DN), 14 (snowflake)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Distance between the separatrix and the nearest limiter or wall element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:gap_limiter_wall ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Distance between the inner and outer separatrices, in the major radius direction, at the plasma outboard and at the height corresponding to the maximum R for the inner separatrix." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:distance_inner_outer_separatrices ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Z position of the inner strike point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:strike_point_inner_z ] ;
    sh:targetClass fyo:SummaryBoundary .

fyo:SummaryDisruption a sh:NodeShape ;
    rdfs:comment "Disruption characteristics, if the pulse is terminated by a disruption" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Pre-disruption time = disruption.time - t_pre, where t_pre[s] is approximately given by 0.0025 * R0[m]^2 and R0 is the major radius where the toroidal field is defined (../../global_quantities/r0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:time_predisruption ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Time of maximum radiated power, relative to the time of the disruption" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:time_radiated_power_max ],
        [ sh:class spo:Identifier ;
            sh:description "Type of the disruption" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:type ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Time of the disruption =  min(t_TQ, t_VDE), where t_TQ and t_VDE are the times at which the Thermal Quench (TQ) and the Vertical Displacement Event (VDE) are detected by their respective detectors" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryDisruptionDecay ;
            sh:description "Characteristic decay times describing the loss of different quantities during the disruption" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:decay_times ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Time at which the plasma current has fallen to half of the initial current at the start of the disruption, relative to the time of the disruption" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:time_half_ip ],
        [ sh:class fyo:SummaryConstantInt0d ;
            sh:description "Direction of the plasma vertical displacement just before the disruption 1 (upwards) / 0 (no displacement)/ -1 (downwards)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:vertical_displacement ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummaryConstantInt0d ;
            sh:description "Flag indicating whether any disruption mitigation valve has been used (1) or none (0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:mitigation_valve ],
        [ sh:class fyo:SummaryHalo ;
            sh:description "Characteristics of halo current" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:halo_current ] ;
    sh:targetClass fyo:SummaryDisruption .

fyo:SummaryDisruptionDecay a sh:NodeShape ;
    rdfs:comment "Characteristic decay times describing the loss of different quantities during the disruption" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
