    sh:targetClass fyo:SummaryStaticInt0d .

fyo:WallDescriptionGgdEnergyIon a sh:NodeShape ;
    rdfs:comment "Fluxes related to the various ion species, in the sense of isonuclear or isomolecular sequences. Ionization states (and other types of states) must be differentiated at the state level below" ;
    sh:closed true ;
