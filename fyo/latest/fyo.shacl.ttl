fyo:Focs a sh:NodeShape ;
    rdfs:comment "Fiber Optic Current Sensor (FOCS)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “Current sensor installed around vacuum vessel sector #5”" ;
