            sh:order 5 ;
            sh:path spo:at_time ],
        [ sh:class fyo:WavesCoherentWaveFullWaveEField ;
            sh:description "Components of the wave electric field, represented as Fourier coefficients E(n_tor,frequency) such that the electric is equal to real(E(n_tor,frequency).exp(i(n_tor.phi - 2.pi.frequency.t)))" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:e_field ],
        [ sh:datatype xsd:string ;
