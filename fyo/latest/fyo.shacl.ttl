fyo:NumericsSolver1dEquationControlParameters a sh:NodeShape ;
    rdfs:comment "Solver-specific input or output quantities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:NumericsSolver1dEquationControlInt ;
            sh:description "Set of integer type scalar control parameters" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:integer0d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
