fyo:ThickLineStatic a sh:NodeShape ;
    rdfs:comment "The element is approximated by a rectangle defined by a central segment and a thickness in the direction perpendicular to the segment" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rz0dStatic ;
            sh:description "Position of the first point" ;
            sh:maxCount 1 ;
