        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:WavesCoherentWaveProfiles2dIonState .

fyo:WavesProfiles1dEFieldNPhi a sh:NodeShape ;
    rdfs:comment "Components of the electric field per toroidal mode number, averaged over the flux surface, where the averaged is weighted with the power deposition density, such that e_field = ave(e_field.power_density) / ave(power_density)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:WavesCPXAmpPhase1D ;
            sh:description "Right hand polarized electric field component for every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:minus ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:WavesCPXAmpPhase1D ;
            sh:description "Left hand polarized electric field component for every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:plus ],
        [ sh:class fyo:WavesCPXAmpPhase1D ;
            sh:description "Parallel electric field component for every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:parallel ] ;
    sh:targetClass fyo:WavesProfiles1dEFieldNPhi .

fyo:WavesProfiles2dEFieldNPhi a sh:NodeShape ;
    rdfs:comment "Components of the electric field per toroidal mode number" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:WavesCPXAmpPhase2D ;
            sh:description "Right hand polarized electric field component" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:minus ],
        [ sh:class fyo:WavesCPXAmpPhase2D ;
            sh:description "Left hand polarized electric field component" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:plus ],
        [ sh:class fyo:WavesCPXAmpPhase2D ;
            sh:description "Parallel electric field component" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:parallel ] ;
    sh:targetClass fyo:WavesProfiles2dEFieldNPhi .

fyo:WorkflowComponent a sh:NodeShape ;
    rdfs:comment "Control parameters for the set of participting components defined in ../../component" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Array of real workflow control parameters used by this component (component specific)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:control_float ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Simulation time interval for which this component is requested to compute its results" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_interval_request ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Array of integer workflow control parameters used by this component (component specific)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:control_integer ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the component in the ../../../component array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:index ],
        [ sh:datatype xsd:float ;
            sh:description "Simulation time interval for which this component has last computed its results" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time_interval_elapsed ],
        [ sh:datatype xsd:integer ;
            sh:description "Component execution mode for current workflow cycle. 0 means the component is not executed and the workflow uses results from previous workflow cycle. 1 means the component is executed for this workflow cycle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:execution_mode ] ;
    sh:targetClass fyo:WorkflowComponent .

fyo:WorkflowCycle a sh:NodeShape ;
    rdfs:comment "Set of time slices corresponding to the beginning of workflow cycles (main time loop of the workflow). During each workflow cycle, active components compute their result during their given time_interval. Components having completed their computation are frozen until the end of the workflow cycle. The next workflow cycle begins when the maximum time_interval (over the components) has been reached." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:WorkflowComponent ;
            sh:description "Control parameters for the set of participting components defined in ../../component" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:component ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:WorkflowCycle .

fyo:WorkflowTimeLoop a sh:NodeShape ;
    rdfs:comment "Description of a workflow based on a time loop which calls components defined in component_list sequentially  during each cycle of the loop (workflow_cycle)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CodeConstant ;
            sh:description "List of components partcipating in the workflow" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:component ],
        [ sh:datatype xsd:float ;
            sh:description "Termination time for the workflow main time loop" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time_end ],
        [ sh:class fyo:WorkflowCycle ;
            sh:description "Set of time slices corresponding to the beginning of workflow cycles (main time loop of the workflow). During each workflow cycle, active components compute their result during their given time_interval. Components having completed their computation are frozen until the end of the workflow cycle. The next workflow cycle begins when the maximum time_interval (over the components) has been reached." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:workflow_cycle ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:WorkflowTimeLoop .

fyo:Xyz1dPositionsStatic a sh:NodeShape ;
    rdfs:comment "List of positions of the centroids, in Cartesian coordinates" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "List of Y coordinates" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:y ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "List of Z coordinates" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "List of X coordinates" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:x ] ;
    sh:targetClass fyo:Xyz1dPositionsStatic .

fyo:Xyz3dStatic a sh:NodeShape ;
    rdfs:comment "Vector that points from the centre of the voxel to the centre of the detector, described in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Component along Z axis  for each voxel" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Component along Y axis  for each voxel" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:y ],
        [ sh:datatype xsd:float ;
            sh:description "Components along X axis for each voxel" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:x ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:Xyz3dStatic .

spo:ControlledVocabulary a sh:NodeShape ;
    rdfs:comment "A controlled vocabulary (the determinable). Its permissible values are the determinates (DD *_identifier.xml entries)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass spo:ControlledVocabulary .

spo:DesignSpecification a sh:NodeShape ;
    rdfs:comment "A DIRECTIVE information content entity that prescribes a material artifact to be realized — an engineering drawing of the EAST vacuum vessel, a coil winding spec. Distinguish three stances toward one MaterialEntity: (1) the thing itself (MaterialEntity); (2) the prescription of it (this class — exists before/independent of the thing; the as-designed view); (3) the description of it as built (a plain descriptive ICE with is_about — an as-measured machine-description dataset). Design and as-built descriptions may disagree; only (3) is truth-evaluable against reality. IAO alignment IRI [TBD]." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "The material entity (kind) this design specification prescribes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:prescribes ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass spo:DesignSpecification .

spo:Mesh a sh:NodeShape ;
    rdfs:comment "A discretized domain (DD GGD generic_grid). Binds to sp_mathx Mesh / DEC: space = Domain, grid_subset = named subdomain / boundary, objects_per_dimension = topology chain (C-7). Not mirrored verbatim from DD." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:theta_straight spo:discretizes_spacetime fyo:dim2 fyo:phi fyo:dim1 fyo:type spo:time fyo:r fyo:identifier fyo:area fyo:path fyo:theta_geometric rdf:type fyo:psi_boundary fyo:rho_tor_norm fyo:rho_pol_norm fyo:volume_element fyo:space fyo:rho_tor spo:has_spatial_base fyo:z spo:has_time_axis fyo:psi fyo:surface fyo:volume fyo:grid_subset fyo:psi_magnetic_axis ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:describes_region ] ;
    sh:targetClass spo:Mesh .

spo:Signal a sh:NodeShape ;
    rdfs:comment "A continuous quantity over the **time domain** (a TemporalRegion) — scalar or tensor (DD signal_flt_Nd, C-2). Sibling of Field (space / general domain) under ContinuousQuantity, not a subtype of it. Corresponds to the engineering carrier sp.mathx.signal.Signal — a Function over a time domain (the temporal analogue of Field, a Function over a Mesh), converged from sp_phys to sp_mathx (L1) as the domain-agnostic quantity-over-time. Bound via class_type (engineering-dispatch FQCN, distinct from the semantic class_uri; SPM-REPORT-15 C-3)." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:validity_timed fyo:validity rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Signal samples over the time base — the DD/A-Box serialization column (runtime carrier is a Function)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:data ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:unit ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:float ;
            sh:description "Signal time base — the DD/A-Box serialization column of the time axis (alias \".../time\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:time ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path spo:timebase_source ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:equivalent_representation ] ;
    sh:targetClass spo:Signal .

spo:TimeSlice a sh:NodeShape ;
    rdfs:comment "One AoS element — the complete state description of a system at one TimeInstant (the foliated 3D view of the 4D referent at fixed t; DD `time_slice[]` element, e.g. one equilibrium reconstruction). Identity note: a TimeSlice is a VIEW indexed by (referent, instant), not an independent individual — the individual is the 4D referent." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:particles_fast_n fyo:power_density_conductive_losses fyo:a_field_phi fyo:n_i_thermal_total fyo:magnetic_moment_r fyo:grid fyo:k_perpendicular fyo:em_force_density fyo:power_thermal_neutrons fyo:total_ion_particles_decomposed fyo:beam fyo:delta_tangency_radius fyo:b_field_r fyo:wall_flux_max fyo:p_i_total_fast_perpendicular fyo:n_e fyo:p_e_fast_perpendicular fyo:inside_lcfs fyo:midplane_wall_distance fyo:t_e_average fyo:b_field_angle fyo:phi_potential fyo:pressure_perpendicular fyo:m_pol fyo:townsend_or_closed_grid_positions fyo:amplitude fyo:energy_fast fyo:total_ion_particles_inside fyo:j_runaways fyo:trapped fyo:current_phi_n_phi fyo:velocity_r fyo:parameters fyo:pressure_fast_perpendicular fyo:distance_x_point_z fyo:toroidal_mode fyo:thermalization fyo:antenna_emission fyo:pressure_parallel fyo:b_field fyo:time_within_plunge fyo:e_field_dreicer fyo:image_raw fyo:power fyo:line_of_sight_emission fyo:a_field fyo:orbit fyo:energy_density_kinetic fyo:collector fyo:p_i_total fyo:sol_heat_decay_length fyo:current_phi_inside_n_phi fyo:power_inside_ion_total fyo:j_parallel fyo:emissivity_neutral_total fyo:power_n_phi fyo:total_ion_power_inside fyo:fast_filter fyo:n_e_target fyo:orbit_frequency_tor fyo:a_field_z fyo:grid_v fyo:torque_tor_j_radial fyo:s1 fyo:ddensity_dt_dreicer fyo:magnetic_moment_phi fyo:d_dvolume_drho_tor_dt fyo:grid_d fyo:s2 fyo:contour_tree fyo:total_ion_energy_decomposed fyo:phi fyo:p_e_fast_parallel fyo:particle_fluxes fyo:ddensity_dt_total fyo:integration_time fyo:counter_passing fyo:expansion_fd3v fyo:ion fyo:p_e fyo:momentum_critical_avalanche fyo:mode fyo:inside_vessel fyo:geometric_coefficients fyo:radiance fyo:total_ion_power fyo:psi fyo:equation fyo:open_fraction fyo:velocity_parallel_over_b_field fyo:s3 fyo:global_quantities fyo:shinethrough fyo:orbit_frequency_pol fyo:power_inside_n_phi fyo:j_non_inductive fyo:torque_phi_j_radial fyo:distance_separatrix_midplane fyo:density_fast fyo:r_j_phi fyo:current_phi_inside fyo:vorticity_over_r fyo:power_thermal_extracted fyo:power_nuclear_blanket fyo:j_r fyo:electrons spo:time fyo:ddensity_dt_hot_tail fyo:power_rotation fyo:current_parallel_inside fyo:psi_star_pre_crash fyo:torque_phi_inside fyo:pressure_inlet fyo:t_e_target fyo:pellet fyo:drho_tor_dt fyo:particles fyo:momentum_critical_hot_tail fyo:type fyo:density fyo:v_plasma fyo:grid_flux fyo:escape_flux_max fyo:n_phi fyo:profiles_2d fyo:a_field_r fyo:psi_star_post_crash fyo:profiles_1d fyo:ddensity_dt_compton fyo:grid_subset fyo:position_average fyo:total_ion_energy fyo:n_i_total fyo:velocity_parallel fyo:antenna_detection fyo:dim2 fyo:torque_phi fyo:expansion fyo:discrete fyo:temperature fyo:power_inside fyo:a fyo:power_charge_exchange fyo:current_parallel fyo:line_of_sight_detection fyo:neutral fyo:current fyo:current_fast_phi fyo:power_flux_parallel fyo:velocity_phi fyo:width fyo:current_parallel_density fyo:power_inside_neutral_total fyo:r rdf:type fyo:zeff fyo:orbit_type fyo:current_phi fyo:ggd fyo:mass_density fyo:temperature_inlet fyo:co_passing fyo:e_field_parallel fyo:power_first_orbit fyo:control_surface fyo:pressure_fast_parallel fyo:pressure_ion_total fyo:tritium_breeding_ratio fyo:field_map fyo:t_i_average fyo:j_bootstrap fyo:j_total fyo:dim1 fyo:n_i_total_over_n_e fyo:energy_fast_parallel fyo:j_phi fyo:s0 fyo:b_field_z fyo:townsend_or_closed_positions fyo:momentum_phi fyo:velocity_z fyo:b_field_phi fyo:e_field_n_phi fyo:e_field_radial fyo:pressure_fast fyo:power_density_n_phi fyo:vorticity fyo:current_density fyo:names fyo:p_i_total_fast_parallel fyo:power_incident_radiated fyo:power_density fyo:power_density_radiative_losses fyo:resistivity fyo:j_z fyo:e_field_critical fyo:power_thermal_radiated fyo:boundary fyo:collisions fyo:starting_positions fyo:power_incident_neutron fyo:conductivity_parallel fyo:lengths fyo:mach_number_parallel fyo:e_field fyo:total_ion_particles fyo:pressure_thermal fyo:filter fyo:magnetic_moment_z fyo:particles_n fyo:temperature_outlet fyo:momentum_phi_j_cross_b_field fyo:control_parameters fyo:q fyo:area fyo:n_e_fast fyo:t_e fyo:b_field_tor fyo:delta_position fyo:component fyo:constraints fyo:j_ohmic fyo:counts_bin_n fyo:power_nuclear_shields fyo:e_field_phi fyo:transport_perpendicular fyo:energy fyo:energy_multiplication_factor fyo:energy_fluxes fyo:pressure fyo:a_field_tor fyo:recycling fyo:sol_heat_spreading_length fyo:centre fyo:emissivity_ion_total fyo:v_biasing fyo:current_parallel_density_n_phi fyo:ddensity_dt_tritium fyo:delta_angle fyo:active_wall_point fyo:pitch_angle fyo:apparent_temperature fyo:midplane_power_density_nuclear fyo:frequency fyo:coordinate_system fyo:identifiers fyo:grid_type fyo:e_field_townsend fyo:spectrum fyo:convergence fyo:descriptions fyo:counts_n fyo:power_nuclear fyo:magnetic_shear fyo:z fyo:region_of_interest fyo:source ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:slice_of ] ;
    sh:targetClass spo:TimeSlice .

<http://purl.obolibrary.org/obo/BFO_0000024> a sh:NodeShape ;
    rdfs:comment "The ionized matter held inside the vacuum-vessel fiat boundary of a Machine during a Shot, bearer of physical qualities (temperature, density, current, flux topology). NOT a bfo:object (no bona-fide boundary; discontinuous across shots). One Plasma instance per Shot. SP-ONT-APP-PLASMA. `sp:Plasma ⊑ bfo:fiat_object_part ⊓ ∃isHostedBy.Machine`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "Inverse of hosts — the Machine a Plasma is confined in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:isHostedBy ],
        [ sh:datatype xsd:string ;
            sh:description "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:occupies ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000024> .

<http://qudt.org/schema/qudt/QuantityKind> a sh:NodeShape ;
    rdfs:comment "A kind of physical quantity — the DETERMINABLE (\"electron temperature\", \"poloidal flux\") as an ICE, independent of any bearer, domain, or unit. A concrete measured or computed quantity (Quality in the world; ContinuousQuantity/QuantityValue as information) determines a QuantityKind. Aligns qudt:QuantityKind; fusion-specific kinds are enumerated downstream (fyo), not here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional symbol (e.g. T_e, psi)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:symbol ],
        [ sh:datatype xsd:string ;
            sh:description "QUDT dimension-vector expression (e.g. L2 M T-2); authority external (QUDT)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:dimension_vector ] ;
    sh:targetClass <http://qudt.org/schema/qudt/QuantityKind> .

fyo:AmnsDataProcessReactant a sh:NodeShape ;
    rdfs:comment "Set of reactants involved in this process" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier for the role of this paricipant in the reaction. For surface reactions distinguish between projectile and wall." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:role ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplicity in the reaction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:multiplicity ],
        [ sh:datatype xsd:string ;
            sh:description "Label identifying in text form the metastable" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:metastable_label ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of the participant" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:mass ],
        [ sh:datatype xsd:integer ;
            sh:description "An array identifying the metastable; if zero-length, then not a metastable; if of length 1, then the value indicates the electronic level for the metastable (mostly used for atoms/ions); if of length 2, then the 1st would indicate the electronic level and the second the vibrational level for the metastable (mostly used for molecules and molecular ions); if of length 3, then the 1st would indicate the electronic level, the second the vibrational level and the third the rotational level for the metastable (mostly used for molecules and molecular ions)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:metastable ],
        [ sh:datatype xsd:float ;
            sh:description "Charge number of the participant" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:charge ],
        [ sh:datatype xsd:integer ;
            sh:description "This is a flag indicating that charges are absolute (if set to 0), relative (if 1) or irrelevant (-1); relative would be used to categorize the ionization reactions from i to i+1 for all charge states; in the case of bundles, the +1 relative indicates the next bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:relative_charge ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom (in such case, this array should be of size 1) or molecule. Mass of atom and nuclear charge should be set to 0 for photons and electrons. The mass of atom shouldn't be set for an atomic process that is not isotope dependent." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying reaction participant (e.g. \"D\", \"e\", \"W\", \"CD4\", \"photon\", \"n\")" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:AmnsDataProcessReactant .

fyo:CameraGeometry a sh:NodeShape ;
    rdfs:comment "Characteristics of the camera used. The orientation of the camera is described as follows : pixels are aligned along x1 and x2 unit vectors while x3 is normal to the detector plane." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the camera centre" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:centre ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of pixels in each direction (x1, x2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:pixels_n ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:datatype xsd:float ;
            sh:description "Total camera dimension in each direction (x1, x2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:camera_dimensions ],
        [ sh:datatype xsd:float ;
            sh:description "Pixel dimension in each direction (x1, x2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:pixel_dimensions ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the camera plane and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:class fyo:Rphiz2dStatic ;
            sh:description "Position of the centre of each pixel. First dimension : line index (x1 axis). Second dimension: column index (x2 axis)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:pixel_position ],
        [ sh:class fyo:LineOfSight2pointsRphiz2d ;
            sh:description "Description of the line of sight for each pixel, given by 2 points. For each coordinate : first dimension : line index (x1 axis); second dimension: column index (x2 axis)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:line_of_sight ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:CameraGeometry .

fyo:CameraVisibleGeometryMatrixStep2 a sh:NodeShape ;
    rdfs:comment "Geometry matrix with reflections" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The Ray Transfer Matrix (RTM, or geometry matrix) here provides transformation of the signal from each individual unit light source (voxel) to each pixel of the receiver (detector). The emission profile has [photons.m^-3.s^-1.sr^-1] units and radiance signal has [photons.m^-2.s^-1.sr^-1] units. So the RTM has [m] units. This data is stored in a sparse form, i.e. the array contains only the non-zero element of the Ray transfer matrix. The voxel index corresponding to an element of this array can be found in voxel_indices. The pixel indices corresponding to an element of this array can be found in pixel_indices" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "List of pixel indices used in the sparse data array. The first dimension refers to the data array index. The second dimension lists the line index (horizontal axis) in first position, then the column index (vertical axis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:pixel_indices ],
        [ sh:datatype xsd:integer ;
            sh:description "List of voxel indices (defined in the voxel map) used in the sparse data array" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:voxel_indices ] ;
    sh:targetClass fyo:CameraVisibleGeometryMatrixStep2 .

fyo:CodeConstantNoparam a sh:NodeShape ;
    rdfs:comment "Plugin infrastructure used to PUT the data" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short description of the software (type, purpose)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:uses_library ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "URL of software repository" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:repository ],
        [ sh:datatype xsd:string ;
            sh:description "Unique version (tag) of software" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:version ],
        [ sh:datatype xsd:string ;
            sh:description "Name of software used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Unique commit reference of software" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:commit ] ;
    sh:targetClass fyo:CodeConstantNoparam .

fyo:CodePartialConstant a sh:NodeShape ;
    rdfs:comment "Code-specific parameters used for this eigenmode" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "List of the code specific parameters in XML format" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Output flag : 0 means the run is successful, other values mean some difficulty has been encountered, the exact meaning is then code specific. Negative values mean the result shall not be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:output_flag ] ;
    sh:targetClass fyo:CodePartialConstant .

fyo:CoreProfilesProfiles1d a sh:NodeShape ;
    rdfs:comment "Changes in 1D core profiles for various time slices. This structure mirrors core_profiles/profiles_1d and describes instant changes to each of these physical quantities (i.e. a signed difference quantity after change - quantity before change)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Total ion thermal density (sum over species and charge states)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:n_i_thermal_total ],
        [ sh:datatype xsd:float ;
            sh:description "Total parallel pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Ratio of total ion density (sum over species and charge states) over electron density. (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:n_i_total_over_n_e ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma toroidal momentum, summed over ion species and electrons weighted by their density and major radius, i.e. sum_over_species(n*R*m*Vphi)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:momentum_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Total toroidal current density = average(J_phi/R) / average(1/R)" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:j_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Electrostatic potential, averaged on the magnetic flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fyo:phi_potential ],
        [ sh:class fyo:CoreProfiles1DFit ;
            sh:description "Information on the fit used to obtain the t_i_average profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:t_i_average_fit ],
        [ sh:class fyo:CoreProfilesVectorComponents1 ;
            sh:description "Electric field, averaged on the magnetic surface. E.g for the parallel component, average(E.B) / B0, using core_profiles/vacuum_toroidal_field/b0" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:e_field ],
        [ sh:datatype xsd:float ;
            sh:description "Safety factor (only positive when toroidal current and magnetic field are in same direction)" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fyo:q ],
        [ sh:datatype xsd:float ;
            sh:description "Ohmic parallel current density = average(J_Ohmic.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:j_ohmic ],
        [ sh:datatype xsd:float ;
            sh:description "Total (sum over ion species) thermal ion pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_ion_total ],
        [ sh:datatype xsd:float ;
            sh:description "Total parallel current density = average(jtot.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:j_total ],
        [ sh:datatype xsd:float ;
            sh:description "Effective charge" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:zeff ],
        [ sh:class fyo:CoreProfilesProfiles1dElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:electrons ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path fyo:time ],
        [ sh:class fyo:CoreRadialGrid ;
            sh:description "Radial grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "Bootstrap current density = average(J_Bootstrap.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:j_bootstrap ],
        [ sh:class fyo:CoreProfiles1DFit ;
            sh:description "Information on the fit used to obtain the zeff profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:zeff_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged on charge states and ion species)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:t_i_average ],
        [ sh:class fyo:CoreProfileIons ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionization states (or other types of states) must be differentiated at the state level below" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:float ;
            sh:description "Total perpendicular pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:pressure_perpendicular ],
        [ sh:class fyo:CoreProfileNeutral ;
            sh:description "Quantities related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:neutral ],
        [ sh:datatype xsd:float ;
            sh:description "Thermal pressure (electrons+ions)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Non-inductive (includes bootstrap) parallel current density = average(jni.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:j_non_inductive ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the flux surface averaged electrostatic potential with respect to the poloidal flux, multiplied by (1/2pi). This quantity is the toroidal angular rotation frequency due to the ExB drift, introduced in formula (43) of Hinton and Wong, Physics of Fluids 3082 (1985), also referred to as sonic flow in regimes in which the toroidal velocity is dominant over the poloidal velocity" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:rotation_frequency_tor_sonic ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel conductivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:conductivity_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel current driven inside the flux surface. Cumulative surface integral of j_total" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:current_parallel_inside ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic shear, defined as rho_tor/q . dq/drho_tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path fyo:magnetic_shear ] ;
    sh:targetClass fyo:CoreProfilesProfiles1d .

fyo:CoreSourcesSourceProfiles1dEnergyDecomposed3 a sh:NodeShape ;
    rdfs:comment "Decomposition of the source term for electron energy equation into implicit and explicit parts" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Explicit part of the source term" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:explicit_part ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Implicit part of the source term, i.e. to be multiplied by the equation's primary quantity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:implicit_part ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:CoreSourcesSourceProfiles1dEnergyDecomposed3 .

fyo:CoreSourcesSourceProfiles1dParticlesDecomposed3 a sh:NodeShape ;
    rdfs:comment "Decomposition of the source term for electron density equation into implicit and explicit parts" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Explicit part of the source term" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:explicit_part ],
        [ sh:datatype xsd:float ;
            sh:description "Implicit part of the source term, i.e. to be multiplied by the equation's primary quantity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:implicit_part ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:CoreSourcesSourceProfiles1dParticlesDecomposed3 .

fyo:CoreTransportModel3Density a sh:NodeShape ;
    rdfs:comment "Transport quantities related to density equation of the charge state considered (thermal+non-thermal)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Effective convection" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:v ],
        [ sh:datatype xsd:float ;
            sh:description "Effective diffusivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:d ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:flux ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:CoreTransportModel3Density .

fyo:CoreTransportModel3Energy a sh:NodeShape ;
    rdfs:comment "Transport quantities related to the energy equation of the charge state considered" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Effective diffusivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:d ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Effective convection" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:v ],
        [ sh:datatype xsd:float ;
            sh:description "Flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:flux ] ;
    sh:targetClass fyo:CoreTransportModel3Energy .

fyo:CovarianceMatrix a sh:NodeShape ;
    rdfs:comment "User defined covariance matrix. The covariance of various quantities can be stored here, these quantities are referred to by giving their IDS path in the rows_uri list" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Covariance matrix" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "List of URIs corresponding to the rows (1st dimension) of the covariance matrix. If not all indices of a given node are used, they must be listed explicitly e.g. rows_uri(i) = pf_active:1/coil(i) will refer to a list of indices of the occurrence 1 of the pf_active IDS of this data entry. If the rows correspond to all indices of a given vector it is sufficient to give a single URI where this vector is denoted using the (:) implicit notation, e.g. rows_uri(1) = /grid_ggd(3)/grid_subset(2)/elements(:)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rows_uri ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description of this covariance matrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:CovarianceMatrix .

fyo:CurvedObject a sh:NodeShape ;
    rdfs:comment "Description of the geometry of the mirror, in its reference position" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Geometry of the object contour. Note that there is some flexibility in the choice of the local coordinate system (X1,X2,X3). The data provider should choose the most convenient coordinate system for the object, respecting the definitions of (X1,X2,X3) indicated below." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:geometry_type ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the center of the sphere which defines the mirror, in the case of a spherical mirror (geometry_type = 2), derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:sphere_centre ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Material of the object" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:material ],
        [ sh:datatype xsd:float ;
            sh:description "Surface of the object, derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:surface ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the object in the X2 direction, used only if geometry_type/index = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:x2_width ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X1 direction, to be filled only for curvature_type/index = 2, 4 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:x1_curvature ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X2 direction, to be filled only for curvature_type/index = 3 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:x2_curvature ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:X1x21dStatic ;
            sh:description "Irregular outline of the object in the (X1, X2) coordinate system, used only if geometry_type/index=1. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:outline ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the object surface and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:class spo:Identifier ;
            sh:description "Curvature of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:curvature_type ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the object in the X1 direction, used only if geometry_type/index = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:x1_width ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of the circle, used only if geometry_type/index = 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:radius ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Coordinates of the origin of the local coordinate system (X1,X2,X3) describing the object. This origin is located within the object area and should be the middle point of the object surface. If geometry_type=2, it's the centre of the circular object. If geometry_type=3, it's the centre of the rectangular object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:centre ] ;
    sh:targetClass fyo:CurvedObject .

fyo:CurvedSurface a sh:NodeShape ;
    rdfs:comment "Curvature of the front surface" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X2 direction, to be filled only for curvature_type/index = 3 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:x2_curvature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X1 direction, to be filled only for curvature_type/index = 2, 4 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:x1_curvature ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Curvature of the surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:curvature_type ] ;
    sh:targetClass fyo:CurvedSurface .

fyo:DdCoil a sh:NodeShape ;
    rdfs:comment "Set of coils" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage on the coil terminals. Sign convention : positive when the current flows in the direction in which conductor elements are ordered (from start to end for a positive polarity coil)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:voltage ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Fast neutron flux arriving on the inboard side of this coil" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:neutron_fast_flux_inboard ],
        [ sh:datatype xsd:float ;
            sh:description "Coil resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:resistance ],
        [ sh:datatype xsd:string ;
            sh:description "Alphanumeric identifier of coil" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CoilConductor ;
            sh:description "Set of conductors inside the coil. The structure can be used with size 1 for a simplified description as a single conductor. A conductor is composed of several elements, serially connected, i.e. transporting the same current." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:conductor ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Current in one turn of the coil (to be multiplied by the number of turns to calculate the magnetic field generated). Sign convention : a positive current flows in the direction in which conductor elements are ordered (from start to end for a positive polarity coil)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “Coil between sector 1 and 2”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Number of total turns in the coil. May be a fraction when describing the coil connections." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:turns ] ;
    sh:targetClass fyo:DdCoil .

fyo:DetectorImage a sh:NodeShape ;
    rdfs:comment "Image of the detector or pixel on the focal plane of the optical system" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Coordinates of the points shaping the polygon of the image" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:outline ],
        [ sh:class fyo:DetectorImageCircular ;
            sh:description "Description of circular or elliptic image" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:circular ],
        [ sh:datatype xsd:integer ;
            sh:description "Type of geometry used to describe the image (1:'outline', 2:'circular')" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DetectorImage .

fyo:DistributionProcessIdentifier a sh:NodeShape ;
    rdfs:comment "Set of processes (NBI units, fusion reactions, ...) that provide the source." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "For nuclear reaction source, energy of the reactants. index = 0 for a sum over all energies; index = 1 for thermal-thermal; index = 2 for beam-beam; index = 3 for beam-thermal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:reactant_energy ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the NBI unit considered. Refers to the \"unit\" array of the NBI IDS. 0 means sum over all NBI units." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:nbi_unit ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the NBI beamlets group considered. Refers to the \"unit/beamlets_group\" array of the NBI IDS. 0 means sum over all beamlets groups." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:nbi_beamlets_group ],
        [ sh:class spo:Identifier ;
            sh:description "Process type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:class spo:Identifier ;
            sh:description "For NBI source, energy of the accelerated species considered. index = 0 for a sum over all energies; index = 1 for full energiy; index = 2 for half energy; index = 3 for third energy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:nbi_energy ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DistributionProcessIdentifier .

fyo:EngineeringPortRun a sh:NodeShape ;
    rdfs:comment "One engineering-port invocation — the \"经端口\" tier of the in/port/out engineering boundary (FYTOK-ADR-119 D3: single-direction-coupled machine engineering — system codes, whole-machine CAD, neutronics, structural FEM — is reached through ports, never implemented in-repo). Contract per FYTOK-ADR-126: THREE segments (prepare inputs → run → collect outputs) sharing no mutable state, with prepare/collect runnable and regressible when the external code is absent; the bidirectional parameter mapping (name · unit · direction · provenance) is DATA, not code; port dependencies are extras-isolated; port products land in existing IMAS DD carriers (produces_ids), never in parallel structures. First landed port = neutronics; the contract generalizes only after that single-point validation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_input ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:produces_ids ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "The engineering port bound (e.g. neutronics; later tritium / heat-and-net-electric / system-code)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:port_name ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:consumes_ids ],
        [ sh:description "live / stub / archive — archive read-back is first-class (FYTOK-ADR-126, ADR-121)." ;
            sh:in ( "live" "stub" "archive" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path fyo:execution_mode ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_output ] ;
    sh:targetClass fyo:EngineeringPortRun .

fyo:EquilibriumConstraints0DIpLike a sh:NodeShape ;
    rdfs:comment "Plasma current. Positive sign means anti-clockwise when viewed from above" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Weight given to the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:weight ],
        [ sh:datatype xsd:float ;
            sh:description "Value calculated from the reconstructed equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:reconstructed ],
        [ sh:datatype xsd:float ;
            sh:description "Measured value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:measured ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the source data for this measurement in the IMAS data dictionary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means exact data, taken as an exact input without being fitted; 0 means the equilibrium code does a least square fit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:exact ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error normalized by the variance considered in the minimization process : chi_squared = weight^2 *(reconstructed - measured)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:chi_squared ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slice used from the time array of the measurement source data. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_measurement ] ;
    sh:targetClass fyo:EquilibriumConstraints0DIpLike .

fyo:EquilibriumConstraintsPurePosition a sh:NodeShape ;
    rdfs:comment "Array of X-points, for each of them the RZ position is given" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Squared error on the major radius normalized by the variance considered in the minimization process : chi_squared = weight^2 *(position_reconstructed/r - position_measured/r)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:chi_squared_r ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "Position estimated from the reconstructed equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:position_reconstructed ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means exact data, taken as an exact input without being fitted; 0 means the equilibrium code does a least square fit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:exact ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Weight given to the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:weight ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "Measured or estimated position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:position_measured ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slice used from the time array of the measurement source data. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_measurement ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error on the altitude normalized by the variance considered in the minimization process : chi_squared = weight^2 *(position_reconstructed/z - position_measured/z)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:chi_squared_z ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the source data for this measurement in the IMAS data dictionary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ] ;
    sh:targetClass fyo:EquilibriumConstraintsPurePosition .

fyo:FlatObjectOrientationAos3 a sh:NodeShape ;
    rdfs:comment "Dynamic emission antenna orientation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Xyz0dDynamicAos3 ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the detector/aperture plane and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Xyz0dDynamicAos3 ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:class fyo:Xyz0dDynamicAos3 ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:FlatObjectOrientationAos3 .

fyo:FlatObjectStatic a sh:NodeShape ;
    rdfs:comment "Static part of the geometry of the emission antenna" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Type of geometry used to describe the surface of the detector or aperture (1:'outline', 2:'circular', 3:'rectangle'). In case of 'outline', the surface is described by an outline of point in a local coordinate system defined by a centre and three unit vectors X1, X2, X3. Note that there is some flexibility here and the data provider should choose the most convenient coordinate system for the object, respecting the definitions of (X1,X2,X3) indicated below. In case of 'circular', the surface is a circle defined by its centre, radius, and normal vector oriented towards the plasma X3.  In case of 'rectangle', the surface is a rectangle defined by its centre, widths in the X1 and X2 directions, and normal vector oriented towards the plasma X3." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:class fyo:X1x21dStatic ;
            sh:description "Irregular outline of the detector/aperture in the (X1, X2) coordinate system. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of the circle, used only if geometry_type = 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:radius ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the aperture in the X2 direction, used only if geometry_type = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:x2_width ],
        [ sh:datatype xsd:float ;
            sh:description "Surface of the detector/aperture, derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:surface ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "If geometry_type=2, coordinates of the centre of the circle. If geometry_type=1 or 3, coordinates of the origin of the local coordinate system (X1,X2,X3) describing the plane detector/aperture. This origin is located within the detector/aperture area." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:centre ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the aperture in the X1 direction, used only if geometry_type = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:x1_width ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:FlatObjectStatic .

fyo:GenericGridConstant a sh:NodeShape ;
    rdfs:comment "Set of grids for use in the coupling_matrix array of structure, described using the GGD" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Grid identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:class fyo:GenericGridConstantGridSubset ;
            sh:description "Grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:grid_subset ],
        [ sh:class fyo:GenericGridConstantSpace ;
            sh:description "Set of grid spaces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:space ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the grid, including the IDS name, in case of implicit reference to a grid_ggd node described in another IDS. To be filled only if the grid is not described explicitly in this grid_ggd structure. Example syntax: #wall:2/description_ggd(1)/grid_ggd, means that the grid is located in the wall IDS, occurrence 2, with relative path description_ggd(1)/grid_ggd, using Fortran index convention (here : first index of the array)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:path ] ;
    sh:targetClass fyo:GenericGridConstant .

fyo:GenericGridConstantGridSubsetMetric a sh:NodeShape ;
    rdfs:comment "Set of bases for the grid subset. For each base, the structure describes the projection of the base vectors on the canonical frame of the grid." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Covariant metric tensor, given on each element of the subgrid (first dimension)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:tensor_covariant ],
        [ sh:datatype xsd:float ;
            sh:description "Contravariant metric tensor, given on each element of the subgrid (first dimension)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:tensor_contravariant ],
        [ sh:datatype xsd:float ;
            sh:description "Metric Jacobian" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:jacobian ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:GenericGridConstantGridSubsetMetric .

fyo:GenericGridDynamicGridSubset a sh:NodeShape ;
    rdfs:comment "Grid subsets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Grid subset identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Space dimension of the grid subset elements, using the convention 1=nodes, 2=edges, 3=faces, 4=cells/volumes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:dimension ],
        [ sh:class fyo:GenericGridDynamicGridSubsetMetric ;
            sh:description "Metric of the canonical frame onto Cartesian coordinates" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:metric ],
        [ sh:class fyo:GenericGridDynamicGridSubsetMetric ;
            sh:description "Set of bases for the grid subset. For each base, the structure describes the projection of the base vectors on the canonical frame of the grid." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:base ],
        [ sh:class fyo:GenericGridDynamicGridSubsetElement ;
