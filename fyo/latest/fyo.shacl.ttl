            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaSourcesSourceGgdFastIon ;
            sh:description "Source term integrals related to the various ion species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
