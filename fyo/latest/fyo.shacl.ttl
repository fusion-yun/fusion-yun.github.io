            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutral_index ],
        [ sh:datatype xsd:float ;
            sh:description "Collisional toroidal torque density to the fast particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:torque_fast_phi ],
        [ sh:class fyo:DistributionsDProfiles2dPartialCollisionsIonState ;
            sh:description "Collisional exchange with the various states of the ion species (ionization, energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionization state; lumped ions are allowed)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H+, D+, T+, He+2, C+, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:DistributionsDProfiles2dPartialCollisionsIon .

fyo:DistributionsDProfiles2dPartialCollisionsIonState a sh:NodeShape ;
    rdfs:comment "Collisional exchange with the various states of the ion species (ionization, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Collisional power density to the fast particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:power_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle (z_min = z_max = 0 for a neutral)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:float ;
            sh:description "Collisional toroidal torque density to the thermal particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:torque_thermal_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Collisional toroidal torque density to the fast particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:torque_fast_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Collisional toroidal torque density to the fast particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:torque_fast_tor ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Collisional power density to the thermal particle population" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:power_thermal ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying charge state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ] ;
    sh:targetClass fyo:DistributionsDProfiles2dPartialCollisionsIonState .

fyo:Divertor a sh:NodeShape ;
    rdfs:comment "Set of divertors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on the divertor targets due to recombination of neutrals into a ground state (e.g. molecules) (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:power_recombination_neutrals ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on the divertor targets due to electric currents (positive means power is deposited on the target) (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:power_currents ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Black body radiated power emitted from the divertor targets (emissivity is included) (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:power_black_body ],
        [ sh:class fyo:DivertorTarget ;
            sh:description "Set of divertor targets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:target ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Net power from neutrals on the divertor targets (positive means power is deposited on the target) (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:power_neutrals ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Net radiated power on the divertor targets (incident - reflected) (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:power_radiated ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total power incident on the divertor (sum over all targets). This power is split in the various physical categories listed below" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:power_incident ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power conducted by the plasma on the divertor targets (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:power_conducted ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total recycled particle flux from  the divertor (in equivalent electrons)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:particle_flux_recycled_total ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power convected by the plasma on the divertor targets (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:power_convected ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Wetted area of the divertor (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:wetted_area ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Nuclear power heating the divertor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:power_nuclear ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total current incident on this divertor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:current_incident ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on the divertor targets due to recombination of plasma ions (sum over all targets)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:power_recombination_plasma ] ;
    sh:targetClass fyo:Divertor .

fyo:DivertorTarget a sh:NodeShape ;
    rdfs:comment "Set of divertor targets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Total current incident on this target" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:current_incident ],
        [ sh:class fyo:DivertorTargetTile ;
            sh:description "Set of divertor tiles belonging to this target" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:tile ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Angle between field lines projected in poloidal plane and target, measured clockwise from the target to the projected field lines" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:tilt_angle_pol ],
        [ sh:datatype xsd:float ;
            sh:description "Target length projected on the major radius axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:extension_r ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on this divertor target due to recombination of neutrals into a ground state (e.g. molecules)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:power_recombination_neutrals ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Peak power flux on the divertor target surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:power_flux_peak ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum steady state heat flux allowed on divertor target surface (engineering design limit)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:heat_flux_steady_limit_max ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Net power from neutrals on this divertor target (positive means power is deposited on the target)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:power_neutrals ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power fraction incident on the target (normalized to the total power incident on the divertor)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:power_incident_fraction ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power conducted by the plasma on this divertor target" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:power_conducted ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on this divertor target due to recombination of plasma ions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:power_recombination_plasma ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total power incident on this target. This power is split in the various physical categories listed below" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:power_incident ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Black body radiated power emitted from this divertor target (emissivity is included)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:power_black_body ],
        [ sh:class fyo:DivertorTargetTwoPointModel ;
            sh:description "Description of SOL according to the two point model, the downstream point being on this target, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:two_point_model ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Wetted area of the target, defined by the SOL heat flux decay length (lambda_q) mapped to the target using flux expansion and spreading factor and the target toroidal circumference. In other words, this is the area getting heat flux from the maximum value down to one e-fold decay." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:wetted_area ],
        [ sh:datatype xsd:float ;
            sh:description "Target length projected on the height axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:extension_z ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power convected by the plasma on this divertor target" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:power_convected ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power deposited on this divertor target due to electric currents (positive means power is deposited on the target)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:power_currents ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Magnetic flux expansion as defined by Stangeby : ratio between the poloidal field at the midplane separatrix and the poloidal field at the strike-point see formula attached, where u means upstream (midplane separatrix) and t means at divertor target (downstream)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:flux_expansion ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Net radiated power on this divertor target (incident - reflected)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:power_radiated ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum surface target temperature allowed to prevent damage (melting, recrystallization, sublimation, etc...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:temperature_limit_max ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum plasma temperature allowed on the divertor target to avoid excessive sputtering" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:t_e_target_sputtering_limit_max ] ;
    sh:targetClass fyo:DivertorTarget .

fyo:DivertorTargetTile a sh:NodeShape ;
    rdfs:comment "Set of divertor tiles belonging to this target" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total current incident on this tile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:current_incident ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Outline of the tile surface facing the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:surface_outline ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "If the tile carries a measurement shunt, index of that shunt (in the magnetics IDS shunt array)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:shunt_index ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Area of the tile surface facing the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:surface_area ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:DivertorTargetTile .

fyo:DivertorTargetTwoPointModel a sh:NodeShape ;
    rdfs:comment "Description of SOL according to the two point model, the downstream point being on this target, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Electron density at divertor target" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_e_target ],
        [ sh:datatype xsd:float ;
            sh:description "Heat flux spreading length in SOL at equatorial mid-plane, this is the S power spreading parameter defined in reference T. Eich et al, Nucl. Fusion 53 (2013) 093031. Relevant only for attached plasmas." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:sol_heat_spreading_length ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:float ;
            sh:description "Heat flux decay length in SOL at divertor entrance, mapped to the mid-plane, this is the lambda_q parameter defined in reference T. Eich et al, Nucl. Fusion 53 (2013) 093031" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:sol_heat_decay_length ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature at divertor target" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:t_e_target ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DivertorTargetTwoPointModel .

fyo:EcLaunchersBeam a sh:NodeShape ;
    rdfs:comment "Set of Electron Cyclotron beam segments, including between mirrors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Time base used for launching_position, angle, spot and phase quantities" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:time ],
        [ sh:class fyo:EcLaunchersBeamSpot ;
            sh:description "Spot ellipse characteristics at launch" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:spot ],
        [ sh:datatype xsd:float ;
            sh:description "Steering angle of the EC beam in the R,Z plane (from the -R axis towards the -Z axis), angle_pol=atan2(-k_Z,-k_R), where k_Z and k_R are the Z and R components of the mean wave vector in the EC beam" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:steering_angle_pol ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Steering angle of the EC beam away from the poloidal plane that is increasing towards the positive phi axis, angle_tor=arcsin(k_phi/k), where k_phi is the component of the wave vector in the phi direction and k is the length of the wave vector. Here the term wave vector refers to the mean wave vector in the EC beam" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:steering_angle_tor ],
        [ sh:class fyo:EcLaunchersBeamWavevector ;
            sh:description "Wavevector at launch point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:direction ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the mirror (in the mirror array of structure) on which this beam has been reflected" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:mirror_index ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Frequency" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:frequency ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Beam power launched into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:power_launched ],
        [ sh:class fyo:EcLaunchersLaunchingPosition ;
            sh:description "Launching position of the beam" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:launching_position ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:EcLaunchersBeamPolarization ;
            sh:description "Wave polarization" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:polarization ],
        [ sh:class fyo:EcLaunchersBeamPhase ;
