            sh:path fyo:tritium ],
        [ sh:class fyo:SummaryDynamicFlt1dRootParent2 ;
            sh:description "Ammonia (NH3)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path fyo:ammonia ],
        [ sh:datatype xsd:string ;
