            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Q component of the IQ detector used to retrieve the phase of signal's envelope" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:q_component ],
        [ sh:datatype xsd:float ;
            sh:description "I component of the IQ detector used to retrieve the phase of signal's envelope" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:i_component ] ;
    sh:targetClass fyo:ReflectometerFluctuationRaw .

fyo:ReflectometerFluctuationSpectrum a sh:NodeShape ;
    rdfs:comment "Spectrum of the fluctuations, obtained by Fourier transform" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Power spectrum in log scale" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:power_log ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Width of the time interval over which the spectrum is processed. By convention, the time interval starts at time-time_width and ends at time." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_width ],
        [ sh:datatype xsd:float ;
            sh:description "Array of frequencies used for the Fourier transform" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:frequencies_fourier ] ;
    sh:targetClass fyo:ReflectometerFluctuationSpectrum .

fyo:RefractometerChannel a sh:NodeShape ;
    rdfs:comment "Set of channels, e.g. different reception antennas of the refractometer" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detection mode \"X\" or \"O\"" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:mode ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Integral of the electron density along the line of sight, deduced from the envelope phase measurements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_e_line ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight. The first point corresponds to the probing wave emission point. The second point corresponds to the probing wave detection point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:line_of_sight ],
        [ sh:class fyo:RefractometerChannelBandwidth ;
            sh:description "Set of frequency bandwidths" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:bandwidth ],
        [ sh:class fyo:RefractometerShapeApproximation ;
            sh:description "Approximation of the radial electron density profile with an array of parameters and an approximation formula, used by post-processing programs for the identification of the electron density profile." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:n_e_profile_approximation ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:RefractometerChannel .

fyo:RefractometerChannelBandwidth a sh:NodeShape ;
    rdfs:comment "Set of frequency bandwidths" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "I component of the IQ detector used to retrieve the phase of signal's envelope, sampled on a high resolution time_detector grid just before each measurement time slice represented by the ../time vector" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:i_component ],
        [ sh:datatype xsd:float ;
            sh:description "Phase of the envelope of the probing signal, relative to the phase at launch" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:phase ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "In-phase and Quadrature components of the analysed signal. They are returned by an IQ-detector, that takes carrying and reference signals as the input and yields I and Q components. These are respectively stored as the first and the second index of the first dimension of the data child." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:phase_quadrature ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for this bandwidth" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Q component of the IQ detector used to retrieve the phase of signal's envelope, sampled on a high resolution time_detector grid just before each measurement time slice represented by the ../time vector" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:q_component ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "High sampling timebase of the IQ-detector signal measurements" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time_detector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Integral of the electron density along the line of sight, deduced from the envelope phase measurements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:n_e_line ],
        [ sh:datatype xsd:float ;
            sh:description "Main frequency used to probe the plasma (before upshifting and modulating)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:frequency_main ] ;
    sh:targetClass fyo:RefractometerChannelBandwidth .

fyo:RefractometerShapeApproximation a sh:NodeShape ;
    rdfs:comment "Approximation of the radial electron density profile with an array of parameters and an approximation formula, used by post-processing programs for the identification of the electron density profile." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
