fyo:WavesCoherentWaveIdentifier a sh:NodeShape ;
    rdfs:comment "List all waves affecting the distribution, identified as in waves/coherent_wave(i)/identifier in the waves IDS" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the antenna that launches this wave. Corresponds to the name specified in antennas/ec(i)/name, or antennas/ic(i)/name or antennas/lh(i)/name (depends of antenna/wave type) in the ANTENNAS IDS." ;
