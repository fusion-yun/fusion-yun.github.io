        [ sh:datatype xsd:integer ;
            sh:description "Control mode (operation mode and/or settings used by the controller)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:mode ] ;
    sh:targetClass fyo:PulseScheduleTf .

fyo:RadiationProcess a sh:NodeShape ;
    rdfs:comment "Set of emission processes. The radiation characteristics are described at the level of the originating entity. For instance describe line radiation from neutrals under profiles_1d/neutral. Line and recombination radiation under profiles_1d/ion. Bremsstrahlung radiation under profiles_1d/neutral and ion ..." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:RadiationProcessProfiles1d ;
            sh:description "Emissivity radial profiles for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:profiles_1d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:RadiationProcessGlobal ;
            sh:description "Scalar volume integrated quantities" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:RadiationProcessGgd ;
            sh:description "Emissivities represented using the general grid description, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:ggd ],
        [ sh:class spo:Identifier ;
            sh:description "Process identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ] ;
    sh:targetClass fyo:RadiationProcess .

fyo:RadiationProcessGgd a sh:NodeShape ;
    rdfs:comment "Emissivities represented using the general grid description, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:RadiationProcessGgdNeutral ;
            sh:description "Process terms related to the different neutral species" ;
