            sh:order 9 ;
            sh:path fyo:current_parallel_density_n_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged total absorbed wave power density (electrons + ion + fast populations)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:power_density ],
        [ sh:datatype xsd:float ;
            sh:description "Wave driven toroidal current, inside a flux surface, per toroidal mode number" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:current_phi_inside_n_phi ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:integer ;
            sh:description "Toroidal mode numbers, the wave vector toroidal component being defined as k_phi = n_phi grad phi where phi is the toroidal angle so that a positive n_phi means a wave propagating in the positive phi direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged absorbed wave power density per toroidal mode number" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:power_density_n_phi ],
        [ sh:class fyo:WavesCoherentWaveProfiles1dIon ;
            sh:description "Quantities related to the different ion species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged wave driven parallel current density = average(j.B) / B0, where B0 = vacuum_toroidal_field/b0." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:current_parallel_density ],
        [ sh:datatype xsd:float ;
            sh:description "Perpendicular wave vector,  averaged over the flux surface, where the averaged is weighted with the power deposition density, such that k_perpendicular = ave(k_perpendicular.power_density) / ave(power_density), for every flux surface and every toroidal number" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:k_perpendicular ],
        [ sh:class fyo:WavesCoherentWaveProfiles1dElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:electrons ],
        [ sh:datatype xsd:float ;
            sh:description "Wave driven toroidal current, inside a flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:current_phi_inside ],
