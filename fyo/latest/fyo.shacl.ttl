fyo:WallGlobalQuantitites a sh:NodeShape ;
    rdfs:comment "Simple 0D description of plasma-wall interaction" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Power deposited on the wall due to recombination of plasma ions" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:power_recombination_plasma ],
        [ sh:datatype xsd:float ;
            sh:description "Total power incident on the wall. This power is split in the various physical categories listed below" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:power_incident ],
        [ sh:datatype xsd:float ;
            sh:description "Power convected by the plasma onto the wall" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:power_convected ],
        [ sh:class fyo:WallGlobalQuantititesElectrons ;
            sh:description "Quantities related to electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:electrons ],
        [ sh:datatype xsd:float ;
            sh:description "Net power from neutrals on the wall  (positive means power is deposited on the wall)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:power_neutrals ],
        [ sh:datatype xsd:float ;
            sh:description "Black body radiated power emitted from the wall (emissivity is included)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:power_black_body ],
        [ sh:datatype xsd:float ;
            sh:description "Net radiated power from plasma onto the wall (incident-reflected)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:power_radiated ],
        [ sh:datatype xsd:float ;
            sh:description "Total ion (summed over ion species) power on the inner target" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:power_inner_target_ion_total ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum power density on the inner target" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:power_density_inner_target_max ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Power to cooling systems" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:power_to_cooling ],
        [ sh:datatype xsd:float ;
            sh:description "Power deposited on the wall due to recombination of neutrals into a ground state (e.g. molecules)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:power_recombination_neutrals ],
        [ sh:class fyo:WallGlobalQuantititesNeutral ;
            sh:description "Quantities related to the various neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:neutral ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum power density on the outer target" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:power_density_outer_target_max ],
        [ sh:datatype xsd:float ;
            sh:description "Power deposited on the wall due to electric currents (positive means power is deposited on the target)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:power_currents ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal current flowing in the vacuum vessel" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:current_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Power conducted by the plasma onto the wall" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:power_conducted ],
        [ sh:datatype xsd:float ;
