            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:code ],
        [ sh:class fyo:WorkflowTimeLoop ;
            sh:description "Description of a workflow based on a time loop which calls components defined in component_list sequentially  during each cycle of the loop (workflow_cycle)." ;
            sh:maxCount 1 ;
