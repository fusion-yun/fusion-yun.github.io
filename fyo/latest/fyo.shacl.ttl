fyo:Complex2dDynamicAosMhdScalar a sh:NodeShape ;
    rdfs:comment "Perpendicular displacement of the modes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
