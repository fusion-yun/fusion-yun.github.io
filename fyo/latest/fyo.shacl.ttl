fyo:Tokamak a sh:NodeShape ;
    rdfs:comment "A toroidal magnetic-confinement fusion Machine (fusion specialization of Machine)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:occupies ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000024> ;
            sh:description "A Machine holds a Plasma within its vacuum-vessel fiat boundary during a Shot." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:hosts ],
        [ sh:class fyo:MachineSubsystem ;
            sh:description "A Machine bears first-class material sub-systems (BFO has_part)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ] ;
    sh:targetClass fyo:Tokamak .

fyo:ToroidalFieldCoilSystem a sh:NodeShape ;
    rdfs:comment "Toroidal-field coil group — main confinement field (TF)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "A CoilSystem is composed of atomic Coil instances (BFO has_part)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:datatype xsd:string ;
            sh:description "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:occupies ] ;
    sh:targetClass fyo:ToroidalFieldCoilSystem .

fyo:TransportSolve a sh:NodeShape ;
    rdfs:comment "A 1.5D core-transport advance (flux-surface-averaged boundary-value problem; default fytrans) — given equilibrium and core profiles, advances transport and writes back the core-profiles IDS (enabling-core scenario S-3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:produces_ids ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:consumes_ids ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ] ;
    sh:targetClass fyo:TransportSolve .

fyo:TransportSolverNumerics a sh:NodeShape ;
    rdfs:comment "Numerical quantities used by transport solvers and convergence details" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:version_put ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:NumericsSolver1d ;
            sh:description "Numerics related to 1D radial solver, for various time slices." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:solver_1d ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Internal time step used by the transport solver (assuming all transport equations are solved with the same time step)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:time_step ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:code ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Minimum internal time step used by the transport solver between the previous and the current time stored for this quantity (assuming all transport equations are solved with the same time step)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:time_step_min ],
        [ sh:class fyo:NumericsBcGgd ;
            sh:description "Boundary conditions of the transport equations, provided on the GGD, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:boundary_conditions_ggd ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path spo:generated_by_process ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition and in the normalization of current densities)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path spo:modality ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class spo:Identifier ;
            sh:description "Primary coordinate system with which the transport equations are solved. For a 1D transport solver: index = 1 means rho_tor_norm; 2 = rho_tor." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:primary_coordinate ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Average internal time step used by the transport solver between the previous and the current time stored for this quantity (assuming all transport equations are solved with the same time step)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:time_step_average ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:reproducible ],
        [ sh:class spo:Identifier ;
            sh:description "Solver identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:solver ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:NumericsRestart ;
            sh:description "Set of code-specific restart files for a given time slice. These files are managed by a physical application to ensure its restart during long simulations" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:restart_files ] ;
    sh:targetClass fyo:TransportSolverNumerics .

