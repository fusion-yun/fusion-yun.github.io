fyo:CoreProfiles1DFit a sh:NodeShape ;
    rdfs:comment "Information on the fit used to obtain the temperature profile" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Path to the source data for each measurement in the IMAS data dictionary, e.g. ece/channel(i)/t_e for the electron temperature on the i-th channel in the ECE IDS" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:float ;
            sh:description "Weight given to each measured value" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:weight ],
        [ sh:class spo:Identifier ;
            sh:description "Method used to slice the data : index = 0 means using exact time slice of the measurement, 1 means linear interpolation, ..." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:time_measurement_slice_method ],
        [ sh:datatype xsd:float ;
            sh:description "Value reconstructed from the fit" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:reconstructed ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means local measurement, 0 means line-integrated measurement" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:local ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Measured values" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:measured ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slices used from the time array of the measurement source data. The time slice is indicated for each measurement point considered in the fit since measurements may come from different and thus asynchronous diagnostics. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_measurement ],
        [ sh:datatype xsd:float ;
            sh:description "In case the measurements are averaged over a time interval, this node is the full width of this time interval (empty otherwise). In case the slicing/averaging method doesn't use a hard time interval cutoff, this width is the characteristic time span of the slicing/averaging method. By convention, the time interval starts at time_measurement-time_width and ends at time_measurement." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time_measurement_width ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error normalized by the weighted standard deviation considered in the minimization process : chi_squared = weight^2 *(reconstructed - measured)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:chi_squared ],
        [ sh:datatype xsd:string ;
            sh:description "List of the fit specific parameters in XML format" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:parameters ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate of each measurement (local value for a local measurement, minimum value reached by the line of sight for a line measurement)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:rho_tor_norm ] ;
    sh:targetClass fyo:CoreProfiles1DFit .

