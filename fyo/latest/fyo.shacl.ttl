fyo:CoreRadialGrid a sh:NodeShape ;
    rdfs:comment "Radial grid" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Volume enclosed inside the magnetic surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:volume ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation, see time_slice/boundary/b_flux_pol_norm in the equilibrium IDS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized poloidal flux coordinate = sqrt((psi(rho)-psi(magnetic_axis)) / (psi(LCFS)-psi(magnetic_axis)))" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:rho_pol_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal magnetic flux at the plasma boundary (useful to normalize the psi array values when the radial grid doesn't go from the magnetic axis to the plasma boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:psi_boundary ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal magnetic flux at the magnetic axis (useful to normalize the psi array values when the radial grid doesn't go from the magnetic axis to the plasma boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:psi_magnetic_axis ],
        [ sh:datatype xsd:float ;
            sh:description "Cross-sectional area of the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate = sqrt(phi/(pi*b0)), where the toroidal magnetic field, b0, corresponds to that stored in vacuum_toroidal_field/b0 and pi can be found in the IMAS constants" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Surface area of the toroidal flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:surface ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal magnetic flux. Integral of magnetic field passing through a contour defined by the intersection of a flux surface passing through the point of interest and a Z=constant plane. If the integration surface is flat, the surface normal vector is in the increasing vertical coordinate direction, Z, namely upwards." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:psi ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass fyo:CoreRadialGrid .

<http://purl.obolibrary.org/obo/BFO_0000030> a sh:NodeShape ;
    rdfs:comment "A measurement apparatus designed to measure physical quantities of the Machine or the Plasma it hosts, bearing a disposition to produce information artifacts (W3C SOSA Sensor aligned). SP-ONT-APP-DIAG. `sp:Diagnostic ⊑ bfo:object ⊓ ∃produces.InformationContentEntity`.",
        "An atomic electromagnetic coil (BFO object); part of a CoilSystem.",
        "The integrated material entity of a scientific apparatus (e.g. a tokamak), composed of first-class sub-systems and bearing the dispositions to participate in experimental processes. SP-ONT-APP-MACHINE." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ),
