fyo:WavesCoherentWaveProfiles1d a sh:NodeShape ;
    rdfs:comment "Source radial profiles (flux surface averaged quantities) for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:WavesProfiles1dEFieldNPhi ;
            sh:description "Components of the electric field per toroidal mode number, averaged over the flux surface, where the averaged is weighted with the power deposition density, such that e_field = ave(e_field.power_density) / ave(power_density)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:e_field_n_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged wave driven parallel current density, per toroidal mode number" ;
