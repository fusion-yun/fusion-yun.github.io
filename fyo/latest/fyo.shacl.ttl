fyo:NumericsSolver1dEquationPrimary a sh:NodeShape ;
    rdfs:comment "Profile and derivatives of the primary quantity of the transport equation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Derivative with respect to time, at constant primary coordinate coordinate (for current diffusion equation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:d_dt_cr ],
        [ sh:datatype xsd:integer ;
            sh:description "If the primary quantity is related to a particular state (of an ion or a neutral species), index of the corresponding state in the core_profiles/profiles_1d/ion (or neutral)/state array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:state_index ],
        [ sh:datatype xsd:float ;
            sh:description "Radial derivative with respect to the primary coordinate" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:d_dr ],
        [ sh:datatype xsd:integer ;
            sh:description "If the primary quantity is related to a neutral species, index of the corresponding species in the core_profiles/profiles_1d/neutral array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:neutral_index ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier of the primary quantity of the transport equation. The description node contains the path to the quantity in the physics IDS (example: core_profiles/profiles_1d/ion(1)/density)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "If the primary quantity is related to a ion species, index of the corresponding species in the core_profiles/profiles_1d/ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:ion_index ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative with respect to time, at constant toroidal flux (for current diffusion equation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:d_dt_cphi ],
        [ sh:datatype xsd:float ;
            sh:description "Second order radial derivative with respect to the primary coordinate" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:d2_dr2 ],
        [ sh:datatype xsd:float ;
            sh:description "Profile of the primary quantity" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:profile ],
        [ sh:datatype xsd:float ;
            sh:description "Time derivative" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:d_dt ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:NumericsSolver1dEquationPrimary .

fyo:ObliqueStatic a sh:NodeShape ;
    rdfs:comment "Parallelogram description of the element" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:manifold_dim ],
        [ sh:datatype xsd:float ;
            sh:description "Inclination of first angle measured counter-clockwise from horizontal outwardly directed radial vector (grad R)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:alpha ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of the reference point (from which the alpha and beta angles are defined, marked by a + on the diagram)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Height of the reference point (from which the alpha and beta angles are defined, marked by a + on the diagram)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Inclination of second angle measured counter-clockwise from vertically upwards directed vector (grad Z). If both alpha and beta are zero (rectangle) then the simpler rectangular elements description should be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:beta ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the parallelogram side inclined with angle alpha with respect to the major radius axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:length_alpha ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the parallelogram side inclined with angle beta with respect to the height axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:length_beta ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass fyo:ObliqueStatic .

fyo:OperationalSensor a sh:NodeShape ;
    rdfs:comment "Set of sensors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Xyz0dStatic ;
            sh:description "Second direction of measurement, in case of a rosette straing gauge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:direction_second ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “Sensor at the top of the machine”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Temperature measured by a thermocouple" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the strain gauge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:gauge_length ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Strain measured by a strain gauge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:strain ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Attachement point(s) of the sensor. Two for displacement sensors, one for the other types of sensors" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:attachement_points ],
        [ sh:datatype xsd:string ;
            sh:description "IMAS URI of the system(s) to which this sensor is attached. Two for displacement sensors, one for the other types of sensors" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:attachement_uris ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Direction of the measurement (unit vector)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:direction ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Length measured by a displacement sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:length ],
        [ sh:class spo:Identifier ;
            sh:description "Type of sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Acceleration measured by an accelerometer sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:acceleration ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Strain measured by a rosette strain gauge. The first dimension lists the components of the strain tensor : Sx1x1, Sx1x2, Sx2x2, where x1 is the main direction and x2 is the second direction of measurement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:strain_rosette ] ;
    sh:targetClass fyo:OperationalSensor .

fyo:OpticalElementMaterial a sh:NodeShape ;
    rdfs:comment "Material properties of the optical element" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Transmission coefficient (for dielectric)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:transmission_coefficient ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Wavelengths array for refractive_index, extinction_coefficient and transmission_coefficient" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelengths ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Refractive index (for metal and dielectric)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:refractive_index ],
        [ sh:datatype xsd:float ;
            sh:description "Extinction coefficient (for metal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:extinction_coefficient ],
        [ sh:class spo:Identifier ;
            sh:description "Type of optical element material. In case of 'metal' refractive_index and extinction_coefficient are used. In case of 'dielectric' refractive_index and transmission_coefficient are used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Roughness parameter of the material. Varies in range [0, 1]. 0 is perfectly specular, 1 is perfectly rough" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:roughness ] ;
    sh:targetClass fyo:OpticalElementMaterial .

fyo:PelletsPropellantGas a sh:NodeShape ;
    rdfs:comment "Propellant gas" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the gas molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
