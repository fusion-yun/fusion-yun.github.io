yo:time_begin fyo:names fyo:d_parallel fyo:photoelectric_voltage fyo:circular fyo:stokes_output fyo:b_field_pol_probe fyo:coordinate3 fyo:power_radiated fyo:power_ic fyo:darea_dpsi fyo:initial_value_run fyo:length_beta fyo:pixel_size fyo:toroidal fyo:ellipticity_initial fyo:focal_length_horizontal fyo:origin fyo:q_95 fyo:constant_float1d fyo:power_electricity_net fyo:moments_norm_gyrocenter_bessel_1 fyo:sweep_time fyo:cooling_loop fyo:inputs fyo:time_measurement_width fyo:time_measurement_slice_method fyo:centreline fyo:pressure_thermal fyo:envelope_type fyo:width_min_vertical fyo:velocity_phi_method fyo:cold_neutrals_temperature fyo:light_collection_efficiencies fyo:d_dpsi_norm_max_position fyo:mesh_type fyo:separatrix fyo:dpressure_dpsi fyo:x_point fyo:momentum_phi_j_cross_b_field fyo:antenna_name fyo:launching_position fyo:control_parameters fyo:moments_norm_gyrocenter fyo:is_referenced_by fyo:direction_second fyo:d_radial fyo:z_square_average fyo:q fyo:diamagnetic_flux fyo:describes_machine fyo:area fyo:curvature_type fyo:power_density_spectrum_1d fyo:description_2d fyo:saturated_relative_permeability fyo:resistance_additional fyo:component fyo:geometric_axis_z fyo:power_density_fast_n_phi fyo:ion_saturation_current fyo:power_nbi fyo:k_r fyo:hot_neutrals_temperature fyo:neutral_type fyo:coefficients fyo:path_profiles fyo:base fyo:radiances fyo:metastable fyo:power_nuclear_shields fyo:force_vertical fyo:x2_unit_vector fyo:e_field_phi fyo:energy_multiplication_factor fyo:gauge_length spo:of_coordinate_system fyo:scattering_length fyo:pressure fyo:j_diamagnetic fyo:current_limit_min fyo:phi_potential_perturbed_weight fyo:energies fyo:pf_current fyo:parallel_coefficients fyo:if_bandwidth fyo:row fyo:tf fyo:sol_heat_spreading_length fyo:centre fyo:detector_temperature spo:ucum_code fyo:process fyo:access_layer_language fyo:event_in_detector_neutron_flux fyo:current_parallel_density_n_phi fyo:wave fyo:j_heat_viscosity fyo:chi_squared_z fyo:change fyo:discriminator_level_upper fyo:fluence fyo:pedestal_width fyo:o_mode_fraction fyo:polychromator_index fyo:energy_bound_lower fyo:t_radiation_central_x fyo:temperature_norm fyo:silane fyo:energy_mhd fyo:collisions_finite_larmor_radius fyo:frequency fyo:n_i_volume_average fyo:module fyo:grid_type fyo:polychromator fyo:e_field_townsend fyo:spectrum fyo:length fyo:counts_n fyo:momentum_phi_method fyo:velocity_mass_centre_fragments_z fyo:torque_thermal_phi fyo:half_width_internal fyo:antenna fyo:z fyo:nustar_pedestal_top_electron fyo:region_of_interest fyo:phi_poloidal_current fyo:current_halo_pol ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000031> .

<http://purl.obolibrary.org/obo/BFO_0000035> a sh:NodeShape ;
    rdfs:comment "The instantaneous temporal boundary of a process (BFO 2020). Parented on Occurrent, following BFO's own hierarchy — a process boundary is not itself a process. Added with ContinuantFiatBoundary, for the same reason (SPM-REPORT-104)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000035> .

<http://purl.obolibrary.org/obo/BFO_0000140> a sh:NodeShape ;
    rdfs:comment "A zero-, one- or two-dimensional immaterial entity whose location is fixed relative to some material entity, and which never has a spatial region as continuant part (BFO 2020 elucidation). Carrier of a demarcation drawn on a thing rather than found in it — a region's fiat boundary, a nominal surface. Added when the conformance gate found `sp.mathx.region.FiatBoundary` anchored to a BFO term the T-Box did not carry: the ontology is authoritative, so the gap was the ontology's (SPM-REPORT-104)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000140> .

<http://purl.obolibrary.org/obo/BFO_0000141> a sh:NodeShape ;
    rdfs:comment "An independent continuant with no material parts (BFO immaterial entity). Base of regions / sites." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:coordinate rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000141> .

<http://purl.obolibrary.org/obo/IAO_0000104> a sh:NodeShape ;
    rdfs:comment "A directive information content entity that prescribes a planned process (IAO plan specification). A pulse_schedule (reference waveforms / setpoints) is a PlanSpecification prescribing a discharge (C-10). class_uri version-sensitive — verify." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:iteration_cap rdf:type fyo:solver_selection ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/IAO_0000104> .

<http://purl.obolibrary.org/obo/OBI_0000011> a sh:NodeShape ;
    rdfs:comment "A process that realizes a plan specification (OBI planned process). An experiment / planned discharge." ;
    sh:closed true ;
    sh:ignoredProperties ( fyo:performed_on rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This planned process realizes a plan / specification — a pulse_schedule for a discharge, or a Code (the program text) for a ComputationalProcess (program = GDC, run = Process, result = ICE output)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_input ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_output ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/OBI_0000011> .

<http://qudt.org/schema/qudt/QuantityValue> a sh:NodeShape ;
    rdfs:comment "A scalar physical quantity value — numeric value + Unit + QuantityKind (the lift of a DD FLT_0D leaf with units; e.g. `vacuum_toroidal_field/b0` at one instant). The information counterpart of a fully determinate Quality; for quantities extended over a Domain use ContinuousQuantity (Field/Signal) instead." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://qudt.org/schema/qudt/Unit> ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://qudt.org/schema/qudt/hasUnit> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality (SDC inhering in a MaterialEntity) this information is about — the reality/description bridge for scalar values (iao:is_about specialization)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:of_quality ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "The numeric value in has_unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:numeric_value ],
        [ sh:class <http://qudt.org/schema/qudt/QuantityKind> ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://qudt.org/schema/qudt/hasQuantityKind> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass <http://qudt.org/schema/qudt/QuantityValue> .

fyo:AmnsData a sh:NodeShape ;
    rdfs:comment "Atomic, molecular, nuclear and surface physics data. Each occurrence contains the data for a given element (nuclear charge), describing various physical processes. For each process, data tables are organized by charge states. The coordinate system used by the data tables is described under the coordinate_system node." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:generated_by_process ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path spo:modality ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:a ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:AmnsDataRelease ;
            sh:description "List of available releases of the AMNS data; each element contains information about the AMNS data that is included in the release. This part of the IDS is filled and stored only into shot/run=0/1, playing the role of a catalogue." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:release ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:reproducible ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ],
        [ sh:class fyo:CodeConstant ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:code ],
        [ sh:class fyo:AmnsDataCoordinateSystem ;
            sh:description "Array of possible coordinate systems for process tables" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:coordinate_system ],
        [ sh:class fyo:AmnsDataProcess ;
            sh:description "Description and data for a set of physical processes." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:process ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:version_put ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:targetClass fyo:AmnsData .

fyo:ApplicationTask a sh:NodeShape ;
    rdfs:comment "An end-to-end FyTok application task run — the abstract parent of the five CONOPS application-task scenarios (S-7 physics modeling, S-8 experiment analysis, S-9 control simulation, S-10 discharge operation design, S-11 device parameter optimization). A planned computational process performed on (or for) a Machine, realizing a ScenarioSpecification, consuming and producing IDS occurrences, and stacking its task-specific outer operators on the ONE shared ForwardOperator. The five subtypes are distinguished by their method / outer operator and by what is free — never by owning a private forward kernel." ;
    sh:closed false ;
    sh:ignoredProperties ( fyo:initial_profiles fyo:design_space fyo:predicted_equilibrium fyo:engineering_evaluations fyo:reconstructed_profiles fyo:predicted_profiles fyo:engineering_limits fyo:initial_state fyo:operating_point_evaluations fyo:reconstructed_equilibrium fyo:objectives fyo:initial_guess fyo:limit_verification_report fyo:uses_inference_engine fyo:actuator_commands fyo:predicted_sources fyo:misfit_report fyo:predicted_transport fyo:reference_design rdf:type fyo:candidate_design fyo:designed_pulse_schedule fyo:heating_and_current_drive fyo:control_laws fyo:closed_loop_trajectory fyo:reference_waveforms fyo:prescribed_waveforms fyo:constraints_and_priors <http://purl.obolibrary.org/obo/BFO_0000051> fyo:port_runs fyo:predicted_trajectory fyo:machine_description fyo:checked_against fyo:measured_diagnostics fyo:design_targets ) ;
    sh:property [ sh:class fyo:ConvergenceCriterion ;
            sh:description "The explicit convergence criterion of this task's scenario loop — a configurable modeling decision (e.g. psi-residual RMS threshold + iteration cap), never an implicit solver internal (enabling-core goal G-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:converges_by ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:consumes_ids ],
        [ sh:datatype xsd:string ;
            sh:description "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:free_variables ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_output ],
        [ sh:class fyo:ScenarioSpecification ;
            sh:description "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:produces_ids ],
        [ sh:class fyo:ForwardOperator ;
            sh:description "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:uses_forward_operator ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:performed_on ] ;
    sh:targetClass fyo:ApplicationTask .

fyo:BFieldNonAxisymmetric a sh:NodeShape ;
    rdfs:comment "Vacuum 3d error magnetic field (the full 3d magnetic field with the axisymmetric components subtracted)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:string ;
            sh:description "In case of a constant (single time slice) b_field description, name of the corresponding scenario/configuration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:configuration ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:generated_by_process ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:reproducible ],
        [ sh:datatype xsd:string ;
            sh:description "List of control surface names, refers to the ../time_slice/control_surface index" ;
