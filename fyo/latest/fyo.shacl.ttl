fyo:WallDescriptionGgdThickness a sh:NodeShape ;
    rdfs:comment "In the case of a thin wall description, effective thickness of each surface element of grid_ggd, given for each slice of the grid_ggd time base (the thickness is not supposed to change, but grid_ggd may evolve with time)" ;
