fyo:CoreSourcesSource a sh:NodeShape ;
    rdfs:comment "Set of source terms" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Source term identifier (process causing this source term)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:class fyo:CoreSourcesSourceGlobal ;
            sh:description "Total source quantities integrated over the plasma volume or surface" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:global_quantities ],
        [ sh:class fyo:DistributionSpecies ;
            sh:description "Species causing this source term (if relevant, e.g. a particular ion or neutral state in case of line radiation)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:species ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:CoreSourcesSourceProfiles1d ;
            sh:description "Source profiles for various time slices. Source terms are positive (resp. negative) when there is a gain (resp. a loss) to the considered channel." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:profiles_1d ],
        [ sh:class fyo:CodeWithTimebase ;
            sh:description "Code-specific parameters used for this source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ] ;
    sh:targetClass fyo:CoreSourcesSource .

fyo:CoreSourcesSourceGlobal a sh:NodeShape ;
    rdfs:comment "Total source quantities integrated over the plasma volume or surface" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:at_instant ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Total power coupled to ion species (summed over ion  species)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:total_ion_power ],
        [ sh:class fyo:CoreSourcesSourceGlobalElectrons ;
            sh:description "Sources for electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:electrons ],
        [ sh:datatype xsd:float ;
            sh:description "Total power coupled to the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:power ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Total ion particle source (summed over ion  species)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:total_ion_particles ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal torque" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:torque_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel current driven" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:current_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:CoreSourcesSourceGlobal .

fyo:CoreSourcesSourceGlobalElectrons a sh:NodeShape ;
    rdfs:comment "Sources for electrons" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Power coupled to electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:power ],
        [ sh:datatype xsd:float ;
            sh:description "Electron particle source" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:particles ] ;
    sh:targetClass fyo:CoreSourcesSourceGlobalElectrons .

fyo:CoreSourcesSourceProfiles1d a sh:NodeShape ;
    rdfs:comment "Source profiles for various time slices. Source terms are positive (resp. negative) when there is a gain (resp. a loss) to the considered channel." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:CoreSourcesSourceProfiles1dEnergyDecomposed2 ;
            sh:description "Decomposition of the source term for total ion energy equation into implicit and explicit parts" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:total_ion_energy_decomposed ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal torque inside the flux surface. Cumulative volume integral of the source term for the total toroidal momentum equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:torque_phi_inside ],
        [ sh:datatype xsd:float ;
            sh:description "Source term for total toroidal momentum equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:momentum_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:time ],
        [ sh:class fyo:CoreSourcesSourceProfiles1dParticlesDecomposed2 ;
            sh:description "Decomposition of the source term for total ion density equation into implicit and explicit parts" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:total_ion_particles_decomposed ],
        [ sh:class fyo:CoreSourcesSourceProfiles1dElectrons ;
            sh:description "Sources for electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:CoreSourcesSourceProfiles1dNeutral ;
            sh:description "Source terms related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:neutral ],
        [ sh:datatype xsd:float ;
            sh:description "Contribution to the toroidal momentum source term (already included in the momentum_tor node) corresponding to the toroidal torques onto the thermal plasma due to Lorentz force associated with radial currents. These currents appear as return-currents (enforcing quasi-neutrality, div(J)=0) balancing radial currents of non-thermal particles, e.g. radial currents of fast and trapped neutral-beam-ions." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:momentum_phi_j_cross_b_field ],
        [ sh:class fyo:CoreRadialGrid ;
            sh:description "Radial grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "Source term for the total (summed over ion species) ion density equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:total_ion_particles ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CoreSourcesSourceProfiles1dIons ;
            sh:description "Source terms related to the different ions species, in the sense of isonuclear or isomolecular sequences. Ionization states (and other types of states) must be differentiated at the state level below" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:float ;
            sh:description "Total power coupled to ion species (summed over ion  species) inside the flux surface. Cumulative volume integral of the source term for the total ion energy equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:total_ion_power_inside ],
        [ sh:datatype xsd:float ;
            sh:description "Total ion particle source (summed over ion species) inside the flux surface. Cumulative volume integral of the source term for the total ion density equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:total_ion_particles_inside ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel conductivity due to this source" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:conductivity_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel current density source, average(J.B) / B0, where B0 = core_sources/vacuum_toroidal_field/b0" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:j_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel current driven inside the flux surface. Cumulative surface integral of j_parallel" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:current_parallel_inside ],
        [ sh:datatype xsd:float ;
            sh:description "Source term for the total (summed over ion  species) energy equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:total_ion_energy ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:CoreSourcesSourceProfiles1d .

fyo:CoreSourcesSourceProfiles1dComponents2 a sh:NodeShape ;
    rdfs:comment "Source term for the ion momentum transport equations along various components (directions)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Toroidal component" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:toroidal ],
        [ sh:class fyo:CoreSourcesSourceProfiles1dMomentumDecomposed4 ;
            sh:description "Decomposition of the source term for ion toroidal momentum equation into implicit and explicit parts" ;
            sh:maxCount 1 ;
