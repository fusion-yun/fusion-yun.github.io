            sh:order 9 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:TurbulenceProfiles2dGrid ;
            sh:description "Values for the 2D grid, for various time slices. The timebase of this array of structure must be a subset of the profiles_2d timebase" ;
