            sh:order 1 ;
            sh:path fyo:v ],
        [ sh:datatype xsd:float ;
            sh:description "Flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:flux ] ;
    sh:targetClass fyo:PlasmaTransportModel3Momentum .

fyo:PlasmaTransportModel4Momentum a sh:NodeShape ;
    rdfs:comment "Radial component" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:flux ],
        [ sh:datatype xsd:float ;
            sh:description "Effective diffusivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:d ],
        [ sh:datatype xsd:float ;
            sh:description "Damping rate for this flow component (e.g. due to collisions, calculated from a neoclassical model)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:flow_damping_rate ],
        [ sh:datatype xsd:float ;
            sh:description "Effective convection" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:v ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PlasmaTransportModel4Momentum .

fyo:PlasmaTransportModelDensity a sh:NodeShape ;
    rdfs:comment "Transport quantities for the electron density equation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective diffusivity (in the poloidal direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:d_pol ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle flux limiter coefficient, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:flux_limiter ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle flux in the parallel direction, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:flux_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle flux in the direction perpendicular to the edges or faces of the grid (flow crossing that surface divided by its actual area), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:flux ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective convection (in the radial direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:v_radial ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective diffusivity (in the direction perpendicular to the edge of faces of the grid), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:d ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective diffusivity (in the radial direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:d_radial ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle flux in the poloidal direction, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:flux_pol ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle flux in the radial direction, on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:flux_radial ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective convection (in the direction perpendicular to the edge of faces of the grid), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:v ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective convection (in the parallel direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:v_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective diffusivity (in the parallel direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:d_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Particle effective convection (in the poloidal direction), on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:v_pol ] ;
    sh:targetClass fyo:PlasmaTransportModelDensity .

fyo:PulseScheduleReferenceLh a sh:NodeShape ;
    rdfs:comment "Power" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Envelope type:  0:relative: means that the envelope upper and lower bound values are defined respectively as reference.data * reference.data_error_upper and reference.data * reference.data_error_lower. 1: absolute: the envelope upper and lower bound values are given respectively by reference/data_error_upper and reference/data_error_lower. Lower and upper are taken in the strict mathematical sense, without considering absolute values of the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:envelope_type ],
        [ sh:datatype xsd:float ;
            sh:description "Reference waveform. Caution : error bars of the reference/data node are not used in the usual sense, instead they are used to describe the control envelope, with a meaning depending on the chosen envelope_type option." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:reference ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Reference type:  0:relative (don't use for the moment, to be defined later when segments are introduced in the IDS structure); 1: absolute: the reference time trace is provided in the reference/data node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:reference_type ],
        [ sh:datatype xsd:string ;
            sh:description "Reference name (e.g. in the native pulse schedule system of the device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:reference_name ] ;
    sh:targetClass fyo:PulseScheduleReferenceLh .

fyo:PulseScheduleReferenceNoAos a sh:NodeShape ;
    rdfs:comment "Plasma current" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Reference waveform. Caution : error bars of the reference/data node are not used in the usual sense, instead they are used to describe the control envelope, with a meaning depending on the chosen envelope_type option." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:reference ],
        [ sh:datatype xsd:string ;
            sh:description "Reference name (e.g. in the native pulse schedule system of the device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:reference_name ],
        [ sh:datatype xsd:integer ;
            sh:description "Envelope type:  0:relative: means that the envelope upper and lower bound values are defined respectively as reference.data * reference.data_error_upper and reference.data * reference.data_error_lower. 1: absolute: the envelope upper and lower bound values are given respectively by reference/data_error_upper and reference/data_error_lower. Lower are upper are taken in the strict mathematical sense, without considering absolute values of the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:envelope_type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Reference type:  0:relative (don't use for the moment, to be defined later when segments are introduced in the IDS structure); 1: absolute: the reference time trace is provided in the reference/data node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:reference_type ] ;
    sh:targetClass fyo:PulseScheduleReferenceNoAos .

fyo:SignalInt1d a sh:NodeShape ;
    rdfs:comment "Indicator of the validity of the channel as a function of time (0 means valid, negative values mean non-valid)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:representation_of ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:equivalent_representation ],
        [ sh:datatype xsd:integer ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:unit ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path spo:timebase_source ] ;
    sh:targetClass fyo:SignalInt1d .

fyo:SummaryDisruptionDecayTimes a sh:NodeShape ;
    rdfs:comment "Total toroidal plasma current (including runaway electrons and halo currents)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Exponential decay time (tau) used when the process is described by an exponential function (exp(-(t-t0)/tau))). Here \"t\" is time and \"t0\" is the time where the decay process starts" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:exponential ],
        [ sh:class fyo:SummaryDisruptionDecayLinear ;
            sh:description "Decay time defined as (t(X2)-t(X1))/(X1-X2), where t(Xj) corresponds to the time where this quantity reaches Xj*100% of its pre-disruptive value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:linear_custom ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Decay time defined as (t(0.2)-t(0.8))/0.6, where t(X) corresponds to the time where this quantity reaches X*100% of its pre-disruptive value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:linear_20_80 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:SummaryDisruptionDecayTimes .

fyo:SummaryStaticFlt0d a sh:NodeShape ;
    rdfs:comment "Major radius" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Source of the data (any comment describing the origin of the data : code, path to diagnostic signals, processing method, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:SummaryStaticFlt0d .

fyo:EquilibriumConstraints0DPosition a sh:NodeShape ;
    rdfs:comment "Set of local density measurements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Value calculated from the reconstructed equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:reconstructed ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rphizpsirho0dDynamicAos3 ;
            sh:description "Position at which this measurement is given" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:float ;
            sh:description "Measured value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:measured ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means exact data, taken as an exact input without being fitted; 0 means the equilibrium code does a least square fit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:exact ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the source data for this measurement in the IMAS data dictionary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slice used from the time array of the measurement source data. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time_measurement ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error normalized by the variance considered in the minimization process : chi_squared = weight^2 *(reconstructed - measured)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:chi_squared ],
        [ sh:datatype xsd:float ;
            sh:description "Weight given to the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:weight ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumConstraints0DPosition .

fyo:ForwardOperator a sh:NodeShape ;
    rdfs:comment "The shared forward operator F — the equilibrium–transport–source forward kernel plus diagnostic-response composition mapping a plasma configuration θ to predicted state and synthetic signals F(θ). ONE operator shared by all five tasks (FYTOK-REPORT-107): synthetic diagnostics and equilibrium/profile inversion are unified as optimization / probabilistic inference over θ with loss ℒ(θ)=‖F(θ)−d_obs‖²_Σ; control-simulation state estimation and discharge-design trajectory optimization reuse the same F. A Code (GDC program), realized by ComputationalProcess runs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:commit ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:uses_library ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:repository ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ] ;
    sh:targetClass fyo:ForwardOperator .

fyo:GenericGridDynamic a sh:NodeShape ;
    rdfs:comment "Grid description" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the grid, including the IDS name, in case of implicit reference to a grid_ggd node described in another IDS. To be filled only if the grid is not described explicitly in this grid_ggd structure. Example syntax: #wall:2/description_ggd(1)/grid_ggd, means that the grid is located in the wall IDS, occurrence 2, with relative path description_ggd(1)/grid_ggd, using Fortran index convention (here : first index of the array)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:path ],
        [ sh:class spo:Identifier ;
            sh:description "Grid identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridDynamicSpace ;
            sh:description "Set of grid spaces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:space ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:geometry_role ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:describes_region ],
        [ sh:class fyo:GenericGridDynamicGridSubset ;
            sh:description "Grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:grid_subset ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GenericGridDynamic .

fyo:NumericsBcGgdBc a sh:NodeShape ;
    rdfs:comment "Boundary condition for the electron density equation (density if ID = 1), on various grid subsets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
