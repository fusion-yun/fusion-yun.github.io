            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:end_point ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Energy of the laser pulse measured after crossing the plasma" ;
