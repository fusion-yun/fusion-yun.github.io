fyo:ConvergenceCriterion a sh:NodeShape ;
    rdfs:comment "An explicit physical-convergence criterion of a scenario loop (e.g. psi-residual RMS below threshold), together with its threshold value — a declared modeling decision, part of the ScenarioSpecification, never an implicit solver internal." ;
