            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DetectorWavelength .

fyo:DisruptionGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Global quantities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Total ohmic cumulated energy (integral of the power over the disruption duration)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:energy_ohm ],
        [ sh:datatype xsd:float ;
            sh:description "Power of the parallel heat flux in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:power_parallel_halo ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux at halo region boundary generated by the plasma poloidal current" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:phi_halo_boundary_poloidal_current ],
        [ sh:datatype xsd:float ;
            sh:description "Ohmic cumulated energy (integral of the power over the disruption duration) in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:energy_ohm_halo ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Total cumulated energy (integral of the power over the disruption duration) radiated by electrons on impurities" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:energy_radiated_electrons_impurities ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux at halo region boundary" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:psi_halo_boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Power radiated by electrons on impurities in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:power_radiated_electrons_impurities_halo ],
        [ sh:datatype xsd:float ;
            sh:description "Total ohmic power" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:power_ohm ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux at halo region boundary" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:phi_halo_boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal halo current" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:current_halo_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal halo current" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:current_halo_pol ],
        [ sh:datatype xsd:float ;
            sh:description "Ohmic power in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:power_ohm_halo ],
        [ sh:datatype xsd:float ;
            sh:description "Total power radiated by electrons on impurities" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:power_radiated_electrons_impurities ],
        [ sh:datatype xsd:float ;
            sh:description "Cumulated energy (integral of the power over the disruption duration) radiated by electrons on impurities in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:energy_radiated_electrons_impurities_halo ],
        [ sh:datatype xsd:float ;
            sh:description "Cumulated parallel energy (integral of the heat flux parallel power over the disruption duration) in the halo region" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:energy_parallel_halo ] ;
    sh:targetClass fyo:DisruptionGlobalQuantities .

fyo:DisruptionHaloCurrents a sh:NodeShape ;
    rdfs:comment "Halo currents geometry and values for a set of time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:slice_of ],
        [ sh:class fyo:DisruptionHaloCurrentsArea ;
            sh:description "Set of wall areas through which there are halo currents" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:area ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "R,Z position of the point of the plasma boundary in contact with the wall" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:active_wall_point ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:at_instant ] ;
    sh:targetClass fyo:DisruptionHaloCurrents .

fyo:DisruptionHaloCurrentsArea a sh:NodeShape ;
    rdfs:comment "Set of wall areas through which there are halo currents" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "Position of the start point of this area" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:start_point ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "Position of the end point of this area" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:end_point ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal halo current crossing through this area" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:current_halo_pol ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:DisruptionHaloCurrentsArea .

fyo:DisruptionProfiles1d a sh:NodeShape ;
    rdfs:comment "Radial profiles for a set of time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Runaways parallel current density = average(j.B) / B0, where B0 = Disruption/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:j_runaways ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Power density of conductive losses to the wall (positive sign for losses)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:power_density_conductive_losses ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Power density of radiative losses (positive sign for losses)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:power_density_radiative_losses ],
        [ sh:class fyo:CoreRadialGrid ;
            sh:description "Radial grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DisruptionProfiles1d .

fyo:DistributionMarkersOrbit a sh:NodeShape ;
    rdfs:comment "Integrals along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral (f(n_tor,m_pol,k,eq,...) dt) from time - tau to time, where tau is the transit/trapping time of the marker and f() a dimensionless function (phase factor,drift,etc) of the equilibrium (e.g. q) and perturbation (Fourier harmonics n_tor,m_pol and bounce harmonic k) along the particles orbits. In fact the integrals are taken during the last orbit of each marker at the time value of the time node bel" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Array of bounce harmonics k" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:bounce_harmonics ],
        [ sh:datatype xsd:integer ;
            sh:description "Array of toroidal mode numbers, where quantities vary as exp(i.n_phi.phi) and phi runs anticlockwise when viewed from above" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Array of poloidal mode numbers, where quantities vary as exp(-i.m_pol.theta) and theta is the angle defined by the choice of ../../coordinate_identifier, with its centre at the magnetic axis recalled at the root of this IDS" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:m_pol ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "List of the expressions f(n_tor,m_pol,k,q,...) used in the orbit integrals" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:expressions ],
        [ sh:datatype xsd:string ;
            sh:description "Values of the orbit integrals" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:values ] ;
    sh:targetClass fyo:DistributionMarkersOrbit .

fyo:DistributionMarkersOrbitInstant a sh:NodeShape ;
    rdfs:comment "Integrals/quantities along the markers orbit. These dimensionless expressions are of the form: (1/tau) integral ( f(eq) dt) from time - tau to time_orbit for different values of time_orbit in the interval from time - tau to time, where tau is the transit/trapping time of the marker and f(eq) a dimensionless function (phase, drift,q,etc) of the equilibrium along the markers orbits. The integrals are taken during the last orbit of each marker at the time value of the time node below" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Time array along the markers last orbit" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time_orbit ],
        [ sh:datatype xsd:string ;
            sh:description "List of the expressions f(eq) used in the orbit integrals" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:expressions ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Values of the orbit integrals" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:values ] ;
    sh:targetClass fyo:DistributionMarkersOrbitInstant .

fyo:DistributionSourcesSource a sh:NodeShape ;
    rdfs:comment "Set of source/sink terms. A source/sink term corresponds to the particle source due to an NBI injection unit, a nuclear reaction or any combination of them (described in \"identifier\")" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:DistributionSourcesSourceGgd ;
            sh:description "Source terms in phase space (real space, velocity space, spin state), represented using the ggd, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:ggd ],
        [ sh:class fyo:DistributionMarkers ;
            sh:description "Source given as a group of markers (test particles) born per second, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:markers ],
        [ sh:class fyo:DistributionSpecies ;
            sh:description "Species injected or consumed by this source/sink" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:species ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:DistributionProcessIdentifier ;
            sh:description "Set of processes (NBI units, fusion reactions, ...) that provide the source." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:process ],
        [ sh:class fyo:DistributionSourcesSourceGlobalQuantities ;
            sh:description "Global quantities for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Defines how to interpret the spatial coordinates: 1 = given at the actual particle birth point; 2 =given at the gyro centre of the birth point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:gyro_type ],
        [ sh:class fyo:DistributionSourcesSourceProfiles1d ;
            sh:description "Source radial profiles (flux surface averaged quantities) for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:profiles_1d ] ;
    sh:targetClass fyo:DistributionSourcesSource .

fyo:DistributionSourcesSourceGgd a sh:NodeShape ;
    rdfs:comment "Source terms in phase space (real space, velocity space, spin state), represented using the ggd, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Source density of particles in phase space, for various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:particles ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:at_time ],
        [ sh:class fyo:GenericGridDynamic ;
            sh:description "Grid description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:integer ;
            sh:description "List of indices of grid spaces (refers to ../grid/space) for which the source is discretely distributed. For example consider a source of 3.5 MeV alpha particles provided on a grid with two coordinates (spaces); rho_tor and energy. To specify that the source is given at energies exactly equal to 3.5 MeV, let discret have length 1 and set discrete(1)=2 since energy is dimension number 2. The source is then proportional to delta( 1 - energy / 3.5MeV ), where delta is the direct delta distribution. Discrete dimensions can only be used when the grid is rectangular." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:discrete ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:at_instant ] ;
    sh:targetClass fyo:DistributionSourcesSourceGgd .

fyo:DistributionSourcesSourceGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Global quantities for various time slices" ;
