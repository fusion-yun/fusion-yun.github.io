fyo:EceChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (frequency)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rphizrhopsitheta1dDynamicAos1CommonTime1 ;
            sh:description "Simple estimate of the difference in position induced by the presence of suprathermal electrons. Position without corrections = position - delta_position_suprathermal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:delta_position_suprathermal ],
        [ sh:class fyo:Int1dTime1AndTypeChange ;
            sh:description "Harmonic detected by the channel. 1 corresponds to the \"O1\" mode, while 2 corresponds to the \"X2\" mode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:harmonic ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Frequency of the channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:frequency ],
        [ sh:class fyo:Rphizrhopsitheta1dDynamicAos1CommonTime1 ;
            sh:description "Position of the measurements (taking into account the suprathermal shift)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Predicted radiation temperature of the e(X)traordinary mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:t_radiation_x ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:EceBeamTracing ;
            sh:description "Beam tracing calculations, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:beam_tracing ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Line of sight of this channel, defined by two points. By convention, the first point is the closest to the diagnostic. Fill only in case the channels have different lines of sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:line_of_sight ],
        [ sh:class fyo:EceChannelBeam ;
            sh:description "ECE Gaussian optics parameters taken at the line_of_sight/first_point position (for synthetic modelling of the ECE emission)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:beam ],
        [ sh:datatype xsd:float ;
            sh:description "Full-width of the Intermediate Frequency (IF) bandpass filter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:if_bandwidth ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the processed dynamic data of this channel (outside of the beam and calibration_offset structures)" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Calibration factor, used as t_radiation = calibration_factor * (voltage_t_radiation - calibration_offset)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:calibration_factor ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Radiation temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:t_radiation ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Predicted radiation temperature of the Ordinary mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:t_radiation_o ],
        [ sh:class fyo:PhysicalQuantityFlt1dTime1 ;
            sh:description "Optical depth of the plasma at the position of the measurement. This parameter is a proxy for the local / non-local character of the ECE emission. It must be greater than 1 to guarantee that the measurement is dominated by local ECE emission (non-local otherwise)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:optical_depth ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Calibration offset, may be re-evaluated dynamically during long pulses on some experiments" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:calibration_offset ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Raw voltage measured on each channel, from which the calibrated temperature data is then derived" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:voltage_t_radiation ] ;
    sh:targetClass fyo:EceChannel .

fyo:EceChannelBeam a sh:NodeShape ;
    rdfs:comment "ECE Gaussian optics parameters taken at the line_of_sight/first_point position (for synthetic modelling of the ECE emission)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:EceChannelBeamPhase ;
            sh:description "Phase ellipse characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:EceChannelBeamSpot ;
            sh:description "Spot ellipse characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:spot ] ;
    sh:targetClass fyo:EceChannelBeam .

fyo:EceChannelBeamPhase a sh:NodeShape ;
    rdfs:comment "Phase ellipse characteristics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Rotation angle for the phase ellipse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:angle ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Inverse curvature radii for the phase ellipse, positive/negative for divergent/convergent beams" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:curvature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EceChannelBeamPhase .

fyo:EceChannelBeamSpot a sh:NodeShape ;
    rdfs:comment "Spot ellipse characteristics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Rotation angle for the spot ellipse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:angle ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Size of the spot ellipse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:size ] ;
    sh:targetClass fyo:EceChannelBeamSpot .

fyo:EdgeSourcesSource a sh:NodeShape ;
    rdfs:comment "Set of source terms" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaSourcesSourceGgdFast ;
            sh:description "Quantities provided at a faster sampling rate than the full ggd quantities. These are either integrated quantities or local quantities provided on a reduced set of positions. Positions and integration domains are described by a set of grid_subsets (of size 1 for a position)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:ggd_fast ],
        [ sh:class fyo:DistributionSpecies ;
            sh:description "Species causing this source term (if relevant, e.g. a particular ion or neutral state in case of line radiation)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:species ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaSourcesSourceGgd ;
            sh:description "Source terms represented using the general grid description, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:ggd ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Source term identifier (process causing this source term)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ] ;
    sh:targetClass fyo:EdgeSourcesSource .

fyo:EdgeTransportModel a sh:NodeShape ;
    rdfs:comment "Transport is described by a combination of various transport models" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaTransportModelGgdFast ;
            sh:description "Quantities provided at a faster sampling rate than the full ggd quantities. These are either integrated quantities or local quantities provided on a reduced set of positions. Positions and integration domains are described by a set of grid_subsets (of size 1 for a position)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:ggd_fast ],
        [ sh:class fyo:CodeWithTimebase ;
            sh:description "Code-specific parameters used for this model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ],
        [ sh:class fyo:PlasmaTransportModelGgd ;
            sh:description "Transport coefficients represented using the general grid description, for various time slices. Fluxes are given in the direction perpendicular to the edges or faces of the grid (flow crossing that surface divided by its actual area). Radial fluxes are positive when they are directed away from the magnetic axis. Poloidal fluxes are positive when they are directed in such a way that they travel clockwise around the magnetic axis (poloidal plane viewed such that the centerline of the tokamak is on the left). Parallel fluxes are positive when they are co-directed with the magnetic field. Toroidal fluxes are positive if travelling counter-clockwise when looking at the plasma from above" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:ggd ],
        [ sh:class spo:Identifier ;
            sh:description "Transport model identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplier applied to the particule flux when adding its contribution in the expression of the heat flux : can be 0, 3/2 or 5/2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:flux_multiplier ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EdgeTransportModel .

fyo:EmCouplingMatrix a sh:NodeShape ;
    rdfs:comment "Set of user-defined coupling matrices, complementary to the other system-based coupling matrices of this IDS" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of URIs corresponding to the columns (2nd dimension) of the coupling matrix. See examples above (rows_uri)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:columns_uri ],
        [ sh:class spo:Identifier ;
            sh:description "Physical quantity obtained following the matrix multiplication of the data node with the vector constructed from references contained in the columns_uri node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:quantity ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "List of URIs corresponding to the rows (1st dimension) of the coupling matrix. If not all indices of a given node are used, they must be listed explicitly e.g. rows_uri(i) = pf_active:1/coil(i) will refer to a list of indices of the occurrence 1 of the pf_active IDS of this data entry. If the rows correspond to all indices of a given vector, it is sufficient to give a insgle uri, the one  of the vector with the impliicit notation (:), e.g. rows_uri(1) = /grid_ggd(3)/grid_subset(2)/elements(:)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:rows_uri ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Coupling matrix" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this coupling matrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:EmCouplingMatrix .

fyo:EngineeringLimitSet a sh:NodeShape ;
    rdfs:comment "The per-channel engineering operating-limit set of a Machine — per-coil current / voltage / stored energy / temperature rise / force limits, wall heat-load limits — the in-scope engineering face of the in/port/out boundary (limits are IN; whole-machine design is via ports; cost and buildings are OUT — FYTOK-ADR-119 D3/D4). About the machine (is_about); consumed by S-10 verification and S-11 feasibility screening." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EngineeringLimitSet .

fyo:EntryTag a sh:NodeShape ;
    rdfs:comment "Tag qualifying this data entry (or a list of data entries)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Any comment describing the content of the tagged list of entries" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the tag" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EntryTag .

fyo:EquilibriumBoundary a sh:NodeShape ;
    rdfs:comment "Description of the plasma boundary. The boundary can be either the real separatrix (provided by a free boundary equilibrium solver) or the 0.99x psi_norm flux surface provided by a fixed boundary equilibrium" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Upper inner squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:squareness_upper_inner ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux at the selected plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Elongation of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:elongation ],
        [ sh:datatype xsd:float ;
            sh:description "Upper triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:triangularity_upper ],
        [ sh:datatype xsd:float ;
            sh:description "Minor radius of the plasma boundary (defined as (Rmax-Rmin) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:minor_radius ],
        [ sh:class fyo:EquilibriumGap ;
            sh:description "Set of gaps, defined by a reference point and a direction." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:gap ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "RZ position of the geometric axis (defined as (Rmin+Rmax) / 2 and (Zmin+Zmax) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:geometric_axis ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Upper outer squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:squareness_upper_outer ],
        [ sh:datatype xsd:integer ;
            sh:description "0 (limiter) or 1 (diverted)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Lower inner squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:squareness_lower_inner ],
        [ sh:class fyo:Rz1dDynamicAos ;
            sh:description "RZ outline of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal flux at which the boundary is taken" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the normalized poloidal flux at which the boundary is taken, the flux being normalized to its value at the separatrix (so psi_norm = 1 if the boundary is the separatrix)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Lower outer squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:squareness_lower_outer ],
        [ sh:datatype xsd:float ;
            sh:description "Triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:triangularity ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate at the selected plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Lower triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:triangularity_lower ],
        [ sh:class fyo:Rz0dDynamicAos ;
            sh:description "Outboard point on the separatrix on which dr/dz = 0 (local maximum of the major radius of the separatrix). In case of multiple local maxima, the closest one from z=z_magnetic_axis is chosen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:dr_dz_zero_point ],
        [ sh:class fyo:EquilibriumBoundaryClosest ;
            sh:description "Position and distance to the plasma boundary of the point of the first wall which is the closest to plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:closest_wall_point ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux at the selected plasma boundary generated by the plasma poloidal current" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:phi_poloidal_current ] ;
    sh:targetClass fyo:EquilibriumBoundary .

fyo:EquilibriumBoundaryClosest a sh:NodeShape ;
    rdfs:comment "Position and distance to the plasma boundary of the point of the first wall which is the closest to plasma boundary" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Distance to the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:distance ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumBoundaryClosest .

fyo:EquilibriumConstraints a sh:NodeShape ;
    rdfs:comment "In case of equilibrium reconstruction under constraints, measurements used to constrain the equilibrium, reconstructed values and accuracy of the fit. The names of the child nodes correspond to the following definition: the solver aims at minimizing a cost function defined as : J=1/2*sum_i [ weight_i^2 (reconstructed_i - measured_i)^2 / sigma_i^2 ]. in which sigma_i is the standard deviation of the measurement error (to be found in the IDS of the measurement)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Number of degrees of freedom of the identification model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:freedom_degrees_n ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of local density measurements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:n_e ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Set of MSE polarization angles" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:mse_polarization_angle ],
        [ sh:class fyo:EquilibriumConstraintsPurePosition ;
            sh:description "Array of X-points, for each of them the RZ position is given" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:x_point ],
        [ sh:class fyo:EquilibriumConstraintsMagnetization ;
            sh:description "Magnetization M of a set of iron core segments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:iron_core_segment ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of constraints used (i.e. having a non-zero weight)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:constraints_n ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Vacuum field times major radius in the toroidal field magnet. Positive sign means anti-clockwise when viewed from above" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:b_field_tor_vacuum_r ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of rotational pressure estimates. The rotational pressure is defined as R0^2*rho*omega^2 / 2, where omega is the toroidal rotation frequency, rho=ne(R0,psi)*m, and m is the plasma equivalent mass." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:pressure_rotational ],
        [ sh:class fyo:EquilibriumConstraints0DB0Like ;
            sh:description "Diamagnetic flux" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:diamagnetic_flux ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:EquilibriumConstraintsPurePosition ;
            sh:description "Array of strike points, for each of them the RZ position is given" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:strike_point ],
        [ sh:class fyo:EquilibriumConstraints0DIpLike ;
            sh:description "Plasma current. Positive sign means anti-clockwise when viewed from above" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:ip ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of flux-surface averaged parallel current density approximations at various positions (= average(j.B) / B0, where B0 = /vacuum_toroidal_field/b0)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:j_parallel ],
        [ sh:class fyo:EquilibriumConstraints0DIpLike ;
            sh:description "Current in a set of poloidal field coils" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:pf_current ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of safety factor estimates at various positions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:q ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Set of line integrated density measurements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:n_e_line ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of flux-surface averaged toroidal current density approximations at various positions  (= average(j_tor/R) / average(1/R))" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:j_phi ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Current in a set of axisymmetric passive conductors" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:pf_passive_current ],
        [ sh:datatype xsd:float ;
            sh:description "Sum of the chi_squared of all constraints used for the equilibrium reconstruction, divided by the number of degrees of freedom of the identification model" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:chi_squared_reduced ],
        [ sh:class fyo:EquilibriumConstraints0DOneLike ;
            sh:description "Set of poloidal field probes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:b_field_pol_probe ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Set of flux loops" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:flux_loop ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:EquilibriumConstraints0DPosition ;
            sh:description "Set of total pressure estimates" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:pressure ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Set of faraday angles" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:faraday_angle ] ;
    sh:targetClass fyo:EquilibriumConstraints .

fyo:EquilibriumConstraints0DB0Like a sh:NodeShape ;
    rdfs:comment "Diamagnetic flux" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means exact data, taken as an exact input without being fitted; 0 means the equilibrium code does a least square fit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:exact ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Measured value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:measured ],
        [ sh:datatype xsd:float ;
            sh:description "Weight given to the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:weight ],
        [ sh:datatype xsd:float ;
            sh:description "Value calculated from the reconstructed equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:reconstructed ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the source data for this measurement in the IMAS data dictionary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slice used from the time array of the measurement source data. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_measurement ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error normalized by the variance considered in the minimization process : chi_squared = weight^2 *(reconstructed - measured)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:chi_squared ] ;
    sh:targetClass fyo:EquilibriumConstraints0DB0Like .

fyo:EquilibriumConstraints0DOneLike a sh:NodeShape ;
    rdfs:comment "Set of poloidal field probes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Value calculated from the reconstructed equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:reconstructed ],
        [ sh:datatype xsd:float ;
            sh:description "Squared error normalized by the variance considered in the minimization process : chi_squared = weight^2 *(reconstructed - measured)^2 / sigma^2, where sigma is the standard deviation of the measurement error" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:chi_squared ],
        [ sh:datatype xsd:float ;
            sh:description "Weight given to the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:weight ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Measured value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:measured ],
        [ sh:datatype xsd:float ;
            sh:description "Exact time slice used from the time array of the measurement source data. If the time slice does not exist in the time array of the source data, it means linear interpolation has been used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time_measurement ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Path to the source data for this measurement in the IMAS data dictionary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer flag : 1 means exact data, taken as an exact input without being fitted; 0 means the equilibrium code does a least square fit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:exact ] ;
    sh:targetClass fyo:EquilibriumConstraints0DOneLike .

fyo:EquilibriumConstraintsMagnetization a sh:NodeShape ;
    rdfs:comment "Magnetization M of a set of iron core segments" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Magnetization M of the iron core segment along the major radius axis, assumed to be constant inside a given iron segment. Reminder : H = 1/mu0 * B - mur * M;" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:magnetization_r ],
        [ sh:class fyo:EquilibriumConstraints0D ;
            sh:description "Magnetization M of the iron core segment along the vertical axis, assumed to be constant inside a given iron segment. Reminder : H = 1/mu0 * B - mur * M;" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:magnetization_z ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumConstraintsMagnetization .

fyo:EquilibriumContourTree a sh:NodeShape ;
    rdfs:comment "Description of the topological connectivity of the poloidal flux map critical points as an undirected graph. Critical points are ether local extremum (o-points) or saddle points (x-points) of the poloidal flux map. X-points have zero gradients in orthogonal directions but are not local extremum of the poloidal flux map whilst O-points are." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:EquilibriumContourTreeNode ;
            sh:description "Set of nodes. A contour tree node is defined by its critical type and position within the poloidal plane. A critical type of 1 references an x-point whilst a critical type of 0 or 2 references an o-point. Both X-points and O-points are rarely coincident with nodes defining the poloidal upon which the poloidal flux map is defined. The order in which the critical points are stored in the nodes array of structure is only important for the primary plasma O-point and X-points. If present, the primary plasma O-point should be placed as the first element of the nodes array of structure. If present, the primary plasma X-point should be the second element in the nodes structure" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:node ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Edges connect nodes to one another. A single node may connect to multiple edges such as the case where a single maximum (a hill) may topologically link to multiple minima (the floors of different valleys). For each edge (1st dimension), the index of the two connected nodes are listed (index referring to the ../node array)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:edges ] ;
    sh:targetClass fyo:EquilibriumContourTree .

fyo:EquilibriumContourTreeNode a sh:NodeShape ;
    rdfs:comment "Set of nodes. A contour tree node is defined by its critical type and position within the poloidal plane. A critical type of 1 references an x-point whilst a critical type of 0 or 2 references an o-point. Both X-points and O-points are rarely coincident with nodes defining the poloidal upon which the poloidal flux map is defined. The order in which the critical points are stored in the nodes array of structure is only important for the primary plasma O-point and X-points. If present, the primary" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:r ],
        [ sh:class fyo:Rz1dDynamicAos ;
            sh:description "Single poloidal flux contour including critical point (x-point only)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:levelset ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal flux at the node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:integer ;
            sh:description "0-minimum, 1-saddle, 2-maximum" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:critical_type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumContourTreeNode .

fyo:EquilibriumConvergence a sh:NodeShape ;
    rdfs:comment "Convergence details" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Convergence result" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:result ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of iterations carried out in the convergence loop" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:iterations_n ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the residual deviation between the left and right hand side of the Grad Shafranov equation, evaluated as per grad_shafranov_deviation_expression" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:grad_shafranov_deviation_value ],
        [ sh:class spo:Identifier ;
            sh:description "Expression for calculating the residual deviation between the left and right hand side of the Grad Shafranov equation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grad_shafranov_deviation_expression ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:EquilibriumConvergence .

fyo:EquilibriumCoordinateSystem a sh:NodeShape ;
    rdfs:comment "Flux surface coordinate system on a square grid of flux and poloidal angle" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Absolute value of the jacobian of the coordinate system" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:jacobian ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the Height on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the major radius on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:r ],
        [ sh:class spo:Identifier ;
            sh:description "Type of coordinate system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:datatype xsd:float ;
            sh:description "Covariant metric tensor on every point of the grid described by grid_type" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:tensor_covariant ],
        [ sh:datatype xsd:float ;
            sh:description "Contravariant metric tensor on every point of the grid described by grid_type" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:tensor_contravariant ] ;
    sh:targetClass fyo:EquilibriumCoordinateSystem .

fyo:EquilibriumGap a sh:NodeShape ;
    rdfs:comment "Set of gaps, defined by a reference point and a direction." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Height of the reference point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. mid-plane gap" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of the reference point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the gap, i.e. distance between the reference point and the separatrix along the gap direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:float ;
            sh:description "Angle measured clockwise from radial cylindrical vector (grad R) to gap vector (pointing away from reference point)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:angle ] ;
    sh:targetClass fyo:EquilibriumGap .

fyo:EquilibriumGgd a sh:NodeShape ;
    rdfs:comment "Set of equilibrium representations using the generic grid description" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridScalar ;
            sh:description "Values of the Height on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal plasma current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:j_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Values of the major radius on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Values of the toroidal flux, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:phi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Values of the poloidal angle, given on various grid subsets. The poloidal angle is centered on the magnetic axis and oriented such that (grad rho_tor_norm, grad theta, grad phi) form a right-handed set where grad rho_tor_norm points away from the magnetic axis." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:theta ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:b_field_phi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Parallel (to magnetic field) plasma current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:j_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Z component of the magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:b_field_z ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Values of the poloidal flux, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:psi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "R component of the poloidal magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:b_field_r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumGgd .

fyo:EquilibriumGgdArray a sh:NodeShape ;
    rdfs:comment "Grids (using the Generic Grid Description), for various time slices. The timebase of this array of structure must be a subset of the time_slice timebase" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridDynamic ;
            sh:description "Set of GGD grids for describing the equilibrium, at a given time slice" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:EquilibriumGgdArray .

fyo:EquilibriumGlobalQuantitiesCurrentCentre a sh:NodeShape ;
    rdfs:comment "Position and vertical velocity of the current centre" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Height of the current center, defined as integral over the poloidal cross section of (j_tor*z*dS) / Ip" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of the current center, defined as integral over the poloidal cross section of (j_tor*r*dS) / Ip" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical velocity of the current center" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:velocity_z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:EquilibriumGlobalQuantitiesCurrentCentre .

fyo:EquilibriumGlobalQuantitiesMagneticAxis a sh:NodeShape ;
    rdfs:comment "Magnetic axis position and toroidal field" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Total toroidal magnetic field at the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:b_field_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Height of the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:EquilibriumGlobalQuantitiesMagneticAxis .

fyo:EquilibriumGlobalQuantitiesQmin a sh:NodeShape ;
    rdfs:comment "Minimum q value and position" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Minimum q value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum q position in normalized toroidal flux coordinate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum q position in poloidal flux" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum q position in normalised poloidal flux" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi_norm ] ;
    sh:targetClass fyo:EquilibriumGlobalQuantitiesQmin .

fyo:EquilibriumProfiles1d a sh:NodeShape ;
    rdfs:comment "Equilibrium profiles (1D radial grid) as a function of the poloidal flux" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Lower outer squareness (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fyo:squareness_lower_outer ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of pressure w.r.t. psi" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:dpressure_dpsi ],
        [ sh:datatype xsd:float ;
            sh:description "Cross-sectional area of the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Radial derivative of the volume enclosed in the flux surface with respect to Psi" ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path fyo:dvolume_dpsi ],
        [ sh:datatype xsd:float ;
            sh:description "Lower triangularity w.r.t. magnetic axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:triangularity_lower ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged |grad_rho_tor|^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path fyo:gm3 ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged |grad_rho_tor|^2/R^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path fyo:gm2 ],
        [ sh:datatype xsd:float ;
            sh:description "Radial coordinate (major radius) on the inboard side of the magnetic axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:r_inboard ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation). Namely (rho_tor(rho)-rho_tor(magnetic_axis)) / (rho_tor(boundary)-rho_tor(magnetic_axis))" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of F w.r.t. Psi, multiplied with F" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:f_df_dpsi ],
        [ sh:datatype xsd:float ;
            sh:description "Radial derivative of the cross-sectional area of the flux surface with respect to psi" ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path fyo:darea_dpsi ],
        [ sh:datatype xsd:float ;
            sh:description "Diamagnetic function (F=R B_Phi)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:f ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged R" ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path fyo:gm8 ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged |grad_rho_tor|" ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path fyo:gm7 ],
        [ sh:datatype xsd:float ;
            sh:description "Elongation" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:elongation ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Upper outer squareness (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:squareness_upper_outer ],
        [ sh:datatype xsd:float ;
            sh:description "Upper triangularity w.r.t. magnetic axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:triangularity_upper ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux. Integral of magnetic field passing through a contour defined by the intersection of a flux surface passing through the point of interest and a Z=constant plane. If the integration surface is flat, the surface normal vector is in the increasing vertical coordinate direction, Z, namely upwards." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Trapped particle fraction" ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path fyo:trapped_fraction ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic shear, defined as rho_tor/q . dq/drho_tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:magnetic_shear ],
        [ sh:datatype xsd:float ;
            sh:description "Radial coordinate (major radius) on the outboard side of the magnetic axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:r_outboard ],
        [ sh:datatype xsd:float ;
            sh:description "Normalised poloidal flux, namely (psi(rho)-psi(magnetic_axis)) / (psi(LCFS)-psi(magnetic_axis))" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:psi_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged 1/B^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path fyo:gm4 ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged approximation to parallel current density = average(j.B) / B0, where B0 = /vacuum_toroidal_field/b0" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:j_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Volume enclosed in the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:volume ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged toroidal current density = average(j_tor/R) / average(1/R)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:j_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Radial derivative of the cross-sectional area of the flux surface with respect to rho_tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path fyo:darea_drho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum(modulus(B)) on the flux surface (always positive, irrespective of the sign convention for the B-field direction)" ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path fyo:b_field_max ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate = sqrt(phi/(pi*b0)), where the toroidal flux, phi, corresponds to time_slice/profiles_1d/phi, the toroidal magnetic field, b0, corresponds to that stored in vacuum_toroidal_field/b0 and pi can be found in the IMAS constants" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal beta profile. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:nodeKind sh:Literal ;
            sh:order 45 ;
            sh:path fyo:beta_pol ],
        [ sh:datatype xsd:float ;
            sh:description "Safety factor (only positive when toroidal current and magnetic field are in same direction)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:q ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Surface area of the toroidal flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path fyo:surface ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of Psi with respect to Rho_Tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:dpsi_drho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged |grad_rho_tor|^2/B^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path fyo:gm6 ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged 1/R^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path fyo:gm1 ],
        [ sh:datatype xsd:float ;
            sh:description "Radial derivative of the volume enclosed in the flux surface with respect to Rho_Tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path fyo:dvolume_drho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum(modulus(B)) on the flux surface (always positive, irrespective of the sign convention for the B-field direction)" ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path fyo:b_field_min ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 48 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged B^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path fyo:gm5 ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Mass density" ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path fyo:mass_density ],
        [ sh:class fyo:EquilibriumProfiles1dRz1dDynamicAos ;
            sh:description "RZ position of the geometric axis of the magnetic surfaces (defined as (Rmin+Rmax) / 2 and (Zmin+Zmax) / 2 of the surface)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:geometric_axis ],
        [ sh:datatype xsd:float ;
            sh:description "Lower inner squareness (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path fyo:squareness_lower_inner ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized square root of enclosed volume (radial coordinate). The normalizing value is the enclosed volume at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fyo:rho_volume_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged 1/R" ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path fyo:gm9 ],
        [ sh:datatype xsd:float ;
            sh:description "Flux surface averaged modulus of B (always positive, irrespective of the sign convention for the B-field direction)." ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path fyo:b_field_average ],
        [ sh:datatype xsd:float ;
            sh:description "Upper inner squareness (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:squareness_upper_inner ] ;
    sh:targetClass fyo:EquilibriumProfiles1d .

fyo:EquilibriumProfiles1dRz1dDynamicAos a sh:NodeShape ;
    rdfs:comment "RZ position of the geometric axis of the magnetic surfaces (defined as (Rmin+Rmax) / 2 and (Zmin+Zmax) / 2 of the surface)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ] ;
    sh:targetClass fyo:EquilibriumProfiles1dRz1dDynamicAos .

fyo:EquilibriumProfiles2d a sh:NodeShape ;
    rdfs:comment "Equilibrium 2D profiles in the poloidal plane. Multiple 2D representations of the equilibrium can be stored here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Z component of the magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:b_field_z ],
        [ sh:datatype xsd:float ;
            sh:description "R component of the poloidal magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:b_field_r ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the poloidal flux at the grid in the poloidal plane. The poloidal flux is integral of magnetic field passing through a contour defined by the intersection of a flux surface passing through the point of interest and a Z=constant plane. If the integration surface is flat, the surface normal vector is in the increasing vertical coordinate direction, Z, namely upwards." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal plasma current density" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:j_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the Height on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:z ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid_type ],
        [ sh:datatype xsd:float ;
            sh:description "Values of poloidal angle on the grid. The poloidal angle is centered on the magnetic axis and oriented such that (grad rho_tor_norm, grad theta, grad phi) form a right-handed set where grad rho_tor_norm points away from the magnetic axis." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:theta ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Defined as (j.B)/B0 where j and B are the current density and magnetic field vectors and B0 is the (signed) vacuum toroidal magnetic field strength at the geometric reference point (R0,Z0). It is formally not the component of the plasma current density parallel to the magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:j_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the major radius on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:r ],
        [ sh:class spo:Identifier ;
            sh:description "Type of profiles (distinguishes contribution from plasma, vaccum fields and total fields)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:b_field_phi ],
        [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:EquilibriumProfiles2d .

fyo:EquilibriumTimeSlice a sh:NodeShape ;
    rdfs:comment "Set of equilibria at various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EquilibriumBoundary ;
            sh:description "Description of the plasma boundary. The boundary can be either the real separatrix (provided by a free boundary equilibrium solver) or the 0.99x psi_norm flux surface provided by a fixed boundary equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:boundary ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:EquilibriumContourTree ;
            sh:description "Description of the topological connectivity of the poloidal flux map critical points as an undirected graph. Critical points are ether local extremum (o-points) or saddle points (x-points) of the poloidal flux map. X-points have zero gradients in orthogonal directions but are not local extremum of the poloidal flux map whilst O-points are." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:contour_tree ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:EquilibriumProfiles2d ;
            sh:description "Equilibrium 2D profiles in the poloidal plane. Multiple 2D representations of the equilibrium can be stored here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:profiles_2d ],
        [ sh:class fyo:EquilibriumConvergence ;
            sh:description "Convergence details" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:convergence ],
        [ sh:class fyo:EquilibriumCoordinateSystem ;
            sh:description "Flux surface coordinate system on a square grid of flux and poloidal angle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:coordinate_system ],
        [ sh:class fyo:EquilibriumConstraints ;
            sh:description "In case of equilibrium reconstruction under constraints, measurements used to constrain the equilibrium, reconstructed values and accuracy of the fit. The names of the child nodes correspond to the following definition: the solver aims at minimizing a cost function defined as : J=1/2*sum_i [ weight_i^2 (reconstructed_i - measured_i)^2 / sigma_i^2 ]. in which sigma_i is the standard deviation of the measurement error (to be found in the IDS of the measurement)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:constraints ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:at_time ],
        [ sh:class fyo:EquilibriumGgd ;
            sh:description "Set of equilibrium representations using the generic grid description" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:ggd ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:EquilibriumProfiles1d ;
            sh:description "Equilibrium profiles (1D radial grid) as a function of the poloidal flux" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:profiles_1d ],
        [ sh:class fyo:EqulibriumGlobalQuantities ;
            sh:description "0D parameters of the equilibrium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:EquilibriumTimeSlice .

fyo:EqulibriumGlobalQuantities a sh:NodeShape ;
    rdfs:comment "0D parameters of the equilibrium" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Plasma resistance = int(e_field.j.dV) / Ip^2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path fyo:plasma_resistance ],
        [ sh:datatype xsd:float ;
            sh:description "q at the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:q_axis ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal length of the magnetic surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:length_pol ],
        [ sh:class fyo:EquilibriumGlobalQuantitiesQmin ;
            sh:description "Minimum q value and position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:q_min ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal beta, defined as 100 * beta_tor * a[m] * B0 [T] / ip [MA]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:beta_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate at the selected plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:rho_tor_boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma energy content = 3/2 * int(p,dV) with p being the total pressure (thermal + fast particles) [J]. Time-dependent; Scalar" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:energy_mhd ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:ip ],
        [ sh:datatype xsd:float ;
            sh:description "Average (over the plasma poloidal cross section) plasma poloidal magnetic flux produced by all external circuits (CS and PF coils, eddy currents, VS in-vessel coils), given by the following formula : int(psi_external.j_tor.dS) / Ip" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:psi_external_average ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Surface area of the toroidal flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:surface ],
        [ sh:class fyo:EquilibriumGlobalQuantitiesMagneticAxis ;
            sh:description "Magnetic axis position and toroidal field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:magnetic_axis ],
        [ sh:class fyo:EquilibriumGlobalQuantitiesCurrentCentre ;
            sh:description "Position and vertical velocity of the current centre" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:current_centre ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal beta. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:beta_pol ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma volume" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:volume ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux at the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:psi_magnetic_axis ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux at the selected plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:psi_boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Area of the LCFS poloidal cross section" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal beta, defined as the volume-averaged total perpendicular pressure divided by (B0^2/(2*mu0)), i.e. beta_toroidal = 2 mu0 int(p dV) / V / B0^2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:beta_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma inductance 2 E_magnetic/Ip^2, where E_magnetic = 1/2 * int(psi.j_tor.dS) (integral over the plasma poloidal cross-section)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:plasma_inductance ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux at the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:psi_axis ],
        [ sh:datatype xsd:float ;
            sh:description "q at the 95% poloidal flux surface (only positive when toroidal current and magnetic field are in same direction)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:q_95 ],
        [ sh:datatype xsd:float ;
            sh:description "Internal inductance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:li_3 ],
        [ sh:datatype xsd:float ;
            sh:description "External voltage, i.e. time derivative of psi_external_average (with a minus sign : - d_psi_external_average/d_time)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:v_external ] ;
    sh:targetClass fyo:EqulibriumGlobalQuantities .

fyo:FerriticObject a sh:NodeShape ;
    rdfs:comment "Set of n objects characterized by a list of centroids, volumes, and permeabilities. Optionally a full 3D description of the n volumes may be given in ../grid_ggd. Here the index for each element given in the grid_ggd should be referenced by the object set." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Xyz1dPositionsStatic ;
            sh:description "List of positions of the centroids, in Cartesian coordinates" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:centroid ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of GGD volumic object corresponding to each element. Refers to the array /grid_ggd/space(1)/objects_per_dimension(4)/object" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:ggd_object_index ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Volume of each element of this object" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:volume ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of permeability table to be used for each element. If not allocated or if an element is equal to EMPTY_INT, use the sibling saturated relative permeability instead ../relative_permeability, for that element" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:permeability_table_index ],
        [ sh:datatype xsd:float ;
            sh:description "Saturated relative magnetic permeability of each element" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:saturated_relative_permeability ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:FerriticObjectTimeSlice ;
            sh:description "Dynamic quantities, per time slice" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:time_slice ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Optional equivalent axisymmetric representation of the geometry of each element (e.g. for each iron core segment), typically used to represent iron core in axisymmetric equilibrium solvers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:axisymmetric ] ;
    sh:targetClass fyo:FerriticObject .

fyo:FerriticObjectTimeSlice a sh:NodeShape ;
    rdfs:comment "Dynamic quantities, per time slice" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Z component of the magnetic field at each centroid" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:b_field_z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Z component of the magnetic moment of each element" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:magnetic_moment_z ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the magnetic moment of each element" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:magnetic_moment_phi ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the magnetic field at each centroid" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:b_field_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "R component of the magnetic moment of each element" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:magnetic_moment_r ],
        [ sh:datatype xsd:float ;
            sh:description "R component of the magnetic field at each centroid" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:b_field_r ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:FerriticObjectTimeSlice .

fyo:FerriticPermeabilityTable a sh:NodeShape ;
    rdfs:comment "Set of tables for relative permeability as a function of the magnetic field" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Array of magnetic field values, for each of which the relative permeability is given" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:b_field ],
        [ sh:datatype xsd:float ;
            sh:description "Relative permeability as a function of the magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:relative_permeability ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Description of this table" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this table" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:FerriticPermeabilityTable .

fyo:FilterSimpleDynamic a sh:NodeShape ;
    rdfs:comment "Set of filters" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Filter transmission function width (at 90% level)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_width ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Central wavelength of the filter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:wavelength_central ] ;
    sh:targetClass fyo:FilterSimpleDynamic .

fyo:FilterSimpleStatic a sh:NodeShape ;
    rdfs:comment "Filter description" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Filter transmission function width (at 90% level)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_width ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Central wavelength of the filter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:wavelength_central ] ;
    sh:targetClass fyo:FilterSimpleStatic .

fyo:FilterWavelength a sh:NodeShape ;
    rdfs:comment "Filter wavelength range and detection efficiency" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Probability of detection of a photon impacting the detector as a function of its wavelength" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:detection_efficiency ],
        [ sh:datatype xsd:float ;
            sh:description "Lower bound of the filter wavelength range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:wavelength_lower ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
