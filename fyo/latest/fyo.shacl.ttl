        [ sh:datatype xsd:float ;
            sh:description "Effective coefficient of chemical sputtering due to this incident species. It is assumed that all sputtered neutrals from the wall have the wall temperature (cold neutrals)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:sputtering_chemical ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
