            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:cold_neutrals_fraction ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (H, D, T, 3He, 4He)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature of hot neutrals for this isotope" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:hot_neutrals_temperature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:float ;
            sh:description "Fraction of hot neutrals for this isotope (n_hot_neutrals/(n_cold_neutrals+n_hot_neutrals))" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:hot_neutrals_fraction ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for dynamic quantities at this level of the data structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:SpectroVisChannelIsotopesIsotope .

fyo:SpectroVisChannelLightCollection a sh:NodeShape ;
    rdfs:comment "Light collection efficiencies (fraction of the local emission detected by the optical system) for a list of points defining regions of interest. To be used for non-pinhole optics." ;
