            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_index ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier of the boundary condition type. List of options TBD." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ] ;
    sh:targetClass fyo:NumericsBcGgdBc .

fyo:Outline2dGeometryStatic a sh:NodeShape ;
    rdfs:comment "Optional equivalent axisymmetric representation of the geometry of each element (e.g. for each iron core segment), typically used to represent iron core in axisymmetric equilibrium solvers" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
