            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Factor to be multiplied by the spectral calibration to obtain the instrument function (fraction of signal received on each energy channel when a photon of relevant energy enters the optical system)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:calibration_absolute ],
        [ sh:datatype xsd:string ;
            sh:description "Date at which the absolute calibration was carried out" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:calibration_absolute_date ],
        [ sh:datatype xsd:string ;
            sh:description "Date at which the spectral calibration was carried out" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:calibration_spectral_date ],
        [ sh:class fyo:DetectorWavelength ;
            sh:description "Set of wavelength bands in which photons are counted by the polychromator" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:wavelength_band ],
        [ sh:datatype xsd:float ;
            sh:description "Polychromator response function: fraction of signal received on each energy channel when a photon of relevant energy enters the polychromator." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:calibration_spectral ] ;
    sh:targetClass fyo:ThomsonScatteringPolychromator .

