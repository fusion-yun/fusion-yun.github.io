fyo:WavesCoherentWaveFullWave a sh:NodeShape ;
    rdfs:comment "Solution by a full wave code, given on a generic grid description, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
