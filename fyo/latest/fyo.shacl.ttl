        [ sh:datatype xsd:float ;
            sh:description "Psi* = psi - phi, just before the sawtooth crash" ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path fyo:psi_star_pre_crash ],
        [ sh:datatype xsd:float ;
            sh:description "Thermal pressure (electrons+ions)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) electron perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:p_e_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Ohmic parallel current density = average(J_Ohmic.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:j_ohmic ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic shear, defined as rho_tor/q . dq/drho_tor" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fyo:magnetic_shear ],
        [ sh:datatype xsd:float ;
            sh:description "Bootstrap current density = average(J_Bootstrap.B) / B0, where B0 = Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:j_bootstrap ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel electric field = average(E.B) / B0, where Core_Profiles/Vacuum_Toroidal_Field/ B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fyo:e_field_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:t_e ],
        [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged on charge states and ion species)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:t_i_average ],
        [ sh:datatype xsd:float ;
            sh:description "Electron pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:p_e ],
        [ sh:datatype xsd:float ;
            sh:description "Safety factor" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:q ],
        [ sh:datatype xsd:float ;
            sh:description "Effective charge" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:zeff ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) total ion (sum over the ion species) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:p_i_total_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) total ion (sum over the ion species) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:p_i_total_fast_parallel ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 34 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Ratio of total ion density (sum over species and charge states) over electron density. (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:n_i_total_over_n_e ] ;
    sh:targetClass fyo:SawteethProfiles1d .

