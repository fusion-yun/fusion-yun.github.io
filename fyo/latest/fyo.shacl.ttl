            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:metric ],
        [ sh:class fyo:GenericGridConstantGridSubsetElement ;
            sh:description "Set of elements defining the grid subset. An element is defined by a combination of objects from potentially all spaces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:element ],
        [ sh:class fyo:GenericGridConstantGridSubsetMetric ;
