fyo:GyrokineticsFluxSurface a sh:NodeShape ;
    rdfs:comment "Flux surface characteristics" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Derivative of the elongation with respect to r_minor_norm" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:delongation_dr_minor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "'s' coefficients in the formula defining the shape of the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:shape_coefficients_s ],
        [ sh:datatype xsd:float ;
            sh:description "normalized pressure gradient (derivative with respect to r_minor_norm)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:pressure_gradient_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the major radius of the surface geometric axis with respect to r_minor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:dgeometric_axis_r_dr_minor ],
        [ sh:datatype xsd:float ;
            sh:description "Sign of the toroidal magnetic field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:b_field_phi_sign ],
        [ sh:datatype xsd:float ;
            sh:description "'c' coefficients in the formula defining the shape of the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:shape_coefficients_c ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the 'c' shape coefficients with respect to r_minor_norm" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:dc_dr_minor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Magnetic shear, defined as r_minor_norm/q . dq/dr_minor_norm (different definition from the equilibrium IDS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:magnetic_shear_r_minor ],
        [ sh:datatype xsd:float ;
            sh:description "Elongation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:elongation ],
        [ sh:datatype xsd:float ;
            sh:description "Safety factor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:q ],
        [ sh:datatype xsd:float ;
            sh:description "Sign of the plasma current" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:ip_sign ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the height of the surface geometric axis with respect to r_minor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:dgeometric_axis_z_dr_minor ],
        [ sh:datatype xsd:float ;
            sh:description "Derivative of the 's' shape coefficients with respect to r_minor_norm" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:ds_dr_minor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized minor radius of the flux surface of interest = 1/2 * (max(R) - min(R))/L_ref" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r_minor_norm ] ;
    sh:targetClass fyo:GyrokineticsFluxSurface .

fyo:GyrokineticsInputNormalizing a sh:NodeShape ;
    rdfs:comment "Physical quantities used for normalization (useful to link to the original simulation/experience)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Major radius of the flux surface of interest, defined as (min(R)+max(R))/2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal magnetic field at major radius r" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:b_field_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature at outboard equatorial midplane of the flux surface (angle_pol = 0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:t_e ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Electron density at outboard equatorial midplane of the flux surface (angle_pol = 0)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_e ] ;
    sh:targetClass fyo:GyrokineticsInputNormalizing .

fyo:GyrokineticsInputSpeciesGlobal a sh:NodeShape ;
    rdfs:comment "Physical quantities common to all species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "normalized ExB shearing rate (for non-linear runs only)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:shearing_rate_norm ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "normalized toroidal velocity of species (all species are assumed to have a purely toroidal velocity with a common toroidal angular frequency)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:velocity_phi_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Debye length computed from the reference quantities (see detailed documentation at the root of the IDS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:debye_length_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal angle grid, from -pi to pi, on which the species dependent effective potential energy (which determines the poloidal variation of the density) is expressed. The angle is defined with respect to (R0,Z0) with R0=(Rmax-Rmin)/2 and Z0=(Zmax-Zmin)/2. It is increasing clockwise. So (r,theta,phi) is right-handed. theta=0 for Z=Z0 and R>R0 (LFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:angle_pol_equilibrium ],
        [ sh:datatype xsd:float ;
            sh:description "Reference plasma beta (see detailed documentation at the root of the IDS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:beta_reference ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:GyrokineticsInputSpeciesGlobal .

fyo:GyrokineticsLinear a sh:NodeShape ;
    rdfs:comment "Linear simulation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GyrokineticsWavevector ;
            sh:description "Set of wavevectors" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:wavevector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:GyrokineticsLinear .

fyo:GyrokineticsModel a sh:NodeShape ;
    rdfs:comment "Assumptions of the GK calculations" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if the collision operator conserves momentum, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:collisions_momentum_conservation ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if electrons are adiabatic, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:adiabatic_electrons ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if only pitch-angle scattering is retained, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:collisions_pitch_only ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if the collision operator conserves energy, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:collisions_energy_conservation ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if centrifugal effects are retained, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:include_centrifugal_effects ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if fluctuations of the parallel vector potential are retained, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:include_a_field_parallel ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if finite larmor radius effects are retained in the collision operator, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:collisions_finite_larmor_radius ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if Coriolis drift is included, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:include_coriolis_drift ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if fluctuations of the parallel magnetic field are retained, 0 otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:include_b_field_parallel ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if the geometric dependence of the grad-B drift is approximated to be that of the curvature drift (including the pressure gradient contribution), 0 otherwise. Using this approximation (Flag=1) is only recommended together with the neglect of parallel magnetic field fluctuations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:use_mhd_approximation ] ;
    sh:targetClass fyo:GyrokineticsModel .

fyo:GyrokineticsNonLinear a sh:NodeShape ;
    rdfs:comment "Non-linear simulation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GyrokineticsFluxesNl1d ;
            sh:description "1D fluxes (flux-surface and time averaged), summed over kx and ky in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path fyo:fluxes_1d_rotating_frame ],
        [ sh:class fyo:GyrokineticsFluxesNl2dSumKxKy ;
            sh:description "2D fluxes (flux-surface averaged), summed over kx and ky" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:fluxes_2d_k_x_k_y_sum ],
        [ sh:datatype xsd:float ;
            sh:description "Array of normalized radial wavevectors" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:radial_wavevector_norm ],
        [ sh:class fyo:CodePartialConstant ;
            sh:description "Code-specific parameters used for the non-linear simulation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:float ;
            sh:description "normalized time interval used to average fluxes in non-linear runs" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time_interval_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Array of normalized binormal wavevectors" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:binormal_wavevector_norm ],
        [ sh:class fyo:GyrokineticsFluxesNl3d ;
            sh:description "3D fluxes (time and flux surface averaged) in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:fluxes_3d_rotating_frame ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GyrokineticsFluxesNl2dSumKx ;
            sh:description "2D fluxes (time and flux-surface averaged), summed over kx in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:fluxes_2d_k_x_sum_rotating_frame ],
        [ sh:class fyo:GyrokineticsFluxesNl3d ;
            sh:description "3D fluxes (time and flux surface averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:fluxes_3d ],
        [ sh:class fyo:GyrokineticsFluxesNl3dSumKx ;
            sh:description "3D fluxes (flux surface averaged, summed over kx)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:fluxes_3d_k_x_sum ],
        [ sh:class fyo:GyrokineticsFieldsNl2dKy0 ;
            sh:description "2D zonal fields (taken at ky=0, flux surface averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:fields_zonal_2d ],
        [ sh:class fyo:GyrokineticsFluxesNl5d ;
            sh:description "5D fluxes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:fluxes_5d ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GyrokineticsFluxesNl4d ;
            sh:description "4D fluxes (time averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:fluxes_4d ],
        [ sh:class fyo:GyrokineticsFluxesNl4d ;
            sh:description "4D fluxes (time averaged) in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:fluxes_4d_rotating_frame ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if the non-linear fluxes are in fact calculated by a quasi-linear model, 0 if non-linear" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:quasi_linear ],
        [ sh:class fyo:GyrokineticsFluxesNl2dSumKx ;
            sh:description "2D fluxes (time and flux-surface averaged), summed over kx" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:fluxes_2d_k_x_sum ],
        [ sh:class fyo:GyrokineticsFluxesNl1d ;
            sh:description "1D fluxes (flux-surface and time averaged), summed over kx and ky" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:fluxes_1d ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal angle grid. The angle is defined with respect to (R0,Z0) with R0=(Rmax-Rmin)/2 and Z0=(Zmax-Zmin)/2. It is increasing clockwise. So (r,theta,phi) is right-handed. theta=0 for Z=Z0 and R>R0 (LFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:angle_pol ],
        [ sh:class fyo:GyrokineticsFieldsNl4d ;
            sh:description "4D fields" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:fields_4d ],
        [ sh:datatype xsd:float ;
            sh:description "normalized time of the gyrokinetic simulation" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time_norm ],
        [ sh:class fyo:GyrokineticsFluxesNl2dSumKxKy ;
            sh:description "2D fluxes (flux-surface averaged), summed over kx and ky in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path fyo:fluxes_2d_k_x_k_y_sum_rotating_frame ],
        [ sh:class fyo:GyrokineticsFieldsNl3d ;
            sh:description "3D fields (time averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:fields_intensity_3d ],
        [ sh:class fyo:GyrokineticsFluxesNl3dSumKx ;
            sh:description "3D fluxes (flux surface averaged, summed over kx)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:fluxes_3d_k_x_sum_rotating_frame ],
        [ sh:class fyo:GyrokineticsFluxesNl5d ;
            sh:description "5D fluxes in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:fluxes_5d_rotating_frame ],
        [ sh:class fyo:GyrokineticsFieldsNl1d ;
            sh:description "1D fields (summed over kx, time averaged and flux surface averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:fields_intensity_1d ],
        [ sh:class fyo:GyrokineticsFieldsNl2dFsAverage ;
            sh:description "2D fields (time averaged and flux surface averaged)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:fields_intensity_2d_surface_average ] ;
    sh:targetClass fyo:GyrokineticsNonLinear .

fyo:GyrokineticsSpecies a sh:NodeShape ;
    rdfs:comment "Set of species (including electrons) used in the calculation and related quantities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Effective potential energy determining the poloidal variation of the species background density" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:potential_energy_gradient_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized logarithmic gradient (with respect to r_minor_norm) of the density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:density_log_gradient_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized gradient (with respect to r_minor_norm) of the toroidal velocity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:velocity_phi_gradient_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:density_norm ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "normalized temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:temperature_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized mass" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:mass_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized logarithmic gradient (with respect to r_minor_norm) of the temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:temperature_log_gradient_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:charge_norm ],
        [ sh:datatype xsd:float ;
            sh:description "normalized gradient (with respect to r_minor_norm) of the effective potential energy" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:potential_energy_norm ] ;
    sh:targetClass fyo:GyrokineticsSpecies .

fyo:GyrokineticsWavevector a sh:NodeShape ;
    rdfs:comment "Set of wavevectors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GyrokineticsEigenmode ;
            sh:description "Set of eigenmode for this wavector" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:eigenmode ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "normalized radial component of the wavevector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:radial_wavevector_norm ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "normalized binormal component of the wavevector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:binormal_wavevector_norm ] ;
    sh:targetClass fyo:GyrokineticsWavevector .

fyo:HxrChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (detector or pixel of a camera)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:DetectorAperture ;
            sh:description "Detector description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:detector ],
        [ sh:datatype xsd:float ;
            sh:description "Etendue (geometric extent) of the channel's optical system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:etendue ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt2dValidity ;
            sh:description "Photons received by the detector per unit time, per unit solid angle and per unit area (i.e. photon flux divided by the etendue), in multiple energy bands if available from the detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:radiance ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight of the channel, given by 2 points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:line_of_sight ],
        [ sh:class spo:Identifier ;
            sh:description "Method used to calculate the etendue. Index = 0 : exact calculation with a 4D integral; 1 : approximation with first order formula (detector surface times solid angle subtended by the apertures); 2 : other methods" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:etendue_method ],
        [ sh:class fyo:DetectorEnergyBand ;
            sh:description "Set of energy bands in which photons are counted by the detector" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:energy_band ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:aperture ],
        [ sh:class fyo:FilterWindow ;
            sh:description "Set of filter windows" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:filter_window ] ;
    sh:targetClass fyo:HxrChannel .

fyo:HxrEmissivityProfile a sh:NodeShape ;
    rdfs:comment "Emissivity profile per energy band (assumed common to all channels used in the profile reconstruction)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "External (towards separatrix) half width of the emissivity peak (in normalized toroidal flux)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:half_width_external ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Radial profile of the plasma emissivity in this energy band" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:emissivity ],
        [ sh:datatype xsd:float ;
            sh:description "Internal (towards magnetic axis) half width of the emissivity peak (in normalized toroidal flux)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:half_width_internal ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the emissivity profile data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:float ;
            sh:description "Lower bound of the energy band" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:lower_bound ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate position at which the emissivity peaks" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:peak_position ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Upper bound of the energy band" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:upper_bound ] ;
    sh:targetClass fyo:HxrEmissivityProfile .

fyo:IcAntennasAntenna a sh:NodeShape ;
    rdfs:comment "Set of Ion Cyclotron antennas" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Power launched from this antenna into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:power_launched ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Forward power arriving to the back of the antenna" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:power_forward ],
        [ sh:class fyo:IcAntennasSurfaceCurrent ;
            sh:description "Description of the IC surface current on the antenna straps and on passive components, for every time slice" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:surface_current ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Reflected power" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:power_reflected ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:IcAntennasAntennaModule ;
            sh:description "Set of antenna modules (each module is fed by a single transmission line)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:module ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Frequency (average over modules)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:frequency ] ;
    sh:targetClass fyo:IcAntennasAntenna .

fyo:IcAntennasAntennaModule a sh:NodeShape ;
    rdfs:comment "Set of antenna modules (each module is fed by a single transmission line)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Power launched from this module into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:power_launched ],
