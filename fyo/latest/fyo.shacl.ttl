            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:datatype xsd:float ;
            sh:description "Quantum efficiency of the detector, i.e. conversion factor multiplying the number of counts to obtain the number of photons impacting the detector, tabulated as a function of the photon energy, for each pixel of the detector. If all pixels have the same quantum efficiency, just set the size of the first and second dimensions to 1" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:quantum_efficiency ],
        [ sh:class fyo:SignalFlt1dValidity ;
