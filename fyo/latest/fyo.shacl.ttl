            sh:path fyo:bins ],
        [ sh:datatype xsd:float ;
            sh:description "Probability to have a value of the quantity between bins(n) and bins(n+1) (thus the size of its second dimension is the size of the second dimension of the bins array - 1). The first dimension correspond to the first dimension of the original 2D quantity" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:probability ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
