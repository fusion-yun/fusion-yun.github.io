    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryLocalQuantities ;
            sh:description "Parameters at separatrix (intersection of the separatrix and the outboard midplane)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:separatrix ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummaryLocalQuantitiesNoPositionName ;
            sh:description "Parameters at the limiter tangency point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:limiter ],
        [ sh:class fyo:SummaryLocalQuantities ;
            sh:description "Parameters at pedestal top" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:pedestal ],
        [ sh:class fyo:SummaryLocalQuantitiesStellerator ;
            sh:description "Parameters at r_eff_norm = 2/3, where r_eff_norm is the stellarator effective minor radius normalized to its value at the last closed flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:r_eff_norm_2_3 ],
        [ sh:class fyo:SummaryLocalQuantities ;
            sh:description "Parameters at internal transport barrier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:itb ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryLocalQuantitiesRZ ;
            sh:description "Parameters at magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:magnetic_axis ],
        [ sh:class fyo:SummaryLocalQuantitiesNoPositionName ;
            sh:description "Parameters at a divertor target" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:divertor_target ],
        [ sh:class fyo:SummaryLocalQuantities ;
            sh:description "Flux surface averaged parameters at separatrix (flux-surface average over the entire core-SOL boundary separatrix)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:separatrix_average ] ;
    sh:targetClass fyo:SummaryLocal .

fyo:SummaryLocalPosition a sh:NodeShape ;
    rdfs:comment "Radial position at which physics quantities are evaluated" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate. rho_tor = sqrt(b_flux_tor/(pi*b0)) ~ sqrt(pi*r^2*b0/(pi*b0)) ~ r [m]. The toroidal field used in its definition is indicated under global_quantities/b0" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal magnetic flux" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation, see time_slice/boundary/b_flux_pol_norm in the equilibrium IDS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:rho_tor_norm ] ;
    sh:targetClass fyo:SummaryLocalPosition .

fyo:SummaryLocalPositionRZ a sh:NodeShape ;
    rdfs:comment "Radial position at which physics quantities are evaluated" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Height" ;
