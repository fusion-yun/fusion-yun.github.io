            sh:order 12 ;
            sh:path spo:version_put ],
        [ sh:class fyo:EquilibriumTimeSlice ;
            sh:description "Set of equilibria at various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:time_slice ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition and in the normalization of current densities)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
