            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:version_put ] ;
    sh:targetClass fyo:DatasetFair .

fyo:DeviceParameterOptimizationTask a sh:NodeShape ;
    rdfs:comment "A device-parameter optimization run (S-11). FUNCTION: search a declared design space of static device / configuration parameters θ_dev — coil currents and positions, geometry, heating mix — under steady-state or parameter-scan evaluation of the shared forward kernel, screening candidates for physics performance (target operating point reached) and engineering feasibility (limits, port-evaluated whole-machine quantities), and ranking them against declared objectives. Direction: outer search over designs; each candidate evaluation is a forward run (S-7-shaped) at fixed θ_dev. What is free here is the MACHINE ITSELF (design-phase lifecycle: the physical counterpart may not yet exist — design work counts as twin work from the start). Whole-machine engineering quantities enter ONLY via EngineeringPortRun (in/port/out boundary); the candidate-design OUTPUT is directive — a DesignSpecification prescribing a Machine, the as-designed stance, not a description of any existing device." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:ForwardOperator ;
            sh:description "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:uses_forward_operator ],
        [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "INPUT — the engineering-limit set used for feasibility screening (shared with S-10; see EngineeringLimitSet in the discharge_design module)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:engineering_limits ],
        [ sh:class fyo:EngineeringPortRun ;
            sh:description "Engineering-port runs this task delegates single-direction engineering quantities to (the \"经端口\" tier of the in/port/out boundary, FYTOK-ADR-119 D3)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:port_runs ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class fyo:ConvergenceCriterion ;
            sh:description "The explicit convergence criterion of this task's scenario loop — a configurable modeling decision (e.g. psi-residual RMS threshold + iteration cap), never an implicit solver internal (enabling-core goal G-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:converges_by ],
        [ sh:class fyo:DesignSpaceSpecification ;
            sh:description "INPUT — the declared design space (which parameters are free, their bounds and couplings)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:design_space ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — port-evaluated whole-machine engineering quantities of candidates (first port: neutronics — source from fusion source terms, geometry from wall / coil carriers), landed in existing DD carriers per the ADR-126 contract." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:engineering_evaluations ],
        [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "INPUT — the optimization objectives / figures of merit (target operating point, performance measures, margins) candidates are ranked by." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:objectives ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_output ],
        [ sh:datatype xsd:string ;
            sh:description "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:free_variables ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_input ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:performed_on ],
        [ sh:class spo:DesignSpecification ;
            sh:description "OUTPUT (principal) — the selected / optimized device parameter set as a DIRECTIVE design specification (as-designed stance: it prescribes a Machine — which may not yet exist — and is truth-evaluated by nothing; the later as-built description may disagree with it)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:candidate_design ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:consumes_ids ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:produces_ids ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the evaluated operating points of surviving candidates (equilibrium + profiles + global performance summary per candidate); modality simulated; the evidence base of the ranking." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:operating_point_evaluations ],
        [ sh:class fyo:MachineDescription ;
            sh:description "INPUT (optional) — a reference machine description the search starts from or is constrained around (retrofit / variation studies on an existing device)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:reference_design ],
        [ sh:class fyo:ScenarioSpecification ;
            sh:description "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ] ;
    sh:targetClass fyo:DeviceParameterOptimizationTask .

fyo:Discharge a sh:NodeShape ;
    rdfs:comment "A tokamak discharge (shot / pulse) — the planned experimental process realizing a pulse-schedule PlanSpecification on a Machine, during which one Plasma exists and MeasurementProcesses run. An unrepeatable spatiotemporal particular: what a data system keeps of it is its record (spo ProcessRecord; the populated IDS set of a pulse), never the discharge itself." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "This planned process realizes a plan / specification — a pulse_schedule for a discharge, or a Code (the program text) for a ComputationalProcess (program = GDC, run = Process, result = ICE output)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:performed_on ] ;
    sh:targetClass fyo:Discharge .

fyo:DischargeOperationDesignTask a sh:NodeShape ;
    rdfs:comment "A discharge-operation design run (S-10). FUNCTION: before the experiment, optimize the feedforward actuator trajectory over the WHOLE discharge time sequence — breakdown, ramp-up, flat-top, ramp-down, termination — as a control-vector-parameterization (CVP) problem over the shared forward kernel, while verifying that every candidate stays within the per-channel engineering limits (per-coil current / voltage / stored energy / temperature rise / forces / wall heat load). Direction: feedforward / pre-shot; free variables are the actuator waveforms u(t) over the full pulse. Distinct from S-9 by the absence of feedback: nothing reacts, everything is planned. The pulse-schedule OUTPUT is directive — it PRESCRIBES a future Discharge (the discharge realizes it), unlike the descriptive outputs of S-7/S-8." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EngineeringLimitSet ;
            sh:description "The engineering-limit set this design run verifies its candidate trajectories against — limit verification is part of the task's FUNCTION, not an afterthought (a design that the coil set and power supplies cannot realize without exceeding limits is not a design)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:checked_against ],
        [ sh:class fyo:ConvergenceCriterion ;
            sh:description "The explicit convergence criterion of this task's scenario loop — a configurable modeling decision (e.g. psi-residual RMS threshold + iteration cap), never an implicit solver internal (enabling-core goal G-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:converges_by ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class fyo:EngineeringPortRun ;
            sh:description "Engineering-port runs this task delegates single-direction engineering quantities to (the \"经端口\" tier of the in/port/out boundary, FYTOK-ADR-119 D3)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:port_runs ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:consumes_ids ],
        [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "INPUT — the discharge design goals (target plasma current / shape / density / stored-energy waypoints, flat-top duration, …) the trajectory must reach." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:design_targets ],
        [ sh:class fyo:IDS ;
            sh:description "INPUT (optional) — an initial pulse-schedule guess (e.g. a scaled reference shot) seeding the optimization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:initial_guess ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:produces_ids ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_input ],
        [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "OUTPUT — the engineering-limit verification report: per-channel margins of the designed trajectory against the EngineeringLimitSet (which limit, where in the pulse, how close)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:limit_verification_report ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the predicted plasma trajectory under the designed schedule (equilibrium + profiles over the pulse); modality simulated; the evidence the design decision rests on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:predicted_trajectory ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:performed_on ],
        [ sh:datatype xsd:string ;
            sh:description "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:free_variables ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_output ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT (principal) — the designed feedforward pulse schedule: reference waveforms / setpoints for all actuators over the full discharge. A directive ICE (spo PlanSpecification nature): the future Discharge realizes it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:designed_pulse_schedule ],
        [ sh:class fyo:ScenarioSpecification ;
            sh:description "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class fyo:MachineDescription ;
            sh:description "INPUT — static machine description (coil set, circuits, power supplies, wall) the design must be realizable on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:machine_description ],
        [ sh:class fyo:ForwardOperator ;
            sh:description "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:uses_forward_operator ] ;
    sh:targetClass fyo:DischargeOperationDesignTask .

fyo:Disruption a sh:NodeShape ;
    rdfs:comment "Description of physics quantities of specific interest during a disruption, in particular halo currents, etc ..." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:version_put ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:generatedAtTime ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:generated_by_process ],
        [ sh:class fyo:DisruptionGlobalQuantities ;
            sh:description "Global quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:global_quantities ],
        [ sh:class fyo:DisruptionHaloCurrents ;
            sh:description "Halo currents geometry and values for a set of time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:halo_currents ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path spo:modality ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition and in the normalization of current densities)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:DisruptionProfiles1d ;
            sh:description "Radial profiles for a set of time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:profiles_1d ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ] ;
    sh:targetClass fyo:Disruption .

fyo:DistributionSources a sh:NodeShape ;
    rdfs:comment "Sources of particles for input to kinetic equations, e.g. Fokker-Planck calculation. The sources could originate from e.g. NBI or fusion reactions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:reproducible ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:version_put ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path spo:modality ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:generated_by_process ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:class fyo:DistributionSourcesSource ;
            sh:description "Set of source/sink terms. A source/sink term corresponds to the particle source due to an NBI injection unit, a nuclear reaction or any combination of them (described in \"identifier\")" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:class fyo:Rz1dDynamic1 ;
            sh:description "Magnetic axis position (used to define a poloidal angle for the 2D profiles)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:magnetic_axis ] ;
    sh:targetClass fyo:DistributionSources .

fyo:Distributions a sh:NodeShape ;
    rdfs:comment "Distribution function(s) of one or many particle species. This structure is specifically designed to handle non-Maxwellian distribution function generated during heating and current drive, typically solved using a Fokker-Planck calculation perturbed by a heating scheme (e.g. IC, EC, LH, NBI, or alpha heating) and then relaxed by Coloumb collisions." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path spo:modality ],
        [ sh:class fyo:Rz1dDynamic1 ;
            sh:description "Magnetic axis position (used to define a poloidal angle for the 2D profiles)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:magnetic_axis ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:DistributionsD ;
            sh:description "Set of distribution functions. Every distribution function has to be associated with only one particle species, specified in distri_vec/species/, but there could be multiple distribution function for each species. In this case, the fast particle populations should be superposed" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:distribution ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in rho_tor definition and in the normalization of current densities)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:vacuum_toroidal_field ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:generated_by_process ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:reproducible ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:version_put ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:Distributions .

fyo:Divertors a sh:NodeShape ;
    rdfs:comment "Description of divertors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:reproducible ],
        [ sh:class spo:Identifier ;
            sh:description "Choice of midplane definition (use the lowest index number if more than one value is relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:midplane ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
