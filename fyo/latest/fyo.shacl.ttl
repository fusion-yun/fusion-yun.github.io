            sh:order 1 ;
            sh:path fyo:diamagnetic ] ;
    sh:targetClass fyo:CoreProfilesVectorComponents2 .

fyo:CoreProfilesVectorComponents3 a sh:NodeShape ;
    rdfs:comment "Velocity at the position of maximum major radius on every flux surface" ;
