            sh:order 2 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:LangmuirProbesMultiTemperature .

fyo:LangmuirProbesPlunge a sh:NodeShape ;
    rdfs:comment "Set of plunges of this probe during the pulse, each plunge being recorded as a time slice from the Access Layer point of view. The time child node corresponds to the time of maximum penetration of the probe during a given plunge. The dynamics of physical quantities within the plunge are described via the time_within_plunge vector." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Ion temperature (upstream to downstream average)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:t_i_average ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Distance in the z direction of the measurement position to the closest X-point (Zmeasurement-Zx_point)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:distance_x_point_z ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Time of maximum penetration of the probe during a given plunge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:time ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Electron temperature (upstream to downstream average)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:t_e_average ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Distance between the measurement position and the separatrix, mapped along flux surfaces to the outboard midplane, in the major radius direction. Positive value means the measurement is outside of the separatrix." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:distance_separatrix_midplane ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Incident angle of the magnetic field with respect to PFC surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:b_field_angle ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Plasma potential" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:v_plasma ],
        [ sh:class fyo:LangmuirProbesPositionReciprocating ;
            sh:description "Average position of the measurements derived from multiple collectors" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:position_average ],
        [ sh:class fyo:LangmuirProbesPlungeCollector ;
            sh:description "Set of probe collectors including measurements specific to each collector. The number of collectors (size of this array of structure) is assumed to remain constant for all plunges" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:collector ],
        [ sh:datatype xsd:float ;
            sh:description "Time vector for describing the dynamics within the plunge" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:time_within_plunge ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Parallel Mach number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:mach_number_parallel ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity ;
            sh:description "Electron density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_e ] ;
    sh:targetClass fyo:LangmuirProbesPlunge .

fyo:LangmuirProbesPlungeCollector a sh:NodeShape ;
    rdfs:comment "Set of probe collectors including measurements specific to each collector. The number of collectors (size of this array of structure) is assumed to remain constant for all plunges" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:LangmuirProbesPlungePhysicalQuantity2 ;
            sh:description "Standard deviation of the ion saturation current density, corresponding to the fluctuations of the quantity over time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
