            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:zeff ],
        [ sh:class fyo:SummarySpecies ;
            sh:description "Ion density per species" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:n_i ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Magnetic shear, defined as rho_tor/q . dq/drho_tor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:magnetic_shear ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Electron density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:n_e ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Electron temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:t_e ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:SummaryLocalQuantitiesRZ .

fyo:SummaryLocalQuantitiesStellerator a sh:NodeShape ;
    rdfs:comment "Parameters at r_eff_norm = 2/3, where r_eff_norm is the stellarator effective minor radius normalized to its value at the last closed flux surface" ;
    sh:closed true ;
