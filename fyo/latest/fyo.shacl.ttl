fyo:PulseSchedulePfActiveCoil a sh:NodeShape ;
    rdfs:comment "Set of poloidal field coils" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PulseScheduleReferencePfActive ;
            sh:description "Additional resistance due to e.g. dynamically switchable resistors" ;
