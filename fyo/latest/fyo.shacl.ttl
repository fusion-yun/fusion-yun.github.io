fyo:GenericGridConstantGridSubsetElement a sh:NodeShape ;
    rdfs:comment "Set of elements defining the grid subset. An element is defined by a combination of objects from potentially all spaces" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
