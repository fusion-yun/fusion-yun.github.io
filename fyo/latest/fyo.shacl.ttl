            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:counter_passing ],
        [ sh:datatype xsd:float ;
            sh:description "Total toroidal driven current density (including electron and thermal ion back-current, or drag-current)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:current_phi ],
        [ sh:class fyo:DistributionsDProfiles2dGrid ;
