            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Inverse curvature radii for the phase ellipse, positive/negative for divergent/convergent beams, in the horizontal direction (first index of the first coordinate) and in the vertical direction (second index of the first coordinate)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:curvature ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation angle for the phase ellipse" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
