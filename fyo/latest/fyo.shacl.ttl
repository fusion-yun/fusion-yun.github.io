fyo:MachineSubsystem a sh:NodeShape ;
    rdfs:comment "Abstract parent of a Machine's first-class material sub-systems (coil systems, vacuum vessel, cryostat, ports, …). SP-ONT-APP-MACHINE." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:occupies ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ] ;
    sh:targetClass fyo:MachineSubsystem .

fyo:MagneticsBpolProbe a sh:NodeShape ;
    rdfs:comment "Poloidal field probes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Indices (from the b_field_pol_probe array of structure) of the two probes used to build the field difference field(second index) - field(first index). Use only if ../type/index = 6, leave empty otherwise" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:indices_differential ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Magnetic field component in direction of sensor normal axis (n) averaged over sensor volume defined by area and length, where n = cos(poloidal_angle)*cos(toroidal_angle)*grad(R) - sin(poloidal_angle)*grad(Z) + cos(poloidal_angle)*sin(toroidal_angle)*grad(Phi)/norm(grad(Phi))" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:field ],
        [ sh:datatype xsd:float ;
            sh:description "Angle of the projection of the sensor normal vector (n) in the horizontal plane with the increasing R direction (i.e. grad(R)) (angle is counter-clockwise from above). Values should be taken modulo pi with values within (-pi/2,pi/2]. Zero if projected sensor normal is parallel to grad(R), pi/2 if it is parallel to grad(phi)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:toroidal_angle ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Area of each turn of the sensor; becomes effective area when multiplied by the turns" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:area ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Voltage on the coil terminals" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:voltage ],
        [ sh:datatype xsd:integer ;
            sh:description "Turns in the coil, including sign" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:turns ],
        [ sh:datatype xsd:float ;
            sh:description "Angle of the sensor normal vector (vector parallel to the the axis of the coil, n on the diagram) with respect to horizontal plane (clockwise theta-like angle). Zero if sensor normal vector fully in the horizontal plane and oriented towards increasing major radius. Values in [0 , 2Pi]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:poloidal_angle ],
        [ sh:class spo:Identifier ;
            sh:description "Probe type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the sensor along it's normal vector (n)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:length ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "R, Z, Phi position of the coil centre" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:position ],
        [ sh:class fyo:MagneticsBpolProbeNonLinear ;
            sh:description "Non-linear response of the probe (typically in case of a Hall probe)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:non_linear_response ],
        [ sh:datatype xsd:float ;
            sh:description "3dB bandwith (first index : lower frequency bound, second index : upper frequency bound)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:bandwidth_3db ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:MagneticsBpolProbe .

fyo:MagneticsMethodDistinct a sh:NodeShape ;
    rdfs:comment "Plasma current. Positive sign means anti-clockwise when viewed from above. The array of structure corresponds to a set of calculation methods (starting with the generally recommended method)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the calculation method" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:method_name ] ;
    sh:targetClass fyo:MagneticsMethodDistinct .

fyo:MhdCoordinateSystem a sh:NodeShape ;
    rdfs:comment "Flux surface coordinate system of the equilibrium used for the MHD calculation on a square grid of flux and poloidal angle" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the major radius on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Absolute value of the jacobian of the coordinate system" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:jacobian ],
        [ sh:datatype xsd:float ;
            sh:description "Covariant metric tensor on every point of the grid described by grid_type" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:tensor_covariant ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the Height on the grid" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Contravariant metric tensor on every point of the grid described by grid_type" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:tensor_contravariant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:MhdCoordinateSystem .

fyo:NeutronDiagnosticEvent a sh:NodeShape ;
    rdfs:comment "5th dimension for the neutron_flux Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
