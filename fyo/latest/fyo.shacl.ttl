        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:time ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the vacuum magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:b_field_tor ],
        [ sh:class fyo:GenericGridScalar ;
