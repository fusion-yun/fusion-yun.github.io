            sh:order 6 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:WavesCoherentWaveFullWaveBField ;
            sh:description "Components of the wave magnetic field, , represented as Fourier coefficients B(n_tor,frequency) such that the electric is equal to real(B(n_tor,frequency).exp(i(n_tor.phi - 2.pi.frequency.t)))" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
