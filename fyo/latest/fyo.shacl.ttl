        [ sh:datatype xsd:float ;
            sh:description "Number of molecules of the propellant gas injected in the vacuum vessel when launching the pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:molecules_n ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the neutral molecule (e.g. H2, D2, T2, N2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PelletsPropellantGas .

fyo:PelletsTimeSlice a sh:NodeShape ;
    rdfs:comment "Description of the pellets launched at various time slices. The time of this structure corresponds to the full ablation of the pellet inside the plasma." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ],
        [ sh:class fyo:PelletsTimeSlicePellet ;
            sh:description "Set of pellets ablated in the plasma at a given time" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:pellet ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ] ;
    sh:targetClass fyo:PelletsTimeSlice .

fyo:PelletsTimeSlicePellet a sh:NodeShape ;
    rdfs:comment "Set of pellets ablated in the plasma at a given time" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PelletsTimeSlicePelletSpecies ;
            sh:description "Set of atomic species included in the pellet composition" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:species ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:LineOfSight2pointsDynamicAos3 ;
            sh:description "Geometry of the pellet path in the vaccuum chamber" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:path_geometry ],
        [ sh:datatype xsd:float ;
            sh:description "Initial velocity of the pellet as it enters the vaccum chamber" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:velocity_initial ],
        [ sh:class fyo:PelletsTimeSlicePelletPathProfiles ;
            sh:description "1-D profiles of plasma and pellet along the pellet path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:path_profiles ],
        [ sh:class fyo:PelletsPropellantGas ;
            sh:description "Propellant gas" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:propellant_gas ],
        [ sh:class fyo:PelletsTimeSlicePelletShape ;
            sh:description "Initial shape of a pellet at launch" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:shape ] ;
    sh:targetClass fyo:PelletsTimeSlicePellet .

fyo:PelletsTimeSlicePelletPathProfiles a sh:NodeShape ;
    rdfs:comment "1-D profiles of plasma and pellet along the pellet path" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Distance along the pellet path, with the origin taken at path_geometry/first_point. Used as the main coordinate for the path_profiles structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:distance ],
        [ sh:class fyo:Rphiz1dDynamicAos3 ;
            sh:description "Position along the pellet path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:position ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Ablation rate (electrons) along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:ablation_rate ],
        [ sh:datatype xsd:float ;
            sh:description "Pellet velocity along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:velocity ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:t_e ],
        [ sh:datatype xsd:float ;
            sh:description "Difference to due ExB drifts between the ablation and the final deposition locations, in terms of the normalized toroidal flux coordinate" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:rho_tor_norm_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Number of ablated particles (electrons) along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:ablated_particles ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal flux along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal coordinate along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Electron density along the pellet path" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:n_e ] ;
    sh:targetClass fyo:PelletsTimeSlicePelletPathProfiles .

fyo:PelletsTimeSlicePelletShape a sh:NodeShape ;
    rdfs:comment "Initial shape of a pellet at launch" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Size of the pellet in the various dimensions, depending on the shape type. Spherical pellets: size(1) is the radius of the pellet. Cylindrical pellets: size(1) is the radius and size(2) is the height of the cylinder. Rectangular pellets: size(1) is the height, size(2) is the width and size(3) is the length" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:size ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier structure for the shape type: 1-spherical; 2-cylindrical; 3-rectangular" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PelletsTimeSlicePelletShape .

fyo:PelletsTimeSlicePelletSpecies a sh:NodeShape ;
    rdfs:comment "Set of atomic species included in the pellet composition" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Atomic fraction of the species in the pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:fraction ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Material density of the species in the pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:float ;
            sh:description "Sublimation energy per atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:sublimation_energy ] ;
    sh:targetClass fyo:PelletsTimeSlicePelletSpecies .

fyo:PfCircuits a sh:NodeShape ;
    rdfs:comment "Circuits, connecting multiple PF coils to multiple supplies, defining the current and voltage relationships in the system" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Description of the supplies and coils connections (nodes) across the circuit. Nodes of the circuit are listed as the first dimension of the matrix. Supplies (listed first) and coils (listed second) are listed as the second dimension. Thus the second dimension has a size equal to (N_supplies+N_coils). N_supplies (resp. N_coils) is the total number of supplies (resp. coils) listed in the supply (resp.coil) array of structure, i.e. including also supplies/coils that are not part of the actual circuit. The (i,j) matrix elements are 1 if the j-th supply or coil side is connected to the i-th node by its positive side, -1 if connected by its negative side, or 0 if not connected." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:connections ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage on the circuit between the sides of the group of supplies (only for circuits with a single supply or in which supplies are grouped)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:voltage ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Type of the circuit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Current in the circuit between the sides of the group of supplies (only for circuits with a single supply or in which supplies are grouped)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:PfCircuits .

fyo:PfCoils a sh:NodeShape ;
    rdfs:comment "Active PF coils" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Radial force applied on this coil (positive when outwards)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:force_radial ],
        [ sh:datatype xsd:float ;
            sh:description "List of values of the conductor temperature (coordinate for current_limit_max)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:temperature ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Current fed in the coil (for 1 turn, to be multiplied by the number of turns to obtain the generated magnetic field), positive when the current is counter-clockwise when seen from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:current ],
        [ sh:class fyo:PfCoilsElements ;
            sh:description "Each PF coil is comprised of a number of cross-section elements described  individually and connected serially" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Coil resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:resistance ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Cross-sectional shape of the coil" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:geometry ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Radial crushing force applied on this coil (positive when compressive)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:force_radial_crushing ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Vertical crushing force applied on this coil (positive when compressive)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:force_vertical_crushing ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum tolerable current in the conductor" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:current_limit_max ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Energy to be dissipated in the coil" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:energy_limit_max ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Maximum absolute value of the magnetic field on the conductor surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:b_field_max_timed ],
        [ sh:class spo:Identifier ;
            sh:description "Set of functions for which this coil may be used" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:function ],
        [ sh:datatype xsd:float ;
            sh:description "List of values of the maximum magnetic field on the conductor surface (coordinate for current_limit_max)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:b_field_max ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Vertical force applied on this coil (positive when upwards)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:force_vertical ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Additional resistance due to e.g. dynamically switchable resistors. The coil effective resistance is obtained by adding this dynamic quantity to the static resistance of the coil." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:resistance_additional ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage on the coil terminals (Vside1-Vside2) - including additional resistors if any" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:voltage ] ;
    sh:targetClass fyo:PfCoils .

fyo:PfForceLimits a sh:NodeShape ;
    rdfs:comment "Description of force limits on the axisymmetric PF coil system" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Force (positive when upwards for a vertical force, positive when outwards for a radial force)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:force ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum force limit, for each limit (line of the combination matrix). EMPTY_FLT value means unbounded" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:limit_max ],
        [ sh:datatype xsd:float ;
            sh:description "Force limits are expressed as a linear combination of the forces on each individual coil. The weights of the linear combination are given by this matrix, while the limits are given by the sibling nodes limit_min and limit_max. Each row of this matrix corresponds to a force limit. The columns represent, for each coil, the 4 types of forces on the coil namely [coil1_radial, coil1_vertical, coil1_radial_crush, coil1_vertical_crush, coil2_radial, coil2_vertical, coil2_radial_crush, coil2_vertical_crush, ...]. There are therefore 4*coils_n columns." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:combination_matrix ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum force limit, for each limit (line of the combination matrix). EMPTY_FLT value means unbounded" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:limit_min ] ;
    sh:targetClass fyo:PfForceLimits .

fyo:PfPassiveLoops a sh:NodeShape ;
    rdfs:comment "Passive axisymmetric conductor description in the form of non-connected loops; any connected loops are expressed as active coil circuits with no power supply attached." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Passive loop current" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes of this loop located at this level of the IDS structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:class fyo:PfCoilsElements ;
            sh:description "Each loop is comprised of a number of cross-section elements described  individually" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:float ;
            sh:description "Passive loop resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:resistance ],
        [ sh:datatype xsd:float ;
            sh:description "Passive loop resistivity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:resistivity ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PfPassiveLoops .

fyo:PfPlasmaElement a sh:NodeShape ;
    rdfs:comment "Set of plasma elements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes located at this level of the IDS structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Cross-sectional area of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Current in the plasma element" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:current ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Outline2dGeometryStatic ;
            sh:description "Cross-sectional shape of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:geometry ] ;
    sh:targetClass fyo:PfPlasmaElement .

fyo:PfSupplies a sh:NodeShape ;
    rdfs:comment "PF power supplies" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Current at the supply output, defined positive if it flows from point 1 to point 2 in the circuit connected to the supply (outside the supply)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum voltage from the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:voltage_limit_min ],
        [ sh:datatype xsd:float ;
            sh:description "Power supply internal resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:resistance ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum energy to be dissipated in the supply during a pulse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:energy_limit_max ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum current in the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:current_limit_max ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum current in the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:current_limit_min ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the nonlinear transfer function of the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:nonlinear_model ],
        [ sh:datatype xsd:float ;
            sh:description "Gain to prevent overcurrent in a linear model of the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:current_limiter_gain ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum voltage from the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:voltage_limit_max ],
        [ sh:datatype xsd:integer ;
            sh:description "Type of the supply; TBD add free description of non-linear power supplies" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficients of the denominator, in increasing order : b0 + b1*s + ... + bm*s^m; used for a linear supply description" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:filter_denominator ],
        [ sh:datatype xsd:float ;
            sh:description "Pure delay in the supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:delay ],
        [ sh:datatype xsd:float ;
            sh:description "Coefficients of the numerator, in increasing order : a0 + a1*s + ... + an*s^n; used for a linear supply description" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:filter_numerator ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage at the supply output (Vside1-Vside2)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:voltage ] ;
    sh:targetClass fyo:PfSupplies .

fyo:PlasmaCompositionIonStateConstant a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle (z_min = z_max = 0 for a neutral)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:electron_configuration ] ;
    sh:targetClass fyo:PlasmaCompositionIonStateConstant .

fyo:PlasmaCompositionIonsConstant a sh:NodeShape ;
    rdfs:comment "Description of the ion or neutral species, used if type/index = 2 or 3" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionization state; lumped ions are allowed)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H+, D+, T+, He+2, C+, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:class fyo:PlasmaCompositionIonStateConstant ;
            sh:description "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PlasmaCompositionIonsConstant .

fyo:PlasmaCompositionNeutralConstant a sh:NodeShape ;
    rdfs:comment "Description of the neutral species, used if type/index = 4 or 5" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaCompositionNeutralStateConstant ;
            sh:description "State of the species (energy, excitation, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying neutral (e.g. H, D, T, He, C, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PlasmaCompositionNeutralConstant .

fyo:PlasmaCompositionNeutralStateConstant a sh:NodeShape ;
    rdfs:comment "State of the species (energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Neutral type, in terms of energy. ID =1: cold; 2: thermal; 3: fast; 4: NBI" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:neutral_type ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying neutral state" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:vibrational_mode ] ;
    sh:targetClass fyo:PlasmaCompositionNeutralStateConstant .

fyo:PlasmaCompositionSpecies a sh:NodeShape ;
    rdfs:comment "Injected species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:PlasmaCompositionSpecies .

fyo:PlasmaInitiationFieldLines a sh:NodeShape ;
    rdfs:comment "Magnetic field line tracing results, given at various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:class fyo:Rz1dDynamicAos ;
            sh:description "List of all R, Z positions along all field lines encoutering Townsend condition or being closed field lines" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:townsend_or_closed_positions ],
        [ sh:datatype xsd:float ;
            sh:description "Townsend electric field along each field line" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:e_field_townsend ],
        [ sh:class fyo:Rz1dDynamicAos ;
            sh:description "Starting position to initiate field line tracing, for each field line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:starting_positions ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Length of each field line" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:lengths ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Fraction of open field lines : ratio open fields lines / (open+closed field lines)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:open_fraction ],
        [ sh:datatype xsd:float ;
            sh:description "Prefill gas pressure used in Townsend E field calculation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path spo:slice_of ],
        [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class fyo:Rz1dDynamicAos ;
            sh:description "List of all R, Z grid positions (from ../grid) containing field lines encoutering Townsend condition or being closed field lines" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:townsend_or_closed_grid_positions ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel electric field along each field line" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:e_field_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:PlasmaInitiationFieldLines .

fyo:PlasmaInitiationGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Global quantities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Coulomb logarithm" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:coulomb_logarithm ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged electron density (average over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:n_e_volume_average ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Stray magnetic field at plasma position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:b_field_stray ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Perpendicular magnetic field at plasma position. b_field_perpendicular = sqrt(b_field_stray^2+b_field_eddy^2)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:b_field_perpendicular ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:ip ],
        [ sh:class fyo:PlasmaInitiationGlobalQuantitiesIon ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:ion ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Average length of open magnetic field lines. In the case of fully closed field lines, connection_length = 1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:connection_length ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged electron temperature (average over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:t_e_volume_average ],
        [ sh:class fyo:PlasmaInitiationGlobalQuantitiesNeutral ;
            sh:description "Quantities related to the different neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:neutral ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PlasmaInitiationGlobalQuantities .

fyo:PlasmaInitiationGlobalQuantitiesIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H+, D+, T+, He+2, C+, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged temperature of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:t_i_volume_average ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged density of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_i_volume_average ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Ion charge (of the dominant ionization state; lumped ions are allowed), volume averaged over plasma radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding neutral species in the ../../neutral array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutral_index ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:PlasmaInitiationGlobalQuantitiesIon .

fyo:PlasmaInitiationGlobalQuantitiesNeutral a sh:NodeShape ;
    rdfs:comment "Quantities related to the different neutral species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged density of this neutral species (averaged over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:density_volume_average ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Volume averaged temperature of this neutral species (averaged over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:temperature_volume_average ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding neutral species in the ../../ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:ion_index ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, He, C, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:PlasmaInitiationGlobalQuantitiesNeutral .

fyo:PlasmaInitiationProfiles2d a sh:NodeShape ;
    rdfs:comment "2D profiles in the poloidal plane, given at various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the electric field" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:e_field_phi ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:PlasmaInitiationProfiles2d .

fyo:PlasmaProfiles2dIon a sh:NodeShape ;
    rdfs:comment "2D quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionisation states (or other types of states) must be differentiated at the state level below. This array doesn't necessarily have the same size as the profiles_1d/ion array, since 2D data may be relevant only for a subset of ion species." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only the 'ion' level is considered and the 'state' array of structure is empty; 1-Ion states are considered and are described in the 'state' array of structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:density ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency  (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken) (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H, D, T, He, C, D2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:class fyo:PlasmaProfiles2dVectorComponents2 ;
            sh:description "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:velocity ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure ],
        [ sh:class fyo:PlasmaProfiles2dIonState ;
            sh:description "Quantities related to the different states of the species (ionisation, energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionisation state; lumped ions are allowed), volume averaged over plasma radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding ion species in the ../../../profiles_1d/ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:ion_index ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_thermal ] ;
    sh:targetClass fyo:PlasmaProfiles2dIon .

fyo:PlasmaProfiles2dIonState a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (ionisation, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z of the charge state bundle, volume averaged over the plasma radius (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_average ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Cumulative and average ionisation potential to reach a given bundle. Defined as sum (x_z* (sum of Epot from z'=0 to z-1)), where Epot is the ionisation potential of ion Xz’+, and x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:ionisation_potential ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z square of the charge state bundle, volume averaged over the plasma radius (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z_square_average ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:vibrational_level ] ;
    sh:targetClass fyo:PlasmaProfiles2dIonState .

fyo:PlasmaProfiles2dVectorComponents2 a sh:NodeShape ;
    rdfs:comment "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Parallel component" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:parallel ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal component" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:poloidal ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:toroidal ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Radial component" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:radial ],
        [ sh:datatype xsd:float ;
            sh:description "Diamagnetic component" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:diamagnetic ] ;
    sh:targetClass fyo:PlasmaProfiles2dVectorComponents2 .

fyo:PlasmaProfilesGgdFastElectrons a sh:NodeShape ;
    rdfs:comment "Quantities related to the electrons" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Temperature, given at various positions (grid subset of size 1)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:temperature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Density (thermal+non-thermal), given at various positions (grid subset of size 1)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:density ] ;
    sh:targetClass fyo:PlasmaProfilesGgdFastElectrons .

fyo:PlasmaProfilesGgdFastIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Particle content = total number of particles for this ion species in the volume of the grid subset, for various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:content ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionisation state; lumped ions are allowed)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Density (thermal+non-thermal) (sum over states when multiple states are considered), given at various positions (grid subset of size 1)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H+, D+, T+, He+2, C+, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding neutral species in the ../../neutral array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutral_index ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:class fyo:GenericGridScalarSinglePosition ;
            sh:description "Temperature (average over states when multiple states are considered), given at various positions (grid subset of size 1)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:temperature ] ;
    sh:targetClass fyo:PlasmaProfilesGgdFastIon .

fyo:PlasmaProfilesGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Various global quantities derived from the profiles" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged electron temperature (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:t_e_volume_average ],
        [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged over ion species and states) peaking factor, defined as the Ti value at the magnetic axis divided by the volume averaged Ti (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:t_i_average_peaking ],
        [ sh:datatype xsd:float ;
            sh:description "Bootstrap current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:current_bootstrap ],
        [ sh:datatype xsd:float ;
            sh:description "Normalised toroidal beta, defined as 100 * beta_tor * a[m] * B0 [T] / ip [MA]" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:beta_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Total non-inductive current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:current_non_inductive ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal beta, defined as the volume-averaged total perpendicular pressure divided by (B0^2/(2*mu0)), i.e. beta_toroidal = 2 mu0 int(p dV) / V / B0^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:beta_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Volume average plasma effective charge, estimated from the flux consumption in the ohmic phase" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:z_eff_resistive ],
        [ sh:class fyo:PlasmaProfilesGlobalQuantitiesIon ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. The set of ion species of this array must be the same as the one defined in profiles_1d/ion, at the time slice indicated in ion_time_slice" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:float ;
            sh:description "Ejima coefficient : resistive psi losses divided by (mu0*R*Ip). See S. Ejima et al, Nuclear Fusion, Vol.22, No.10 (1982), 1313" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:ejima ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:ip ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal beta. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:beta_pol ],
        [ sh:datatype xsd:float ;
            sh:description "Internal inductance. The li_3 definition is used, i.e. li_3 = 2/R0/mu0^2/Ip^2 * int(Bp^2 dV)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:li_3 ],
        [ sh:datatype xsd:float ;
            sh:description "Time slice of the profiles_1d array used to define the ion composition of the global_quantities/ion array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:ion_time_slice ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged electron density (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:n_e_volume_average ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature peaking factor, defined as the Te value at the magnetic axis divided by the volume averaged Te (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:t_e_peaking ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma energy content = 3/2 * integral over the plasma volume of the total perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:energy_diamagnetic ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Resistive part of the poloidal flux losses, defined as the volume-averaged scalar product of the electric field and the ohmic current density, normalized by the plasma current and integrated in time from the beginning of the plasma discharge: int ( (int(E_field_phi.j_ohm_phi) dV) / Ip ) dt)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:resistive_psi_losses ],
        [ sh:datatype xsd:float ;
            sh:description "LCFS loop voltage (positive value drives positive ohmic current that flows anti-clockwise when viewed from above)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:v_loop ] ;
    sh:targetClass fyo:PlasmaProfilesGlobalQuantities .

fyo:PlasmaProfilesGlobalQuantitiesIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. The set of ion species of this array must be the same as the one defined in profiles_1d/ion, at the time slice indicated in ion_time_slice" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Volume averaged density of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_i_volume_average ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged temperature of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:t_i_volume_average ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PlasmaProfilesGlobalQuantitiesIon .

fyo:PlasmaProfilesProfiles1dElectrons a sh:NodeShape ;
    rdfs:comment "Quantities related to the electrons" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the density profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:density_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Collisionality normalised to the bounce frequency" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:collisionality_norm ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the temperature profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:temperature_validity ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the density profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:density_validity ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the temperature profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:temperature_fit ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1dElectrons .

fyo:PlasmaProfilesProfiles1dIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionisation states (and other types of states) must be differentiated at the state level below" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the density profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:density_validity ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Average charge of the ion species (sum of states charge weighted by state density and divided by ion density)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:z_ion_1d ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the density profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:density_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:density ],
        [ sh:class fyo:PlasmaProfilesProfiles1dIonState ;
            sh:description "Quantities related to the different states of the species (ionisation, energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionisation state; lumped ions are allowed), volume averaged over plasma radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure ],
        [ sh:class fyo:PlasmaProfilesVectorComponents2 ;
            sh:description "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:velocity ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding neutral species in the ../../neutral array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutral_index ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the temperature profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:temperature_fit ],
        [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only the 'ion' level is considered and the 'state' array of structure is empty; 1-Ion states are considered and are described in the 'state' array of structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Average square charge of the ion species (sum of states square charge weighted by state density and divided by ion density)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:z_ion_square_1d ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the temperature profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:temperature_validity ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H, D, T, He, C, D2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency  (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken) (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:temperature ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1dIon .

fyo:PlasmaProfilesProfiles1dIonState a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (ionisation, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Cumulative and average ionisation potential to reach a given bundle. Defined as sum (x_z* (sum of Epot from z'=0 to z-1)), where Epot is the ionisation potential of ion Xz_+, and x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:ionisation_potential ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Average square charge profile of the charge state bundle (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:z_average_square_1d ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:pressure_thermal ],
        [ sh:class fyo:PlasmaProfiles1dFit ;
            sh:description "Information on the fit used to obtain the density profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:density_fit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z of the charge state bundle, volume averaged over the plasma radius (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_average ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Average charge profile of the charge state bundle (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:z_average_1d ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:density ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z square of the charge state bundle, volume averaged over the plasma radius (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z_square_average ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:class fyo:PlasmaProfilesVectorComponents3 ;
            sh:description "Velocity at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:velocity ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1dIonState .

fyo:PlasmaProfilesProfiles1dNeutral a sh:NodeShape ;
    rdfs:comment "Quantities related to the different neutral species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:class fyo:PlasmaProfilesProfiles1dNeutralState ;
            sh:description "Quantities related to the different states of the species (energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only one state is considered; 1-Multiple states are considered and are described in the state structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding ion species in the ../../ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:ion_index ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, He, C, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_fast_perpendicular ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1dNeutral .

fyo:PlasmaProfilesProfiles1dNeutralState a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying state" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:temperature ],
        [ sh:class spo:Identifier ;
            sh:description "Neutral type (if the considered state is a neutral), in terms of energy. ID =1: cold; 2: thermal; 3: fast; 4: NBI" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:neutral_type ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles1dNeutralState .

fyo:PlasmaProfilesProfiles2d a sh:NodeShape ;
    rdfs:comment "Plasma quantities in a poloidal cross section, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Total parallel pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Ratio of total ion density (sum over species and charge states) over electron density. (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:n_i_total_over_n_e ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:at_time ],
        [ sh:class fyo:PlasmaProfiles2dIon ;
            sh:description "2D quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionisation states (or other types of states) must be differentiated at the state level below. This array doesn't necessarily have the same size as the profiles_1d/ion array, since 2D data may be relevant only for a subset of ion species." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:ion ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Total (sum over ion species) thermal ion pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure_ion_total ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged on states and ion species)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:t_i_average ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma toroidal momentum, summed over ion species and electrons weighted by their density and major radius, i.e. sum_over_species(n*R*m*Vphi)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:momentum_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Thermal pressure (electrons+ions)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_thermal ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Total ion thermal density (sum over species and charge states)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:n_i_thermal_total ],
        [ sh:datatype xsd:float ;
            sh:description "Effective charge" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:zeff ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Total perpendicular pressure (electrons+ions, thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_perpendicular ] ;
    sh:targetClass fyo:PlasmaProfilesProfiles2d .

fyo:PlasmaProfilesTimeSliceElectrons a sh:NodeShape ;
    rdfs:comment "Quantities related to the electrons" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridScalar ;
            sh:description "Fast (non-thermal) parallel pressure, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Pressure, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:pressure ],
