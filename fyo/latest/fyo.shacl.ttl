            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Upper bound of the delay between input command received from the RT network and actuator starting to react. Applies globally to the system described by this IDS unless specific latencies (e.g. channel-specific or antenna-specific) are provided at a deeper level in the IDS structure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:latency ] ;
    sh:targetClass fyo:Spi .

fyo:StateEstimation a sh:NodeShape ;
    rdfs:comment "One state-estimation step of the closed loop — inferring the current plasma state from available (synthetic) diagnostic signals and the device linear model (EKF-family), the quasi-real-time counterpart of S-8's offline inference: same forward spine, hard latency budget. GAP (informative): estimator and device linear model are pending (as-built: direct PD on reconstructed position)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:consumes_ids ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:produces_ids ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ] ;
    sh:targetClass fyo:StateEstimation .

fyo:Summary a sh:NodeShape ;
    rdfs:comment "Summary of physics quantities from a simulation or an experiment. Dynamic quantities are either taken at given time slices (indicated in the \"time\" vector) or time-averaged over an interval (in such case the \"time_width\" of the interval is indicated and the \"time\" vector represents the end of each time interval)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryAverageQuantities ;
            sh:description "Volume-averaged plasma parameters (averaged over the confined plasma volume, i.e. inside the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:volume_average ],
        [ sh:class fyo:SummaryFusion ;
            sh:description "Fusion reactions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path fyo:fusion ],
        [ sh:class fyo:SummaryDisruption ;
            sh:description "Disruption characteristics, if the pulse is terminated by a disruption" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:disruption ],
        [ sh:datatype xsd:float ;
            sh:description "Generic time" ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:integer ;
            sh:description "Pulse number to which this data is related (if relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:pulse ],
        [ sh:class spo:Identifier ;
            sh:description "Type of data contained in the dataset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:type ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 42 ;
            sh:path spo:modality ],
        [ sh:class fyo:EntryTag ;
            sh:description "Tag qualifying this data entry (or a list of data entries)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:tag ],
        [ sh:class fyo:SummarySol ;
            sh:description "Scrape-Off-Layer (SOL) characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path fyo:scrape_off_layer ],
        [ sh:class fyo:SummaryGlobalQuantities ;
            sh:description "Various global quantities derived from the profiles" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:global_quantities ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 45 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 43 ;
            sh:path spo:generated_by_process ],
        [ sh:class fyo:SummaryStaticInt0d ;
            sh:description "Magnetic field shear indicator for stellarators: 0 for shearless stellarators (W7-A, W7-AS, W7-X); 1, otherwise. See [Stroth U. et al 1996 Nucl. Fusion 36 1063]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:magnetic_shear_flag ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 49 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummarySimulation ;
            sh:description "Description of the general characteristics of the simulation, if this dataset has been produced by a simulation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:simulation ],
        [ sh:class fyo:SummaryWall ;
            sh:description "Wall characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 34 ;
            sh:path fyo:wall ],
        [ sh:class fyo:SummaryLimiter ;
            sh:description "Limiter characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 35 ;
            sh:path fyo:limiter ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:class fyo:SummaryGasInjectionAccumulated ;
            sh:description "Accumulated injected gas since the plasma breakdown in equivalent electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path fyo:gas_injection_accumulated ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Time of the plasma breakdown" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 36 ;
            sh:path fyo:time_breakdown ],
        [ sh:class fyo:SummaryAverageQuantities ;
            sh:description "Line average plasma parameters" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:line_average ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time (UTC) at which the pulse started on the experiment (if relevant), expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:pulse_time_begin ],
        [ sh:class fyo:SummaryElms ;
            sh:description "Edge Localized Modes related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:elms ],
        [ sh:class fyo:SummaryDynamicInt1dRoot ;
            sh:description "This flag is set to one if the pulse is in a stationary phase from the point of the of the energy content (if the time derivative of the energy dW/dt can be neglected when calculating tau_E as W/(P_abs-dW/dt).)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:stationary_phase_flag ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:SummaryRunaways ;
            sh:description "Runaway electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path fyo:runaways ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the simulation or the pulse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the experimental device to which this data is related (if relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:machine ],
        [ sh:class fyo:SummaryGasInjection ;
            sh:description "Gas injection rates in equivalent electrons.s^-1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path fyo:gas_injection_rates ],
        [ sh:class fyo:SummaryLocal ;
            sh:description "Plasma parameter values at different locations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:local ],
        [ sh:class fyo:SummaryHCd ;
            sh:description "Heating and current drive parameters" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path fyo:heating_current_drive ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Duration of existence of a confined plasma during the pulse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 37 ;
            sh:path fyo:plasma_duration ],
        [ sh:class spo:Code ;
            sh:description "The Code (activity / agent) that produced this artifact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 41 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "For experimental processed data, date and time (UTC) at which the pulse data processing started on the experiment (if relevant), expressed in a human readable form (ISO 8601) : the format of the string shall be : YYYY-MM-DDTHH:MM:SSZ. Example : 2020-07-24T14:19:00Z" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:pulse_processing_time_begin ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 44 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:SummarySpeciesConstant ;
            sh:description "Ratios of the volume-averaged density (inside LCFS) of each ion species to the volume-averaged electron density, taken at the time of maximum electron density during the pulse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:composition ],
        [ sh:class fyo:SummaryEpochTime ;
            sh:description "Time at which the pulse started on the experiment (if relevant), expressed in Unix Epoch time represented as two integers: seconds, plus additionally elapsed nanoseconds" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:pulse_time_begin_epoch ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 39 ;
            sh:path fyo:code ],
        [ sh:class fyo:SummaryRmp ;
            sh:description "Resonant magnetic perturbations related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path fyo:rmps ],
        [ sh:class fyo:SummaryPedestalFits ;
            sh:description "Quantities derived from specific fits of pedestal profiles, typically used in the Pedestal Database." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:pedestal_fits ],
        [ sh:class fyo:SummaryEpochTime ;
            sh:description "Time at which the pulse ended on the experiment (if relevant), expressed in Unix Epoch time represented as two integers: seconds, plus additionally elapsed nanoseconds" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:pulse_time_end_epoch ],
        [ sh:class fyo:SummaryGasInjectionPrefill ;
            sh:description "Accumulated injected gas during the prefill in equivalent electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path fyo:gas_injection_prefill ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path spo:version_put ],
        [ sh:datatype xsd:float ;
            sh:description "In case the time-dependent quantities of this IDS are averaged over a time interval, this node is the width of this time interval (empty otherwise). By convention, the time interval starts at time-time_width and ends at time." ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path fyo:time_width ],
        [ sh:class fyo:SummaryPellets ;
            sh:description "Pellet related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path fyo:pellets ],
        [ sh:class spo:Identifier ;
            sh:description "Choice of midplane definition (use the lowest index number if more than one value is relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:midplane ],
        [ sh:class fyo:SummaryKicks ;
            sh:description "Vertical kicks of the plasma position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path fyo:kicks ],
        [ sh:class fyo:SummaryBoundary ;
            sh:description "Description of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:boundary ],
        [ sh:class fyo:SummaryStaticStr0d ;
            sh:description "Device configuration (the content may be device-specific)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:configuration ] ;
    sh:targetClass fyo:Summary .

fyo:SyntheticDiagnosticEvaluation a sh:NodeShape ;
    rdfs:comment "A forward evaluation of a diagnostic's response to a candidate plasma configuration — composing the forward operator F with the diagnostic geometry / response model to produce SYNTHETIC signals comparable with d_obs. The reusable half of the unified forward–inference loss; also the verification loop of prediction (predict → synthesize → compare). GAP (informative): synthetic-diagnostic forward models are the identified zero of the as-built state (R-3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:consumes_ids ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:produces_ids ] ;
    sh:targetClass fyo:SyntheticDiagnosticEvaluation .

fyo:Temporary a sh:NodeShape ;
    rdfs:comment "Storage of undeclared data model components" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 26 ;
            sh:path spo:modality ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:code ],
        [ sh:class fyo:TemporaryDynamicQuantitiesFloat1d ;
            sh:description "Dynamic 1D float" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:dynamic_float1d ],
