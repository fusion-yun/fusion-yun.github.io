        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Reference temperature profile used to define the local thermal energy and the thermal velocity (for normalization of the grid coordinates)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:temperature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:DistributionsDGgdNogrid .

fyo:DistributionsDGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Global quantities (integrated over plasma volume for moments of the distribution, collisional exchange and source terms), for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Power loss due to Charge Exchange loss of fast ions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:power_charge_exchange ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal torque due to radial currents" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:torque_tor_j_radial ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Total energy in the distribution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:energy ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path spo:slice_of ],
        [ sh:class fyo:DistributionsDGlobalQuantitiesCollisions ;
            sh:description "Power and torque exchanged between the species described by the distribution and the different plasma species through collisions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:collisions ],
        [ sh:class fyo:DistributionsDGlobalQuantitiesThermalized ;
            sh:description "Volume integrated source of thermal particles, momentum and energy due to thermalization. Here thermalization refers to non-thermal particles, sufficiently assimilated to the thermal background to be re-categorized as thermal particles. Note that this source may also be negative if thermal particles are being accelerated such that they form a distinct non-thermal contribution, e.g. due run-away of RF interactions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:thermalization ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:float ;
            sh:description "Number of fast particles in the distribution, i.e. the volume integral of the density (note: this is the number of real particles and not markers)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:particles_fast_n ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Number of particles in the distribution, i.e. the volume integral of the density (note: this is the number of real particles and not markers)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:particles_n ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel energy of the fast particles in the distribution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:energy_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Total energy of the fast particles in the distribution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:energy_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal current driven by the distribution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:current_phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Power loss due to first orbit losses" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:power_first_orbit ],
        [ sh:class fyo:DistributionsDGlobalQuantitiesSource ;
            sh:description "Set of volume integrated sources and sinks of particles, momentum and energy included in the Fokker-Planck modelling, related to the various waves or particle source processes affecting the distribution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:float ;
            sh:description "Power going to plasma rotation. This power goes into sustaining the plasma rotation rather than heating the plasma. This is given because the injection energy in the rotating plasma frame is (assuming rotation in the same direction of the NB injection) lower than in the lab-frame." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:power_rotation ] ;
    sh:targetClass fyo:DistributionsDGlobalQuantities .

