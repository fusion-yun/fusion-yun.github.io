fyo:SpectroVisChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (detector or pixel of a camera)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Etendue (geometric extent) of the channel's optical system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:etendue ],
        [ sh:class fyo:SpectroVisChannelPolarization ;
            sh:description "Physics quantities measured from polarized light spectroscopy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:polarization_spectroscopy ],
        [ sh:class fyo:SpectroVisChannelLightCollection ;
            sh:description "Light collection efficiencies (fraction of the local emission detected by the optical system) for a list of points defining regions of interest. To be used for non-pinhole optics." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:light_collection_efficiencies ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight of the channel, given by 2 points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:line_of_sight ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the channel for the whole acquisition period (0 means valid, negative values mean non-valid)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:validity ],
        [ sh:class fyo:FibreBundle ;
            sh:description "Description of the fibre bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:fibre_bundle ],
        [ sh:class fyo:OpticalElement ;
            sh:description "Set of optical elements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:optical_element ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:aperture ],
        [ sh:class fyo:SpectroVisGeometryMatrix ;
            sh:description "Description of geometry matrix (ray transfer matrix)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:geometry_matrix ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Polarizer description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:polarizer ],
        [ sh:class spo:Identifier ;
            sh:description "Method used to calculate the etendue. Index = 0 : exact calculation with a 4D integral; 1 : approximation with first order formula (detector surface times solid angle subtended by the apertures); 2 : other methods" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:etendue_method ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Detector description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:detector ],
        [ sh:class fyo:DetectorImage ;
            sh:description "Image of the detector or pixel on the focal plane of the optical system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:detector_image ],
        [ sh:class fyo:SpectroVisChannelIsotopes ;
            sh:description "Isotope ratios and related information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:isotope_ratios ],
        [ sh:class fyo:SpectroVisChannelFilter ;
            sh:description "Quantities measured by the channel if connected to a filter spectrometer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:filter_spectrometer ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectroVisChannelResolution ;
            sh:description "In case of active spectroscopy, describes the spatial resolution of the measurement, calculated as a convolution of the atomic smearing, magnetic and beam geometry smearing and detector projection, for a set of time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:active_spatial_resolution ],
        [ sh:class fyo:DetectorImage ;
            sh:description "Image of the optical fibre on the focal plane of the optical system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:fibre_image ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SpectroVisChannelGrating ;
            sh:description "Quantities measured by the channel if connected to a grating spectrometer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:grating_spectrometer ],
        [ sh:class spo:Identifier ;
            sh:description "Type of spectrometer the channel is connected to (index=1: grating, 2: filter)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of whether a polarizer is present and active in the optical system (set to 1 in this case, set to 0 or leave empty ottherwise)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:polarizer_active ],
        [ sh:class fyo:SignalInt1d ;
            sh:description "Indicator of the validity of the channel as a function of time (0 means valid, negative values mean non-valid)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:string ;
