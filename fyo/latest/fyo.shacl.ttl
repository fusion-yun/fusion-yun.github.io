fyo:NeutronDiagnosticDetectorMode a sh:NodeShape ;
    rdfs:comment "Set of Measuring Modes simultaneously used by the detector" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt2d ;
            sh:description "Detected counts per second per energy channel as a function of time (in case of spectroscopic measurement mode)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:spectrum ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum count limit under which the detector response is linear" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:count_limit_max ],
        [ sh:datatype xsd:float ;
            sh:description "Neutron flux impinging on the detector, deduced from the measured count-rate (relevant only when mode/identifier/index = 1)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:neutron_flux ],
        [ sh:datatype xsd:float ;
            sh:description "Line-integrated emissivity along the line of sight, deduced from the measured count-rate of this detector (relevant only when mode/identifier/index = 1)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:brightness ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum count limit above which the detector response is linear" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:count_limit_min ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier of the measuring mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Detected counts per second as a function of time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:counting ] ;
    sh:targetClass fyo:NeutronDiagnosticDetectorMode .

fyo:NeutronDiagnosticDetectors a sh:NodeShape ;
    rdfs:comment "Set of neutron detection systems" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:DetectorEnergyBand ;
            sh:description "Set of energy bands in which neutrons are counted by the detector" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:energy_band ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:NeutronDiagnosticSupply ;
            sh:description "Description of high voltage power supply" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:supply_high_voltage ],
        [ sh:class spo:Identifier ;
            sh:description "Name of detector's converter for resent particle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:material ],
        [ sh:class fyo:NeutronDiagnosticTestGenerator ;
            sh:description "Magnetic field sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:b_field_sensor ],
        [ sh:class fyo:NeutronDiagnosticTestGenerator ;
            sh:description "Temperature sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:temperature_sensor ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the detector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:NeutronDiagnosticGreen ;
            sh:description "Green function coefficients used to represent the detector response based on its field of view" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:green_functions ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Detector geometry" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:geometry ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of target nuclei in the dectector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:nuclei_n ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:exposure_time ],
        [ sh:class fyo:NeutronDiagnosticFieldOfView ;
            sh:description "Field of view associated to this detector. The field of view is described by a voxelized plasma volume. Each voxel, with indexes i_R, i_Z, and i_phi, has an associated solid angle scalar and a detector direction vector." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:field_of_view ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of the line of sight where the detector is mounted" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:line_of_sight_index ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature of the detector" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:temperature ],
        [ sh:class fyo:NeutronDiagnosticDetectorMode ;
            sh:description "Set of Measuring Modes simultaneously used by the detector" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:mode ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:aperture ],
        [ sh:class fyo:NeutronDiagnosticAdc ;
            sh:description "Description of analogic-digital converter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:adc ],
        [ sh:class fyo:NeutronDiagnosticSupply ;
