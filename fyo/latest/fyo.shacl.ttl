fyo:DistributionSpecies a sh:NodeShape ;
    rdfs:comment "Species causing this source term (if relevant, e.g. a particular ion or neutral state in case of line radiation)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:PlasmaCompositionNeutralConstant ;
            sh:description "Description of the neutral species, used if type/index = 4 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:neutral ],
        [ sh:class fyo:PlasmaCompositionIonsConstant ;
            sh:description "Description of the ion or neutral species, used if type/index = 2 or 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:ion ],
        [ sh:class spo:Identifier ;
            sh:description "Species type. index=1 for electron; index=2 for ion species in a single/average state (refer to ion structure); index=3 for ion species in a particular state (refer to ion/state structure);  index=4 for neutral species in a single/average state (refer to neutral structure); index=5 for neutral species in a particular state (refer to neutral/state structure);  index=6 for neutron; index=7 for photon" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:type ] ;
    sh:targetClass fyo:DistributionSpecies .

fyo:GenericGridVectorComponentsRphiz a sh:NodeShape ;
    rdfs:comment "Total current density, given on various grid subsets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Component along the height axis, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:datatype xsd:float ;
            sh:description "Component along the major radius axis, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the toroidal component, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:phi_coefficients ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component, one scalar value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the component along the height axis, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:z_coefficients ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients for the component along the major radius axis, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:r_coefficients ] ;
    sh:targetClass fyo:GenericGridVectorComponentsRphiz .

fyo:LineOfSight3points a sh:NodeShape ;
    rdfs:comment "Description of the reference line of sight of the channel, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the second point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:second_point ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:describes_region ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:manifold_dim ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the third point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:third_point ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:geometry_role ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the first point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:first_point ] ;
    sh:targetClass fyo:LineOfSight3points .

fyo:MachineDescription a sh:NodeShape ;
    rdfs:comment "A static description of a Machine as built — geometry, coil positions, probe positions (the machine-description IDS subset; EngineeringDetermination output). The DESCRIPTION-side counterpart of the MaterialEntity Machine: a survey dataset is_about the machine, while the drawing that PRESCRIBES it is a spo DesignSpecification. as-designed ≠ as-built ≠ the machine itself." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this description is about (iao:is_about specialization)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:describes_machine ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:MachineDescription .

fyo:MhdLinearVector a sh:NodeShape ;
    rdfs:comment "Pertubed vector potential for given toroidal mode number" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Complex2dDynamicAosMhdLinearVector ;
            sh:description "First coordinate (radial)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:coordinate1 ],
        [ sh:class fyo:Complex2dDynamicAosMhdLinearVector ;
            sh:description "Third coordinate (toroidal)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:coordinate3 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Complex2dDynamicAosMhdLinearVector ;
            sh:description "Second coordinate (poloidal)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:coordinate2 ] ;
    sh:targetClass fyo:MhdLinearVector .

fyo:PlasmaRadialGrid a sh:NodeShape ;
    rdfs:comment "Radial grid. Note that some of the radial coordinates listed above are undefined outside the last closed flux surface, thus they must be filled with EMPTY_FLOAT values in such locations" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Normalised toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation, see time_slice/boundary/b_flux_pol_norm in the equilibrium IDS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal flux coordinate. rho_tor = sqrt(b_flux_tor/(pi*b0)) ~ sqrt(pi*r^2*b0/(pi*b0)) ~ r [m]. The toroidal field used in its definition is indicated under vacuum_toroidal_field/b0" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal magnetic flux. Integral of magnetic field passing through a contour defined by the intersection of a flux surface passing through the point of interest and a Z=constant plane. If the integration surface is flat, the surface normal vector is in the increasing vertical coordinate direction, Z, namely upwards." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Surface area of the toroidal flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:surface ],
        [ sh:datatype xsd:float ;
            sh:description "Cross-sectional area of the flux surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:float ;
            sh:description "Volume enclosed inside the magnetic surface" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:volume ],
        [ sh:datatype xsd:float ;
            sh:description "Normalised poloidal flux coordinate = sqrt((psi(rho)-psi(magnetic_axis) / (psi(LCFS)-psi(magnetic_axis)))" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:rho_pol_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal magnetic flux at the plasma boundary (useful to normalize the psi array values when the radial grid doesn't go from the magnetic axis to the plasma boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:psi_boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the poloidal magnetic flux at the magnetic axis (useful to normalize the psi array values when the radial grid doesn't go from the magnetic axis to the plasma boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:psi_magnetic_axis ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PlasmaRadialGrid .

fyo:PlasmaTransportModel3Momentum a sh:NodeShape ;
    rdfs:comment "Radial component" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Damping rate for this flow component (e.g. due to collisions, calculated from a neoclassical model)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:flow_damping_rate ],
        [ sh:datatype xsd:float ;
            sh:description "Effective diffusivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Effective convection" ;
