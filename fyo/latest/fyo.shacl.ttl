fyo:PlasmaTransport a sh:NodeShape ;
    rdfs:comment "Plasma transport. This IDS is a prototype based on the merge of core_transport and edge_transport. Energy terms correspond to the full kinetic energy equation (i.e. the energy flux takes into account the energy transported by the particle flux)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:PlasmaTransportModel ;
            sh:description "Transport is described by a combination of various transport models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:model ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:string ;
            sh:description "The agent that provided the data (DD ids_properties/provider → prov:Agent)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class spo:Identifier ;
            sh:description "Choice of midplane definition (use the lowest index number if more than one value is relevant)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:midplane ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path spo:modality ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:GenericGridAos3Root ;
            sh:description "Grid (using the Generic Grid Description), for various time slices. The timebase of this array of structure must be a subset of the ggd timebases" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:grid_ggd ],
        [ sh:class fyo:BTorVacuum1 ;
            sh:description "Characteristics of the vacuum toroidal field (used in Rho_Tor definition and in the normalization of current densities)" ;
