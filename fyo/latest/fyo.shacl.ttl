fyo:NeutronDiagnosticEmissivity a sh:NodeShape ;
    rdfs:comment "Reconstructed emissivity parameters and data" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "1 if the detector is used for the emissivity reconstruction; 0 if the detector is not used" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:detectors_used ],
        [ sh:datatype xsd:float ;
            sh:description "Radio of densities nT/nD" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:fuel_ratio ],
        [ sh:datatype xsd:float ;
            sh:description "Emissivity profile due to DD reactions" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:emissivity_dd ],
        [ sh:datatype xsd:float ;
            sh:description "Emissivity profile due to DT reactions" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:emissivity_dt ],
        [ sh:datatype xsd:float ;
            sh:description "Fusion power profile due to DT reactions" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:fusion_power_dt ],
        [ sh:datatype xsd:float ;
            sh:description "Accuracy profile of reconstructed DT emissivity with respect to true DT emissivity. The accuracy is obtained by comparing the reconstructed emissivity profile and the emissivity profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:emissivity_dt_accuracy ],
        [ sh:class spo:Identifier ;
            sh:description "Algorithm used to reconstruct the emissivity profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:algorithm_type ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature profile of D and T ions (assumed to be equal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:t_i ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Fusion power profile due to DD reactions" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:fusion_power_dd ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Accuracy profile of reconstructed DT fusion power with respect to true DT fusion power. The accuracy is obtained by comparing the reconstructed profile and the profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:fusion_power_dt_accuracy ],
        [ sh:datatype xsd:float ;
            sh:description "Accuracy profile of reconstructed DD emissivity with respect to true DD emissivity. The accuracy is obtained by comparing the reconstructed emissivity profile and the emissivity profile input to the synthetic diagnostic calculation: relative error = (reconstructed-input)/input" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:emissivity_dd_accuracy ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized poloidal flux coordinate for the reconstructed profiles, the flux being normalized to run from 0 at the magnetic axis to 1 at the separatrix" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:psi_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Accuracy profile of reconstructed DD fusion power with respect to true DD fusion power. The accuracy is obtained by comparing the reconstructed profile and the profile input to the synthetic diagnostic calculation: relative error = (reconstruted-input)/input" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:fusion_power_dd_accuracy ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal flux coordinate. The normalizing value for rho_tor_norm, is the toroidal flux coordinate at the equilibrium boundary (LCFS or 99.x % of the LCFS in case of a fixed boundary equilibium calculation, see time_slice/boundary in the equilibrium IDS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:rho_tor_norm ] ;
    sh:targetClass fyo:NeutronDiagnosticEmissivity .

fyo:NeutronDiagnosticFieldOfView a sh:NodeShape ;
    rdfs:comment "Field of view associated to this detector. The field of view is described by a voxelized plasma volume. Each voxel, with indexes i_R, i_Z, and i_phi, has an associated solid angle scalar and a detector direction vector." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rphiz1dGrid ;
            sh:description "Grid defining the neutron emission cells in the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:emission_grid ],
        [ sh:datatype xsd:float ;
            sh:description "Average solid angle that the detector covers within the voxel" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:solid_angle ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Xyz3dStatic ;
            sh:description "Vector that points from the centre of the voxel to the centre of the detector, described in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:direction_to_detector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:NeutronDiagnosticFieldOfView .

fyo:NeutronDiagnosticGreen a sh:NodeShape ;
    rdfs:comment "Green function coefficients used to represent the detector response based on its field of view" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Array of source neutron energy bins" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:source_neutron_energies ],
        [ sh:datatype xsd:integer ;
            sh:description "Array of flags telling, for each coordinate of the response_function, whether the response_function has been integrated over this coordinate (1) or not (0). If it has been integrated over a coordinate, the size related to this coordinate must be equal to 1" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:response_function_integrated_flags ],
        [ sh:class fyo:NeutronDiagnosticEvent ;
            sh:description "5th dimension for the neutron_flux Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:event_in_detector_neutron_flux ],
        [ sh:datatype xsd:float ;
            sh:description "Number of events occurring in the detector from one neutron energy bin emitted by the current plasma voxel towards the detector" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:response_function ],
        [ sh:datatype xsd:float ;
            sh:description "Grouped neutron flux in the detector from one neutron energy bin emitted by the current plasma voxel towards the detector" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutron_flux ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Array of flags telling, for each coordinate of the neutron_flux, whether the neutron_flux has been integrated over this coordinate (1) or not (0). If it has been integrated over a coordinate, the size related to this coordinate must be equal to 1" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:neutron_flux_integrated_flags ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:NeutronDiagnosticEvent ;
            sh:description "5th dimension for the response_function Green function representing values of events measured in the detector. The type of events monitored depends on the detector and can be defined by the user. It can be energy of neutrons, or electrical signal, or time of flight ... (defined by type below)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:event_in_detector_response_function ] ;
    sh:targetClass fyo:NeutronDiagnosticGreen .

fyo:NormalBinormalStatic a sh:NodeShape ;
    rdfs:comment "Polygonal outline of the cross section in the (normal, binormal) coordinate system. Do NOT repeat the first point." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Coordinates along the binormal axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:binormal ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Coordinate along the normal axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:normal ] ;
    sh:targetClass fyo:NormalBinormalStatic .

fyo:NtmTimeSlice a sh:NodeShape ;
    rdfs:comment "Description of neoclassical tearing modes for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:NtmTimeSliceMode ;
            sh:description "List of the various NTM modes appearing during the simulation. If a mode appears several times, use several indices in this array of structure with the same m,n values." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:mode ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:NtmTimeSlice .

fyo:NtmTimeSliceMode a sh:NodeShape ;
    rdfs:comment "List of the various NTM modes appearing during the simulation. If a mode appears several times, use several indices in this array of structure with the same m,n values." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:NtmTimeSliceModeOnset ;
            sh:description "NTM onset characteristics" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:onset ],
        [ sh:datatype xsd:float ;
            sh:description "Time derivative of the phase of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:dphase_dt ],
        [ sh:datatype xsd:float ;
            sh:description "Flux coordinate on which the mode is centred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:rho_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Extra diffusion coefficient for the transport equations of Te, ne, Ti" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:delta_diff ],
        [ sh:class fyo:NtmTimeSliceModeDetailedEvolution ;
            sh:description "Detailed NTM evolution on a finer timebase than the time_slice array of structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:detailed_evolution ],
        [ sh:datatype xsd:float ;
            sh:description "Time derivative of the full width of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:dwidth_dt ],
        [ sh:datatype xsd:float ;
            sh:description "Time derivative of the frequency of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:dfrequency_dt ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:width ],
        [ sh:class fyo:NtmTimeSliceModeEvolutionDeltaw ;
            sh:description "deltaw contributions to the Rutherford equation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:deltaw ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized flux coordinate on which the mode is centred" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:rho_tor_norm ],
        [ sh:datatype xsd:integer ;
            sh:description "Toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:n_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Frequency of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:frequency ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:NtmTimeSliceModeEvolutionTorque ;
            sh:description "torque contributions to the Rutherford equation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:torque ],
        [ sh:datatype xsd:string ;
            sh:description "Description of how the mode evolution is calculated" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:calculation_method ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Phase of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:integer ;
            sh:description "Poloidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:m_pol ] ;
    sh:targetClass fyo:NtmTimeSliceMode .

