            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:float ;
            sh:description "Seed island full width at onset time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:width ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
