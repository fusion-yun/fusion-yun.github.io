            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Second dimension values" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:dim2 ],
        [ sh:datatype xsd:float ;
            sh:description "First dimension values" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:dim1 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:EquilibriumProfiles2dGrid .

fyo:PulseScheduleReferenceDensity a sh:NodeShape ;
    rdfs:comment "Flow rate of the valve" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Envelope type:  0:relative: means that the envelope upper and lower bound values are defined respectively as reference.data * reference.data_error_upper and reference.data * reference.data_error_lower. 1: absolute: the envelope upper and lower bound values are given respectively by reference/data_error_upper and reference/data_error_lower. Lower and upper are taken in the strict mathematical sense, without considering absolute values of the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:envelope_type ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Reference name (e.g. in the native pulse schedule system of the device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:reference_name ],
        [ sh:datatype xsd:float ;
            sh:description "Reference waveform. Caution : error bars of the reference/data node are not used in the usual sense, instead they are used to describe the control envelope, with a meaning depending on the chosen envelope_type option." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:reference ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Reference type:  0:relative (don't use for the moment, to be defined later when segments are introduced in the IDS structure); 1: absolute: the reference time trace is provided in the reference/data node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:reference_type ] ;
    sh:targetClass fyo:PulseScheduleReferenceDensity .

fyo:Rphiz1dStatic a sh:NodeShape ;
    rdfs:comment "Outline of the tile surface facing the plasma" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
