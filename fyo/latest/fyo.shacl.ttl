        [ sh:datatype xsd:integer ;
            sh:description "Space dimension of the grid subset elements. This must be equal to the sum of the dimensions of the individual objects forming the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:dimension ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
