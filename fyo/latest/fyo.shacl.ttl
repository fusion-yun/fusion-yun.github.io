            sh:description "Major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:string ;
            sh:description "Definition of the reference point" ;
