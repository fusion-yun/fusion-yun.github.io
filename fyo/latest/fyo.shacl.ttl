            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Number of counts detected on each pixel of the frame during one exposure time" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:counts_n ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalFrame .

fyo:SpectrometerXRayCrystalInstrumentFuncBin a sh:NodeShape ;
    rdfs:comment "Instrument function for this bin (replaces the ../../instrument function in case vertical binning is used), i.e. response of the detector to a monochromatic emission passing through the spectrometer. The resulting image on the detector will be a 2-D distribution of pixel values, for each wavelength. It can be given as explicit values for each detector pixel (values node) or as a parametric function of wavelength (described by the other nodes)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Explicit instrument function values for the detector. When multiplied by the line-integrated emission spectrum in photons/second/sr/m/m^2 received on a binned pixel of the detector, gives the detector pixel output in counts/seconds." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:values ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Instrument function type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:float ;
            sh:description "Centre (in terms of absolute wavelength) of instrument function" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:centre ],
        [ sh:datatype xsd:float ;
            sh:description "Array of wavelengths on which the instrument function is defined" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:wavelengths ],
        [ sh:datatype xsd:float ;
            sh:description "Standard deviation of Gaussian instrument function" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:sigma ],
        [ sh:datatype xsd:float ;
            sh:description "Scale of Lorentzian instrument function (full width at half height)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:scale ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Scaling factor for the instrument function such that convolving the instrument function with an emission spectrum gives the counts per second on the detector" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:intensity ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalInstrumentFuncBin .

fyo:SpectrometerXRayCrystalInstrumentFunction a sh:NodeShape ;
    rdfs:comment "Instrument function (to be used in case vertical binning is not used), i.e. response of the detector to a monochromatic emission passing through the spectrometer. The resulting image on the detector will be a 2-D distribution of pixel values, for each wavelength. It can be given as explicit values for each detector pixel (values node) or as a parametric function of wavelength (described by the other nodes)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Explicit instrument function values for the detector. When multiplied by the line-integrated emission spectrum in photons/second/sr/m/m^2 received on a pixel of the detector, gives the detector pixel output in counts/seconds." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:values ],
        [ sh:datatype xsd:float ;
            sh:description "Standard deviation of Gaussian instrument function" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:sigma ],
        [ sh:class spo:Identifier ;
            sh:description "Instrument function type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Array of wavelengths on which the instrument function is defined" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:wavelengths ],
        [ sh:datatype xsd:float ;
            sh:description "Scale of Lorentzian instrument function (full width at half height)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:scale ],
        [ sh:datatype xsd:float ;
            sh:description "Centre (in terms of absolute wavelength) of instrument function" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:centre ],
        [ sh:datatype xsd:float ;
            sh:description "Scaling factor for the instrument function such that convolving the instrument function with an emission spectrum gives the counts per second on the detector" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:intensity ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalInstrumentFunction .

fyo:SpectrometerXRayCrystalProxy a sh:NodeShape ;
    rdfs:comment "Profiles proxies are given in the vertical direction of the detector. They are estimated directly from the camera, without tomographic inversion. Binning is allowed so the number of profile points may be lower than the length of z_frames. Physical quantities deduced from the measured spectra are given for each profile point. They correspond to the spectra integrated along lines of sight, defined by a first point given by the centre of the crystal and a second point (depending on the profile poin" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SpectrometerXRayCrystalFlt2dTime1 ;
            sh:description "Electron temperature (estimated from a spectral fit directly on the output line-integrated signal, without tomographic inversion)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:t_e ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "For each profile point, a line of sight is defined by a first point given by the centre of the crystal and a second point described here." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:lines_of_sight_second_point ],
        [ sh:class fyo:SpectrometerXRayCrystalFlt2dTime1 ;
            sh:description "Toroidal velocity (estimated from a spectral fit directly on the output line-integrated signal, without tomographic inversion)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:velocity_tor ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectrometerXRayCrystalFlt2dTime1 ;
            sh:description "Shortest distance in rho_tor_norm between lines of sight and magnetic axis, signed with following convention : positive (resp. negative) means the point of shortest distance is above (resp. below) the magnetic axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:lines_of_sight_rho_tor_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes of this probe located at this level of the IDS structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SpectrometerXRayCrystalFlt2dTime1 ;
            sh:description "Ion temperature (estimated from a spectral fit directly on the output line-integrated signal, without tomographic inversion)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:t_i ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalProxy .

fyo:SpiFragment a sh:NodeShape ;
    rdfs:comment "Set of shattered pellet fragments" ;
