            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:SpectroVisChannelLightCollection .

fyo:SpectroVisChannelPolarization a sh:NodeShape ;
    rdfs:comment "Physics quantities measured from polarized light spectroscopy" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Modulus of the magnetic field (always positive, irrespective of the sign convention for the B-field direction), obtained from Zeeman effect fit" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:b_field_modulus ],
        [ sh:datatype xsd:float ;
            sh:description "Lower Hybrid electric field component in the vertical direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:e_field_lh_z ],
        [ sh:datatype xsd:float ;
            sh:description "Fit of cold neutrals temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:temperature_cold_neutrals ],
        [ sh:datatype xsd:float ;
            sh:description "Lower Hybrid electric field component in the toroidal direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:e_field_lh_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Lower Hybrid electric field component in the major radius direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:e_field_lh_r ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for dynamic quantities at this level of the data structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Electron density, obtained from Stark broadening fit" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:n_e ],
        [ sh:datatype xsd:float ;
            sh:description "Projection of the hot neutral velocity along the line of sight, positive when going from first point to second point of the line of sight" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:velocity_hot_neutrals ],
        [ sh:datatype xsd:float ;
            sh:description "Fit of hot neutrals temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:temperature_hot_neutrals ],
        [ sh:datatype xsd:float ;
            sh:description "Projection of the cold neutral velocity along the line of sight, positive when going from first point to second point of the line of sight" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:velocity_cold_neutrals ] ;
    sh:targetClass fyo:SpectroVisChannelPolarization .

fyo:SpectroVisChannelProcessedLine a sh:NodeShape ;
    rdfs:comment "Set of processed spectral lines" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String identifying the processed line. To avoid ambiguities, the following syntax is used : element with ionization state_wavelength in Angstrom (e.g. WI_4000)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Calibrated, background subtracted radiance (integrated over the spectrum for this line)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:radiance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Central wavelength of the processed line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_central ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Non-calibrated intensity (integrated over the spectrum for this line)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:intensity ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:SpectroVisChannelProcessedLine .

fyo:SpectroVisChannelProcessedLineFilter a sh:NodeShape ;
    rdfs:comment "Set of processed spectral lines (normally a single line is filtered out, but it may happen in some cases that several lines go through the filter)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Central wavelength of the processed line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_central ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the processed line. To avoid ambiguities, the following syntax is used : element with ionization state_wavelength in Angstrom (e.g. WI_4000)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:SpectroVisChannelProcessedLineFilter .

fyo:SpectroVisChannelResolution a sh:NodeShape ;
    rdfs:comment "In case of active spectroscopy, describes the spatial resolution of the measurement, calculated as a convolution of the atomic smearing, magnetic and beam geometry smearing and detector projection, for a set of time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rphiz0dDynamicAos3 ;
            sh:description "Position of the centre of the spatially resolved zone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:centre ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rphiz0dDynamicAos3 ;
            sh:description "Full width of the spatially resolved zone in the R, Z and phi directions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:width ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:at_instant ] ;
    sh:targetClass fyo:SpectroVisChannelResolution .

fyo:SpectroVisChannelWavelengthCalibration a sh:NodeShape ;
    rdfs:comment "Wavelength calibration data. The wavelength is obtained from the pixel index k by: wavelength =  k * gain + offset. k is starting from 1." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Gain" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:gain ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Offset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:offset ] ;
    sh:targetClass fyo:SpectroVisChannelWavelengthCalibration .

fyo:SpectroVisGeometryMatrix a sh:NodeShape ;
    rdfs:comment "Description of geometry matrix (ray transfer matrix)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Voxel map for geometry matrix. The cells with same number are merged in the computation into a single emission source meta-cell (the voxel). Cells with number -1 are excluded. Voxel count starts from 0." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:voxel_map ],
        [ sh:class fyo:SpectroVisGeometryMatrixStep2 ;
            sh:description "Geometry matrix without reflections" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:without_reflections ],
        [ sh:class fyo:GeometryMatrixEmission ;
            sh:description "Grid defining the light emission cells" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:emission_grid ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectroVisGeometryMatrixStep2 ;
            sh:description "Geometry matrix with reflections" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:with_reflections ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of voxels defined in the voxel_map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:voxels_n ],
        [ sh:class fyo:SpectroVisGeometryMatrixInterpolated ;
            sh:description "Interpolated geometry matrix for reflected light" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:interpolated ] ;
    sh:targetClass fyo:SpectroVisGeometryMatrix .

fyo:SpectroVisGeometryMatrixInterpolated a sh:NodeShape ;
    rdfs:comment "Interpolated geometry matrix for reflected light" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Height of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolated Ray Transfer Matrix (RTM, or geometry matrix), which provides transformation of the reflected light from each interpolation knot to the receiver (detector or head of an optic fibre). When convolving with an emission profile, the values must be interpolated to the emission grid and multiplied by the volume of the grid cells. The interpolated matrix is given on an array of interpolation knots of coordinates r, z and phi" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle (oriented counter-clockwise when viewing from above) of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:SpectroVisGeometryMatrixInterpolated .

fyo:SpectrometerMassChannel a sh:NodeShape ;
    rdfs:comment "Set of mass channels, each corresponding to a given atomic mass measured continuously by the spectrometer" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Collected current" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Partial pressure (calibrated data)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:pressure_partial ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes of this channel" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Voltage applied to the photomultiplier" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:photomultiplier_voltage ],
        [ sh:datatype xsd:float ;
            sh:description "Atomic mass measured by this channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data. 0: Valid from automated processing; 1: Valid and certified by the diagnostic RO; -1: Problem identified in the data processing (request verification by the diagnostic RO); -2: Invalid data, should not be used. (Values less than -2 have a code-specific meaning)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:validity ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for each time slice. 0: Valid from automated processing; 1: Valid and certified by the diagnostic RO; -1: Means problem identified in the data processing (request verification by the diagnostic RO); -2: Invalid data, should not be used. (Values less than -2 have a code-specific meaning.)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:validity_timed ] ;
    sh:targetClass fyo:SpectrometerMassChannel .

fyo:SpectrometerMassResidual a sh:NodeShape ;
    rdfs:comment "Set of entire mass spectra recorded at various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Array of atomic masses" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:float ;
            sh:description "Collected current" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:at_instant ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:SpectrometerMassResidual .

fyo:SpectrometerXRayCrystalBin a sh:NodeShape ;
    rdfs:comment "Set of bins (binning in the vertical dimension) defined to increase the signal to noise ratio of the spectra" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight from the crystal to the plasma for this bin, defined by two points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:line_of_sight ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SpectrometerXRayCrystalInstrumentFuncBin ;
            sh:description "Instrument function for this bin (replaces the ../../instrument function in case vertical binning is used), i.e. response of the detector to a monochromatic emission passing through the spectrometer. The resulting image on the detector will be a 2-D distribution of pixel values, for each wavelength. It can be given as explicit values for each detector pixel (values node) or as a parametric function of wavelength (described by the other nodes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:instrument_function ],
        [ sh:datatype xsd:integer ;
            sh:description "Vertical pixel index range indicating the corresponding binned detector area" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_pixel_range ],
        [ sh:datatype xsd:float ;
            sh:description "Wavelength of incoming photons on each horizontal pixel of this bin." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalBin .

fyo:SpectrometerXRayCrystalChannel a sh:NodeShape ;
    rdfs:comment "Measurement channel, composed of a camera, a crystal, and (optional) a set of reflectors. The light coming from the plasma passes through the (optional) set of reflectors, then the crystal and arrives at the camera" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SpectrometerXRayCrystalCrystal ;
            sh:description "Characteristics of the crystal used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:crystal ],
        [ sh:class fyo:SpectrometerXRayCrystalFrame ;
            sh:description "Set of frames" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:frame ],
        [ sh:datatype xsd:float ;
            sh:description "Wavelength of incoming photons on each pixel of the frames, mainly varying accross the horizontal dimension of the frame. However a 2D map of the wavelength is given since it is not constant vertically due to the elliptical curvature of the photon iso-surfaces" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:wavelength_frames ],
        [ sh:datatype xsd:float ;
            sh:description "Lower energy bound for the photon detection, for each pixel (horizontal, vertical)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:energy_bound_lower ],
        [ sh:datatype xsd:float ;
            sh:description "Array of energy values for tabulation of the detection efficiency" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:energies ],
        [ sh:datatype xsd:float ;
            sh:description "Upper energy bound for the photon detection, for each pixel (horizontal, vertical)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:energy_bound_upper ],
        [ sh:datatype xsd:float ;
            sh:description "Height of the observed zone at the focal plane in the plasma, corresponding to the vertical dimension of the frame" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:z_frames ],
        [ sh:class fyo:CurvedObject ;
            sh:description "Set of reflectors (optional) reflecting the light coming from the plasma towards the crystal. If empty, means that the plasma light directly arrives on the crystal." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:reflector ],
        [ sh:datatype xsd:float ;
            sh:description "Probability of detection of a photon impacting the detector as a function of its energy" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:detection_efficiency ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SpectrometerXRayCrystalProxy ;
            sh:description "Profiles proxies are given in the vertical direction of the detector. They are estimated directly from the camera, without tomographic inversion. Binning is allowed so the number of profile points may be lower than the length of z_frames. Physical quantities deduced from the measured spectra are given for each profile point. They correspond to the spectra integrated along lines of sight, defined by a first point given by the centre of the crystal and a second point (depending on the profile point) described below." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:profiles_line_integrated ],
        [ sh:class fyo:CameraGeometry ;
            sh:description "Characteristics of the camera used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:camera ],
        [ sh:class fyo:SpectrometerXRayCrystalBin ;
            sh:description "Set of bins (binning in the vertical dimension) defined to increase the signal to noise ratio of the spectra" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:bin ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Collimating aperture" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:aperture ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time of the measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:exposure_time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SpectrometerXRayCrystalInstrumentFunction ;
            sh:description "Instrument function (to be used in case vertical binning is not used), i.e. response of the detector to a monochromatic emission passing through the spectrometer. The resulting image on the detector will be a 2-D distribution of pixel values, for each wavelength. It can be given as explicit values for each detector pixel (values node) or as a parametric function of wavelength (described by the other nodes)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:instrument_function ],
        [ sh:class fyo:FilterWindow ;
            sh:description "Set of filter windows" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:filter_window ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalChannel .

fyo:SpectrometerXRayCrystalCrystal a sh:NodeShape ;
    rdfs:comment "Characteristics of the crystal used" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the object surface and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X2 direction, to be filled only for curvature_type/index = 3 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:x2_curvature ],
        [ sh:class spo:Identifier ;
            sh:description "Crystal mesh type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:mesh_type ],
        [ sh:class spo:Identifier ;
            sh:description "Geometry of the object contour. Note that there is some flexibility in the choice of the local coordinate system (X1,X2,X3). The data provider should choose the most convenient coordinate system for the object, respecting the definitions of (X1,X2,X3) indicated below." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:geometry_type ],
        [ sh:class spo:Identifier ;
            sh:description "Curvature of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:curvature_type ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of curvature in the X1 direction, to be filled only for curvature_type/index = 2, 4 or 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:x1_curvature ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Coordinates of the origin of the local coordinate system (X1,X2,X3) describing the object. This origin is located within the object area and should be the middle point of the object surface. If geometry_type=2, it's the centre of the circular object. If geometry_type=3, it's the centre of the rectangular object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:centre ],
        [ sh:class spo:Identifier ;
            sh:description "Material of the object" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:material ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:X1x21dStatic ;
            sh:description "Irregular outline of the object in the (X1, X2) coordinate system, used only if geometry_type/index=1. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:integer ;
            sh:description "Miller indices characterizing the cut of the crystal (can be of length 3 or 4)" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:cut ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Thickness of the crystal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:thickness ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of the circle, used only if geometry_type/index = 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Surface of the object, derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:surface ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the object in the X2 direction, used only if geometry_type/index = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:x2_width ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Bragg wavelength of the crystal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:wavelength_bragg ],
        [ sh:datatype xsd:float ;
            sh:description "Bragg angle of the crystal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:angle_bragg ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the object in the X1 direction, used only if geometry_type/index = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:x1_width ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:x2_unit_vector ] ;
    sh:targetClass fyo:SpectrometerXRayCrystalCrystal .

fyo:SpectrometerXRayCrystalFrame a sh:NodeShape ;
    rdfs:comment "Set of frames" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Number of counts detected on each pixel/bin of the binned frame during one exposure time" ;
