            sh:order 20 ;
            sh:path fyo:methane_carbon_13 ],
        [ sh:class fyo:SummaryConstantInt0d ;
            sh:description "Flag set to 1 if any gas other than H, D, T, He is puffed during the prefill, 0 otherwise" ;
            sh:maxCount 1 ;
