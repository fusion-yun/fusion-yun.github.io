fyo:PulseSchedulePosition a sh:NodeShape ;
    rdfs:comment "Plasma position and shape control references" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PulseScheduleRz ;
            sh:description "RZ position of the current centroid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:current_centroid ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Lower triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:triangularity_lower ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Elongation (upper half w.r.t. geometric axis) of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:elongation_upper ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Minor triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:triangularity_minor ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Upper triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:triangularity_upper ],
        [ sh:class fyo:PulseScheduleRz ;
            sh:description "Magnetic axis position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:magnetic_axis ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Minor radius of the plasma boundary (defined as (Rmax-Rmin) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:minor_radius ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Inner triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:triangularity_inner ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Height of the separatrix point of maximum major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:z_r_max ],
        [ sh:class fyo:PulseScheduleRz ;
            sh:description "RZ position of the active limiter point (point of the plasma boundary in contact with the limiter)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:active_limiter_point ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Upper outer squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:squareness_upper_outer ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Lower outer squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:squareness_lower_outer ],
        [ sh:class fyo:PulseScheduleOutline ;
            sh:description "Set of (R,Z) points defining the outline of the plasma boundary" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:boundary_outline ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Upper inner squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:squareness_upper_inner ],
        [ sh:class fyo:PulseScheduleRz ;
            sh:description "Array of strike points, for each of them the RZ position is given" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:strike_point ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Elongation of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:elongation ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Elongation (lower half w.r.t. geometric axis) of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:elongation_lower ],
        [ sh:class fyo:PulseScheduleGap ;
            sh:description "Set of gaps, defined by a reference point and a direction." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:gap ],
        [ sh:class fyo:PulseScheduleRz ;
            sh:description "RZ position of the geometric axis (defined as (Rmin+Rmax) / 2 and (Zmin+Zmax) / 2 of the boundary)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:geometric_axis ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Outer triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:triangularity_outer ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Lower inner squareness of the plasma boundary (definition from T. Luce, Plasma Phys. Control. Fusion 55 (2013) 095009)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:squareness_lower_inner ],
        [ sh:class fyo:PulseScheduleRz ;
            sh:description "Array of X-points, for each of them the RZ position is given" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:x_point ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Height of the separatrix point of minimum major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:z_r_min ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Control mode (operation mode and/or settings used by the controller)" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:mode ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes located at this level of the IDS structure and below" ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fyo:time ],
        [ sh:class fyo:PulseScheduleReferencePosition ;
            sh:description "Triangularity of the plasma boundary" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:triangularity ] ;
    sh:targetClass fyo:PulseSchedulePosition .

fyo:PulseScheduleTf a sh:NodeShape ;
    rdfs:comment "Toroidal field references" ;
    sh:closed true ;
