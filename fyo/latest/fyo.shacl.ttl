            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the vacuum error magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:b_field_phi ] ;
    sh:targetClass fyo:BFieldNaFieldMap .

