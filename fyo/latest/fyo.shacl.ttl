fyo:EquilibriumSolve a sh:NodeShape ;
    rdfs:comment "A Grad–Shafranov equilibrium solve (fixed or free boundary; built-in fyeq or external plugins) — writes back the equilibrium IDS (enabling-core scenario S-2). Axisymmetric by construction (configuration applicability boundary)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:consumes_ids ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:produces_ids ] ;
    sh:targetClass fyo:EquilibriumSolve .

fyo:ExperimentAnalysisTask a sh:NodeShape ;
    rdfs:comment "An experiment-analysis / inversion run (S-8, primary). FUNCTION: assemble measured diagnostic IDS occurrences of one Discharge (via the data-adaptation face, S-5), pose the plasma configuration θ as the unknown, and minimize / infer over ℒ(θ)=‖F(θ)−d_obs‖²_Σ — where F is the SHARED forward operator composed with the diagnostic geometry / response (SyntheticDiagnosticEvaluation) — yielding reconstructed equilibrium and profiles with quantified misfit. Direction: inverse (d_obs → θ). The inference engine is exchangeable (least-squares / MAP / Bayesian / UQ) over the fixed forward spine. Inputs carry modality `measured`; outputs carry modality `reconstructed` (measured-derived) in their provenance." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "INPUT (optional) — parameterization, regularization and prior information (the middle layer of the forward / parameterization+prior / inference-engine decoupling)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:constraints_and_priors ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000011> ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the reconstructed kinetic core profiles; modality reconstructed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:reconstructed_profiles ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence consumed by this task (refines spo has_input to the lifted-DD information layer). The intended DD module is named per-attribute via `fyo_ids:`." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:consumes_ids ],
        [ sh:class fyo:MachineDescription ;
            sh:description "INPUT — static as-built machine description (probe / chord / sensor positions, wall and coil geometry) fixing the diagnostic geometry operators." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:machine_description ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:has_input ],
        [ sh:class fyo:ConvergenceCriterion ;
            sh:description "The explicit convergence criterion of this task's scenario loop — a configurable modeling decision (e.g. psi-residual RMS threshold + iteration cap), never an implicit solver internal (enabling-core goal G-3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:converges_by ],
        [ sh:class fyo:InferenceEngine ;
            sh:description "The exchangeable inference engine stacked on the fixed forward spine (least-squares reconstruction / MAP / Bayesian posterior / UQ propagation are engine choices, not forward-model changes)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:uses_inference_engine ],
        [ sh:class fyo:ScenarioSpecification ;
            sh:description "The ScenarioSpecification this task run realizes (OBI planned-process pattern narrowed to application tasks): the run is the occurrent, the scenario declaration is the directive ICE it executes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000055> ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class fyo:IDS ;
            sh:description "OUTPUT — the reconstructed equilibrium (flux map, boundary, global quantities) best matching the measurements; modality reconstructed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:reconstructed_equilibrium ],
        [ sh:datatype xsd:string ;
            sh:description "Informative — WHICH quantities this task treats as free (the lifecycle-table \"自由量\" column, FYTOK-CONOPS-00 §conops-fytok-lifecycle): device static parameters, actuator waveforms, plasma configuration θ, … The tasks share one kernel; what varies is what is free this time." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:free_variables ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000030> ;
            sh:description "The Machine this discharge is performed on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:performed_on ],
        [ sh:class <http://purl.obolibrary.org/obo/IAO_0000030> ;
            sh:description "OUTPUT — the residual / uncertainty report of the inference (per-channel misfit, posterior spreads when a Bayesian engine is used)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:misfit_report ],
        [ sh:class fyo:ForwardOperator ;
            sh:description "The shared forward operator F this task stacks its method on. All five application tasks reuse the SAME equilibrium–transport–source forward kernel (FYTOK-REPORT-107: \"正向脊柱 不动、推断引擎可换\"); they differ only in the outer operators applied around it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:uses_forward_operator ],
        [ sh:class fyo:IDS ;
            sh:description "An IDS occurrence produced by this task (refines spo has_output to the lifted-DD information layer); its data modality (simulated / reconstructed) is carried by the IDS ProvenanceMixin, not by the schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:produces_ids ],
        [ sh:class fyo:IDS ;
            sh:description "INPUT — the measured diagnostic signal set of the analyzed discharge (d_obs): magnetic probes / flux loops, interferometry / polarimetry, Thomson scattering, charge exchange, ECE, MSE, bolometry, … — each an IDS occurrence with modality `measured`, produced by the MeasurementProcesses of the Discharge." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:measured_diagnostics ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_output ] ;
    sh:targetClass fyo:ExperimentAnalysisTask .

fyo:Ferritic a sh:NodeShape ;
