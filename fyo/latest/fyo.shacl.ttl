fyo:CameraVisibleDetector a sh:NodeShape ;
    rdfs:comment "Set of detectors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CameraVisibleGeometryMatrix ;
            sh:description "Description of geometry matrix (ray transfer matrix)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:geometry_matrix ],
        [ sh:datatype xsd:float ;
            sh:description "Lower bound of the detector wavelength range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:wavelength_lower ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:CameraVisibleFrame ;
            sh:description "Set of frames" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:frame ],
        [ sh:datatype xsd:float ;
            sh:description "Alpha angle of each pixel in the horizontal axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:pixel_to_alpha ],
        [ sh:datatype xsd:float ;
            sh:description "Detector noise (e.g. read-out noise) (rms counts per second exposure time)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:noise ],
        [ sh:datatype xsd:float ;
            sh:description "Beta angle of each pixel in the vertical axis" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:pixel_to_beta ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of pixel lines in the vertical direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:lines_n ],
        [ sh:datatype xsd:float ;
            sh:description "Upper bound of the detector wavelength range" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:wavelength_upper ],
        [ sh:datatype xsd:float ;
            sh:description "Counts to radiance factor, for each pixel of the detector. Includes both the transmission losses in the relay optics and the quantum efficiency of the camera itself, integrated over the wavelength range" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:counts_to_radiance ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of pixel columns in the horizontal direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:columns_n ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:exposure_time ] ;
    sh:targetClass fyo:CameraVisibleDetector .

fyo:CameraVisibleFrame a sh:NodeShape ;
    rdfs:comment "Set of frames" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Radiance image. First dimension : line index (horizontal axis). Second dimension: column index (vertical axis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:radiance ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:integer ;
            sh:description "Raw image (unprocessed) (digital levels). First dimension : line index (horizontal axis). Second dimension: column index (vertical axis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:image_raw ] ;
    sh:targetClass fyo:CameraVisibleFrame .

fyo:CameraVisibleGeometryMatrix a sh:NodeShape ;
    rdfs:comment "Description of geometry matrix (ray transfer matrix)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Voxel map for geometry matrix. The cells with same number are merged in the computation into a single emission source meta-cell (the voxel). Cells with number -1 are excluded. Voxel count starts from 0." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:voxel_map ],
        [ sh:class fyo:CameraVisibleGeometryMatrixStep2 ;
            sh:description "Geometry matrix without reflections" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:without_reflections ],
        [ sh:class fyo:CameraVisibleGeometryMatrixStep2 ;
            sh:description "Geometry matrix with reflections" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:with_reflections ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of voxels defined in the voxel_map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:voxels_n ],
        [ sh:class fyo:GeometryMatrixEmission ;
            sh:description "Grid defining the light emission cells" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:emission_grid ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CameraVisibleGeometryMatrixInterpolated ;
            sh:description "Interpolated geometry matrix for reflected light" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:interpolated ] ;
    sh:targetClass fyo:CameraVisibleGeometryMatrix .

fyo:CameraVisibleGeometryMatrixInterpolated a sh:NodeShape ;
    rdfs:comment "Interpolated geometry matrix for reflected light" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Interpolated Ray Transfer Matrix (RTM, or geometry matrix), which provides transformation of the reflected light from each interpolation knot to the receiver (detector pixel). When convolving with an emission profile, the values must be interpolated to the emission grid and multiplied by the volume of the grid cells. The interpolated matrix is given on an array of interpolation knots of coordinates r, z and phi (third dimension of this array). The first two dimension correspond to the detector pixels : first dimension : line index (horizontal axis); second dimension: column index (vertical axis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:float ;
            sh:description "Height of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle (oriented counter-clockwise when viewing from above) of interpolation knots" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:CameraVisibleGeometryMatrixInterpolated .

fyo:CameraXRaysFrame a sh:NodeShape ;
    rdfs:comment "Set of frames. Each time step corresponds to the beginning of the photon integration of each image" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of counts detected on each pixel during one exposure time. First dimension : line index (horizontal axis). Second dimension: column index (vertical axis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:counts_n ] ;
    sh:targetClass fyo:CameraXRaysFrame .

fyo:ChargeExchangeChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (lines-of-sight). The line-of-sight is defined by the centre of the collimating aperture and the position of the measurements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Diameter at the image plane (typically the diameter of the optical fibre)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:image_diameter ],
        [ sh:class fyo:ChargeExchangeChannelIonFast ;
            sh:description "Derived Fast Ion Charge eXchange (FICX) parameters" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:ion_fast ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Etendue (geometric extent) of the optical system for this channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:etendue ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Ionic effective charge, line average along the channel line-of-sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:zeff_line_average ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the total plasma toroidal momentum" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:momentum_phi_method ],
        [ sh:class fyo:Rphiz1dDynamicAos1 ;
            sh:description "Position of the measurements (assuming point emission)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:position ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the average ion temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:t_i_average_method ],
        [ sh:datatype xsd:float ;
            sh:description "Diameter of the base of the optical cone at the entrance pupil" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:cone_diameter ],
        [ sh:class fyo:ChargeExchangeChannelIon ;
            sh:description "Physical quantities related to ion species and charge stage (H+, D+, T+, He+2, Li+3, Be+4, C+6, N+7, O+8, Ne+10, Si+14, Ar+16 or Ar+18) derived from the measured charge exchange emission of each species, at the position of the measurement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:ion ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Ion temperature (averaged on charge states and ion species) at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:t_i_average ],
        [ sh:class spo:Identifier ;
            sh:description "Method used to calculate the etendue. Index = 0 : exact calculation with a 4D integral; 1 : approximation with first order formula (detector surface times solid angle subtended by the apertures); 2 : other methods" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:etendue_method ],
        [ sh:class fyo:ChargeExchangeChannelSpectrum ;
            sh:description "Set of spectra obtained by various gratings" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:spectrum ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of the collimating aperture for this channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:aperture ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Local ionic effective charge at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:zeff ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the local effective charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:zeff_method ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the line average effective charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:zeff_line_average_method ],
        [ sh:class fyo:ChargeExchangeChannelBes ;
            sh:description "Derived Beam Emission Spectroscopy (BES) parameters" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:bes ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Total plasma toroidal momentum, summed over ion species and electrons weighted by their density and major radius, i.e. sum_over_species(n*R*m*Vphi), at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:momentum_phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Focal length of the collector lens" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:focal_length ] ;
    sh:targetClass fyo:ChargeExchangeChannel .

fyo:ChargeExchangeChannelBes a sh:NodeShape ;
    rdfs:comment "Derived Beam Emission Spectroscopy (BES) parameters" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt2d ;
            sh:description "Calibrated intensities of the 9 splitted lines (Stark effect due to Lorentz electric field). Note: radiances are integrated over the sightline crossing the neutral beam" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:radiances ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Unshifted wavelength of the BES transition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:transition_wavelength ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge of the diagnostic neutral beam particle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Lorentz shift due to the Lorentz electric field (vxB) in the frame of the diagnostic neutral beam particles moving with a velocity v across the magnetic field B" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:lorentz_shift ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the diagnostic neutral beam particle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom of the diagnostic neutral beam particle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge of the diagnostic neutral beam particle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_n ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Doppler shift due to the diagnostic neutral beam particle velocity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:doppler_shift ] ;
    sh:targetClass fyo:ChargeExchangeChannelBes .

fyo:ChargeExchangeChannelIon a sh:NodeShape ;
    rdfs:comment "Physical quantities related to ion species and charge stage (H+, D+, T+, He+2, Li+3, Be+4, C+6, N+7, O+8, Ne+10, Si+14, Ar+16 or Ar+18) derived from the measured charge exchange emission of each species, at the position of the measurement" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Ion concentration (ratio of the ion density over the electron density) at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:n_i_over_n_e ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to derive the ion concentration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:n_i_over_n_e_method ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the ion toroidal velocity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:velocity_phi_method ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_n ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Poloidal velocity of the ion (oriented clockwise when seen from front on the right side of the tokamak axi-symmetry axis) at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:velocity_pol ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom of the ion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Toroidal velocity of the ion (oriented counter-clockwise when seen from above) at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:velocity_phi ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to derive the ion temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:t_i_method ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the ion (e.g. H+, D+, T+, He+2, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:name ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the ion poloidal velocity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:velocity_pol_method ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Ion temperature at the channel measurement point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:t_i ] ;
    sh:targetClass fyo:ChargeExchangeChannelIon .

fyo:ChargeExchangeChannelIonFast a sh:NodeShape ;
    rdfs:comment "Derived Fast Ion Charge eXchange (FICX) parameters" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Calibrated radiance of the fast ion charge exchange spectrum assuming the shape is pre-defined (e.g. by the Fokker-Planck slowing-down function). Note: radiance is integrated over the sightline crossing the neutral beam" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:radiance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge of the fast ion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_n ],
        [ sh:datatype xsd:float ;
            sh:description "Fast ion charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:float ;
            sh:description "Unshifted wavelength of the fast ion charge exchange transition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:transition_wavelength ],
        [ sh:class spo:Identifier ;
            sh:description "Description of the method used to reconstruct the fast ion charge exchange spectrum (e.g. what pre-defined slowing-down and source functions used)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:radiance_spectral_method ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the fast ion (e.g. H+, D+, T+, He+2, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom of the fast ion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ] ;
    sh:targetClass fyo:ChargeExchangeChannelIonFast .

fyo:ChargeExchangeChannelProcessedLine a sh:NodeShape ;
    rdfs:comment "Set of processed spectral lines" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String identifying the processed spectral line: Spectroscopy notation emitting element (e.g. D I, Be IV,  W I, C VI), transition - if known - between round brackets (e.g. (3-2) ) and indication type of charge exchange - if applicable - between square brackets (e.g. [ACX] or [PCX]). Example for beryllium active charge exchange line at 468.5 nm: 'Be IV (8-6) [ACX]'. Example for impact excitation tungsten line coming from the plasma edge: 'W I'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Full width at Half Maximum (FWHM) of the emission line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:width ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Non-calibrated intensity (integrated over the spectrum for this line), i.e. number of photoelectrons detected by unit time, taking into account electronic gain compensation and channels relative calibration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:intensity ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Calibrated, background subtracted radiance (integrated over the spectrum for this line)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:radiance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Shift of the emission line wavelength with respected to the unshifted cental wavelength (e.g. Doppler shift)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:shift ],
        [ sh:datatype xsd:float ;
            sh:description "Unshifted central wavelength of the processed spectral line" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:wavelength_central ] ;
    sh:targetClass fyo:ChargeExchangeChannelProcessedLine .

fyo:ChargeExchangeChannelSpectrum a sh:NodeShape ;
    rdfs:comment "Set of spectra obtained by various gratings" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt2d ;
            sh:description "Intensity spectrum (not calibrated), i.e. number of photoelectrons detected by unit time by a wavelength pixel of the channel, taking into account electronic gain compensation and channels relative calibration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:intensity_spectrum ],
        [ sh:datatype xsd:float ;
            sh:description "Radiance calibration" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:radiance_calibration ],
        [ sh:datatype xsd:float ;
            sh:description "Number of grating lines per unit length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grating ],
        [ sh:class fyo:ChargeExchangeChannelProcessedLine ;
            sh:description "Set of processed spectral lines" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:processed_line ],
        [ sh:datatype xsd:string ;
            sh:description "Date of the wavelength calibration (yyyy_mm_dd)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:wavelength_calibration_date ],
        [ sh:datatype xsd:float ;
            sh:description "Measured wavelengths" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:wavelengths ],
        [ sh:datatype xsd:float ;
            sh:description "Array of Gaussian widths and amplitudes which as a sum make up the instrument fuction. IF(lambda) = sum( instrument_function(1,i)/sqrt(2 * pi * instrument_function(2,i)^2  ) * exp( -lambda^2/(2 * instrument_function(2,i)^2) )  ),whereby sum( instrument_function(1,i) ) = 1" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:instrument_function ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Width of the slit (placed in the object focal plane)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:slit_width ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:exposure_time ],
        [ sh:datatype xsd:string ;
            sh:description "Date of the radiance calibration (yyyy_mm_dd)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:radiance_calibration_date ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Calibrated continuum intensity  in the middle of the spectrum per unit wavelength" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:radiance_continuum ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Calibrated spectral radiance (radiance per unit wavelength)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:radiance_spectral ] ;
    sh:targetClass fyo:ChargeExchangeChannelSpectrum .

fyo:CoilConductor a sh:NodeShape ;
    rdfs:comment "Set of conductors inside the coil. The structure can be used with size 1 for a simplified description as a single conductor. A conductor is composed of several elements, serially connected, i.e. transporting the same current." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Voltage on the conductor terminals. Sign convention : positive when the current flows in the direction in which conductor elements are ordered (from start to end for a positive polarity coil)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:voltage ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:CoilCrossSection ;
            sh:description "The cross-section perpendicular to the conductor contour is described by a series of contour points, given by their relative position with respect to the start point of each element. If the size of this array of structure is equal to 1, then the cross-section is given only for the first element and translated along the conductor elements. Otherwise, it's given explictly for each element, allowing to describe changes of the cross section shape" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:cross_section ],
        [ sh:datatype xsd:float ;
            sh:description "conductor resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:resistance ],
        [ sh:class fyo:CoilConductorElements ;
            sh:description "Set of geometrical elements (line segments and/or arcs of a circle) describing the contour of the conductor centre. We define a coordinate system associated to each element as follows: for the arc and circle elements: binormal = (start point - center) x (intermediate point - center). This vector points in the direction of the circle / arc axis. normal = (center - point on curve). The normal vector will rotate as the point moves around the curve. Tangent = normal x binormal. For the line element we require an extra point, using the currently redundant intermediate point to define the line element's normal axis. The local coordinates for the line element then become: tangent = end point - start point; normal = intermediate point - start point; binormal = tangent x normal. It is assumed that all the axes above are normalized such that they have a unit length." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:elements ] ;
    sh:targetClass fyo:CoilConductor .

fyo:CoilConductorElements a sh:NodeShape ;
    rdfs:comment "Set of geometrical elements (line segments and/or arcs of a circle) describing the contour of the conductor centre. We define a coordinate system associated to each element as follows: for the arc and circle elements: binormal = (start point - center) x (intermediate point - center). This vector points in the direction of the circle / arc axis. normal = (center - point on curve). The normal vector will rotate as the point moves around the curve. Tangent = normal x binormal. For the line element " ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:CoilNaRphiz1dStatic ;
            sh:description "Position of the end point of every element. Meaningful only if type/index = 1 or 2, fill with default/empty value otherwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:end_points ],
        [ sh:class fyo:CoilNaRphiz1dStatic ;
            sh:description "Position of the centre of the arc of a circle of every element (meaningful only if type/index = 2 or 3, fill with default/empty value otherwise)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:centres ],
        [ sh:class fyo:CoilNaRphiz1dStatic ;
            sh:description "Position of an intermediate point along the circle or arc of circle, for every element, providing the orientation of the element (must define with the corresponding start point an aperture angle strictly inferior to PI). In the case of a line segment (../types/index=1), fill this node with a point such that the vector intermediate_point - start_point defines the direction of the element's normal axis (see documentation of ../elements)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:intermediate_points ],
        [ sh:class fyo:CoilNaRphiz1dStatic ;
            sh:description "Position of the start point of every element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:start_points ],
        [ sh:datatype xsd:integer ;
            sh:description "Type of every element: 1: line segment, its ends are given by the start and end points; index = 2: arc of a circle; index = 3: full circle" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:types ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:CoilConductorElements .

fyo:CoilCrossSection a sh:NodeShape ;
    rdfs:comment "The cross-section perpendicular to the conductor contour is described by a series of contour points, given by their relative position with respect to the start point of each element. If the size of this array of structure is equal to 1, then the cross-section is given only for the first element and translated along the conductor elements. Otherwise, it's given explictly for each element, allowing to describe changes of the cross section shape" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Inner radius of the annulus, used only if geometry_type/index = 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:radius_inner ],
        [ sh:class spo:Identifier ;
            sh:description "Geometry type used to describe the cross section of this element. The conductor centre is given by the ../../elements description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:class fyo:NormalBinormalStatic ;
            sh:description "Polygonal outline of the cross section in the (normal, binormal) coordinate system. Do NOT repeat the first point." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:float ;
            sh:description "Area of the conductor cross-section, derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Full height of the rectangle in the binormal direction, used only if geometry_type/index = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:height ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the rectangle or square in the normal direction, when geometry_type/index = 3 or 4. Diameter of the circle when geometry_type/index = 2. Outer diameter of the annulus in case geometry_type/index = 5" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:width ] ;
    sh:targetClass fyo:CoilCrossSection .

fyo:Complex1dMhdAlfvenSpectrum a sh:NodeShape ;
    rdfs:comment "Local shear Alfven spectrum as a function of radius (only in case grid/dim1 is a radial coordinate)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Real part of the frequency, for a given radial position and every root found at this position" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:real ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Imaginary part of the frequency, for a given radial position and every root found at this position" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:imaginary ] ;
    sh:targetClass fyo:Complex1dMhdAlfvenSpectrum .

fyo:ControllersLinearController a sh:NodeShape ;
    rdfs:comment "A linear controller, this is rather conventional" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the output signals following the SDN convention" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:output_names ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Output signals; the timebase is common to inputs and outputs for any particular controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:outputs ],
        [ sh:class fyo:ControllersStatespace ;
            sh:description "Statespace controller in discrete or continuous time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:statespace ],
        [ sh:datatype xsd:string ;
            sh:description "Description of this controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Input signals; the timebase is common to inputs and outputs for any particular controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:inputs ],
        [ sh:datatype xsd:string ;
            sh:description "One of a known class of controllers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:controller_class ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:ControllersPid ;
            sh:description "Filtered PID controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:pid ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the input signals, following the SDN convention" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:input_names ] ;
    sh:targetClass fyo:ControllersLinearController .

fyo:ControllersNonlinearController a sh:NodeShape ;
    rdfs:comment "A non-linear controller, this is less conventional and will have to be developed" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Output signal names following the SDN convention" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:output_names ],
        [ sh:datatype xsd:string ;
            sh:description "One of a known class of controllers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:controller_class ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the input signals, following the SDN convention" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:input_names ],
        [ sh:datatype xsd:string ;
            sh:description "Description of this controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Method to be defined" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:function ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Input signals; the timebase is common  to inputs and outputs for any particular controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:inputs ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Output signals; the timebase is common  to inputs and outputs for any particular controller" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:outputs ] ;
    sh:targetClass fyo:ControllersNonlinearController .

fyo:ControllersPid a sh:NodeShape ;
    rdfs:comment "Filtered PID controller" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt3d ;
            sh:description "Integral term" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:i ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Filter time-constant for the D-term" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:tau ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "Proportional term" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:p ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "Derivative term" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:d ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:ControllersPid .

fyo:ControllersStatespace a sh:NodeShape ;
    rdfs:comment "Statespace controller in discrete or continuous time" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "D matrix, normally proper and D=0" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:d ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Discrete time sampling interval ; if less than 1e-10, the controller is considered to be expressed in continuous time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:deltat ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Names of the states" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:state_names ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "A matrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:a ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "C matrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:c ],
        [ sh:class fyo:SignalFlt3d ;
            sh:description "B matrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:b ] ;
    sh:targetClass fyo:ControllersStatespace .

fyo:CoreInstantChangesChange a sh:NodeShape ;
    rdfs:comment "Set of instant change terms (each being due to a different phenomenon)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Instant change term identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:CoreProfilesProfiles1d ;
            sh:description "Changes in 1D core profiles for various time slices. This structure mirrors core_profiles/profiles_1d and describes instant changes to each of these physical quantities (i.e. a signed difference quantity after change - quantity before change)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:profiles_1d ] ;
    sh:targetClass fyo:CoreInstantChangesChange .

fyo:CoreProfile2dIons a sh:NodeShape ;
    rdfs:comment "2D quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionization states (or other types of states) must be differentiated at the state level below. This array doesn't necessarily have the same size as the profiles_1d/ion array, since 2D data may be relevant only for a subset of ion species." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding ion species in the ../../../profiles_1d/ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:ion_index ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only the 'ion' level is considered and the 'state' array of structure is empty; 1-Ion states are considered and are described in the 'state' array of structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency  (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken) (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:CoreProfiles2dIonsStates ;
            sh:description "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionization state; lumped ions are allowed), volume averaged over plasma radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:class fyo:CoreProfiles2dVectorComponents2 ;
            sh:description "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:velocity ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H, D, T, He, C, D2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:CoreProfile2dIons .

fyo:CoreProfileIons a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. Ionization states (or other types of states) must be differentiated at the state level below" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Average square charge of the ion species (sum of states square charge weighted by state density and divided by ion density)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:z_ion_square_1d ],
        [ sh:class fyo:CoreProfilesVectorComponents2 ;
            sh:description "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:velocity ],
        [ sh:class fyo:CoreProfilesIonsChargeStates2 ;
            sh:description "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the density profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:density_validity ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency  (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken) (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Average charge of the ion species (sum of states charge weighted by state density and divided by ion density)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:z_ion_1d ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the temperature profile. 0: valid from automated processing, 1: valid and certified by the RO; - 1 means problem identified in the data processing (request verification by the RO), -2: invalid data, should not be used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:temperature_validity ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:density ],
        [ sh:class fyo:CoreProfiles1DFit ;
            sh:description "Information on the fit used to obtain the density profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:density_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only the 'ion' level is considered and the 'state' array of structure is empty; 1-Ion states are considered and are described in the 'state' array of structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:class fyo:CoreProfiles1DFit ;
            sh:description "Information on the fit used to obtain the temperature profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:temperature_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding neutral species in the ../../neutral array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:neutral_index ],
        [ sh:datatype xsd:float ;
            sh:description "Ion charge (of the dominant ionization state; lumped ions are allowed), volume averaged over plasma radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:temperature ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H, D, T, He, C, D2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ] ;
    sh:targetClass fyo:CoreProfileIons .

fyo:CoreProfileNeutral a sh:NodeShape ;
    rdfs:comment "Quantities related to the different neutral species" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:pressure ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the corresponding ion species in the ../../ion array" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:ion_index ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, He, C, D2, DT, CD4, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:name ],
        [ sh:class fyo:PlasmaCompositionNeutralElement ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature (average over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:temperature ],
        [ sh:class fyo:CoreProfilesNeutralState ;
            sh:description "Quantities related to the different states of the species (energy, excitation, ...)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:state ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure  (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:integer ;
            sh:description "Multiple states calculation flag : 0-Only one state is considered; 1-Multiple states are considered and are described in the state structure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:multiple_states_flag ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2) (sum over charge states when multiple charge states are considered)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:CoreProfileNeutral .

fyo:CoreProfiles2dIonsStates a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken)" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z of the charge state bundle, volume averaged over the plasma radius (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_average ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z square of the charge state bundle, volume averaged over the plasma radius (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z_square_average ],
        [ sh:datatype xsd:float ;
            sh:description "Cumulative and average ionization potential to reach a given bundle. Defined as sum (x_z* (sum of Epot from z'=0 to z-1)), where Epot is the ionization potential of ion Xz’+, and x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:ionization_potential ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:name ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:pressure ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:vibrational_level ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:density_fast ] ;
    sh:targetClass fyo:CoreProfiles2dIonsStates .

fyo:CoreProfiles2dVectorComponents2 a sh:NodeShape ;
    rdfs:comment "Velocity (average over charge states when multiple charge states are considered) at the position of maximum major radius on every flux surface" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:toroidal ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel component" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal component" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:poloidal ],
        [ sh:datatype xsd:float ;
            sh:description "Radial component" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:radial ],
        [ sh:datatype xsd:float ;
            sh:description "Diamagnetic component" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:diamagnetic ] ;
    sh:targetClass fyo:CoreProfiles2dVectorComponents2 .

fyo:CoreProfilesGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Various global quantities derived from the profiles" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Ion temperature (averaged over ion species and states) peaking factor, defined as the Ti value at the magnetic axis divided by the volume averaged Ti (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:t_i_average_peaking ],
        [ sh:datatype xsd:float ;
            sh:description "Total non-inductive current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:current_non_inductive ],
        [ sh:datatype xsd:float ;
            sh:description "Electron temperature peaking factor, defined as the Te value at the magnetic axis divided by the volume averaged Te (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:t_e_peaking ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal beta. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:beta_pol ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time slice of the profiles_1d array used to define the ion composition of the global_quantities/ion array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:ion_time_slice ],
        [ sh:datatype xsd:float ;
            sh:description "Resistive part of the poloidal flux losses, defined as the volume-averaged scalar product of the electric field and the ohmic current density, normalized by the plasma current and integrated in time from the beginning of the plasma discharge: int ( (int(E_field_tor.j_ohm_tor) dV) / Ip ) dt)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:resistive_psi_losses ],
        [ sh:datatype xsd:float ;
            sh:description "LCFS loop voltage (positive value drives positive ohmic current that flows anti-clockwise when viewed from above)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:v_loop ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged electron temperature (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:t_e_volume_average ],
        [ sh:datatype xsd:float ;
            sh:description "Bootstrap current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:current_bootstrap ],
        [ sh:datatype xsd:float ;
            sh:description "Ejima coefficient : resistive psi losses divided by (mu0*R*Ip). See S. Ejima et al, Nuclear Fusion, Vol.22, No.10 (1982), 1313" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:ejima ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal beta, defined as the volume-averaged total perpendicular pressure divided by (B0^2/(2*mu0)), i.e. beta_toroidal = 2 mu0 int(p dV) / V / B0^2" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:beta_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Volume average plasma effective charge, estimated from the flux consumption in the ohmic phase" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:z_eff_resistive ],
        [ sh:datatype xsd:float ;
            sh:description "Internal inductance. The li_3 definition is used, i.e. li_3 = 2/R0/mu0^2/Ip^2 * int(Bp^2 dV)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:li_3 ],
        [ sh:class fyo:CoreProfilesGlobalQuantitiesIon ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. The set of ion species of this array must be the same as the one defined in profiles_1d/ion, at the time slice indicated in ion_time_slice" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:float ;
            sh:description "Total plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:ip ],
        [ sh:datatype xsd:float ;
            sh:description "Plasma energy content = 3/2 * integral over the plasma volume of the total perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:energy_diamagnetic ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged electron density (average over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fyo:n_e_volume_average ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized toroidal beta, defined as 100 * beta_tor * a[m] * B0 [T] / ip [MA]" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:beta_tor_norm ] ;
    sh:targetClass fyo:CoreProfilesGlobalQuantities .

fyo:CoreProfilesGlobalQuantitiesIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences. The set of ion species of this array must be the same as the one defined in profiles_1d/ion, at the time slice indicated in ion_time_slice" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged density of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_i_volume_average ],
        [ sh:datatype xsd:float ;
            sh:description "Volume averaged temperature of this ion species (averaged over the plasma volume up to the LCFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:t_i_volume_average ] ;
    sh:targetClass fyo:CoreProfilesGlobalQuantitiesIon .

fyo:CoreProfilesIonsChargeStates2 a sh:NodeShape ;
    rdfs:comment "Quantities related to the different states of the species (ionization, energy, excitation, ...)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Average Z of the charge state bundle, volume averaged over the plasma radius (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z_average ],
        [ sh:datatype xsd:float ;
            sh:description "Minimum Z of the charge state bundle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:z_min ],
        [ sh:datatype xsd:float ;
            sh:description "Maximum Z of the charge state bundle (equal to z_min if no bundle)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_max ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal rotation frequency (i.e. toroidal velocity divided by the major radius at which the toroidal velocity is taken)" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fyo:rotation_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "Density of fast (non-thermal) particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fyo:density_fast ],
        [ sh:datatype xsd:float ;
            sh:description "Average square charge profile of the charge state bundle (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:z_average_square_1d ],
        [ sh:datatype xsd:float ;
            sh:description "Density (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:density ],
        [ sh:datatype xsd:float ;
            sh:description "Temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:temperature ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) perpendicular pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fyo:pressure_fast_perpendicular ],
        [ sh:datatype xsd:string ;
            sh:description "Configuration of atomic orbitals of this state, e.g. 1s2-2s1" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:electron_configuration ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal+non-thermal)" ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fyo:pressure ],
        [ sh:class fyo:CoreProfilesVectorComponents3 ;
            sh:description "Velocity at the position of maximum major radius on every flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:velocity ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying state (e.g. C+, C+2 , C+3, C+4, C+5, C+6, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Average charge profile of the charge state bundle (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:z_average_1d ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Fast (non-thermal) parallel pressure" ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fyo:pressure_fast_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Cumulative and average ionization potential to reach a given bundle. Defined as sum (x_z* (sum of Epot from z'=0 to z-1)), where Epot is the ionization potential of ion Xz’+, and x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:ionization_potential ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Density of thermal particles" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fyo:density_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Average Z square of the charge state bundle, volume averaged over the plasma radius (equal to z_min squared if no bundle), = sum (Z^2*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:z_square_average ],
        [ sh:datatype xsd:float ;
            sh:description "Pressure (thermal) associated with random motion ~average((v-average(v))^2)" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fyo:pressure_thermal ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:vibrational_level ],
        [ sh:class fyo:CoreProfiles1DFit ;
            sh:description "Information on the fit used to obtain the density profile" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:density_fit ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:vibrational_mode ] ;
    sh:targetClass fyo:CoreProfilesIonsChargeStates2 .

fyo:CoreProfilesNeutralState a sh:NodeShape ;
