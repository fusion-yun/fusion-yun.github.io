fyo:LangmuirProbesPositionReciprocating a sh:NodeShape ;
    rdfs:comment "Average position of the measurements derived from multiple collectors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the position data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the position data for the whole plunge. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:validity ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:LangmuirProbesPositionReciprocating .

fyo:LangmuirProbesPositionReciprocating2 a sh:NodeShape ;
    rdfs:comment "Position of the collector" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the position data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the position data for the whole plunge. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:validity ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:LangmuirProbesPositionReciprocating2 .

fyo:LangmuirProbesReciprocating a sh:NodeShape ;
    rdfs:comment "Set of reciprocating probes" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Area of the surface exposed to the plasma of each collector (constant assuming negligible dependence on e.g. the magnetic field line angle)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:surface_area ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:LangmuirProbesPlunge ;
            sh:description "Set of plunges of this probe during the pulse, each plunge being recorded as a time slice from the Access Layer point of view. The time child node corresponds to the time of maximum penetration of the probe during a given plunge. The dynamics of physical quantities within the plunge are described via the time_within_plunge vector." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:plunge ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ] ;
    sh:targetClass fyo:LangmuirProbesReciprocating .

fyo:LhAntennasAntenna a sh:NodeShape ;
    rdfs:comment "Set of Lower Hybrid antennas" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Power reflection coefficient, averaged over modules" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:reflection_coefficient ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:LhAntennasAntennaModule ;
            sh:description "Set of antenna modules" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:module ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power launched from this antenna into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:power_launched ],
        [ sh:datatype xsd:float ;
            sh:description "Frequency" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Radial distance to the antenna mouth (grid for the electron density profile). 0 at antenna mouth, increasing towards the plasma" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:distance_to_antenna ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the antenna model used for antenna spectrum computation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:model_name ],
        [ sh:class fyo:Rphiz1dDynamicAos1Definition ;
            sh:description "Position of a reference point on the antenna (allowing also tracking the possible movements of the antenna)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:position ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Forward power arriving at the back of the antenna" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:power_forward ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Phase difference between two neighbouring modules (average over modules), at the mouth (front) of the antenna" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:phase_average ],
        [ sh:class fyo:LhAntennasAntennaRow ;
            sh:description "Set of horizontal rows of waveguides (corresponding to different poloidal positions). A power spectrum is provided for each row." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:row ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Electron density profile in front of the antenna" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:n_e ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Pressure in the vacuum tank of the antenna" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:pressure_tank ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Reflected power" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:power_reflected ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Peak parallel refractive index of the launched wave spectrum (simple estimate based on the measured phase difference)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:n_parallel_peak ] ;
    sh:targetClass fyo:LhAntennasAntenna .

fyo:LhAntennasAntennaModule a sh:NodeShape ;
    rdfs:comment "Set of antenna modules" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “Top module”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Phase of the forward power arriving at the back of this module" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power reflection coefficient" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:reflection_coefficient ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Forward power arriving to the back of the module" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:power_forward ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power launched from this module into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:power_launched ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Reflected power" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:power_reflected ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:LhAntennasAntennaModule .

fyo:LhAntennasAntennaRow a sh:NodeShape ;
    rdfs:comment "Set of horizontal rows of waveguides (corresponding to different poloidal positions). A power spectrum is provided for each row." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the row" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Refraction index in the toroidal direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:n_phi ],
        [ sh:class fyo:Rphiz1dDynamicAos1CommonTime ;
            sh:description "Position of the middle on the row" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:float ;
            sh:description "1D power density spectrum dP/dn_phi, as a function of time" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:power_density_spectrum_1d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "2D power density spectrum d2P/(dn_tor.dn_pol), as a function of time" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:power_density_spectrum_2d ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes of this probe located at this level of the IDS structure" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Refraction index in the poloidal direction. The poloidal angle is defined from the reference point; the angle at a point (R,Z) is given by atan((Z-Zref)/(R-Rref)), where Rref=reference_point/r and Zref=reference_point/z" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:n_pol ] ;
    sh:targetClass fyo:LhAntennasAntennaRow .

fyo:LineOfSight2pointsDynamicAos1 a sh:NodeShape ;
    rdfs:comment "Description of the line of sight of the channel, given by 2 points. The 2nd point is allowed to evolve in case of dynamic line of sight." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "In case of line of sight moving during a pulse, position parameter allowing to record and compute the line of sight position as a function of time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:position_parameter ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the first point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:first_point ],
        [ sh:class fyo:Rphiz1dDynamicAos1CommonTime ;
            sh:description "Position of the second point (possibly dynamic)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:second_point ],
        [ sh:datatype xsd:float ;
            sh:description "Amplitude of the line of sight position parameter oscillation (in case moving_mode/index = 1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:amplitude_parameter ],
        [ sh:datatype xsd:float ;
            sh:description "Period of the line of sight oscillation (in case moving_mode/index = 1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:period ],
        [ sh:class spo:Identifier ;
            sh:description "Moving mode of the line of sight. Index = 0 : no movement, fixed position. Index = 1 : oscillating" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:moving_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:LineOfSight2pointsDynamicAos1 .

fyo:LineOfSight2pointsRphiz2d a sh:NodeShape ;
    rdfs:comment "Description of the line of sight for each pixel, given by 2 points. For each coordinate : first dimension : line index (x1 axis); second dimension: column index (x2 axis)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Rphiz2dStatic ;
            sh:description "Position of the first point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:first_point ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:geometry_role ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:manifold_dim ],
        [ sh:class fyo:Rphiz2dStatic ;
            sh:description "Position of the second point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:second_point ] ;
    sh:targetClass fyo:LineOfSight2pointsRphiz2d .

fyo:LineOfSight2pointsRz a sh:NodeShape ;
    rdfs:comment "Position of shunt terminals" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Rz0dStatic ;
            sh:description "Position of the second point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:second_point ],
        [ sh:class fyo:Rz0dStatic ;
            sh:description "Position of the first point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:first_point ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:LineOfSight2pointsRz .

fyo:MagneticsBpolProbeNonLinear a sh:NodeShape ;
    rdfs:comment "Non-linear response of the probe (typically in case of a Hall probe)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Magnetic field value taking into account the non-linear response of the probe" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:b_field_non_linear ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Array of magnetic field values (corresponding to the assumption of a linear relation between magnetic field and probe coil current), for each of which the probe non-linear response is given in ../b_field_non_linear" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:b_field_linear ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:MagneticsBpolProbeNonLinear .

fyo:MagneticsFluxLoop a sh:NodeShape ;
    rdfs:comment "Flux loops; partial flux loops can be described. In case of differential loops, the geometry of differential flux loops is stored in the flux_loop indices of the primitive loops. Signals may be stored on the primitive loop indices but this is optional if the index of the primitive loop is referenced by a differential loop index" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class spo:Identifier ;
            sh:description "Flux loop type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:type ],
        [ sh:datatype xsd:integer ;
            sh:description "Indices (from the flux_loop array of structures) of the two loops used to build a differential measurement: loop(second index) - loop(first index). Use only if ../type/index = 6, leave empty otherwise." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:indices_differential ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Measured voltage between the loop terminals" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:voltage ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Measured magnetic flux through loop with normal to enclosed surface determined by order of points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:flux ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Effective area (ratio between flux and average magnetic field over the loop). Leave empty if ../type/index = 6 (differential loop)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "List of (R,Z,phi) points defining the position of the loop (see data structure documentation FLUXLOOPposition.pdf). Leave empty if ../type/index = 6 (differential loop)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:float ;
            sh:description "Integral of 1/R over the loop area (ratio between flux and magnetic rigidity R0.B0). Use only if ../type/index = 3 to 5, leave empty otherwise." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:gm9 ] ;
    sh:targetClass fyo:MagneticsFluxLoop .

fyo:MagneticsRogowski a sh:NodeShape ;
    rdfs:comment "Set of Rogowski coils. If some of the coils form a compound Rogowski sensor, they must be entered in contiguous order" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Quantity measured by the sensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:measured_quantity ],
        [ sh:datatype xsd:float ;
            sh:description "Effective area of the loop wrapped around the guiding centre. In case of multiple layers, sum of the areas of each layer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:datatype xsd:integer ;
            sh:description "Indices (from the rogowski_coil array of structure) of the partial Rogowskis used to build the coumpound signal (sum of the partial Rogowski signals). Can be set to any unique integer value for each section of a compound Rogowski coil. Use only if ../measure_quantity/index = 5, leave empty otherwise" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:indices_compound ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Measured current inside the Rogowski coil contour. The normal direction to the Rogowski coil is defined by the order of points in the list of guiding centre positions. The current is positive when oriented in the same direction as the normal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:current ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "List of (R,Z,phi) points defining the position of the coil guiding centre. Values defining a single segment must be entered in contiguous order" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Number of turns per unit length. In case of multiple layers, turns are counted for a single layer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:turns_per_metre ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:MagneticsRogowski .

fyo:MagneticsShunt a sh:NodeShape ;
    rdfs:comment "Set of shunt resistances through which currents in the divertor structure are measured. Shunts are modelled as piecewise straight line segments in the poloidal plane." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Voltage on the shunt terminals (Vfirst_point-Vsecond_point)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:voltage ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Shunt resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:resistance ],
        [ sh:datatype xsd:integer ;
            sh:description "If the shunt is located on a given divertor, index of that divertor in the divertors IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:divertor_index ],
        [ sh:datatype xsd:integer ;
            sh:description "If the shunt is located on a divertor tile, index of that tile in the divertors IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:tile_index ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:LineOfSight2pointsRz ;
            sh:description "Position of shunt terminals" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:position ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:integer ;
            sh:description "If the shunt is located on a divertor target, index of that target in the divertors IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:target_index ] ;
    sh:targetClass fyo:MagneticsShunt .

fyo:MhdGgd a sh:NodeShape ;
    rdfs:comment "Edge plasma quantities represented using the general grid description, for various time slices." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path spo:slice_of ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Vorticity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:vorticity ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the plasma velocity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:velocity_phi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "R component of the current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:j_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Z component of the magnetic vector potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:a_field_z ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Z component of the magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:b_field_z ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "R component of the magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:b_field_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Z component of the plasma velocity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:velocity_z ],
        [ sh:class fyo:MhdGgdElectrons ;
            sh:description "Quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Vorticity divided by the local major radius, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:vorticity_over_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Parallel (to magnetic field) component of the plasma velocity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:velocity_parallel ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Ion temperature (averaged on ion species), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:t_i_average ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Electric potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:phi_potential ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Mass density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:mass_density ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Total ion density (sum over ion species and thermal+non-thermal), given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:n_i_total ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:j_phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the current density multiplied by the local major radius, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:r_j_phi ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:b_field_phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "R component of the magnetic vector potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:a_field_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Z component of the current density, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:j_z ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:time ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Poloidal flux, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:psi ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path spo:at_time ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Effective charge, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:zeff ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "R component of the plasma velocity, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:velocity_r ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Parallel (to magnetic field) component of the plasma velocity divided by the modulus of the local magnetic field, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:velocity_parallel_over_b_field ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal component of the magnetic vector potential, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:a_field_phi ] ;
    sh:targetClass fyo:MhdGgd .

fyo:MhdGgdElectrons a sh:NodeShape ;
    rdfs:comment "Quantities related to the electrons" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Temperature, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:temperature ] ;
    sh:targetClass fyo:MhdGgdElectrons .

fyo:MhdLinearTimeSlice a sh:NodeShape ;
    rdfs:comment "Core plasma radial profiles for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:at_instant ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class fyo:MhdLinearTimeSliceToroidalModes ;
            sh:description "Vector of toroidal modes. Each mode is described as exp(i(n_tor.phi - m_pol.theta - 2.pi.frequency.t - phase))" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:toroidal_mode ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:MhdLinearTimeSlice .

fyo:MhdLinearTimeSliceToroidalModePlasma a sh:NodeShape ;
    rdfs:comment "MHD modes in the confined plasma" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Parallel displacement of the modes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:displacement_parallel ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perturbed electrostatic potential for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:phi_potential_perturbed ],
        [ sh:class fyo:MhdLinearVector ;
            sh:description "Pertubed velocity for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:velocity_perturbed ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ],
        [ sh:datatype xsd:float ;
            sh:description "Resistive time = mu_0 rho*rho/1.22/eta_neo" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:tau_resistive ],
        [ sh:class fyo:Complex3dMhdStressTensor ;
            sh:description "Reynolds stress tensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:stress_reynolds ],
        [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perturbed electromagnetic super-potential for given toroidal mode number, see ref [Antonsen/Lane Phys Fluids 23(6) 1980, formula 34], so that A_field_parallel=1/(i*2pi*frequency) (grad psi_potential)_parallel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:psi_potential_perturbed ],
        [ sh:datatype xsd:float ;
            sh:description "Alven time=R/vA=R0 sqrt(mi ni(rho))/B0" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:tau_alfven ],
        [ sh:class fyo:MhdLinearVector ;
            sh:description "Pertubed magnetic field for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:b_field_perturbed ],
        [ sh:class fyo:Complex1dMhdAlfvenSpectrum ;
            sh:description "Local shear Alfven spectrum as a function of radius (only in case grid/dim1 is a radial coordinate)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:alfven_frequency_spectrum ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perturbed pressure for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:pressure_perturbed ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perturbed mass density for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:mass_density_perturbed ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:Complex3dMhdStressTensor ;
            sh:description "Maxwell stress tensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:stress_maxwell ],
        [ sh:class fyo:MhdCoordinateSystem ;
            sh:description "Flux surface coordinate system of the equilibrium used for the MHD calculation on a square grid of flux and poloidal angle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:coordinate_system ],
        [ sh:class fyo:Complex3dMhdStressTensor ;
            sh:description "Neoclassical toroidal viscosity tensor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:ntv ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perpendicular displacement of the modes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:displacement_perpendicular ],
        [ sh:class fyo:MhdLinearVector ;
            sh:description "Pertubed vector potential for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:a_field_perturbed ],
        [ sh:class fyo:Complex2dDynamicAosMhdScalar ;
            sh:description "Perturbed temperature for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:temperature_perturbed ] ;
    sh:targetClass fyo:MhdLinearTimeSliceToroidalModePlasma .

fyo:MhdLinearTimeSliceToroidalModeVacuum a sh:NodeShape ;
    rdfs:comment "MHD modes in the vacuum" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:EquilibriumProfiles2dGrid ;
            sh:description "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid ],
        [ sh:class fyo:MhdLinearVector ;
            sh:description "Pertubed magnetic field for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:b_field_perturbed ],
        [ sh:class fyo:MhdLinearVector ;
            sh:description "Pertubed vector potential for given toroidal mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:a_field_perturbed ],
        [ sh:class fyo:MhdCoordinateSystem ;
            sh:description "Flux surface coordinate system of the equilibrium used for the MHD calculation on a square grid of flux and poloidal angle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Selection of one of a set of grid types" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_type ] ;
    sh:targetClass fyo:MhdLinearTimeSliceToroidalModeVacuum .

fyo:MhdLinearTimeSliceToroidalModes a sh:NodeShape ;
    rdfs:comment "Vector of toroidal modes. Each mode is described as exp(i(n_tor.phi - m_pol.theta - 2.pi.frequency.t - phase))" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Dominant poloidal mode number defining the mode rational surface; for TAEs the lower of the two main m's has to be specified" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:m_pol_dominant ],
        [ sh:class spo:Identifier ;
            sh:description "Ballooning type of the mode : ballooning 0; anti-ballooning:1; flute-like:2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:ballooning_type ],
        [ sh:class fyo:MhdLinearTimeSliceToroidalModePlasma ;
            sh:description "MHD modes in the confined plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:plasma ],
        [ sh:datatype xsd:float ;
            sh:description "Frequency of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Additional phase offset of mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:phase ],
        [ sh:datatype xsd:float ;
            sh:description "Radial mode number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:radial_mode_number ],
        [ sh:datatype xsd:float ;
            sh:description "Perturbed energy associated to the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:energy_perturbed ],
        [ sh:datatype xsd:float ;
            sh:description "Multiplier that is needed to convert the linear mode structures to the amplitude of a non-linearly saturated mode in physical units. If empty, it means that the structures contains no information about non-linearly saturated mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:amplitude_multiplier ],
        [ sh:datatype xsd:float ;
            sh:description "Linear growthrate of the mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:growthrate ],
        [ sh:class spo:Identifier ;
            sh:description "Type of the perturbation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:perturbation_type ],
        [ sh:class fyo:MhdLinearTimeSliceToroidalModeVacuum ;
            sh:description "MHD modes in the vacuum" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:vacuum ],
        [ sh:datatype xsd:integer ;
            sh:description "Toroidal mode number of the MHD mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:n_phi ] ;
    sh:targetClass fyo:MhdLinearTimeSliceToroidalModes .

fyo:MseChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (lines of sight)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:MseChannelResolution ;
            sh:description "Spatial resolution of the measurement, calculated as a convolution of the atomic smearing, magnetic and beam geometry smearing and detector projection, for a set of time slices (use a single time slice for the whole pulse if the beam and the line of sight are not moving during the pulse)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:active_spatial_resolution ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "MSE polarization angle" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:polarization_angle ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the channel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:aperture ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight of the channel, given by 2 points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:line_of_sight ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Detector description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:detector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:MseChannel .

fyo:MseChannelResolution a sh:NodeShape ;
    rdfs:comment "Spatial resolution of the measurement, calculated as a convolution of the atomic smearing, magnetic and beam geometry smearing and detector projection, for a set of time slices (use a single time slice for the whole pulse if the beam and the line of sight are not moving during the pulse)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Set of 9 geometric coefficients providing the MSE polarization angle as a function of the local electric and magnetic field components (these are related to the angle between beam and line of sight). The list is ordered as follows : coefficients of BZ, BR, Bphi, ER (numerator of the MSE angle expression); coefficients of BZ, BR, Bphi, ER, EZ (denominator)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:geometric_coefficients ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:at_time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:Rphiz0dDynamicAos3 ;
            sh:description "Position of the centre of the spatially resolved zone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:centre ],
        [ sh:class fyo:Rphiz0dDynamicAos3 ;
            sh:description "Full width of the spatially resolved zone in the R, Z and phi directions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:width ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:MseChannelResolution .

fyo:NbiUnit a sh:NodeShape ;
    rdfs:comment "The NBI system is described as a set of units of which the power can be controlled individually." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Power launched from this unit into the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:power_launched ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of the surface of the ion source from which the beam is extracted" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaCompositionSpecies ;
            sh:description "Injected species" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:species ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Full energy of the injected species (acceleration of a single atom)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:energy ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Fractions of beam current distributed among the different energies, the first index corresponds to the fast neutrals energy (1:full, 2: half, 3: one third)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:beam_current_fraction ],
        [ sh:class fyo:NbiUnitBeamletsGroup ;
            sh:description "Group of beamlets with common vertical and horizontal focal point. If there are no common focal points, then select small groups of beamlets such that a focal point description of the beamlets group provides a fair description. Beamlet groups are assumed to be Gaussian." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:beamlets_group ],
        [ sh:class fyo:DetectorAperture ;
            sh:description "Description of a set of collimating apertures through which the beam is launched" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:aperture ],
        [ sh:class fyo:SignalFlt2d ;
            sh:description "Fractions of beam power distributed among the different energies, the first index corresponds to the fast neutrals energy (1:full, 2: half, 3: one third)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:beam_power_fraction ] ;
    sh:targetClass fyo:NbiUnit .

fyo:NbiUnitBeamletsGroup a sh:NodeShape ;
    rdfs:comment "Group of beamlets with common vertical and horizontal focal point. If there are no common focal points, then select small groups of beamlets such that a focal point description of the beamlets group provides a fair description. Beamlet groups are assumed to be Gaussian." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:NbiUnitBeamletsGroupDivergence ;
            sh:description "Detailed information on beamlet divergence. Divergence is described as a superposition of Gaussian components with amplitide \"particles_fraction\" and vertical/horizontal divergence. Note that for positive ion NBI the divergence is well described by a single Gaussian" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:divergence_component ],
        [ sh:datatype xsd:float ;
            sh:description "Tangency radius (major radius where the central line of a NBI unit is tangent to a circle around the torus)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:tangency_radius ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Direction of the beam seen from above the torus: -1 = clockwise; 1 = counter clockwise" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:direction ],
        [ sh:class fyo:NbiUnitBeamletsGroupBeamlets ;
            sh:description "Detailed information on beamlets" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:beamlets ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal width (dimensions of the smallest rectangle that surrounds the outer dimensions of the beamlets) of the beamlet group at the injection unit surface (or grounded grid)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:width_horizontal ],
        [ sh:class fyo:NbiUnitBeamletsGroupTilting ;
            sh:description "In case of dynamic beam tilting (i.e. during the pulse), e.g. for some Beam Emission Spectroscopy use cases, variations of position, tangency radius and angle with respect to their static value, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:tilting ],
        [ sh:datatype xsd:float ;
            sh:description "Angle of inclination between a beamlet at the centre of the injection unit surface and the horiontal plane" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:angle ],
        [ sh:class fyo:NbiUnitBeamletsGroupFocus ;
            sh:description "Describes how the beamlet group is focused. Calculations of width_min_horizontal and width_min_vertical are on a plane defined by the average normal vector of the two constituent accelerator nbi target planes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:focus ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical width (dimensions of the smallest rectangle that surrounds the outer dimensions of the beamlets) of the beamlet group at the injection unit surface (or grounded grid)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:width_vertical ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "R, Z, Phi position of the beamlet group centre" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:position ] ;
    sh:targetClass fyo:NbiUnitBeamletsGroup .

fyo:NbiUnitBeamletsGroupBeamlets a sh:NodeShape ;
    rdfs:comment "Detailed information on beamlets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Fraction of power of a unit injected by each beamlet" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:power_fractions ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Position of each beamlet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:positions ],
        [ sh:datatype xsd:float ;
            sh:description "Tangency radius (major radius where the central line of a beamlet is tangent to a circle around the torus), for each beamlet" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:tangency_radii ],
        [ sh:datatype xsd:float ;
            sh:description "Angle of inclination between a line at the centre of a beamlet and the horizontal plane, for each beamlet" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:angles ] ;
    sh:targetClass fyo:NbiUnitBeamletsGroupBeamlets .

fyo:NbiUnitBeamletsGroupDivergence a sh:NodeShape ;
    rdfs:comment "Detailed information on beamlet divergence. Divergence is described as a superposition of Gaussian components with amplitide \"particles_fraction\" and vertical/horizontal divergence. Note that for positive ion NBI the divergence is well described by a single Gaussian" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Fraction of injected particles in the component" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:particles_fraction ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "The horiztonal beamlet divergence of the component. Here the divergence is defined for Gaussian beams as the angle where the beam density is reduced by a factor 1/e compared to the maximum density (equivalent to the intensity for the divergence of each individual beamlet as the energy is assumed constant). For non-Gaussian beams the divergence is mean((x-mean(x))**2)/sqrt(2), where x is the angle and the mean should be performed over the beam density, P(x): mean(y)=int(y*P(x)*dx)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:horizontal ],
        [ sh:datatype xsd:float ;
            sh:description "The vertical beamlet divergence of the component. Here the divergence is defined for Gaussian beams as the angle where the beam density is reduced by a factor 1/e compared to the maximum density (equivalent to the intensity for the divergence of each individual beamlet as the energy is assumed constant). For non-Gaussian beams the divergence is mean((x-mean(x))**2)/sqrt(2), where x is the angle and the mean should be performed over the beam density, P(x): mean(y)=int(y*P(x)*dx)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:vertical ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:NbiUnitBeamletsGroupDivergence .

fyo:NbiUnitBeamletsGroupFocus a sh:NodeShape ;
    rdfs:comment "Describes how the beamlet group is focused. Calculations of width_min_horizontal and width_min_vertical are on a plane defined by the average normal vector of the two constituent accelerator nbi target planes." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "The horizontal width (Full Width at Half Maximum) of the beamlets group at the horizontal focal point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:width_min_horizontal ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical focal length along the beam line, i.e. the point along the centre of the beamlet-group where the beamlet-group has its minimum vertical width" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:focal_length_vertical ],
        [ sh:datatype xsd:float ;
            sh:description "Horizontal focal length along the beam line, i.e. the point along the centre of the beamlet-group where the beamlet-group has its minimum horizontal width" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:focal_length_horizontal ],
        [ sh:datatype xsd:float ;
            sh:description "The vertical width (Full Width at Half Maximum) of the beamlets group at the vertical focal point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:width_min_vertical ] ;
    sh:targetClass fyo:NbiUnitBeamletsGroupFocus .

fyo:NbiUnitBeamletsGroupTilting a sh:NodeShape ;
    rdfs:comment "In case of dynamic beam tilting (i.e. during the pulse), e.g. for some Beam Emission Spectroscopy use cases, variations of position, tangency radius and angle with respect to their static value, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:at_time ],
        [ sh:class fyo:Rphiz0dDynamicAos3 ;
            sh:description "Variation of the position of the beamlet group centre" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:delta_position ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Variation of the angle of inclination between a beamlet at the centre of the injection unit surface and the horiontal plane" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:delta_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Variation of the tangency radius (major radius where the central line of a NBI unit is tangent to a circle around the torus)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:delta_tangency_radius ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:NbiUnitBeamletsGroupTilting .

fyo:NeutronDiagnosticAdc a sh:NodeShape ;
    rdfs:comment "Description of analogic-digital converter" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
