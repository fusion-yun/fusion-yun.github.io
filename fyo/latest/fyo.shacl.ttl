fyo:SummaryGlobalQuantities a sh:NodeShape ;
    rdfs:comment "Various global quantities derived from the profiles" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal beta, using the pressure determined by an equilibrium reconstruction code" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:beta_tor_mhd ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Helium confinement time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path fyo:tau_helium ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Ratio of Helium confinement time to fuel confinement time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 36 ;
            sh:path fyo:ratio_tau_helium_fuel ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Time derivative of the diamagnetic plasma energy content" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:denergy_diamagnetic_dt ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Volume of the confined plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path fyo:volume ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Figure of merit of the alignment of the current profile sources, defined in the following reference: http://iopscience.iop.org/article/10.1088/0029-5515/43/7/318" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:current_alignment ],
        [ sh:class fyo:SummaryDynamicInt1dRoot ;
            sh:description "H-mode flag: 0 when the plasma is in L-mode and 1 when in H-mode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path fyo:h_mode ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Fusion gain : ratio of the power provided by fusion reactions to the auxiliary power needed to heat the plasma. Often noted as Q in the litterature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path fyo:fusion_gain ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "LCFS loop voltage (positive value drives positive ohmic current that flows anti-clockwise when viewed from above)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:v_loop ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total power coupled to the plasma minus dW/dt (correcting from transient energy content)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 40 ;
            sh:path fyo:power_steady ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Internal inductance. The li_3 definition is used, i.e. li_3 = 2/R0/mu0^2/Ip^2 * int(Bp^2 dV)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:li_3 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Vacuum toroidal field at R0. Positive sign means anti-clockwise when viewed from above. The product R0B0 must be consistent with the b_tor_vacuum_r field of the tf IDS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path fyo:b0 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta estimated from the pressure determined by an equilibrium reconstruction code. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:beta_pol_mhd ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Energy confinement time enhancement factor over the IPB98(y,2) scaling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path fyo:h_98 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total radiated power" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 41 ;
            sh:path fyo:power_radiated ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "q at the 95% poloidal flux surface (only positive when toroidal current and magnetic field are in same direction)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 38 ;
            sh:path fyo:q_95 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized toroidal beta, using the pressure determined by an equilibrium reconstruction code" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:beta_tor_norm_mhd ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 51 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Fast particles perpendicular energy content = 3/2 * integral over the plasma volume of the fast perpendicular pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path fyo:energy_fast_perpendicular ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Plasma diamagnetic energy content = 3/2 * integral over the plasma volume of the total perpendicular pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:energy_diamagnetic ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Internal inductance as determined by an equilibrium reconstruction code. Use this only when the li node above is used for another estimation method and there is a need to store a second value of li (determined by an equilibrium reconstruction code). The li_3 definition is used, i.e. li_3 = 2/R0/mu0^2/Ip^2 * int(Bp^2 dV)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:li_3_mhd ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Power through separatrix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 47 ;
            sh:path fyo:power_loss ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total plasma current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ip ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Ohmic current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:current_ohm ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Ohmic power" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 39 ;
            sh:path fyo:power_ohm ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Energy confinement time estimated from the IPB98(y,2) scaling" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 35 ;
            sh:path fyo:tau_energy_98 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal beta, defined as the volume-averaged total perpendicular pressure divided by (B0^2/(2*mu0)), i.e. beta_toroidal = 2 mu0 int(p dV) / V / B0^2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:beta_tor ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Energy confinement time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path fyo:tau_energy ],
        [ sh:class fyo:SummaryConstantFlt0d ;
            sh:description "Reference major radius where the vacuum toroidal magnetic field is given (usually a fixed position such as the middle of the vessel at the equatorial midplane)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path fyo:r0 ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal magnetic plasma energy content = 1/(2.mu0) * integral over the plasma volume of b_field_pol^2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:energy_b_field_pol ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Thermal plasma energy content = 3/2 * integral over the plasma volume of the thermal pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:energy_thermal ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Plasma energy content = 3/2 * integral over the plasma volume of the total kinetic pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:energy_total ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized toroidal beta, defined as 100 * beta_tor * a[m] * B0 [T] / ip [MA]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:beta_tor_norm ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Radiated power from the plasma outside the Last Closed Flux Surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 43 ;
            sh:path fyo:power_radiated_outside_lcfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total non-inductive current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:current_non_inductive ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 52 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Time derivative of the thermal plasma energy content" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:denergy_thermal_dt ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Fusion fluence : power provided by fusion reactions, integrated over time since the beginning of the pulse" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 49 ;
            sh:path fyo:fusion_fluence ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Current diffusion characteristic time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 34 ;
            sh:path fyo:tau_resistive ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Plasma energy content = 3/2 * integral over the plasma volume of the total kinetic pressure (pressure determined by an equilibrium reconstruction code)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:energy_mhd ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Thermal electron plasma energy content = 3/2 * integral over the plasma volume of the thermal electron pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:energy_electrons_thermal ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Radiated power from the plasma inside the Last Closed Flux Surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 42 ;
            sh:path fyo:power_radiated_inside_lcfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Radiated power from Bremsstrahlung" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 45 ;
            sh:path fyo:power_bremsstrahlung ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Radiated power from synchrotron radiation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 46 ;
            sh:path fyo:power_synchrotron ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta. Defined as betap = 4 int(p dV) / [R_0 * mu_0 * Ip^2]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:beta_pol ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Plasma electric resistance" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 37 ;
            sh:path fyo:resistance ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Fast particles parallel energy content = 3/2 * integral over the plasma volume of the fast parallel pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path fyo:energy_fast_parallel ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized toroidal beta from thermal pressure only, defined as 100 * beta_tor_thermal * a[m] * B0 [T] / ip [MA]" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:beta_tor_thermal_norm ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Average (over the plasma poloidal cross section) plasma poloidal magnetic flux produced by all toroidal loops (active coils and passive loops) but the plasma, given by the following formula : int(psi_loops.j_tor.dS) / Ip" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 50 ;
            sh:path fyo:psi_external_average ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Radiated power from line radiation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 44 ;
            sh:path fyo:power_line ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Greenwald fraction =line_average/n_e/value divided by (global_quantities/ip/value *1e6 * pi * minor_radius^2)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 48 ;
            sh:path fyo:greenwald_fraction ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Bootstrap current (toroidal component). Positive sign means anti-clockwise when viewed from above." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:current_bootstrap ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Thermal ion plasma energy content (sum over the ion species) = 3/2 * integral over the plasma volume of the thermal ion pressure" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:energy_ion_total_thermal ] ;
    sh:targetClass fyo:SummaryGlobalQuantities .

