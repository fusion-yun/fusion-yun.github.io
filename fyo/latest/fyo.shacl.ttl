fyo:BolometerChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (detector or pixel of a camera)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:LineOfSight3points ;
            sh:description "Description of the reference line of sight of the channel, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
