        [ sh:class fyo:SummaryDynamicFlt1dRootParent2 ;
            sh:description "Carbon" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:carbon ],
        [ sh:class fyo:SummaryDynamicFlt1dRootParent2 ;
