        [ sh:datatype xsd:float ;
            sh:description "Value of (b_field_max-b_field_min)/(b_field_max+b_field_min), where b_field_max resp. b_field_min) is the maximum (resp. minimum) of the magnetic field amplitude over a 2pi rotation in toroidal angle phi at a given R, Z position." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:ripple_amplitude ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
