fyo:SpiPellet a sh:NodeShape ;
    rdfs:comment "Information related to the pellet" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius component of the velocity of the centre of mass of the pellet" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:velocity_r ],
        [ sh:datatype xsd:float ;
            sh:description "Pellet diameter" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:diameter ],
        [ sh:class fyo:SpiShell ;
            sh:description "Shell-layer around of the unshattered pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:shell ],
        [ sh:datatype xsd:float ;
            sh:description "Pellet length (cylindrical pellet)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:length ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical component of the velocity of the centre of mass of the pellet" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:velocity_z ],
        [ sh:class fyo:SpiShell ;
            sh:description "Core of the unshattered pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:core ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the velocity of the centre of mass of the pellet" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:velocity_phi ],
        [ sh:class fyo:Rphiz1dDynamicRootTime ;
            sh:description "Position of the centre of mass of the pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:position ],
        [ sh:datatype xsd:float ;
            sh:description "Norm of the velocity of the centre of mass of the pellet right before shattering" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:velocity_shatter ] ;
    sh:targetClass fyo:SpiPellet .

fyo:SpiShatterCone a sh:NodeShape ;
    rdfs:comment "Description of the elliptic shatter cone" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Angle between the cone direction and unit_vector_minor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:angle_minor ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Angle between the cone direction and unit_vector_major" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:angle_major ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Minor unit vector describing the geometry of the elliptic shatter cone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:unit_vector_minor ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Major unit vector describing the geometry of the elliptic shatter cone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:unit_vector_major ],
        [ sh:class fyo:Xyz0dConstant ;
            sh:description "Unit vector of the cone direction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:direction ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Coordinates of the origin of the shatter cone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:origin ] ;
    sh:targetClass fyo:SpiShatterCone .

fyo:SpiSingle a sh:NodeShape ;
    rdfs:comment "Set of shattered pellet injectors" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SpiPellet ;
            sh:description "Information related to the pellet" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:pellet ],
        [ sh:class fyo:SpiGas ;
            sh:description "Description of the gas produced during fragmentation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:fragmentation_gas ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Arrival time at the shattering unit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time_shatter ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal component of the velocity of the centre of mass of the fragments at the shattering cone origin" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fyo:velocity_mass_centre_fragments_phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time of trigger request to the power supply according to the DMS sequence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time_trigger ],
        [ sh:class fyo:SpiFragment ;
            sh:description "Set of shattered pellet fragments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:fragment ],
        [ sh:datatype xsd:float ;
            sh:description "Impact (or grazing) angle of the pellet with the shattering element. It is the complementary of the incidence angle with the element surface at the shattering location" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:shattering_angle ],
        [ sh:class fyo:SpiGas ;
            sh:description "Description of the propellant gas" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:propellant_gas ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius component of the velocity of the centre of mass of the fragments at the shattering cone origin" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:velocity_mass_centre_fragments_r ],
        [ sh:datatype xsd:float ;
            sh:description "Vertical component of the velocity velocity of the centre of mass of the fragments at the shattering cone origin" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:velocity_mass_centre_fragments_z ],
        [ sh:class fyo:SpiOpd ;
            sh:description "Information related to the embedded optical pellet diagnostic" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:optical_pellet_diagnostic ],
        [ sh:class fyo:SpiShatterCone ;
            sh:description "Description of the elliptic shatter cone" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:shatter_cone ],
        [ sh:class fyo:Xyz0dConstant ;
            sh:description "Unit vector of the unshattered pellet velocity direction right before shattering" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:injection_direction ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position where the pellet is shattered. It is defined as the intersection of the trayectory of the pellet center of mass with the shattering element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:shattering_position ] ;
    sh:targetClass fyo:SpiSingle .

fyo:SpiSpeciesFraction a sh:NodeShape ;
    rdfs:comment "Atomic species in the gas composition" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying the species (e.g. H, D, T, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:datatype xsd:float ;
            sh:description "Atomic fraction of the species" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:fraction ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:float ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ] ;
    sh:targetClass fyo:SpiSpeciesFraction .

fyo:StatisticsInput2d a sh:NodeShape ;
    rdfs:comment "If the statistics are based on an uncertainty quantification process, set of 2D input quantities that are varied" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the quantity within the IDS, following the syntax given in the link below" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:path ],
        [ sh:class fyo:StatisticsDistribution2d ;
            sh:description "Probability distribution function of the quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:distribution ] ;
    sh:targetClass fyo:StatisticsInput2d .

fyo:StatisticsQuantity2d a sh:NodeShape ;
    rdfs:comment "Set of 2D quantities on which statistics are provided. 2D means 1D+time dimension, so either a 1D quantity within a dynamic array of structure, or a 2D dynamic quantity outside of an array of structure. Therefore the resulting statistical value is 1D for a given statistics time slice." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:StatisticsQuantity2dType ;
            sh:description "Set of statistics types applied to the quantity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:statistics_type ],
        [ sh:class fyo:StatisticsDistribution2d ;
            sh:description "Probability distribution function of the quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:distribution ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the quantity within the IDS, following the syntax given in the link below" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:path ] ;
    sh:targetClass fyo:StatisticsQuantity2d .

fyo:StatisticsQuantity2dType a sh:NodeShape ;
    rdfs:comment "Set of statistics types applied to the quantity" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "For Sobol index only, path to the related the uq_input quantity, e.g. ../../../uq_input_2d(3)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:uq_input_path ],
        [ sh:datatype xsd:float ;
            sh:description "Value of the statistics for that quantity, the array corresponding to the first dimension of the original 2D quantity" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:value ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Only if the statistics value is given on a different GGD grid subset than the original quantity (e.g. if the statistics has worked over a dimension of the GGD), index of the grid used to represent the statistics value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:grid_index ],
        [ sh:datatype xsd:integer ;
            sh:description "Only if the statistics value is given on a different GGD grid subset than the original quantity (e.g. if the statistics has worked over a dimension of the GGD), index of the new grid subset the statistics value is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:grid_subset_index ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier of the statistics type" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ] ;
    sh:targetClass fyo:StatisticsQuantity2dType .

fyo:StokesDynamic a sh:NodeShape ;
    rdfs:comment "Stokes vector at the output of the FOCS as a function of time" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "S2 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:s2 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "S3 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:s3 ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "S0 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:s0 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "S1 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:s1 ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:at_time ] ;
    sh:targetClass fyo:StokesDynamic .

fyo:StokesInitial a sh:NodeShape ;
    rdfs:comment "Initial Stokes vector at the entrance of the FOCS" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "S0 component of the unit Stokes vector" ;
            sh:maxCount 1 ;
