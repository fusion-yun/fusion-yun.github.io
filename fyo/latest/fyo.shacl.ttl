            sh:order 9 ;
            sh:path fyo:code ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Line of sight of the diagnostic (fill when valid for all channels), defined by two points. By convention, the first point is the closest to the diagnostic. In case the channels have different lines of sight, they should be described within the channel array of structures" ;
