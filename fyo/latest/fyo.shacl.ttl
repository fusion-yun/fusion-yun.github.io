            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:hydrogen ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Krypton" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:krypton ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Deuterated ammonia (ND3)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path fyo:ammonia_deuterated ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Deuterated methane (CD4)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:methane_deuterated ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Lithium" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:lithium ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Helium isotope with 3 nucleons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:helium_3 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Methane (CH4)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:methane ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
