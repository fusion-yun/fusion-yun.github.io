fyo:WavesBeamTracingBeamK a sh:NodeShape ;
    rdfs:comment "Wave vector of the ray/beam along its path" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Wave vector component in the toroidal direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:k_phi ],
        [ sh:datatype xsd:integer ;
            sh:description "Toroidal wave number, contains a single value if varying_n_phi = 0 to avoid useless repetition of constant values. The wave vector toroidal component is defined as k_phi = n_phi grad phi where phi is the toroidal angle so that a positive n_phi means a wave propagating in the positive phi direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:n_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Perpendicular refractive index" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:n_perpendicular ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized wave vector component in the major radius direction = k_r / norm(k)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:k_r_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized wave vector component in the toroidal direction = k_phi / norm(k)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:k_phi_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized wave vector component in the vertical direction = k_z / norm(k)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:k_z_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Wave vector component in the major radius direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:k_r ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag telling whether n_phi is constant along the ray path (0) or varying (1)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:varying_n_phi ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Wave vector component in the vertical direction" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:k_z ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel refractive index" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:n_parallel ] ;
    sh:targetClass fyo:WavesBeamTracingBeamK .

