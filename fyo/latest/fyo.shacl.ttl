            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class fyo:MagneticsBpolProbe ;
            sh:description "Poloidal field probes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:b_field_pol_probe ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path spo:modality ],
        [ sh:class fyo:MagneticsShunt ;
            sh:description "Set of shunt resistances through which currents in the divertor structure are measured. Shunts are modelled as piecewise straight line segments in the poloidal plane." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:shunt ],
        [ sh:class fyo:MagneticsMethodDistinct ;
            sh:description "Plasma current. Positive sign means anti-clockwise when viewed from above. The array of structure corresponds to a set of calculation methods (starting with the generally recommended method)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:ip ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:reproducible ],
        [ sh:class fyo:MagneticsBpolProbe ;
            sh:description "Toroidal field probes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:b_field_phi_probe ],
        [ sh:datatype xsd:integer ;
            sh:description "Indices of equivalent poloidal field probes (from the b_field_pol_probe array) that differ only by their toroidal position and have the same (R,Z) position and the same coil orientation (poloidal and toroidal angles). Sets of equivalent probes (i.e. sets of (R, Z, poloidal_angle and toroidal_angle) values) are grouped by the first coordinate and the coils belonging to a given set are listed along the second coordinate. As an example, if there are N probes in a poloidal cross section that are replicated at the same poloidal positions and with the same orientation at 8 toroidal positions, the matrix will be of size Nx8." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:b_field_pol_probe_equivalent ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000015> ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path spo:generated_by_process ],
        [ sh:class fyo:IdsProperties ;
            sh:description "Interface Data Structure properties. This element identifies the node above as an IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:ids_properties ],
        [ sh:class fyo:MagneticsFluxLoop ;
            sh:description "Flux loops; partial flux loops can be described. In case of differential loops, the geometry of differential flux loops is stored in the flux_loop indices of the primitive loops. Signals may be stored on the primitive loop indices but this is optional if the index of the primitive loop is referenced by a differential loop index" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:flux_loop ],
        [ sh:class fyo:IdsCode ;
            sh:description "Generic decription of the code-specific parameters for the code that has produced this IDS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:code ] ;
    sh:targetClass fyo:Magnetics .

