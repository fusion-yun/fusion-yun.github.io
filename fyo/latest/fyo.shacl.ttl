            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:at_time ],
        [ sh:datatype xsd:float ;
            sh:description "Source term for the density transport equation" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:particles ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:at_instant ],
        [ sh:class fyo:CoreRadialGrid ;
            sh:description "Radial grid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:slice_of ] ;
    sh:targetClass fyo:DistributionSourcesSourceProfiles1d .

fyo:DistributionsD a sh:NodeShape ;
    rdfs:comment "Set of distribution functions. Every distribution function has to be associated with only one particle species, specified in distri_vec/species/, but there could be multiple distribution function for each species. In this case, the fast particle populations should be superposed" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "If is_delta_f=1, then the distribution represents the deviation from a Maxwellian; is_delta_f=0, then the distribution represents all particles, i.e. the full-f solution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:is_delta_f ],
        [ sh:class fyo:DistributionsDGlobalQuantities ;
            sh:description "Global quantities (integrated over plasma volume for moments of the distribution, collisional exchange and source terms), for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:global_quantities ],
        [ sh:class fyo:DistributionProcessIdentifier ;
            sh:description "List all processes (NBI units, fusion reactions, ...) affecting the distribution, identified as in distribution_sources/source(i)/process in the DISTRIBUTION_SOURCES IDS" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:process ],
        [ sh:class fyo:DistributionsDGgd ;
            sh:description "Distribution represented using the ggd, for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:ggd ],
        [ sh:class fyo:DistributionSpecies ;
            sh:description "Species described by this distribution" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:species ],
        [ sh:class fyo:WavesCoherentWaveIdentifier ;
            sh:description "List all waves affecting the distribution, identified as in waves/coherent_wave(i)/identifier in the waves IDS" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:wave ],
        [ sh:class fyo:DistributionMarkers ;
            sh:description "Distribution represented by a set of markers (test particles)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:markers ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:DistributionsDProfiles1d ;
            sh:description "Radial profiles (flux surface averaged quantities) for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:profiles_1d ],
        [ sh:class fyo:DistributionsDProfiles2d ;
            sh:description "2D profiles in the poloidal plane for various time slices" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:profiles_2d ],
        [ sh:datatype xsd:integer ;
            sh:description "Defines how to interpret the spatial coordinates: 1 = given at the actual particle birth point; 2 =given at the gyro centre of the birth point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:gyro_type ] ;
    sh:targetClass fyo:DistributionsD .

fyo:DistributionsDFastFilter a sh:NodeShape ;
    rdfs:comment "Description of how the fast and the thermal particle populations are separated" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Energy at which the fast and thermal particle populations were separated, as a function of radius" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:energy ],
        [ sh:class spo:Identifier ;
            sh:description "Method used to separate the fast and thermal particle population (indices TBD)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:method ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:DistributionsDFastFilter .

fyo:DistributionsDGgd a sh:NodeShape ;
    rdfs:comment "Distribution represented using the ggd, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridInteger ;
            sh:description "Orbit type identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:orbit_type ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Toroidal orbit frequency (transit or precession) at the grid location (in phase space)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:orbit_frequency_tor ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:at_time ],
        [ sh:class fyo:GenericGridMatrix ;
            sh:description "Orbit description of the particle at this position in phase space. First dimension is the element index. Second dimension is the time along the orbit. Third dimension contains the particle phase space coordinates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:orbit ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Poloidal orbit frequency (transit or bounce) at the grid location (in phase space)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:orbit_frequency_pol ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Value of the distribution function at the grid position in phase space. The interpolation coefficients refer to a C-2 spline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:amplitude ],
        [ sh:class fyo:DistributionsDGgdExpansion ;
            sh:description "Distribution function expanded into a vector of successive approximations. The first element in the vector (expansion(1)) is the zeroth order distribution function, while the K:th element in the vector (expansion(K)) is the K:th correction, such that the total distribution function is a sum over all elements in the expansion vector." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:expansion ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "Reference temperature profile used to define the local thermal energy and the thermal velocity (for normalization of the grid coordinates)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:temperature ],
        [ sh:class fyo:GenericGridDynamic ;
            sh:description "Grid description" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path spo:slice_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:DistributionsDGgdExpansion ;
            sh:description "Distribution function multiplied by the volume of the local velocity cell d3v, expanded into a vector of successive approximations. The first element in the vector (expansion(1)) is the zeroth order distribution function, while the K:th element in the vector (expansion(K)) is the K:th correction, such that the total distribution function is a sum over all elements in the expansion vector." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:expansion_fd3v ] ;
    sh:targetClass fyo:DistributionsDGgd .

fyo:DistributionsDGgdNogrid a sh:NodeShape ;
    rdfs:comment "Distribution represented using the ggd, for various time slices" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:DistributionsDGgdExpansion ;
            sh:description "Distribution function expanded into a vector of successive approximations. The first element in the vector (expansion(1)) is the zeroth order distribution function, while the K:th element in the vector (expansion(K)) is the K:th correction, such that the total distribution function is a sum over all elements in the expansion vector." ;
