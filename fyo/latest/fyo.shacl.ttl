fyo:SummaryPedestalFit a sh:NodeShape ;
    rdfs:comment "Quantities related to \"mtanh\" fit" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryPedestalFitStability ;
            sh:description "MHD stability analysis of the pedestal (for this fit of the profiles)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path fyo:stability ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total magnetic field calculated at the position of the pressure pedestal top (as determined by the fit) on the high field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path fyo:b_field_pedestal_top_hfs ],
        [ sh:class fyo:SummaryPedestalFitNe ;
            sh:description "Electron density related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:n_e ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized Larmor radius at pressure pedestal top for electrons using the magnetic field on the magnetic axis (definition used in most tokamak litterature)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:rhostar_pedestal_top_electron_magnetic_axis ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta at pedestal top for electrons using the low field side magnetic poloidal field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:beta_pol_pedestal_top_electron_lfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta at pressure pedestal top for electrons using the high field side magnetic poloidal field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:beta_pol_pedestal_top_electron_hfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized Larmor radius at pressure pedestal top for electrons using the low field side magnetic field (important for spherical tokamaks)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:rhostar_pedestal_top_electron_lfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Maximum value in the pedestal of the alpha parameter for electron pressure (see [Miller PoP 5 (1998),973,Eq. 42])" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:alpha_electron_pedestal_max ],
        [ sh:datatype xsd:float ;
            sh:description "Parameters of the fit" ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fyo:parameters ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Pedestal stored thermal energy for electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:energy_thermal_pedestal_electron ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Coulomb factor log(lambda) at the position of the pressure pedestal top (as determined by the fit)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path fyo:coulomb_factor_pedestal_top ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal field calculated at the position of the pressure pedestal top (as determined by the fit) on the high field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:b_field_pol_pedestal_top_hfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal field calculated at the position of the pressure pedestal top (as determined by the fit) on the low field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fyo:b_field_pol_pedestal_top_lfs ],
        [ sh:class fyo:SummaryPedestalFitTe ;
            sh:description "Electron temperature related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:t_e ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized Larmor radius at pressure pedestal top for electrons using the high field side magnetic field (important for spherical tokamaks)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:rhostar_pedestal_top_electron_hfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal field calculated at the position of the pressure pedestal top (as determined by the fit) on the high field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path fyo:b_field_tor_pedestal_top_hfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta at pressure pedestal top for electrons using the flux surface average magnetic poloidal field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:beta_pol_pedestal_top_electron_average ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Toroidal field calculated at the position of the pressure pedestal top (as determined by the fit) on the low field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path fyo:b_field_tor_pedestal_top_lfs ],
        [ sh:class fyo:SummaryPedestalFitNe ;
            sh:description "Electron pressure related quantities" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:pressure_electron ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Pedestal stored thermal energy for ions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:energy_thermal_pedestal_ion ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal field calculated at the position of the pressure pedestal top (as determined by the fit) and averaged over the flux surface" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fyo:b_field_pol_pedestal_top_average ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Plasma volume enclosed between the magnetic axis and the top of the pedestal" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:volume_inside_pedestal ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Normalized collisionality at pressure pedestal top for electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:nustar_pedestal_top_electron ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total magnetic field calculated at the position of the pressure pedestal top (as determined by the fit) on the low field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path fyo:b_field_pedestal_top_lfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Position in normalized poloidal flux of the maximum value in the pedestal of the alpha parameter for electron pressure (see [Miller PoP 5 (1998),973,Eq. 42])" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:alpha_electron_pedestal_max_position ] ;
    sh:targetClass fyo:SummaryPedestalFit .

fyo:SummaryPedestalFitLinear a sh:NodeShape ;
    rdfs:comment "Quantities related to linear fit" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Total magnetic field calculated at the position of the pressure pedestal top (as determined by the fit) on the high field side" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:b_field_pedestal_top_hfs ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Pedestal stored thermal energy for ions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:energy_thermal_pedestal_ion ],
        [ sh:class fyo:SummaryDynamicFlt1dRoot ;
            sh:description "Poloidal beta at pressure pedestal top for electrons using the low field side magnetic poloidal field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
