            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:minus ],
        [ sh:class fyo:WavesCPX1D ;
            sh:description "Parallel to magnetic field polarised electric field component" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:parallel ],
        [ sh:datatype xsd:string ;
