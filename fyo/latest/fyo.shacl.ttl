            sh:order 10 ;
            sh:path fyo:beryllium ],
        [ sh:class fyo:SummaryConstantFlt0d2 ;
            sh:description "Accumulated gas injected from all valves located near the equatorial midplane" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
