            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:area ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Position of the laser start point" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:start_point ] ;
    sh:targetClass fyo:ThomsonScatteringLaser .

fyo:ThomsonScatteringPolychromator a sh:NodeShape ;
    rdfs:comment "Set of polychromators" ;
