            sh:path prov:wasAttributedTo ],
        [ sh:class spo:Identifier ;
            sh:description "Choice of midplane definition for the mapping of measurements on an equilibrium. Indicate the IMAS URI of the used equilibrium IDS in the ids_properties/provenance section." ;
            sh:maxCount 1 ;
