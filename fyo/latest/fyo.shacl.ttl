    sh:targetClass fyo:GenericGridScalarSinglePosition .

spo:ContinuousQuantity a sh:NodeShape ;
    rdfs:comment "A continuous physical quantity defined over a Domain — scalar or tensor (the information content of a Quality that is_function_of the Domain and inheres_in a MaterialEntity, C-4). Field (space / general domain) and Signal (time domain) are its sibling specializations. MULTI-REPRESENTATION: one Quality may be re-presented by several ContinuousQuantity instances on different Domains / grids / charts (DD equilibrium profiles_2d[i] per grid_type) — each carries representation_of to the shared Quality and equivalent_representation to its peers; the representations differ in discretization, not in referent." ;
    sh:closed false ;
    sh:ignoredProperties ( fyo:phi_coefficients fyo:poloidal fyo:value fyo:values fyo:phi spo:time fyo:diamagnetic fyo:parallel_coefficients fyo:validity_timed fyo:radial fyo:z_coefficients fyo:r_coefficients fyo:grid_subset_index fyo:parallel fyo:radial_coefficients fyo:r fyo:poloidal_coefficients rdf:type spo:data fyo:grid_index fyo:validity fyo:z fyo:diamagnetic_coefficients fyo:coefficients spo:timebase_source ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_domain ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:equivalent_representation ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:is_function_of ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass spo:ContinuousQuantity .

<http://purl.obolibrary.org/obo/BFO_0000019> a sh:NodeShape ;
    rdfs:comment "A specifically dependent continuant that inheres in its bearer (BFO quality). A measurable physical attribute." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000019> .

<http://purl.obolibrary.org/obo/BFO_0000040> a sh:NodeShape ;
    rdfs:comment "A continuant that occupies a spatial region and can be identified as a whole (BFO material entity). Devices / equipment / plasma referent." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type fyo:produces fyo:hosts fyo:isHostedBy ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This material entity occupies a spatial region. (slot_uri [TBD] — verify BFO/RO IRI.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:occupies ],
        [ sh:datatype xsd:string ;
            sh:description "Parthood (BFO has_part). Device assembly chains (coil → turn → conductor)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ] ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000040> .

fyo:SummaryConstantFlt0d a sh:NodeShape ;
    rdfs:comment "Nitrogen (N)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Source of the data (any comment describing the origin of the data : code, path to diagnostic signals, processing method, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:source ],
        [ sh:datatype xsd:float ;
            sh:description "Value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:value ] ;
    sh:targetClass fyo:SummaryConstantFlt0d .

fyo:BTorVacuum1 a sh:NodeShape ;
    rdfs:comment "Characteristics of the vacuum toroidal field (used in Rho_Tor definition and in the normalization of current densities)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Reference major radius where the vacuum toroidal magnetic field is given (usually a fixed position such as the middle of the vessel at the equatorial midplane)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r0 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Vacuum toroidal field at R0 [T]; Positive sign means anti-clockwise when viewing from above. The product R0B0 must be consistent with the b_tor_vacuum_r field of the tf IDS." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:b0 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:BTorVacuum1 .

<http://purl.obolibrary.org/obo/BFO_0000011> a sh:NodeShape ;
    rdfs:comment "A region of spacetime (BFO spatiotemporal region). 4D extension stratum (FYTOK-REPORT-05 §rpt05-4d): the four-dimensional intension whose 3D+Time foliation is the canonical view." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000011> .

fyo:PulseScheduleReferencePosition a sh:NodeShape ;
    rdfs:comment "Major radius" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Reference waveform. Caution : error bars of the reference/data node are not used in the usual sense, instead they are used to describe the control envelope, with a meaning depending on the chosen envelope_type option." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:reference ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Reference name (e.g. in the native pulse schedule system of the device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:reference_name ],
        [ sh:datatype xsd:integer ;
            sh:description "Reference type:  0:relative (don't use for the moment, to be defined later when segments are introduced in the IDS structure); 1: absolute: the reference time trace is provided in the reference/data node" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:reference_type ],
        [ sh:datatype xsd:integer ;
            sh:description "Envelope type:  0:relative: means that the envelope upper and lower bound values are defined respectively as reference.data * reference.data_error_upper and reference.data * reference.data_error_lower. 1: absolute: the envelope upper and lower bound values are given respectively by reference/data_error_upper and reference/data_error_lower. Lower are upper are taken in the strict mathematical sense, without considering absolute values of the data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:envelope_type ] ;
    sh:targetClass fyo:PulseScheduleReferencePosition .

fyo:PhysicalQuantityFlt1dTime1 a sh:NodeShape ;
    rdfs:comment "Frequency of the channel" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for the whole acquisition period. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:validity ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:validity_timed ] ;
    sh:targetClass fyo:PhysicalQuantityFlt1dTime1 .

fyo:DetectorAperture a sh:NodeShape ;
    rdfs:comment "Detector description" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path spo:describes_region ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "If geometry_type=2, coordinates of the centre of the circle. If geometry_type=1 or 3, coordinates of the origin of the local coordinate system (X1,X2,X3) describing the plane detector/aperture. This origin is located within the detector/aperture area." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:centre ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path spo:has_coordinate_system ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the detector/aperture plane and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of the circle, used only if geometry_type = 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:radius ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the aperture in the X2 direction, used only if geometry_type = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:x2_width ],
        [ sh:class fyo:X1x21dStatic ;
            sh:description "Irregular outline of the detector/aperture in the (X1, X2) coordinate system. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:outline ],
        [ sh:datatype xsd:float ;
            sh:description "Full width of the aperture in the X1 direction, used only if geometry_type = 3" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:x1_width ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:geometry_role ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:datatype xsd:integer ;
            sh:description "Type of geometry used to describe the surface of the detector or aperture (1:'outline', 2:'circular', 3:'rectangle'). In case of 'outline', the surface is described by an outline of point in a local coordinate system defined by a centre and three unit vectors X1, X2, X3. Note that there is some flexibility here and the data provider should choose the most convenient coordinate system for the object, respecting the definitions of (X1,X2,X3) indicated below. In case of 'circular', the surface is a circle defined by its centre, radius, and normal vector oriented towards the plasma X3.  In case of 'rectangle', the surface is a rectangle defined by its centre, widths in the X1 and X2 directions, and normal vector oriented towards the plasma X3." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:datatype xsd:float ;
            sh:description "Surface of the detector/aperture, derived from the above geometric data" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fyo:surface ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:DetectorAperture .

fyo:SignalFlt1dValidity a sh:NodeShape ;
    rdfs:comment "Average effective charge along the line of sight" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:has_domain ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path spo:equivalent_representation ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for the whole acquisition period. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:validity ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:unit ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path spo:timebase_source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:validity_timed ] ;
    sh:targetClass fyo:SignalFlt1dValidity .

spo:Domain a sh:NodeShape ;
    rdfs:comment "A mathematical domain a quantity is defined over (an axis / grid / mesh). Coordinates are Domains, not path strings (C-3). Mesh / discretization detail is owned by sp_mathx (OI-2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The controlled coordinate name this Domain realizes (continuous physical axis)." ;
            sh:in ( "time" "psi" "psi_norm" "rho_tor" "rho_tor_norm" "rho_pol_norm" "phi" "theta" "volume" "area" "r" "z" "dim1" "dim2" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path spo:coordinate ] ;
    sh:targetClass spo:Domain .

fyo:SignalFlt2d a sh:NodeShape ;
    rdfs:comment "Calibrated intensities of the 9 splitted lines (Stark effect due to Lorentz electric field). Note: radiances are integrated over the sightline crossing the neutral beam" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path spo:timebase_source ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:equivalent_representation ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:representation_of ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:unit ] ;
    sh:targetClass fyo:SignalFlt2d .

fyo:Rphiz0dStatic a sh:NodeShape ;
    rdfs:comment "Position of the measurements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle (oriented counter-clockwise when viewing from above)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:phi ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:geometry_role ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:manifold_dim ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:describes_region ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:Rphiz0dStatic .

fyo:Xyz0dStatic a sh:NodeShape ;
    rdfs:comment "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:float ;
            sh:description "Component along X axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:x ],
        [ sh:datatype xsd:float ;
            sh:description "Component along Y axis" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:y ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:manifold_dim ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:float ;
            sh:description "Component along Z axis" ;
