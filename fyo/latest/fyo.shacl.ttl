    sh:property [ sh:class fyo:GenericGridVectorComponents ;
            sh:description "Velocity due to the diamagnetic drift, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fyo:velocity_diamagnetic ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:vibrational_mode ],
        [ sh:class fyo:GenericGridScalar ;
            sh:description "Average Z of the state bundle (equal to z_min if no bundle), = sum (Z*x_z) where x_z is the relative concentration of a given charge state in the bundle, i.e. sum(x_z) = 1 over the bundle, given on various grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:z_average ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
