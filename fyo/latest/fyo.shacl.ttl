            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PlasmaTransportModel3Density ;
            sh:description "Transport quantities related to density equation of the charge state considered (thermal+non-thermal)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:particles ],
        [ sh:class fyo:PlasmaTransportModel3Energy ;
            sh:description "Transport quantities related to the energy equation of the charge state considered" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:energy ],
        [ sh:datatype xsd:string ;
            sh:description "Vibrational mode of this state, e.g. \"A_g\". Need to define, or adopt a standard nomenclature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:vibrational_mode ],
        [ sh:datatype xsd:float ;
            sh:description "Vibrational level (can be bundled)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:vibrational_level ] ;
    sh:targetClass fyo:PlasmaTransportModelNeutralState .

fyo:PlasmaTransportModelProfiles1d a sh:NodeShape ;
    rdfs:comment "Transport coefficient profiles for various time slices. The transport of particles, energy and momentum is described by diffusion coefficients, D, and convection velocities, v. In 1D (radial) equations, these are defined by the total fluxes of particles, energy and momentum, across a flux surface given by : V' [-D Y' <|grad(rho_tor_norm)|^2> + v Y <|grad(rho_tor_norm)|>], where Y represents the particles, energy and momentum density, respectively, while V is the volume inside a flux surface, the" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PlasmaTransportModelNeutral ;
            sh:description "Transport coefficients related to the various neutral species" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:neutral ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000148> ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Parallel conductivity" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:conductivity_parallel ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fyo:time ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path spo:at_time ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path spo:slice_of ],
        [ sh:class fyo:PlasmaTransportModel1Momentum ;
            sh:description "Transport coefficients for total toroidal momentum equation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:momentum_phi ],
        [ sh:datatype xsd:float ;
            sh:description "Radial component of the electric field (calculated e.g. by a neoclassical model)" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:e_field_radial ],
        [ sh:class fyo:PlasmaRadialGrid ;
            sh:description "Grid for effective diffusivities and parallel conductivity. Note that some of the radial coordinates listed above are undefined outside the last closed flux surface, thus they must be filled with EMPTY_FLOAT values in such locations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:grid_d ],
        [ sh:class fyo:PlasmaRadialGrid ;
            sh:description "Grid for effective convections. Note that some of the radial coordinates listed above are undefined outside the last closed flux surface, thus they must be filled with EMPTY_FLOAT values in such locations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:grid_v ],
        [ sh:class fyo:PlasmaTransportModelElectrons ;
            sh:description "Transport quantities related to the electrons" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:electrons ],
        [ sh:class fyo:PlasmaTransportModelIons ;
            sh:description "Transport coefficients related to the various ion species, in the sense of isonuclear or isomolecular sequences. ionization states (and other types of states) must be differentiated at the state level below" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:ion ],
        [ sh:class fyo:PlasmaRadialGrid ;
            sh:description "Grid for fluxes. Note that some of the radial coordinates listed above are undefined outside the last closed flux surface, thus they must be filled with EMPTY_FLOAT values in such locations" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:grid_flux ],
        [ sh:class fyo:PlasmaTransportModel1Energy ;
            sh:description "Transport coefficients for the total (summed over ion  species) energy equation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:total_ion_energy ] ;
    sh:targetClass fyo:PlasmaTransportModelProfiles1d .

fyo:PolarimeterChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (lines-of-sight)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Ellipticity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:ellipticity ],
        [ sh:datatype xsd:float ;
            sh:description "Wavelength used for polarimetry" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:wavelength ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Faraday angle (variation of the Faraday angle induced by crossing the plasma)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:faraday_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Initial ellipticity before entering the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:ellipticity_initial ],
        [ sh:class fyo:LineOfSight3points ;
            sh:description "Description of the line of sight of the channel, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:line_of_sight ],
        [ sh:datatype xsd:float ;
            sh:description "Initial polarization vector before entering the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:polarization_initial ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:PolarimeterChannel .

fyo:Polarizer a sh:NodeShape ;
    rdfs:comment "Set of polarizers placed in front of the diagnostic (if any). Polarizers are assumed to be orthogonal to the line of sight, so that the x3 unit vector is aligned with the line of sight" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X2 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X2 axis is orthonormal so that uX2 = uX3 x uX1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:x2_unit_vector ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X1 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X1 vector is more horizontal than X2 (has a smaller abs(Z) component) and oriented in the positive phi direction (counter-clockwise when viewing from above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:x1_unit_vector ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "If geometry_type=2, coordinates of the centre of the circle. If geometry_type=1 or 3, coordinates of the origin of the local coordinate system (X1,X2,X3) describing the plane polarizer. This origin is located within the polarizer area. Note that there is some flexibility here and the data provider should choose the most convenient coordinate system for the object, respecting the definitions of (X1,X2,X3) indicated below." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:centre ],
        [ sh:datatype xsd:float ;
            sh:description "Alignment angle of the polarizer in the (x1,x2) plane. Electric fields parallel to the polarizer angle will be reflected. The angle is defined with respect to the x1 unit vector, positive in the counter-clockwise direction when looking towards the plasma" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:polarization_angle ],
        [ sh:class fyo:Xyz0dStatic ;
            sh:description "Components of the X3 direction unit vector in the (X,Y,Z) coordinate system, where X is the major radius axis for phi = 0, Y is the major radius axis for phi = pi/2, and Z is the height axis. The X3 axis is normal to the polarizer plane and oriented towards the plasma." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:x3_unit_vector ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Radius of the circle, used only if geometry_type = 2" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:radius ] ;
    sh:targetClass fyo:Polarizer .

fyo:Profiles2dGrid a sh:NodeShape ;
    rdfs:comment "Definition of the 2D grid (the content of dim1 and dim2 is defined by the selected grid_type)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Second dimension values" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:dim2 ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:float ;
            sh:description "Volume of plasma enclosed in the cell formed by the nodes [dim1(i) dim2(j)], [dim1(i+1) dim2(j)], [dim1(i) dim2(j+1)] and [dim1(i+1) dim2(j+1)]" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:volume_element ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "First dimension values" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:dim1 ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass fyo:Profiles2dGrid .

fyo:PulseScheduleDensityControl a sh:NodeShape ;
    rdfs:comment "Gas injection system and density control references" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Average ratio of hydrogen over deuterium density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:n_h_over_n_d ],
        [ sh:class fyo:LineOfSight3points ;
            sh:description "Description of the line of sight for calculating n_e, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:n_e_line_of_sight ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Average ratio of tritium over deuterium density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:n_t_over_n_d ],
        [ sh:class fyo:PulseScheduleDensityControlValve ;
            sh:description "Set of injection valves. Time-dependent" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:valve ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Line averaged effective charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:zeff ],
        [ sh:datatype xsd:float ;
            sh:description "Timebase for the dynamic nodes located at this level of the IDS structure and below" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:time ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Line integrated electron density over a line of sight in the whole vacuum chamber" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:n_e_line ],
        [ sh:class fyo:PulseScheduleDensityControlIon ;
            sh:description "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:ion ],
        [ sh:datatype xsd:integer ;
            sh:description "Control mode (operation mode and/or settings used by the controller)" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fyo:mode ],
        [ sh:class spo:Identifier ;
            sh:description "Method for zeff calculation : Index = 1: average over a line of sight in the whole vacuum chamber, 2 : average over a line of sight within the LCFS, 3 : average of a 1D core profile over rho_tor_norm up to the LCFS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:zeff_method ],
        [ sh:class fyo:LineOfSight3points ;
            sh:description "Description of the line of sight for calculating zeff, defined by two points when the beam is not reflected, a third point is added to define the reflected beam path" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:zeff_line_of_sight ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Integral of a 1D core profile over rho_tor_norm up to the LCFS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:n_e_profile_average ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Volume averaged electron density (average over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:n_e_volume_average ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Line integrated electron density over a line of sight within the LCFS" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:n_e_line_lcfs ] ;
    sh:targetClass fyo:PulseScheduleDensityControl .

fyo:PulseScheduleDensityControlIon a sh:NodeShape ;
    rdfs:comment "Quantities related to the different ion species, in the sense of isonuclear or isomolecular sequences" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Ion charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_ion ],
        [ sh:class fyo:PlasmaCompositionNeutralElementConstant ;
            sh:description "List of elements forming the atom or molecule" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:element ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "String identifying ion (e.g. H, D, T, He, C, D2, ...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:name ],
        [ sh:class fyo:PulseScheduleReferenceDensity ;
            sh:description "Volume averaged ion density (average over the plasma volume up to the LCFS)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:n_i_volume_average ] ;
    sh:targetClass fyo:PulseScheduleDensityControlIon .

fyo:PulseScheduleDensityControlValve a sh:NodeShape ;
    rdfs:comment "Set of injection valves. Time-dependent" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
