fyo:WavesCoherentWaveFullWaveBField a sh:NodeShape ;
    rdfs:comment "Components of the wave magnetic field, , represented as Fourier coefficients B(n_tor,frequency) such that the electric is equal to real(B(n_tor,frequency).exp(i(n_tor.phi - 2.pi.frequency.t)))" ;
