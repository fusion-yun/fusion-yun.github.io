            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:signal_to_noise ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the isotope ratios for the whole acquisition period (0 means valid, negative values mean non-valid)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:validity ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the isotope ratios as a function of time (0 means valid, negative values mean non-valid)" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:validity_timed ],
        [ sh:class fyo:SpectroVisChannelIsotopesIsotope ;
            sh:description "Set of isotopes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:isotope ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
