            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:filter ],
        [ sh:datatype xsd:float ;
            sh:description "Exposure time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:exposure_time ],
        [ sh:datatype xsd:float ;
            sh:description "Array of wavelengths for radiance calibration" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:wavelengths ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Gain corrected and background subtracted voltage" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:photoelectric_voltage ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Date of the radiance calibration (yyyy_mm_dd)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:radiance_calibration_date ],
        [ sh:datatype xsd:float ;
            sh:description "Radiance calibration" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:radiance_calibration ],
        [ sh:class fyo:SignalFlt1d ;
            sh:description "Raw voltage output of the whole acquisition chain" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:output_voltage ] ;
