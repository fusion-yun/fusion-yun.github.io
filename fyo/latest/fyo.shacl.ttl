            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Toroidal angle (oriented counter-clockwise when viewing from above)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:phi ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:manifold_dim ],
        [ sh:datatype xsd:float ;
            sh:description "Height" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:z ],
        [ sh:datatype xsd:float ;
            sh:description "Major radius" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:r ] ;
    sh:targetClass fyo:Rphiz1dStatic .

fyo:SignalFlt3d a sh:NodeShape ;
    rdfs:comment "Power density map in the poloidal cross-section, obtained from tomographic inversion of the bolometer data" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of the quantity (UCUM / QUDT string; authority external to fytok — SpData sp:phys)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:unit ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:equivalent_representation ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000040> ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/RO_0000052> ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000019> ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:representation_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path spo:timebase_source ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:time ] ;
    sh:targetClass fyo:SignalFlt3d .

fyo:GenericGridAos3Root a sh:NodeShape ;
    rdfs:comment "Grid (using the Generic Grid Description), for various time slices. The timebase of this array of structure must be a subset of the ggd timebase" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GenericGridDynamicGridSubset ;
            sh:description "Grid subsets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:grid_subset ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridDynamicSpace ;
            sh:description "Set of grid spaces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:space ],
        [ sh:datatype xsd:float ;
            sh:description "Time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:time ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:has_coordinate_system ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:geometry_role ],
        [ sh:class spo:Identifier ;
            sh:description "Grid identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Path of the grid, including the IDS name, in case of implicit reference to a grid_ggd node described in another IDS. To be filled only if the grid is not described explicitly in this grid_ggd structure. Example syntax: #wall:2/description_ggd(1)/grid_ggd, means that the grid is located in the wall IDS, occurrence 2, with relative path description_ggd(1)/grid_ggd, using Fortran index convention (here : first index of the array)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:path ] ;
    sh:targetClass fyo:GenericGridAos3Root .

fyo:LangmuirProbesPlungePhysicalQuantity2 a sh:NodeShape ;
    rdfs:comment "Floating potential" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for each time slice. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:validity_timed ],
        [ sh:datatype xsd:integer ;
            sh:description "Indicator of the validity of the data for the whole plunge. 0: valid from automated processing, 1: valid and certified by the diagnostic RO; - 1 means problem identified in the data processing (request verification by the diagnostic RO), -2: invalid data, should not be used (values lower than -2 have a code-specific meaning detailing the origin of their invalidity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:validity ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Data" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:data ] ;
    sh:targetClass fyo:LangmuirProbesPlungePhysicalQuantity2 .

fyo:PlasmaCompositionNeutralElementConstant a sh:NodeShape ;
    rdfs:comment "List of elements forming the atom (in such case, this array should be of size 1) or molecule. Mass of atom and nuclear charge should be set to 0 for photons and electrons. The mass of atom shouldn't be set for an atomic process that is not isotope dependent." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Nuclear charge" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:z_n ],
        [ sh:datatype xsd:float ;
            sh:description "Mass of atom" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:a ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of atoms of this element in the molecule" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:atoms_n ] ;
    sh:targetClass fyo:PlasmaCompositionNeutralElementConstant .

