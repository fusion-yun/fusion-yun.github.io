fyo:ScenarioSpecification a sh:NodeShape ;
    rdfs:comment "A directive information content entity declaring an application-task run: which solvers (by plugin name), which convergence criterion and iteration cap, which data sources — the \"scenario\" as authored, before any run realizes it. The scenario loop's declared configuration (enabling-core G-3: convergence criteria and iteration caps are explicit, configurable modeling decisions)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Upper bound on scenario-loop iterations (explicit modeling decision)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:iteration_cap ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Solver plugin names this scenario binds (FyModule prefix keys), e.g. fyeq / fytrans / freegs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:solver_selection ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:ScenarioSpecification .

fyo:CodeConstant a sh:NodeShape ;
