            sh:order 18 ;
            sh:path prov:generatedAtTime ],
        [ sh:class fyo:StokesDynamic ;
            sh:description "Stokes vector at the output of the FOCS as a function of time" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:stokes_output ],
        [ sh:class fyo:FocsFibreProperties ;
            sh:description "Intrinsic properties of the fibre installed on the vacuum vessel" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:fibre_properties ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
