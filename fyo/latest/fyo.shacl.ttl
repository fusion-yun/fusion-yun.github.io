fyo:GenericGridConstantSpace a sh:NodeShape ;
    rdfs:comment "Set of grid spaces" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Type of coordinates describing the physical space, for every coordinate of the space. The size of this node therefore defines the dimension of the space." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:coordinates_type ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridConstantSpaceDimension ;
            sh:description "Definition of the space objects for every dimension (from one to the dimension of the highest-dimensional objects). The index correspond to 1=nodes, 2=edges, 3=faces, 4=cells/volumes, .... For every index, a collection of objects of that dimension is described." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:objects_per_dimension ],
        [ sh:class spo:Identifier ;
            sh:description "Type of space geometry (0: standard, 1:Fourier, >1: Fourier with periodicity)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:geometry_type ],
        [ sh:class spo:Identifier ;
            sh:description "Space identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GenericGridConstantSpace .

fyo:GenericGridConstantSpaceDimension a sh:NodeShape ;
    rdfs:comment "Definition of the space objects for every dimension (from one to the dimension of the highest-dimensional objects). The index correspond to 1=nodes, 2=edges, 3=faces, 4=cells/volumes, .... For every index, a collection of objects of that dimension is described." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:GenericGridConstantSpaceDimensionObject ;
            sh:description "Set of objects for a given dimension" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:object ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class spo:Identifier ;
            sh:description "Content of the ../object/geometry node for this dimension" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:geometry_content ] ;
    sh:targetClass fyo:GenericGridConstantSpaceDimension .

fyo:GenericGridConstantSpaceDimensionObject a sh:NodeShape ;
    rdfs:comment "Set of objects for a given dimension" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "2D geometry data associated with the object. Its dimension depends on the type of object, geometry and coordinate considered. Typically, the first dimension represents the object coordinates, while the second dimension would represent the values of the various degrees of freedom of the finite element attached to the object." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:geometry_2d ],
        [ sh:class fyo:GenericGridConstantSpaceDimensionObjectBoundary ;
            sh:description "Set of (n-1)-dimensional objects defining the boundary of this n-dimensional object" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:boundary ],
        [ sh:datatype xsd:float ;
            sh:description "Measure of the space object, i.e. physical size (length for 1d, area for 2d, volume for 3d objects,...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:measure ],
        [ sh:datatype xsd:integer ;
            sh:description "List of nodes forming this object (indices to objects_per_dimension(1)%object(:) in Fortran notation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:nodes ],
        [ sh:datatype xsd:float ;
            sh:description "Geometry data associated with the object. Its detailed content is defined by ../../geometry_content. Its dimension depends on the type of object, geometry and coordinate considered." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:geometry ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GenericGridConstantSpaceDimensionObject .

fyo:GenericGridConstantSpaceDimensionObjectBoundary a sh:NodeShape ;
    rdfs:comment "Set of (n-1)-dimensional objects defining the boundary of this n-dimensional object" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Index of this (n-1)-dimensional boundary object" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:index ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "List of indices of the n-dimensional objects adjacent to the given n-dimensional object. An object may have multiple neighbours on a boundary" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:neighbours ] ;
    sh:targetClass fyo:GenericGridConstantSpaceDimensionObjectBoundary .

fyo:GenericGridDynamicGridSubsetElement a sh:NodeShape ;
    rdfs:comment "Set of elements defining the grid subset. An element is defined by a combination of objects from potentially all spaces" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridDynamicGridSubsetElementObject ;
            sh:description "Set of objects defining the element" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:object ] ;
    sh:targetClass fyo:GenericGridDynamicGridSubsetElement .

fyo:GenericGridDynamicGridSubsetElementObject a sh:NodeShape ;
    rdfs:comment "Set of objects defining the element" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Dimension of the object - using the convention  1=nodes, 2=edges, 3=faces, 4=cells/volumes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:dimension ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the space from which that object is taken" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:space ],
        [ sh:datatype xsd:integer ;
            sh:description "Object index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:index ] ;
    sh:targetClass fyo:GenericGridDynamicGridSubsetElementObject .

fyo:GenericGridDynamicSpaceDimension a sh:NodeShape ;
    rdfs:comment "Definition of the space objects for every dimension (from one to the dimension of the highest-dimensional objects). The index correspond to 1=nodes, 2=edges, 3=faces, 4=cells/volumes, .... For every index, a collection of objects of that dimension is described." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Identifier ;
            sh:description "Content of the ../object/geometry node for this dimension" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:geometry_content ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:GenericGridDynamicSpaceDimensionObject ;
            sh:description "Set of objects for a given dimension" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:object ] ;
    sh:targetClass fyo:GenericGridDynamicSpaceDimension .

fyo:GenericGridDynamicSpaceDimensionObject a sh:NodeShape ;
    rdfs:comment "Set of objects for a given dimension" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Measure of the space object, i.e. physical size (length for 1d, area for 2d, volume for 3d objects,...)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:measure ],
        [ sh:datatype xsd:float ;
            sh:description "Geometry data associated with the object, its detailed content is defined by ../../geometry_content. Its dimension depends on the type of object, geometry and coordinate considered." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:geometry ],
        [ sh:class fyo:GenericGridDynamicSpaceDimensionObjectBoundary ;
            sh:description "Set of  (n-1)-dimensional objects defining the boundary of this n-dimensional object" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:boundary ],
        [ sh:datatype xsd:float ;
            sh:description "2D geometry data associated with the object. Its dimension depends on the type of object, geometry and coordinate considered. Typically, the first dimension represents the object coordinates, while the second dimension would represent the values of the various degrees of freedom of the finite element attached to the object." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:geometry_2d ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "List of nodes forming this object (indices to objects_per_dimension(1)%object(:) in Fortran notation)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:nodes ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GenericGridDynamicSpaceDimensionObject .

fyo:GenericGridDynamicSpaceDimensionObjectBoundary a sh:NodeShape ;
    rdfs:comment "Set of  (n-1)-dimensional objects defining the boundary of this n-dimensional object" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of this (n-1)-dimensional boundary object" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:index ],
        [ sh:datatype xsd:integer ;
            sh:description "List of indices of the n-dimensional objects adjacent to the given n-dimensional object. An object can possibly have multiple neighbours on a boundary" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:neighbours ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ] ;
    sh:targetClass fyo:GenericGridDynamicSpaceDimensionObjectBoundary .

fyo:GenericGridIdentifierSingle a sh:NodeShape ;
    rdfs:comment "The component type is given for various grid_subsets, using the identifier convention below" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:class spo:Identifier ;
            sh:description "Identifier value for the grid subset" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:identifier ] ;
    sh:targetClass fyo:GenericGridIdentifierSingle .

fyo:GenericGridInteger a sh:NodeShape ;
    rdfs:comment "Orbit type identifier" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:datatype xsd:integer ;
            sh:description "One integer value is provided per element in the grid subset." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:values ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GenericGridInteger .

fyo:GenericGridMatrix a sh:NodeShape ;
    rdfs:comment "Orbit description of the particle at this position in phase space. First dimension is the element index. Second dimension is the time along the orbit. Third dimension contains the particle phase space coordinates." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "List of matrix components, one list per element in the grid subset. First dimension: element index. Second dimension: first matrix index. Third dimension: second matrix index." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:values ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension). Second dimension: first matrix index. Third dimension: second matrix index. Fourth dimension: coefficient index" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:coefficients ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ] ;
    sh:targetClass fyo:GenericGridMatrix .

fyo:GenericGridVector a sh:NodeShape ;
    rdfs:comment "Parameters of the BRDF model for various wall components (grid subsets)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Index of the grid used to represent this quantity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:grid_index ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "List of vector components, one list per element in the grid subset. First dimension: element index. Second dimension: vector component index." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:values ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "Interpolation coefficients, to be used for a high precision evaluation of the physical quantity with finite elements, provided per element in the grid subset (first dimension). Second dimension: vector component index. Third dimension: coefficient index" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:coefficients ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the grid subset the data is provided on. Corresponds to the index used in the grid subset definition: grid_subset(:)/identifier/index" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:grid_subset_index ] ;
    sh:targetClass fyo:GenericGridVector .

fyo:GyrokineticsCollisions a sh:NodeShape ;
    rdfs:comment "Collisions related quantities" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:float ;
            sh:description "normalized collisionality between two species" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:collisionality_norm ] ;
    sh:targetClass fyo:GyrokineticsCollisions .

fyo:GyrokineticsEigenmode a sh:NodeShape ;
    rdfs:comment "Set of eigenmode for this wavector" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:GyrokineticsMomentsLinear ;
            sh:description "Moments (normalized) of the perturbed distribution function of gyrocenters times 1st order Bessel function of the first kind" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:moments_norm_gyrocenter_bessel_1 ],
        [ sh:datatype xsd:integer ;
            sh:description "Flag = 1 if this is an initial value run, 0 for an eigenvalue run" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:initial_value_run ],
        [ sh:class fyo:GyrokineticsMomentsLinear ;
            sh:description "Moments (normalized) of the perturbed distribution function of particles" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:moments_norm_particle ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of poloidal turns considered in the flux-tube simulation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:poloidal_turns ],
        [ sh:datatype xsd:float ;
            sh:description "normalized time of the gyrokinetic simulation" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:time_norm ],
        [ sh:class fyo:GyrokineticsMomentsLinear ;
            sh:description "Moments (normalized) of the perturbed distribution function of gyrocenters times 0th order Bessel function of the first kind" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:moments_norm_gyrocenter_bessel_0 ],
        [ sh:datatype xsd:float ;
            sh:description "Poloidal angle grid. The angle is defined with respect to (R0,Z0) with R0=(Rmax-Rmin)/2 and Z0=(Zmax-Zmin)/2. It is increasing clockwise. So (r,theta,phi) is right-handed. theta=0 for Z=Z0 and R>R0 (LFS)" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:angle_pol ],
        [ sh:class fyo:GyrokineticsFluxes ;
            sh:description "normalized fluxes in the laboratory frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fyo:linear_weights ],
        [ sh:class fyo:GyrokineticsEigenmodeFields ;
            sh:description "Electrostatic potential, magnetic field and magnetic vector potential" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:fields ],
        [ sh:class fyo:CodePartialConstant ;
            sh:description "Code-specific parameters used for this eigenmode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:code ],
        [ sh:datatype xsd:float ;
            sh:description "Frequency" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:frequency_norm ],
        [ sh:class fyo:GyrokineticsFluxes ;
            sh:description "normalized fluxes in the rotating frame" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path fyo:linear_weights_rotating_frame ],
        [ sh:datatype xsd:float ;
            sh:description "Relative tolerance on the growth rate (convergence of the simulation)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:growth_rate_tolerance ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Growth rate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:growth_rate_norm ],
        [ sh:class fyo:GyrokineticsMomentsLinear ;
            sh:description "Moments (normalized) of the perturbed distribution function of gyrocenters" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:moments_norm_gyrocenter ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GyrokineticsEigenmode .

fyo:GyrokineticsEigenmodeFields a sh:NodeShape ;
    rdfs:comment "Electrostatic potential, magnetic field and magnetic vector potential" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Parity of the perturbed parallel vector potential with respect to theta = 0 (poloidal angle)" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:a_field_parallel_perturbed_parity ],
        [ sh:datatype xsd:float ;
            sh:description "Amplitude of the perturbed parallel magnetic field normalized to the sum of amplitudes of all perturbed fields" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:b_field_parallel_perturbed_weight ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:string ;
            sh:description "normalized perturbed electrostatic potential" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:phi_potential_perturbed_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Parity of the perturbed electrostatic potential with respect to theta = 0 (poloidal angle)" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:phi_potential_perturbed_parity ],
        [ sh:datatype xsd:string ;
            sh:description "normalized perturbed parallel vector potential" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fyo:a_field_parallel_perturbed_norm ],
        [ sh:datatype xsd:string ;
            sh:description "normalized perturbed parallel magnetic field" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fyo:b_field_parallel_perturbed_norm ],
        [ sh:datatype xsd:float ;
            sh:description "Amplitude of the perturbed electrostatic potential normalized to the sum of amplitudes of all perturbed fields" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:phi_potential_perturbed_weight ],
        [ sh:datatype xsd:float ;
            sh:description "Parity of the perturbed parallel magnetic field with respect to theta = 0 (poloidal angle)" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:b_field_parallel_perturbed_parity ],
        [ sh:datatype xsd:float ;
            sh:description "Amplitude of the perturbed parallel vector potential normalized to the sum of amplitudes of all perturbed fields" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fyo:a_field_parallel_perturbed_weight ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:GyrokineticsEigenmodeFields .

