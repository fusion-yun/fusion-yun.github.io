            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path spo:geometry_role ],
        [ sh:class fyo:Rz1dStatic ;
            sh:description "Irregular outline of the element. Repeat the first point since this is a closed contour" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fyo:outline ],
        [ sh:class fyo:ObliqueStatic ;
            sh:description "Parallelogram description of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fyo:oblique ],
        [ sh:class fyo:AnnulusStatic ;
            sh:description "The element is an annulus of centre R, Z, with inner radius radius_inner and outer radius radius_outer" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fyo:annulus ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:class fyo:ThickLineStatic ;
            sh:description "The element is approximated by a rectangle defined by a central segment and a thickness in the direction perpendicular to the segment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fyo:thick_line ],
        [ sh:class fyo:ArcsOfCircleStatic ;
            sh:description "Description of the element contour by a set of arcs of circle. For each of these, the position of the start point is given together with the curvature radius. The end point is given by the start point of the next arc of circle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fyo:arcs_of_circle ],
        [ sh:class fyo:RectangleStatic ;
            sh:description "Rectangular description of the element" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:rectangle ],
        [ sh:datatype xsd:integer ;
            sh:description "Type used to describe the element shape (1:'outline', 2:'rectangle', 3:'oblique', 4:'arcs of circle, 5: 'annulus', 6 : 'thick line')" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:geometry_type ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000006> ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass fyo:Outline2dGeometryStatic .

