            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Identifier ;
            sh:description "Analytical formula representing the electron density profile as a function of a radial coordinate and adjustable parameters f(rho_tor_norm, alpha1, ... alphaN)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fyo:formula ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:float ;
            sh:description "Values of the formula's parameters alpha1, ..., alphaN" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:parameters ] ;
    sh:targetClass fyo:RefractometerShapeApproximation .

