            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:fibre_length ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Total toroidal current flowing through the area outlined by the FOCS" ;
            sh:maxCount 1 ;
