fyo:ThomsonScatteringChannel a sh:NodeShape ;
    rdfs:comment "Set of channels (lines-of-sight)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fyo:SignalFlt1d ;
            sh:description "Distance between the measurement position and the separatrix, mapped along flux surfaces to the outboard midplane, in the major radius direction. Positive value means the measurement is outside of the separatrix." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fyo:distance_separatrix_midplane ],
        [ sh:class <http://purl.obolibrary.org/obo/BFO_0000001> ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ sh:datatype xsd:integer ;
            sh:description "Index of the polychromator used by this channel (refers to the ../../polychromator array)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fyo:polychromator_index ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the light scattering volume (full width) along the laser beam path, for this line of sight (i.e. length of the intersection between the laser beam and the viewing cone). This is a time average value in case of different lasers fired at different times" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fyo:scattering_length ],
        [ sh:datatype xsd:string ;
            sh:description "Description, e.g. “channel viewing the upper divertor”" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fyo:description ],
        [ sh:datatype xsd:float ;
            sh:description "Amplitude of the gaussian fit of the measured signal in each energy band, used to estimate the electron temperature" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fyo:gaussian_fit ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Electron temperature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fyo:t_e ],
        [ sh:datatype xsd:string ;
            sh:description "Short string identifier (unique for a given device)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fyo:name ],
        [ sh:class fyo:Rphiz0dStatic ;
            sh:description "Average position of the measurements (intersection between laser beam and line of sight)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fyo:position ],
        [ sh:class fyo:LineOfSight2points ;
            sh:description "Description of the line of sight of the channel, given by 2 points" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fyo:line_of_sight ],
        [ sh:class fyo:Rphiz1dDynamicAos1CommonTime ;
            sh:description "Incremental variation of the position of the measurements, due to e.g. different lasers not intersecting the line of sight at the same position. The actual position is then the static position + delta_position" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fyo:delta_position ],
        [ sh:class fyo:Rphiz1dStatic ;
            sh:description "Position of the intersection between each laser beam and this line of sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fyo:position_per_laser ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path spo:has_provenance ],
        [ sh:class fyo:SignalFlt1dValidity ;
            sh:description "Electron density" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fyo:n_e ],
        [ sh:datatype xsd:integer ;
            sh:description "Solid angle of the line of sight" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fyo:solid_angle ],
        [ sh:datatype xsd:float ;
            sh:description "Angle formed by the laser beam wave vector and the line of sight, counted clockwise when projected in the poloidal plane" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fyo:scattering_angle ] ;
    sh:targetClass fyo:ThomsonScatteringChannel .

fyo:ThomsonScatteringLaser a sh:NodeShape ;
    rdfs:comment "Set of probing lasers" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
