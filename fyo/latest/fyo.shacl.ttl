            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:occupies ],
        [ sh:class fyo:MachineSubsystem ;
            sh:description "A Machine bears first-class material sub-systems (BFO has_part)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:datatype xsd:string ;
