@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spo: <https://fusion-yun.github.io/spo/v0.5.g03cc95f6/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bfo:0000004 a sh:NodeShape ;
    rdfs:comment "A continuant that is the bearer of qualities and does not depend on other entities (BFO independent continuant)." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:coordinate rdf:type bfo:0000210 bfo:0000178 ) ;
    sh:targetClass bfo:0000004 .

bfo:0000008 a sh:NodeShape ;
    rdfs:comment "A region of time (BFO temporal region — an OCCURRENT in BFO 2020, re-seated here from the continuant side by SP-ONT-ADR-02 D-1). A dynamic quantity is a Quality over a TemporalRegion; an AoS time_slice[] array dissolves to a TemporalRegion domain." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000008 .

bfo:0000020 a sh:NodeShape ;
    rdfs:comment "A continuant that depends on one specific bearer (BFO SDC)." ;
    sh:closed false ;
    sh:ignoredProperties ( ro:0000052 rdf:type ) ;
    sh:targetClass bfo:0000020 .

bfo:0000031 a sh:NodeShape ;
    rdfs:comment "A continuant that can be copied across bearers (BFO GDC). Base of information artifacts and scenarios." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:has_slice spo:at_time spo:about_occurrent spo:is_function_of spo:of_coordinate_system spo:time spo:commit qudt:hasQuantityKind spo:description spo:geometry_role spo:metric_kind spo:of_quality spo:srepr rdf:type qudt:hasUnit spo:dimension_vector spo:at_instant spo:timebase_source spo:version spo:unit spo:chart_kind spo:describes_region spo:prescribes spo:index spo:has_spatial_base spo:latex spo:quantity_kind spo:discretizes_spacetime spo:has_coordinate_system spo:symbol spo:equivalent_representation spo:has_channel spo:has_domain spo:data spo:sympy_version spo:discretizes_time spo:dual_view_of spo:has_time_axis spo:is_record_of spo:coordinate_axis spo:manifold_dim spo:executed_code spo:has_metric spo:ucum_code spo:representation_of spo:samples spo:defining_formulation spo:numeric_value spo:slice_of spo:uses_library spo:name spo:has_provenance spo:draws_from iao:0000136 spo:repository ) ;
    sh:targetClass bfo:0000031 .

bfo:0000035 a sh:NodeShape ;
    rdfs:comment "The instantaneous temporal boundary of a process (BFO 2020). Parented on Occurrent, following BFO's own hierarchy — a process boundary is not itself a process. Added with ContinuantFiatBoundary, for the same reason (SPM-REPORT-104)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000035 .

bfo:0000140 a sh:NodeShape ;
    rdfs:comment "A zero-, one- or two-dimensional immaterial entity whose location is fixed relative to some material entity, and which never has a spatial region as continuant part (BFO 2020 elucidation). Carrier of a demarcation drawn on a thing rather than found in it — a region's fiat boundary, a nominal surface. Added when the conformance gate found `sp.mathx.region.FiatBoundary` anchored to a BFO term the T-Box did not carry: the ontology is authoritative, so the gap was the ontology's (SPM-REPORT-104)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000140 .

bfo:0000141 a sh:NodeShape ;
    rdfs:comment "An independent continuant with no material parts (BFO immaterial entity). Base of regions / sites." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:coordinate rdf:type ) ;
    sh:targetClass bfo:0000141 .

iao:0000030 a sh:NodeShape ;
    rdfs:comment "A generically dependent continuant that is about something (IAO information content entity). An IDS as a whole is an ICE. The is_about slot is the REALITY / DESCRIPTION bridge: the EAST tokamak is a MaterialEntity; a drawing of its vacuum vessel, a machine-description IDS, or a reconstructed equilibrium are ICEs ABOUT it — never the thing itself." ;
    sh:closed true ;
    sh:ignoredProperties ( spo:has_slice spo:at_time spo:about_occurrent spo:is_function_of spo:of_coordinate_system spo:time spo:commit qudt:hasQuantityKind spo:description spo:geometry_role spo:metric_kind spo:of_quality spo:srepr rdf:type qudt:hasUnit spo:dimension_vector spo:at_instant spo:timebase_source spo:version spo:unit spo:chart_kind spo:describes_region spo:prescribes spo:index spo:has_spatial_base spo:latex spo:quantity_kind spo:discretizes_spacetime spo:has_coordinate_system spo:symbol spo:equivalent_representation spo:has_channel spo:has_domain spo:data spo:sympy_version spo:discretizes_time spo:dual_view_of spo:has_time_axis spo:is_record_of spo:coordinate_axis spo:manifold_dim spo:executed_code spo:has_metric spo:ucum_code spo:representation_of spo:samples spo:defining_formulation spo:numeric_value spo:slice_of spo:uses_library spo:name spo:draws_from spo:repository ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass iao:0000030 .

iao:0000104 a sh:NodeShape ;
    rdfs:comment "A directive information content entity that prescribes a planned process (IAO plan specification). A pulse_schedule (reference waveforms / setpoints) is a PlanSpecification prescribing a discharge (C-10). class_uri version-sensitive — verify." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass iao:0000104 .

obi:0000011 a sh:NodeShape ;
    rdfs:comment "A process that realizes a plan specification (OBI planned process). An experiment / planned discharge." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iao:0000033 ;
            sh:description "NATIVE relation (SP-ONT-ADR-02 D-2/D-3): this planned process realizes a directive information entity — a plan specification for a planned run, or a Code (the program text) for a ComputationalProcess (program = directive ICE, run = Process, result = descriptive ICE output). Deliberate concretization SHORTCUT relative to BFO 2020: the strict bfo:0000055 realizes targets a REALIZABLE ENTITY (the plan concretizing the specification), never an ICE — so this slot carries no bfo anchor (skos:closeMatch bfo:0000055 in intent; the former exactMatch was a false mapping)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:realizes ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:class bfo:0000002 ;
            sh:description "A continuant that participates in this process (BFO 2020 \"has participant\") — the apparatus a measurement is implemented by, the subject it probes, the computing system a run executes on. Structural carrier of the process family's participation face (SP-ONT-ADR-04)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path bfo:0000057 ],
        [ sh:class bfo:0000011 ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ] ;
    sh:targetClass obi:0000011 .

qudt:QuantityValue a sh:NodeShape ;
    rdfs:comment "A scalar physical quantity value — numeric value + Unit + QuantityKind (the lift of a DD FLT_0D leaf with units; e.g. `vacuum_toroidal_field/b0` at one instant). The information counterpart of a fully determinate Quality; for quantities extended over a Domain use ContinuousQuantity (Field/Signal) instead." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "The numeric value in has_unit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:numeric_value ],
        [ sh:class bfo:0000019 ;
            sh:description "The world-side Quality (SDC inhering in a MaterialEntity) this information is about — the reality/description bridge for scalar values (iao:is_about specialization)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:of_quality ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class qudt:Unit ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path qudt:hasUnit ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path qudt:hasQuantityKind ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ] ;
    sh:targetClass qudt:QuantityValue .

spo:ComputationRecord a sh:NodeShape ;
    rdfs:comment "The record of a ComputationalProcess — a run manifest: which Code (program, GDC) was executed, with which inputs, producing which outputs (workflow-run document, solver log). Completes the program / computation / result triangle: Code (plan, GDC) — ComputationalProcess (occurrent, realizes the Code) — output ICEs (results) — this record (information about the run, distinct from the results themselves)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000015 ;
            sh:description "The process this record is about and generated by (iao:is_about + prov:wasGeneratedBy)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:is_record_of ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path iao:0000136 ],
        [ sh:class spo:Code ;
            sh:description "The Code (program) whose execution this record documents (prov:used the plan)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:executed_code ] ;
    sh:targetClass spo:ComputationRecord .

spo:ComputationalProcess a sh:NodeShape ;
    rdfs:comment "A computational process (a code run) producing simulated / reconstructed data. Reproducible given (code, inputs, version). When it consumes measured inputs (e.g. an equilibrium reconstruction over real magnetics) its output is reconstructed (measured-derived). A planned process (SP-ONT-ADR-02 D-5): every run realizes the directive ICE it executes (its Code) — the program/run split now carried structurally by the inherited `realizes`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000002 ;
            sh:description "A continuant that participates in this process (BFO 2020 \"has participant\") — the apparatus a measurement is implemented by, the subject it probes, the computing system a run executes on. Structural carrier of the process family's participation face (SP-ONT-ADR-04)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path bfo:0000057 ],
        [ sh:class iao:0000033 ;
            sh:description "NATIVE relation (SP-ONT-ADR-02 D-2/D-3): this planned process realizes a directive information entity — a plan specification for a planned run, or a Code (the program text) for a ComputationalProcess (program = directive ICE, run = Process, result = descriptive ICE output). Deliberate concretization SHORTCUT relative to BFO 2020: the strict bfo:0000055 realizes targets a REALIZABLE ENTITY (the plan concretizing the specification), never an ICE — so this slot carries no bfo anchor (skos:closeMatch bfo:0000055 in intent; the former exactMatch was a false mapping)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:realizes ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_output ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_input ],
        [ sh:class bfo:0000011 ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:has_spacetime_extent ] ;
    sh:targetClass spo:ComputationalProcess .

spo:Curve a sh:NodeShape ;
    rdfs:comment "A 1-D geometric object / manifold_dim 1 (e.g. flux-surface outline, limiter contour). Analytic children (Line / Ray / Segment / Circle / Ellipse) are sp_mathx plugin specializations dispatched by ``sp:plugin_name``; all lift here as spo:Curve." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_coordinate_system ],
        [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:describes_region ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:manifold_dim ] ;
    sh:targetClass spo:Curve .

spo:DesignSpecification a sh:NodeShape ;
    rdfs:comment "A DIRECTIVE information content entity that prescribes a material artifact to be realized — an engineering drawing of the EAST vacuum vessel, a coil winding spec. Distinguish three stances toward one MaterialEntity: (1) the thing itself (MaterialEntity); (2) the prescription of it (this class — exists before/independent of the thing; the as-designed view); (3) the description of it as built (a plain descriptive ICE with is_about — an as-measured machine-description dataset). Design and as-built descriptions may disagree; only (3) is truth-evaluable against reality. IAO alignment IRI [TBD]." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000040 ;
            sh:description "The material entity (kind) this design specification prescribes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:prescribes ] ;
    sh:targetClass spo:DesignSpecification .

spo:EngineeringDetermination a sh:NodeShape ;
    rdfs:comment "An engineering survey / calibration / design determination establishing a static device fact (e.g. a probe position). Invariant on the discharge timescale." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_input ],
        [ sh:class bfo:0000011 ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:class bfo:0000002 ;
            sh:description "A continuant that participates in this process (BFO 2020 \"has participant\") — the apparatus a measurement is implemented by, the subject it probes, the computing system a run executes on. Structural carrier of the process family's participation face (SP-ONT-ADR-04)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:0000057 ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_output ] ;
    sh:targetClass spo:EngineeringDetermination .

spo:Field a sh:NodeShape ;
    rdfs:comment "A continuous quantity over a (spatial / general) Domain — scalar or tensor (SoA leaf, L3; rank-1 → Function). Sibling of Signal under ContinuousQuantity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000019 ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_domain ],
        [ sh:class qudt:Unit ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path qudt:hasUnit ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:is_function_of ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "DEPRECATED — unit as a bare UCUM/QUDT string (see deprecation note; use has_unit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:unit ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path qudt:hasQuantityKind ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:equivalent_representation ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass spo:Field .

spo:Function a sh:NodeShape ;
    rdfs:comment "The one-dimensional Field — a rank-1 continuous quantity over a 1-D Domain (L3). NAMING (convention, see artifact/field.md §1): CamelCase `spo:Function` is this T-Box class (data: values over a domain); lowercase `spo:function` is the SpData document DSL for TYPED MATH FUNCTION specifications (args/returns/body — a mapping rule, GDC). The IRIs are distinct (case-sensitive); never mix the two in prose or CURIEs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_domain ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path iao:0000136 ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path qudt:hasQuantityKind ],
        [ sh:class bfo:0000019 ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:representation_of ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:equivalent_representation ],
        [ sh:class qudt:Unit ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path qudt:hasUnit ],
        [ sh:datatype xsd:string ;
            sh:description "DEPRECATED — unit as a bare UCUM/QUDT string (see deprecation note; use has_unit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:unit ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:is_function_of ] ;
    sh:targetClass spo:Function .

spo:GeoObject a sh:NodeShape ;
    rdfs:comment "Base of geometric primitives; the concrete carrier is sp_mathx (``geom.base.GeoObject`` — control-point ``points`` array, pluggable ``GeometryKernel`` engine). Manifold dimension distinguishes the four concrete children below (SPM-SDD-06 DE-MATHX-05)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:geometry_role ],
        [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:manifold_dim ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass spo:GeoObject .

spo:Geometry a sh:NodeShape ;
    rdfs:comment "An information content entity describing the geometry of a SpatialRegion (C-5). Bound to a sp_mathx GeoObject." ;
    sh:closed true ;
    sh:ignoredProperties ( spo:discretizes_spacetime spo:manifold_dim rdf:type spo:has_spatial_base spo:has_time_axis ) ;
    sh:property [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:geometry_role ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass spo:Geometry .

spo:Identifier a sh:NodeShape ;
    rdfs:comment "The DD identifier triple (name / index / description). The triple is a controlled-vocabulary value; the vocabulary it draws from is a T-Box enum / class (C-8)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short string key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Integer index into the vocabulary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:index ],
        [ sh:class spo:ControlledVocabulary ;
            sh:description "The controlled vocabulary this identifier value draws from (value → vocabulary, A-Box → T-Box)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:draws_from ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:description ] ;
    sh:targetClass spo:Identifier .

spo:MeasurementProcess a sh:NodeShape ;
    rdfs:comment "A real-world measurement / observation process producing measured data; part of a discharge (a PlannedProcess instance = shot). Unrepeatable — its output is about a unique spatiotemporal particular (this shot at this time), hence read-only / not reproducible / per-shot distinct." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000011 ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_output ],
        [ sh:class bfo:0000002 ;
            sh:description "A continuant that participates in this process (BFO 2020 \"has participant\") — the apparatus a measurement is implemented by, the subject it probes, the computing system a run executes on. Structural carrier of the process family's participation face (SP-ONT-ADR-04)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:0000057 ] ;
    sh:targetClass spo:MeasurementProcess .

spo:Point a sh:NodeShape ;
    rdfs:comment "A 0-D geometric object / manifold_dim 0 (e.g. magnetic axis, X-point). Carrier sp_mathx geom.point.Point." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:manifold_dim ],
        [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:describes_region ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:geometry_role ] ;
    sh:targetClass spo:Point .

spo:ProcessRecord a sh:NodeShape ;
    rdfs:comment "The RECORD of a process — an ICE generated by and about an Occurrent (prov:Entity wasGeneratedBy the Activity). The experiment / record split: a Shot (PlannedProcess) is unrepeatable and unstorable; what a data system holds is its ProcessRecord (the shot file, the populated IDS set, the logbook entry). The record is mutable/versionable and may be partial or wrong about the process; the process itself is neither." ;
    sh:closed true ;
    sh:ignoredProperties ( spo:executed_code rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000015 ;
            sh:description "The process this record is about and generated by (iao:is_about + prov:wasGeneratedBy)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:is_record_of ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path iao:0000136 ] ;
    sh:targetClass spo:ProcessRecord .

spo:ProvenanceMixin a sh:NodeShape ;
    rdfs:comment "Orthogonal provenance carried by any domain ICE (L7). Provenance time (creation_date / version order) is distinct from physical time (manifold coordinate). Also carries the data **modality** (static-device / measured / reconstructed / simulated) — derived from the generating process, orthogonal to the domain category (FYTOK-REPORT-05 §rpt05-modality)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "NATIVE attribute (SP-ONT-ADR-02 D-3 anchor hygiene): the name string of the agent that provided the data (legacy ids_properties/provider). The former prov:wasAttributedTo anchor was a false mapping — that PROV term is an object property to a prov:Agent, not a literal name; a structural agent concept is a registered open item." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:provider ],
        [ sh:description "The provenance modality of the data — how it was generated, orthogonal to its domain category. Derived from the generating process (and DD code/source), NOT from DD `type` (§rpt05-modality)." ;
            sh:in ( "static_device" "measured" "reconstructed" "simulated" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path spo:modality ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance time of generation (≠ physical time)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data can be regenerated identically — true for simulated / reconstructed / static device, false for measured (a unique, unrepeatable discharge event)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:reproducible ],
        [ sh:class bfo:0000015 ;
            sh:description "The process that generated the data — MeasurementProcess / ComputationalProcess / EngineeringDetermination (spo-core). The truthmaker of `modality`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:generated_by_process ],
        [ sh:class spo:Code ;
            sh:description "DEPRECATED — the Code associated with this artifact's production (see deprecation note)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:produced_by ],
        [ sh:datatype xsd:string ;
            sh:description "DD / Access-Layer version the data was written with (prov:Entity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:version_put ] ;
    sh:targetClass spo:ProvenanceMixin .

spo:Region a sh:NodeShape ;
    rdfs:comment "Base of SPATIAL regions only (SP-ONT-ADR-02 D-1). Temporal and spatiotemporal regions are occurrents in BFO 2020 and are seated on the occurrent side; this class no longer spans the categories." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass spo:Region .

spo:Solid a sh:NodeShape ;
    rdfs:comment "A 3-D geometric object / manifold_dim 3 (Box / Ball / Cylinder / Toroidal / swept solids)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_coordinate_system ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:geometry_role ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:manifold_dim ] ;
    sh:targetClass spo:Solid .

spo:SpacetimeMesh a sh:NodeShape ;
    rdfs:comment "A discretized 4D domain — a Mesh whose discretized region is a SpacetimeRegion (4D extension stratum). Two constructions: (a) product form, a spatial base Mesh extruded along a TimeAxis (the common shot-data case: same spatial grid, many instants); (b) a genuinely unstructured 4D GGD (moving/adaptive grids: the spatial grid itself is time-dependent, e.g. per-time-slice equilibrium grids — then the product decomposition is per-interval, not global). Fields over a SpacetimeMesh subsume both AoS and SoA: layout becomes a storage detail of the same 4D Field." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:has_coordinate_system ],
        [ sh:class spo:TimeAxis ;
            sh:description "The TimeAxis this aggregate/mesh is sampled on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_time_axis ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:describes_region ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:geometry_role ],
        [ sh:class spo:Mesh ;
            sh:description "The spatial base Mesh of a product-form SpacetimeMesh (absent for unstructured 4D grids)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:has_spatial_base ],
        [ sh:class bfo:0000011 ;
            sh:description "The SpacetimeRegion this 4D mesh discretizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:discretizes_spacetime ] ;
    sh:targetClass spo:SpacetimeMesh .

spo:SpacetimeWorm a sh:NodeShape ;
    rdfs:comment "A four-dimensionally extended individual (its temporal parts are time slices). A DD `time_slice[]` array is the discretized worm; the 3D continuant view is its foliated slice. Identity rests in the 4D intension artifact (SPM-CONOPS-01). Conservative extension — does not alter the 3D core axioms." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The 3D+Time foliated view of this worm (slice ⊣ stack; SPM-CONOPS-01). Read-time derivation, not a persisted distinct datum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:foliates_to ],
        [ sh:class bfo:0000011 ;
            sh:description "The spacetime region this worm occupies." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:occupies_spacetime ] ;
    sh:targetClass spo:SpacetimeWorm .

spo:Surface a sh:NodeShape ;
    rdfs:comment "A 2-D geometric object / manifold_dim 2 (Plane / Disc / Polygon / Sphere shell / ToroidalSurface)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:integer ;
            sh:description "Topological (manifold) dimension of the primitive — 0 point / 1 curve / 2 surface / 3 solid." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:manifold_dim ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_coordinate_system ],
        [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:describes_region ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:geometry_role ] ;
    sh:targetClass spo:Surface .

spo:TimeSeries a sh:NodeShape ;
    rdfs:comment "The SoA layout — per-quantity channels over a shared or embedded TimeAxis (DD signal pattern; a control-room trend plot). Each channel is a spo-signal Signal (a quantity over the time domain). Convenient for single-quantity-over-time access; dual to the AoS TimeSliceSeries via dual_view_of (slice the stack)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:Signal ;
            sh:description "The per-quantity Signal channels of this SoA aggregate." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_channel ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:TemporalAggregate ;
            sh:description "The other-layout aggregate carrying the same content about the same referent (AoS ↔ SoA; the slice ⊣ stack adjunction). Symmetric; a read-time transform (sampling one way, regrouping the other), not a persisted distinct datum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:dual_view_of ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:class bfo:0000003 ;
            sh:description "The temporally extended referent (SpacetimeWorm / Process) this aggregate is the information content of (iao:is_about specialization). Two aggregates about the same referent with different layouts are dual views, not distinct claims about the world." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:about_occurrent ],
        [ sh:class spo:TimeAxis ;
            sh:description "The TimeAxis this aggregate/mesh is sampled on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:has_time_axis ] ;
    sh:targetClass spo:TimeSeries .

bfo:0000038 a sh:NodeShape ;
    rdfs:comment "A one-dimensional temporal region (BFO temporal interval) — the extent a Signal or a discharge phase covers (e.g. flat-top). A TimeAxis discretizes a TimeInterval." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000038 .

bfo:0000148 a sh:NodeShape ;
    rdfs:comment "A zero-dimensional temporal region (BFO temporal instant) — the referent of one time-slice timestamp. A `time_slice[i]/time` value denotes a TimeInstant on the shot/simulation timeline." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000148 .

spo:ControlledVocabulary a sh:NodeShape ;
    rdfs:comment "A controlled vocabulary (the determinable). Its permissible values are the determinates (DD *_identifier.xml entries)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path iao:0000136 ] ;
    sh:targetClass spo:ControlledVocabulary .

spo:Library a sh:NodeShape ;
    rdfs:comment "A dependency library used by a Code (legacy code/library[]) — directive ICE like Code itself." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:repository ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:commit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:name ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:version ] ;
    sh:targetClass spo:Library .

spo:MathExpression a sh:NodeShape ;
    rdfs:comment "A symbolic mathematical expression as an ICE — the machine-canonical carrier of a formula (a defining formulation of a quantity kind, a model equation, a conversion law). PREFERRED machine representation = SymPy srepr text (SP-ONT-ADR-05, informed by the SPD-REPORT-12 survey): full structural capture, sympify round-trip, one source generating LaTeX / Content MathML / numeric callables. The optional LaTeX attribute is the PRESENTATION annex (application/x-tex), never a machine-semantics source. DECLARATION, NEVER EVALUATION: this class states what an equation is; the restricted read/write evaluation channel is a separate, sandboxed concern and the two are never merged. Machine retrieval goes through structured symbol-to-quantity side-band relations, not by parsing the expression string (carrier ledgered)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The canonical machine form — SymPy srepr text (e.g. \"Eq(Symbol('psi'), Mul(...))\"). Round-trips via sympify under the pinned SymPy version; regenerate downstream forms from this, never the reverse." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:srepr ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Optional presentation annex — LaTeX source (MIME application/x-tex)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:latex ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "SymPy version the srepr was produced with (version pin — srepr stability binds to SymPy constructor signatures; upgrades require a round-trip regression)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:sympy_version ] ;
    sh:targetClass spo:MathExpression .

spo:Mesh a sh:NodeShape ;
    rdfs:comment "A discretized domain (DD GGD generic_grid). Binds to sp_mathx Mesh / DEC: space = Domain, grid_subset = named subdomain / boundary, objects_per_dimension = topology chain (C-7). Not mirrored verbatim from DD." ;
    sh:closed true ;
    sh:ignoredProperties ( spo:discretizes_spacetime spo:has_spatial_base rdf:type spo:has_time_axis ) ;
    sh:property [ sh:class bfo:0000006 ;
            sh:description "The SpatialRegion this geometry describes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:describes_region ],
        [ sh:datatype xsd:string ;
            sh:description "The role this geometry plays (boundary / axis / limiter / outline …) — a controlled vocabulary value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:geometry_role ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this geometry's control points are expressed in (default Cartesian)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_coordinate_system ] ;
    sh:targetClass spo:Mesh .

spo:Metric a sh:NodeShape ;
    rdfs:comment "The metric tensor g_ij of a CoordinateSystem — the first fundamental form giving the line element ds² = g_ij dx^i dx^j, the volume element √det g, and (via its inverse g^ij) the Hodge star used by sp_mathx DEC. Identity for Cartesian charts; diagonal for the standard curvilinear charts. Carrier sp_mathx metric.Metric." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Structural form of the metric — euclidean (identity) / diagonal / general." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:metric_kind ],
        [ sh:class spo:CoordinateSystem ;
            sh:description "The CoordinateSystem this metric measures." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:of_coordinate_system ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ] ;
    sh:targetClass spo:Metric .

spo:Signal a sh:NodeShape ;
    rdfs:comment "A continuous quantity over the **time domain** (a TemporalRegion) — scalar or tensor (DD signal_flt_Nd, C-2). Sibling of Field (space / general domain) under ContinuousQuantity, not a subtype of it. Corresponds to the engineering carrier sp.mathx.signal.Signal — a Function over a time domain (the temporal analogue of Field, a Function over a Mesh), converged from sp_phys to sp_mathx (L1) as the domain-agnostic quantity-over-time. Bound via class_type (engineering-dispatch FQCN, distinct from the semantic class_uri; SPM-REPORT-15 C-3)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path iao:0000136 ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path qudt:hasQuantityKind ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path spo:is_function_of ],
        [ sh:class bfo:0000019 ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_domain ],
        [ sh:class qudt:Unit ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path qudt:hasUnit ],
        [ sh:datatype xsd:float ;
            sh:description "Signal samples over the time base — the DD/A-Box serialization column (runtime carrier is a Function)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:data ],
        [ sh:description "Where the time axis came from — IDS-homogeneous timebase vs per-signal embedded timebase (for reverse mapping)." ;
            sh:in ( "homogeneous" "embedded" "heterogeneous" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path spo:timebase_source ],
        [ sh:datatype xsd:string ;
            sh:description "DEPRECATED — unit as a bare UCUM/QUDT string (see deprecation note; use has_unit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path spo:equivalent_representation ],
        [ sh:datatype xsd:float ;
            sh:description "Signal time base — the DD/A-Box serialization column of the time axis (alias \".../time\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:time ] ;
    sh:targetClass spo:Signal .

spo:TimeSlice a sh:NodeShape ;
    rdfs:comment "One AoS element — the complete state description of a system at one TimeInstant (the foliated 3D view of the 4D referent at fixed t; DD `time_slice[]` element, e.g. one equilibrium reconstruction). Identity note: a TimeSlice is a VIEW indexed by (referent, instant), not an independent individual — the individual is the 4D referent." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000148 ;
            sh:description "The TimeInstant this slice is the state description of." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:at_instant ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:class spo:TimeSliceSeries ;
            sh:description "The TimeSliceSeries this slice is an element of (view → aggregate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:slice_of ],
        [ sh:datatype xsd:float ;
            sh:description "The timestamp of this slice (seconds on the shot/simulation timeline; A-Box scalar)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:at_time ] ;
    sh:targetClass spo:TimeSlice .

spo:TimeSliceSeries a sh:NodeShape ;
    rdfs:comment "The AoS layout — an ordered array of TimeSlice structs (DD `time_slice[]`): the discretized SpacetimeWorm, foliated per instant. Convenient for whole-state-at-t access (equilibrium at t); dual to the SoA TimeSeries via dual_view_of (stack the slices)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class spo:TemporalAggregate ;
            sh:description "The other-layout aggregate carrying the same content about the same referent (AoS ↔ SoA; the slice ⊣ stack adjunction). Symmetric; a read-time transform (sampling one way, regrouping the other), not a persisted distinct datum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:dual_view_of ],
        [ sh:class bfo:0000003 ;
            sh:description "The temporally extended referent (SpacetimeWorm / Process) this aggregate is the information content of (iao:is_about specialization). Two aggregates about the same referent with different layouts are dual views, not distinct claims about the world." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:about_occurrent ],
        [ sh:class spo:TimeAxis ;
            sh:description "The TimeAxis this aggregate/mesh is sampled on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:has_time_axis ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:TimeSlice ;
            sh:description "The ordered TimeSlice elements (AoS axis; order = TimeAxis order)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_slice ] ;
    sh:targetClass spo:TimeSliceSeries .

bfo:0000040 a sh:NodeShape ;
    rdfs:comment "A continuant that occupies a spatial region and can be identified as a whole (BFO material entity). Devices / equipment / plasma referent." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000006 ;
            sh:description "This material entity occupies a spatial region (BFO 2020 \"occupies spatial region\", BFO_0000210; verified against 21838-2 bfo-core — domain: independent continuant that is not a spatial region; range: spatial region). Range made structural (SP-ONT-ADR-02 D-2): SpatialRegion now lives in this module, closing the former string-range escape." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:0000210 ],
        [ sh:class bfo:0000002 ;
            sh:description "Parthood among continuants (BFO 2020 \"has continuant part\", BFO_0000178). Device assembly chains (coil → turn → conductor). Anchor corrected from the OBO/RO-era has_part BFO_0000051, which is not a term of ISO/IEC 21838-2 (BFO 2020); the RO lineage is noted here for interop with OBO ontologies still using it. Range made structural per the anchor's own signature (SP-ONT-ADR-02 D-2)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path bfo:0000178 ] ;
    sh:targetClass bfo:0000040 .

iao:0000033 a sh:NodeShape ;
    rdfs:comment "An information content entity whose concretizations prescribe — the directive branch of IAO (plan specifications, design specifications, program code). Added as the structural range of `realizes` (SP-ONT-ADR-02 D-2): the things a planned process realizes-by-shortcut are directive ICEs, not descriptive ones." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type spo:version spo:commit spo:uses_library spo:name spo:prescribes spo:repository ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path iao:0000136 ] ;
    sh:targetClass iao:0000033 .

spo:Code a sh:NodeShape ;
    rdfs:comment "The program text a computational run executes (legacy code node = name / commit / version / repository) — a DIRECTIVE information content entity, nothing else (SP-ONT-ADR-02 D-3): the run is the ComputationalProcess that realizes it, the run's account is the ComputationRecord. The former \"prov:SoftwareAgent + prov:Activity\" gloss conflated three categories and is retired." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:commit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:repository ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path iao:0000136 ],
        [ sh:class spo:Library ;
            sh:description "A library this code depends on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:uses_library ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:version ] ;
    sh:targetClass spo:Code .

bfo:0000003 a sh:NodeShape ;
    rdfs:comment "An entity that unfolds in time and has temporal parts (BFO occurrent)." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:has_output bfo:0000057 rdf:type spo:has_input spo:foliates_to spo:has_spacetime_extent spo:occupies_spacetime spo:realizes ) ;
    sh:targetClass bfo:0000003 .

bfo:0000015 a sh:NodeShape ;
    rdfs:comment "An occurrent that depends on material participants (BFO process). Unifies physical evolution / computation / measurement (FYTOK-REPORT-05 §rpt05-cat-process)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type spo:realizes ) ;
    sh:property [ sh:class bfo:0000002 ;
            sh:description "A continuant that participates in this process (BFO 2020 \"has participant\") — the apparatus a measurement is implemented by, the subject it probes, the computing system a run executes on. Structural carrier of the process family's participation face (SP-ONT-ADR-04)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:0000057 ],
        [ sh:class bfo:0000011 ;
            sh:description "The 4D spacetime region over which this process unfolds (4D extension bridge)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path spo:has_spacetime_extent ],
        [ sh:datatype xsd:string ;
            sh:description "An information / material input consumed by this process." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:has_input ],
        [ sh:datatype xsd:string ;
            sh:description "An information content entity produced by this process (e.g. an IDS)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_output ] ;
    sh:targetClass bfo:0000015 .

spo:TemporalAggregate a sh:NodeShape ;
    rdfs:comment "A temporally indexed information aggregate — the information content of a temporally extended referent (a SpacetimeWorm / Process) sampled on a TimeAxis. Abstract parent of the two LAYOUTS of the same content: TimeSliceSeries (AoS) and TimeSeries (SoA). The layout choice is representational, orthogonal to the referent's identity." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:has_slice rdf:type spo:has_channel ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:class bfo:0000003 ;
            sh:description "The temporally extended referent (SpacetimeWorm / Process) this aggregate is the information content of (iao:is_about specialization). Two aggregates about the same referent with different layouts are dual views, not distinct claims about the world." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:about_occurrent ],
        [ sh:class spo:TemporalAggregate ;
            sh:description "The other-layout aggregate carrying the same content about the same referent (AoS ↔ SoA; the slice ⊣ stack adjunction). Symmetric; a read-time transform (sampling one way, regrouping the other), not a persisted distinct datum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:dual_view_of ],
        [ sh:class spo:TimeAxis ;
            sh:description "The TimeAxis this aggregate/mesh is sampled on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_time_axis ] ;
    sh:targetClass spo:TemporalAggregate .

spo:ContinuousQuantity a sh:NodeShape ;
    rdfs:comment "A continuous physical quantity defined over a Domain — scalar or tensor: the INFORMATION CONTENT (an ICE) about a world-side Quality. The bearer chain is indirect and strata-clean (SP-ONT-ADR-02 D-4): this ICE carries representation_of to the Quality; the Quality — not this ICE — inheres_in its MaterialEntity bearer. Field (space / general domain) and Signal (time domain) are its sibling specializations. MULTI-REPRESENTATION: one Quality may be re-presented by several ContinuousQuantity instances on different Domains / grids / charts — each carries representation_of to the shared Quality and equivalent_representation to its peers; the representations differ in discretization, not in referent." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:timebase_source spo:data spo:time rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "DEPRECATED — unit as a bare UCUM/QUDT string (see deprecation note; use has_unit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path spo:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000019 ;
            sh:description "The world-side Quality this quantity re-presents (iao:is_about specialization narrowed to qualities). Several representations on different Domains share one referent Quality." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path spo:representation_of ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this field is defined over (C-3, replaces DD coordinate-by-path; bound via graph_connect)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:has_domain ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path iao:0000136 ],
        [ sh:class spo:ContinuousQuantity ;
            sh:description "A peer ContinuousQuantity re-presenting the SAME Quality on a different Domain / grid / coordinate chart (equilibrium profiles_2d rectangular vs flux-surface grid). Symmetric; conversion between peers is interpolation / chart transform, not new information." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path spo:equivalent_representation ],
        [ sh:class qudt:Unit ;
            sh:description "The Unit the numeric value is expressed in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path qudt:hasUnit ],
        [ sh:class spo:Domain ;
            sh:description "The Domain this quality is a function of (C-4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:is_function_of ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this value/quantity determines (determinable ← determinate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path qudt:hasQuantityKind ] ;
    sh:targetClass spo:ContinuousQuantity .

spo:TimeAxis a sh:NodeShape ;
    rdfs:comment "The discretized time coordinate — an ordered sequence of sample instants over a TimeInterval (an ICE; the information-level counterpart of the region it discretizes). Unifies the DD timebases: the IDS-homogeneous root `time[]`, a per-signal embedded `.../time`, and an AoS `time_slice[]/time` column are all TimeAxis instances; which one a datum rides is recorded by spo-signal `timebase_source`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:class bfo:0000038 ;
            sh:description "The TimeInterval this axis discretizes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:discretizes_time ],
        [ sh:datatype xsd:float ;
            sh:description "The sample instants (seconds); externalized array (A-Box column)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:samples ] ;
    sh:targetClass spo:TimeAxis .

bfo:0000019 a sh:NodeShape ;
    rdfs:comment "A specifically dependent continuant that inheres in its bearer (BFO quality). A measurable physical attribute." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000040 ;
            sh:description "This quality inheres in its material bearer (BFO/RO inheres_in)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path ro:0000052 ] ;
    sh:targetClass bfo:0000019 .

qudt:Unit a sh:NodeShape ;
    rdfs:comment "A measurement unit as an ICE — carrier of the UCUM code / QUDT IRI the `unit` strings across Spo schemas point into. Authority is the external unit system (UCUM/QUDT via the SpData `sp:phys` registry); this class is the T-Box landing, not a unit database." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path iao:0000136 ],
        [ sh:class qudt:QuantityKind ;
            sh:description "The QuantityKind this unit conventionally measures." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path spo:quantity_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:has_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "UCUM unit expression (e.g. Wb, m2.s-1, eV)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:ucum_code ] ;
    sh:targetClass qudt:Unit .

bfo:0000002 a sh:NodeShape ;
    rdfs:comment "An entity that persists through time keeping its identity, with no temporal parts (BFO continuant). Its immediate children (independent / specifically dependent / generically dependent continuant) are mutually disjoint, mirroring BFO 2020's AllDisjointClasses axiom — this is the structural carrier of the four-strata partition (matter / quality / occurrent / ICE): no class may inherit across strata (SP-ONT-STD-01 partition)." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:coordinate spo:has_slice spo:at_time spo:about_occurrent spo:is_function_of spo:of_coordinate_system spo:time spo:commit qudt:hasQuantityKind spo:description spo:geometry_role spo:metric_kind spo:of_quality bfo:0000178 spo:srepr rdf:type qudt:hasUnit spo:dimension_vector spo:at_instant spo:timebase_source spo:version spo:unit spo:chart_kind spo:prescribes spo:describes_region spo:index spo:has_spatial_base bfo:0000210 spo:latex spo:quantity_kind spo:discretizes_spacetime spo:has_coordinate_system spo:symbol spo:equivalent_representation spo:has_channel spo:has_domain spo:data spo:sympy_version ro:0000052 spo:discretizes_time spo:dual_view_of spo:has_time_axis spo:is_record_of spo:coordinate_axis spo:manifold_dim spo:executed_code spo:has_metric spo:ucum_code spo:representation_of spo:samples spo:defining_formulation spo:numeric_value spo:slice_of spo:uses_library spo:name spo:has_provenance spo:draws_from iao:0000136 spo:repository ) ;
    sh:targetClass bfo:0000002 .

qudt:QuantityKind a sh:NodeShape ;
    rdfs:comment "A kind of physical quantity — the DETERMINABLE (\"electron temperature\", \"poloidal flux\") as an ICE, independent of any bearer, domain, or unit. A concrete measured or computed quantity (Quality in the world; ContinuousQuantity/QuantityValue as information) determines a QuantityKind. Aligns qudt:QuantityKind; domain-specific kinds are enumerated by downstream domain artifacts, not here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:MathExpression ;
            sh:description "NATIVE relation (SP-ONT-ADR-05): the MathExpression that formally defines this quantity kind (MathModDB definingFormulation pattern — machine carrier here is the srepr canonical form rather than a bare LaTeX literal)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path spo:defining_formulation ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional symbol (e.g. T_e, psi)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spo:symbol ],
        [ sh:datatype xsd:string ;
            sh:description "QUDT dimension-vector expression (e.g. L2 M T-2); authority external (QUDT)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:dimension_vector ],
        [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ] ;
    sh:targetClass qudt:QuantityKind .

bfo:0000011 a sh:NodeShape ;
    rdfs:comment "A region of spacetime (BFO spatiotemporal region — an OCCURRENT in BFO 2020, re-seated by SP-ONT-ADR-02 D-1). 4D extension stratum: the four-dimensional intension whose 3D+Time foliation is the canonical view." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000011 .

spo:Domain a sh:NodeShape ;
    rdfs:comment "A mathematical domain a quantity is defined over (an axis / grid / mesh). Coordinates are Domains, not path strings (C-3). Mesh / discretization detail is owned by sp_mathx (OI-2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The controlled coordinate name this Domain realizes (continuous physical axis)." ;
            sh:in ( "time" "psi" "psi_norm" "rho_tor" "rho_tor_norm" "rho_pol_norm" "phi" "theta" "volume" "area" "r" "z" "dim1" "dim2" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path spo:coordinate ] ;
    sh:targetClass spo:Domain .

bfo:0000006 a sh:NodeShape ;
    rdfs:comment "A region of space (BFO spatial region — a continuant immaterial entity). The base manifold a field rides; bound to the shared math layer's geometry carriers." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass bfo:0000006 .

spo:CoordinateSystem a sh:NodeShape ;
    rdfs:comment "A coordinate chart — an ordered tuple of coordinate axes plus the metric that measures lengths / areas / volumes on it (IMAS ``coordinate_system`` / ``grid_type``). Cartesian (x,y,z), polar (r,θ), cylindrical (r,z,φ), spherical (r,φ,θ) and toroidal charts are the built-in kinds; the metric is Euclidean-identity unless the chart is curvilinear. COCOS orientation of flux charts is a domain concern owned by the downstream domain artifact (SPM-ADR-104 D2)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class bfo:0000001 ;
            sh:description "The entity this information is about (IAO is_about) — matter (a device), a quality (a temperature), or an occurrent (a shot). The generic reality → description arrow every descriptive ICE carries." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path iao:0000136 ],
        [ sh:datatype xsd:string ;
            sh:description "Orthogonal provenance information (FYTOK-REPORT-05 §rpt05-provenance, L7)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path spo:has_provenance ],
        [ sh:class spo:Metric ;
            sh:description "The metric tensor of this coordinate system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path spo:has_metric ],
        [ sh:datatype xsd:string ;
            sh:description "Named chart family — cartesian / polar / cylindrical / spherical / toroidal (selects the built-in metric)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path spo:chart_kind ],
        [ sh:datatype xsd:string ;
            sh:description "An ordered coordinate axis of the chart. Values draw on the ContinuousCoordinate vocabulary (x / y / z / r / z / phi / theta / psi …). Each axis carries a physical unit." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path spo:coordinate_axis ] ;
    sh:targetClass spo:CoordinateSystem .

bfo:0000001 a sh:NodeShape ;
    rdfs:comment "Anything that exists (BFO entity) — the common root of Continuant and Occurrent. Added as the range of cross-quadrant relations (is_about can target matter, qualities, or processes alike). Its immediate children are mutually disjoint — BFO 2020 asserts continuant/occurrent disjointness; spo carries the axiom natively so the compiled OWL is axiom-bearing without the BFO merge (SP-ONT-STD-01 conformance, D.5.1 machine check)." ;
    sh:closed false ;
    sh:ignoredProperties ( spo:has_slice spo:has_output spo:about_occurrent spo:is_function_of spo:of_coordinate_system qudt:hasQuantityKind spo:of_quality spo:has_spacetime_extent spo:version spo:unit bfo:0000057 spo:discretizes_spacetime spo:has_coordinate_system spo:symbol spo:equivalent_representation spo:has_channel spo:has_domain spo:sympy_version spo:dual_view_of spo:executed_code spo:manifold_dim spo:representation_of spo:uses_library spo:name spo:occupies_spacetime iao:0000136 spo:repository spo:coordinate spo:at_time spo:description spo:time spo:commit spo:has_input spo:geometry_role spo:metric_kind bfo:0000178 spo:srepr rdf:type qudt:hasUnit spo:dimension_vector spo:at_instant spo:timebase_source spo:chart_kind spo:prescribes spo:describes_region spo:index spo:has_spatial_base spo:foliates_to bfo:0000210 spo:latex spo:quantity_kind spo:data ro:0000052 spo:discretizes_time spo:has_time_axis spo:is_record_of spo:coordinate_axis spo:has_metric spo:ucum_code spo:samples spo:defining_formulation spo:realizes spo:numeric_value spo:slice_of spo:has_provenance spo:draws_from ) ;
    sh:targetClass bfo:0000001 .


